+/* ------------------------------------------------------------------ */
+/* sprites                                                             */
+/* ------------------------------------------------------------------ */
+static const char *spr_file[SPR_COUNT] = {
+    "music", "settings", "stats", "play",
+    "music_s", "settings_s", "stats_s", "play_s",
+    "lbl_music", "lbl_settings", "lbl_stats", "lbl_play",
+    "bar_dark", "bar_light", "note", "stats_bg",
+    "moon0", "moon1", "moon2", "moon3", "moon4", "moon5", "moon6", "moon7",
+    "m_music", "m_settings", "m_stats", "m_play", "bar_modern",
+    "m_music_s", "m_settings_s", "m_stats_s", "m_play_s",
+    "m_np_rew", "m_np_prev", "m_np_pause", "m_np_play", "m_np_next", "m_np_ff",
+    "m_npbg",
+};
+struct spr { int w, h; unsigned char *rgb; unsigned char *a; };
+static struct spr sprs[SPR_COUNT];
+static unsigned char spool[1400 * 1024];
+static size_t spool_used;
+
+static bool load_sprite(int id)
+{
+    char path[MAX_PATH];
+    unsigned char hd[8];
+    int fd;
+    snprintf(path, sizeof(path), UI_DIR "%s.asi", spr_file[id]);
+    fd = open(path, O_RDONLY);
+    if (fd < 0) return false;
+    if (read(fd, hd, 8) != 8 || memcmp(hd, "ASI1", 4)) { close(fd); return false; }
+    int w = hd[4] | hd[5] << 8, h = hd[6] | hd[7] << 8;
+    size_t need = (size_t)w * h * 3;
+    need = (need + 3) & ~3u;
+    if (w <= 0 || h <= 0 || spool_used + need > sizeof(spool)) { close(fd); return false; }
+    unsigned char *p = spool + spool_used;
+    if (read(fd, p, (size_t)w * h * 3) != (ssize_t)((size_t)w * h * 3)) { close(fd); return false; }
+    close(fd);
+    sprs[id].w = w; sprs[id].h = h;
+    sprs[id].rgb = p;
+    sprs[id].a = p + (size_t)w * h * 2;
+    spool_used += need;
+    return true;
+}
+
+int aui_sprite_w(int id) { return sprs[id].rgb ? sprs[id].w : 0; }
+int aui_sprite_h(int id) { return sprs[id].rgb ? sprs[id].h : 0; }
+
+static bool sprite_draw(int id, int x, int y, int op)
+{
+    const struct spr *s = &sprs[id];
+    if (!s->rgb) return false;
+    for (int j = 0; j < s->h; j++)
+    {
+        int yy = y + j;
+        if (yy < 0 || yy >= AUI_H) continue;
+        const unsigned char *c = s->rgb + (size_t)j * s->w * 2;
+        const unsigned char *a = s->a + (size_t)j * s->w;
+        fb_data *d = &aui_fb[yy * AUI_W];
+        for (int i = 0; i < s->w; i++)
+        {
+            int xx = x + i;
+            unsigned al = a[i];
+            if (!al || xx < 0 || xx >= AUI_W) continue;
+            fb_data sc = (fb_data)(c[2 * i] | (c[2 * i + 1] << 8));
+            unsigned w = al + (al >> 7);
+            if (op < 256) w = (w * op) >> 8;
+            d[xx] = (w >= 256) ? sc : blend(d[xx], sc, w);
+        }
+    }
+    return true;
+}
+
+bool aui_sprite(int id, int x, int y) { return sprite_draw(id, x, y, 256); }
+
+bool aui_sprite_fill(int id)
+{
+    const struct spr *s = &sprs[id];
+    if (!s->rgb || s->w != AUI_W || s->h != AUI_H) return false;
+    memcpy(aui_fb, s->rgb, sizeof(fb_data) * AUI_W * AUI_H);
+    return true;
+}
+
+bool aui_sprite_c(int id, int cx, int cy)
+{
+    return sprite_draw(id, cx - sprs[id].w / 2, cy - sprs[id].h / 2, 256);
+}
+
+bool aui_sprite_ca(int id, int cx, int cy, int op)
+{
+    return sprite_draw(id, cx - sprs[id].w / 2, cy - sprs[id].h / 2, op);
+}
+
+/* ------------------------------------------------------------------ */
+/* fonts                                                               */
+/* ------------------------------------------------------------------ */
+static const char *font_file[AF_COUNT] = {
+    "18-Adobe-Helvetica-Bold", "14-Adobe-Helvetica-Bold",
+    "12-Adobe-Helvetica-Bold", "12-Adobe-Helvetica",
+    "20-Asher-Retro", "10-Asher-Retro",
+};
+static int fonts[AF_COUNT] = { -1, -1, -1, -1, -1, -1 };
+static bool inited;
+static bool load_anim(int i);
+static void wp_loading_cb(int pct);
+
+/* album art slot shared by Stats and Now Playing (120x120) */
+static int aa_slot = -1;
+
+void aui_init(void)
+{
+    char path[MAX_PATH];
+    if (inited) return;
+    inited = true;
+    f3d_init();                       /* the 3D retro lettering */
+    for (int i = 0; i < AF_COUNT; i++)
+    {
+        snprintf(path, sizeof(path), FONT_DIR "%s.fnt", font_file[i]);
+        fonts[i] = font_load(path);
+    }
+    for (int i = 0; i < SPR_COUNT; i++)
+        load_sprite(i);
+    {
+        /* are the picture files the ones that go with this version? */
+        char v[8] = { 0 };
+        int fd = open(UI_DIR "version.txt", O_RDONLY);
+        if (fd >= 0) { read(fd, v, sizeof(v) - 1); close(fd); }
+        aui_assets_old = strncmp(v, ASHER_ASSETS_VERSION, strlen(ASHER_ASSETS_VERSION)) != 0;
+    }
+    for (int i = 0; i < LDR_COUNT; i++)
+        load_anim(i);
+    /* memory for wallpapers, the library and pop-ups, set aside now so
+     * opening things later never has to pause the music */
+#if defined(IPOD_NANO3G)
+    asher_mem_init(9 * 1024 * 1024);
+#elif defined(IPOD_VIDEO) && !defined(SIMULATOR)
+    {
+        extern unsigned char probed_ramsize;
+        asher_mem_init(probed_ramsize <= 32 ? 9 * 1024 * 1024 : 18 * 1024 * 1024);
+    }
+#else
+    asher_mem_init(18 * 1024 * 1024);
+#endif
+    asher_wp_set_loading_cb(wp_loading_cb);
+#ifdef HAVE_ALBUMART
+    if (aa_slot < 0)
+    {
+        struct dim d = { 120, 120 };
+        aa_slot = playback_claim_aa_slot(&d);
+    }
+#endif
+}
+
+int aui_font(int which)
+{
+    if (which == AF_RETRO_T) which = AF_RETRO_S;
+    if (which < 0 || which >= AF_COUNT || fonts[which] < 0) return FONT_UI;
+    return fonts[which];
+}
+/* the old pixel font (AF_RETRO, AF_RETRO_S) is drawn with the 3D lettering */
+static int f3_of(int which)
+{
+    if (which == AF_RETRO && f3d_ok(F3D_BIG)) return F3D_BIG;
+    if (which == AF_RETRO_S && f3d_ok(F3D_SMALL)) return F3D_SMALL;
+    if (which == AF_RETRO_T && f3d_ok(F3D_TINY)) return F3D_TINY;
+    return -1;
+}
+int aui_font_h(int which)
+{
+    int f = f3_of(which);
+    if (f >= 0) return f3d_h(f);
+    return font_get(aui_font(which))->height;
+}
+int aui_text_w(int which, const char *s)
+{
+    int w = 0, h = 0;
+    int f = f3_of(which);
+    if (f >= 0) return f3d_text_w(f, s);
+    font_getstringsize((const unsigned char *)s, &w, &h, aui_font(which));
+    return w;
+}
+
+
+/* ------------------------------------------------------------------ */
+/* loading animations                                                  */
+/* ------------------------------------------------------------------ */
+struct anim { int handle, w, h, n, ms; size_t fsz; };
+static struct anim anims[LDR_COUNT] = { { -1 }, { -1 }, { -1 }, { -1 } };
+static const char *anim_file[LDR_COUNT] = { "ldr_music", "ldr_stats", "ldr_np", "m_ldr" };
+static const unsigned anim_bg[LDR_COUNT] = { 0x080a19, 0x000000, 0x1d384d, 0xffffff };
+static const unsigned anim_fg[LDR_COUNT] = { 0xd9b8ff, 0xffa040, 0x13f08c, 0x1c1c1e };
+
+static bool load_anim(int i)
+{
+    char path[MAX_PATH];
+    unsigned char hd[12];
+    struct anim *a = &anims[i];
+    int fd;
+    snprintf(path, sizeof(path), UI_DIR "%s.awp", anim_file[i]);
+    fd = open(path, O_RDONLY);
+    if (fd < 0) return false;
+    if (read(fd, hd, 12) != 12 || memcmp(hd, "AWP1", 4)) { close(fd); return false; }
+    a->w = hd[4] | hd[5] << 8; a->h = hd[6] | hd[7] << 8;
+    a->n = hd[8] | hd[9] << 8; a->ms = hd[10] | hd[11] << 8;
+    if (a->w <= 0 || a->w > AUI_W || a->h <= 0 || a->h > AUI_H || a->n <= 0)
+        { close(fd); return false; }
+    if (a->ms < 20) a->ms = 20;
+    a->fsz = (size_t)a->w * a->h * sizeof(fb_data);
+    a->handle = core_alloc(a->fsz * a->n);
+    if (a->handle <= 0) { a->handle = -1; close(fd); return false; }
+    char *dst = core_get_data_pinned(a->handle);
+    bool ok = read(fd, dst, a->fsz * a->n) == (ssize_t)(a->fsz * a->n);
+    core_unpin(a->handle);
+    close(fd);
+    if (!ok) { core_free(a->handle); a->handle = -1; }
+    return ok;
+}
+
+int aui_loading_ticks(int which)
+{
+    if (aui_theme()->modern && anims[LDR_MODERN].handle > 0) which = LDR_MODERN;
+    int t = anims[which].handle > 0 ? anims[which].ms * HZ / 1000 : HZ / 5;
+    return t < 1 ? 1 : t;
+}
+
+/* Modern theme: a simple grey spinner with "Loading" under it */
+static void modern_loading(const char *sub, long start)
+{
+    struct anim *ma = &anims[LDR_MODERN];
+    if (ma->handle > 0)
+    {
+        /* the spinner (with "Loading" under it) on white */
+        long ms = (long)(current_tick - start) * (1000 / HZ);
+        int f = (int)(ms / ma->ms) % ma->n;
+        int y = AUI_BAR + (AUI_H - AUI_BAR - ma->h) / 2 - (sub ? 10 : 0);
+        aui_fill(0, 0, AUI_W, AUI_H, 0xffffff);
+        aui_topbar();
+        aui_blit((const fb_data *)((char *)core_get_data(ma->handle) + ma->fsz * f),
+                 ma->w, ma->h, (AUI_W - ma->w) / 2, y);
+        aui_present();
+        if (sub) aui_text(AF_SMALLR, AUI_W / 2, y + ma->h + 4, 0x8e8e93, sub, AUI_W - 20, 1);
+        aui_topbar_text("");
+        aui_update();
+        return;
+    }
+    static const signed char dir[12][2] = {
+        {0,-100},{50,-87},{87,-50},{100,0},{87,50},{50,87},
+        {0,100},{-50,87},{-87,50},{-100,0},{-87,-50},{-50,-87} };
+    int cx = AUI_W / 2, cy = AUI_BAR + 82;
+    int head = (int)(((current_tick - start) * 12 / (HZ * 8 / 10)) % 12);
+    aui_fill(0, 0, AUI_W, AUI_H, 0xf2f2f7);
+    aui_topbar();
+    for (int i = 0; i < 12; i++)
+    {
+        int age = (head - i + 12) % 12;              /* 0 = newest = darkest */
+        int g = 0x3a + age * 13;
+        unsigned c = (g << 16) | (g << 8) | (g + 4);
+        for (int r = 11; r <= 20; r += 3)
+        {
+            int x = cx + dir[i][0] * r / 100, y = cy + dir[i][1] * r / 100;
+            aui_round(x - 2, y - 2, 5, 5, 2, c, c);
+        }
+    }
+    aui_present();
+    aui_text(AF_MED, AUI_W / 2, cy + 36, 0x6e6e76, "Loading", AUI_W - 20, 1);
+    if (sub) aui_text(AF_SMALLR, AUI_W / 2, cy + 56, 0x8e8e93, sub, AUI_W - 20, 1);
+    aui_topbar_text("");
+    aui_update();
+}
+
+void aui_loading(int which, const char *text, const char *sub, long start, bool once)
+{
+    /* a screen you opened is still loading: don't let the screen time out
+     * meanwhile (only these loading screens do this, not background work) */
+    /* (at most twice a second: every progress step would flood the
+     * backlight thread's queue while it's still busy at start-up) */
+    static long last_bl;
+    if (is_backlight_on(true) && TIME_AFTER(current_tick, last_bl + HZ / 2))
+    {
+        last_bl = current_tick;
+        backlight_on();
+    }
+    if (aui_theme()->modern)
+    {
+        (void)text; (void)once;
+        modern_loading(which == LDR_MUSIC ? NULL : sub, start);
+        return;
+    }
+    struct anim *a = &anims[which];
+    int h = a->handle > 0 ? a->h : 0;
+    int th = text ? aui_font_h(AF_RETRO) + 6 : 0, sh = sub ? aui_font_h(AF_RETRO_S) + 4 : 0;
+    int avail = AUI_H - AUI_BAR, y, ty;
+    if (which == LDR_MUSIC && h > 0)
+    {
+        /* the record player: always in the same spot, a little below the bar */
+        y = AUI_BAR + (sub ? 8 : 20);
+        ty = y + h + 4;
+    }
+    else if (h + th + sh + 8 <= avail)
+    {
+        y = AUI_BAR + (avail - h - th - sh) / 2;
+        ty = y + h + 6;
+    }
+    else      /* tall animation: pin it under the bar, text at the bottom */
+    {
+        y = AUI_BAR;
+        ty = AUI_H - th - sh - 2;
+    }
+    aui_fill(0, 0, AUI_W, AUI_H, anim_bg[which]);
+    if (a->handle > 0)
+    {
+        long ms = (long)(current_tick - start) * (1000 / HZ);
+        int f = (int)(ms / a->ms);
+        f = once ? MIN(f, a->n - 1) : f % a->n;
+        if (f < 0) f = 0;
+        aui_blit((const fb_data *)((char *)core_get_data(a->handle) + a->fsz * f),
+                 a->w, a->h, (AUI_W - a->w) / 2, y);
+    }
+    if (text && ty < y + h)    /* soften the animation behind the text */
+        aui_shade(0, ty - 4, AUI_W, AUI_H - ty + 4, 0, 60, anim_bg[which]);
+    aui_topbar();
+    aui_present();
+    if (text) aui_text(AF_RETRO, AUI_W / 2, ty, anim_fg[which], text, AUI_W - 16, 1);
+    if (sub)  aui_text(AF_RETRO_S, AUI_W / 2, ty + th, 0xd0d4ea, sub, AUI_W - 16, 1);
+    aui_topbar_text("");
+    aui_update();
+}
+
+void aui_intro(int which)
+{
+    struct anim *a = &anims[which];
+    long start = current_tick;
+    long len = a->handle > 0 ? (long)a->n * a->ms * HZ / 1000 + HZ / 6 : 0;
+    if (aui_theme()->modern) len = HZ / 2;          /* just a quick spin */
+    if (aui_quiet_until && TIME_BEFORE(current_tick, aui_quiet_until)) return;
+    if (len <= 0 || !aui_screen_on()) return;
+    while (TIME_BEFORE(current_tick, start + len))
+    {
+        aui_loading(which, NULL, NULL, start, true);
+        int act = get_action(CONTEXT_STD, aui_theme()->modern ? HZ / 15 : aui_loading_ticks(which));
+        if (act != ACTION_NONE) break;          /* any button skips it */
+    }
+}
+
+/* shown while a wallpaper is read from the (slow) hard drive */
+static long wp_load_start;
+long aui_quiet_until;   /* no loading screens until then (just after USB) */
+
+static void wp_loading_cb(int pct)
+{
+    char sub[16];
+    if (aui_quiet_until && TIME_BEFORE(current_tick, aui_quiet_until)) return;
+    if (pct == 0 || !wp_load_start) wp_load_start = current_tick;
+    if (!aui_screen_on()) return;
+    snprintf(sub, sizeof(sub), "%d%%", pct);
+    aui_loading(LDR_STATS, "LOADING WALLPAPER", sub, wp_load_start, false);
+}
+
+int asher_splash_font(void)
+{
+    if (!inited) return -1;
+    return aui_theme()->modern ? fonts[AF_MED] : fonts[AF_RETRO];
+}
+bool asher_splash_modern(void) { return inited && aui_theme()->modern; }
+
+/* ------------------------------------------------------------------ */
+/* album art / progress                                                */
+/* ------------------------------------------------------------------ */
+/* the current song's album art bitmap (RGB565), false if it has none */
+bool aui_albumart_bitmap(const fb_data **data, int *w, int *h)
+{
+#ifdef HAVE_ALBUMART
+    struct bitmap *bmp = NULL;
+    int hid;
+    if (aa_slot < 0 || !(audio_status() & AUDIO_STATUS_PLAY)) return false;
+    hid = playback_current_aa_hid(aa_slot);
+    if (hid < 0 || bufgetdata(hid, 0, (void **)&bmp) <= 0 || !bmp || !bmp->data)
+        return false;
+    *data = (const fb_data *)bmp->data;
+    *w = bmp->width;
+    *h = bmp->height;
+    return *w > 0 && *h > 0;
+#else
+    (void)data; (void)w; (void)h;
+    return false;
+#endif
+}
+
+/* album art squeezed (or stretched) into a size x size square */
+bool aui_albumart_scaled(int x, int y, int size)
+{
+    const fb_data *src; int w, h;
+    if (!aui_albumart_bitmap(&src, &w, &h)) return false;
+    for (int j = 0; j < size; j++)
+    {
+        int yy = y + j;
+        if (yy < 0 || yy >= AUI_H) continue;
+        const fb_data *row = src + (j * h / size) * w;
+        fb_data *dst = &aui_fb[yy * AUI_W];
+        for (int i = 0; i < size; i++)
+            if (x + i >= 0 && x + i < AUI_W) dst[x + i] = row[i * w / size];
+    }
+    return true;
+}
+
+bool aui_albumart(int x, int y, int box)
+{
+#ifdef HAVE_ALBUMART
+    struct bitmap *bmp = NULL;
+    int hid;
+    if (aa_slot < 0 || !(audio_status() & AUDIO_STATUS_PLAY)) return false;
+    hid = playback_current_aa_hid(aa_slot);
+    if (hid < 0 || bufgetdata(hid, 0, (void **)&bmp) <= 0 || !bmp || !bmp->data)
+        return false;
+    int w = MIN(bmp->width, box), h = MIN(bmp->height, box);
+    const fb_data *src = (const fb_data *)bmp->data;
+    int ox = x + (box - w) / 2, oy = y + (box - h) / 2;
+    for (int j = 0; j < h; j++)
+        if (oy + j >= 0 && oy + j < AUI_H)
+            memcpy(&aui_fb[(oy + j) * AUI_W + ox], &src[j * bmp->width],
+                   w * sizeof(fb_data));
+    return true;
+#else
+    (void)x; (void)y; (void)box;
+    return false;
+#endif
+}
+
+void aui_progress(int x, int y, int w, int h, long pos, long len)
+{
+    const struct aui_theme *t = aui_theme();
+    int r = h / 2, fill = 0;
+    aui_round(x, y, w, h, r, t->track, t->track);
+    if (len > 0)
+    {
+        if (pos < 0) pos = 0;
+        if (pos > len) pos = len;
+        fill = (int)((long long)w * pos / len);
+    }
+    if (fill > 0)
+        aui_round(x, y, MAX(fill, h), h, r, t->sel1, t->sel2);
+}
+
+/* ------------------------------------------------------------------ */
+/* top bar                                                             */
+/* ------------------------------------------------------------------ */
+unsigned aui_batt_rgb(int pct)
+{
+    /* picked so they also stay apart for red-green colour blindness
+     * (protan): bright green, dark orange, deep red read as light,
+     * medium and dark */
+    if (pct >= 66) return 0x26ff38;      /* green */
+    if (pct >= 31) return 0xd97116;      /* dark orange */
+    return 0xbf1d38;                     /* deep red */
+}
+
+/* the charging bolt, like a phone's: white with a dark edge */
+#define BOLT_H 8
+static const char *const bolt_rows[BOLT_H] = {
+    "....##.", "...##..", "..##...", ".######", "######.",
+    "...##..", "..##...", ".##....",
+};
+void aui_bolt(void (*rect)(int x, int y, int w, int h, unsigned rgb), int x, int y)
+{
+    /* the edge: every pixel next to the bolt */
+    for (int r = -1; r <= BOLT_H; r++)
+        for (int c = -1; c <= 7; c++)
+        {
+            bool in = r >= 0 && r < BOLT_H && c >= 0 && c < 7 && bolt_rows[r][c] == '#';
+            if (in) continue;
+            bool near = false;
+            for (int dr = -1; dr <= 1 && !near; dr++)
+                for (int dc = -1; dc <= 1; dc++)
+                {
+                    int rr = r + dr, cc = c + dc;
+                    if (rr >= 0 && rr < BOLT_H && cc >= 0 && cc < 7 && bolt_rows[rr][cc] == '#')
+                        { near = true; break; }
+                }
+            if (near) rect(x + c, y + r, 1, 1, 0x1c1c1e);
+        }
+    for (int r = 0; r < BOLT_H; r++)
+        for (int c = 0; c < 7; c++)
+            if (bolt_rows[r][c] == '#') rect(x + c, y + r, 1, 1, 0xffffff);
+}
+
+void aui_topbar(void)
+{
+    const struct aui_theme *t = aui_theme();
+    int bat = battery_level();
+    int bx = AUI_W - 34, by = 9;
+    if (t->modern)
+    {
+        if (!aui_sprite(SPR_BAR_MODERN, 0, 0))
+        {
+            aui_fill(0, 0, AUI_W, AUI_BAR, 0xf8f8fa);
+            aui_fill(0, AUI_BAR - 1, AUI_W, 1, 0xd6d6dc);
+        }
+    }
+    else if (!aui_sprite(t->light ? SPR_BAR_LIGHT : SPR_BAR_DARK, 0, 0))
+        aui_vgrad(0, 0, AUI_W, AUI_BAR, t->light ? 0xf4f5f8 : 0x15173a,
+                  t->light ? 0xc9ced8 : 0x0a0b1c);
+    /* battery outline is part of the bar picture; draw the fill */
+    if (bat >= 0)
+    {
+        /* fill the whole inside of the outline, so the picture matches
+         * the number (it used to leave a gap that made it look emptier) */
+        int f = (bat * 22 + 50) / 100;
+        unsigned c = aui_batt_rgb(bat);
+        if (f > 0) aui_fill(bx + 1, by + 1, f, 10, c);
+#if CONFIG_CHARGING
+        if (charger_inserted())
+            aui_bolt(aui_fill, bx + 1 + 11 - 3, by + 2);
+#endif
+    }
+}
+
+void aui_topbar_text(const char *title)
+{
+    const struct aui_theme *t = aui_theme();
+    static const char *dn[7] = { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" };
+    static const char *mn[12] = { "Jan", "Feb", "Mar", "Apr", "May", "Jun",
+                                  "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };
+    char buf[24];
+    unsigned c = t->light ? 0x161616 : 0xffffff;
+    unsigned c2 = t->light ? 0x55555c : 0xc8cde6;
+    /* time on top, day and date under it */
+    aui_time_str(buf, sizeof(buf));
+    aui_text(AF_SMALL, 34, 1, c, buf, 84, 0);
+    struct tm *tm = get_time();
+    snprintf(buf, sizeof(buf), "%s %s %d", dn[tm->tm_wday % 7], mn[tm->tm_mon % 12], tm->tm_mday);
+    aui_text(AF_SMALLR, 34, 15, c2, buf, 84, 0);
+    int fh = aui_font_h(AF_MED), y = (AUI_BAR - fh) / 2;
+    if (title && title[0])
+        aui_text(AF_MED, 168, y, c, title, 100, 1);
+    /* play / pause sign: only when a song is loaded */
+    int st = audio_status();
+    if (st & AUDIO_STATUS_PLAY)
+    {
+        lcd_set_drawmode(DRMODE_SOLID);
+        lcd_set_foreground(LCD_RGBPACK((c >> 16) & 255, (c >> 8) & 255, c & 255));
+        int ix = 224, iy = 9;
+        /* like a phone: while playing it shows the pause button, while
+         * paused the play button */
+        if (!(st & AUDIO_STATUS_PAUSE))
+        {
+            lcd_fillrect(ix + 1, iy, 3, 12);
+            lcd_fillrect(ix + 6, iy, 3, 12);
+        }
+        else
+            for (int k = 0; k < 9; k++)        /* a small triangle */
+            {
+                int half = 6 - (k * 6 + 4) / 9;
+                lcd_vline(ix + 1 + k, iy + 6 - half, iy + 5 + half);
+            }
+    }
+    int bat = battery_level();
+    if (bat >= 0)
+    {
+        snprintf(buf, sizeof(buf), "%d%%", bat);
+        aui_text(AF_MED, AUI_W - 40, y, c, buf, 48, 2);
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* output                                                              */
+/* ------------------------------------------------------------------ */
+void aui_begin(void)
+{
+    aui_depth++;
+    aui_init();
+    viewportmanager_theme_enable(SCREEN_MAIN, false, NULL);
+    lcd_set_viewport(NULL);
+    lcd_set_drawmode(DRMODE_SOLID);
+}
+
+void aui_end(void)
+{
+    if (aui_depth > 0) aui_depth--;
+    lcd_set_viewport(NULL);
+    lcd_set_drawmode(DRMODE_SOLID);
+    lcd_setfont(FONT_UI);
+    lcd_set_foreground(global_settings.fg_color);
+    lcd_set_background(global_settings.bg_color);
+    lcd_clear_display();
+    viewportmanager_theme_undo(SCREEN_MAIN, false);
+}
+
+void aui_present(void)
+{
+    lcd_set_viewport(NULL);
+    lcd_bitmap(aui_fb, 0, 0, AUI_W, AUI_H);
+    asher_boot_release();     /* first screen after boot is up: bar allowed again */
+}
+
+void aui_text(int font, int x, int y, unsigned rgb, const char *s, int maxw, int align)
+{
+    char buf[160];
+    int w = 0, h = 0, fid = aui_font(font);
+    if (!s || !s[0]) return;
+    strlcpy(buf, s, sizeof(buf));
+    int f3 = f3_of(font);
+    if (f3 >= 0)
+    {
+        w = f3d_text_w(f3, buf);
+        if (maxw > 0 && w > maxw)
+        {
+            size_t len = strlen(buf);
+            while (len > 0)
+            {
+                do { len--; } while (len > 0 && (buf[len] & 0xc0) == 0x80);
+                buf[len] = '\0';
+                char tmp[164];
+                snprintf(tmp, sizeof(tmp), "%s...", buf);
+                w = f3d_text_w(f3, tmp);
+                if (w <= maxw) { strlcpy(buf, tmp, sizeof(buf)); break; }
+            }
+        }
+        if (align == 1) x -= w / 2;
+        else if (align == 2) x -= w;
+        lcd_set_viewport(NULL);
+        f3d_draw(f3, x, y, rgb, buf);
+        return;
+    }
+    font_getstringsize((unsigned char *)buf, &w, &h, fid);
+    if (maxw > 0 && w > maxw)
+    {
+        size_t len = strlen(buf);
+        while (len > 0)
+        {
+            do { len--; } while (len > 0 && (buf[len] & 0xc0) == 0x80);
+            buf[len] = '\0';
+            char tmp[164];
+            snprintf(tmp, sizeof(tmp), "%s...", buf);
+            font_getstringsize((unsigned char *)tmp, &w, &h, fid);
+            if (w <= maxw) { strlcpy(buf, tmp, sizeof(buf)); break; }
+        }
+    }
+    if (align == 1) x -= w / 2;
+    else if (align == 2) x -= w;
+    lcd_setfont(fid);
+    lcd_set_drawmode(DRMODE_FG);
+    lcd_set_foreground(LCD_RGBPACK((rgb >> 16) & 255, (rgb >> 8) & 255, rgb & 255));
+    lcd_putsxy(x, y, buf);
+    lcd_set_drawmode(DRMODE_SOLID);
+}
+
+void aui_update(void) { asher_toast_overlay(); lcd_update(); asher_batt_save_if_due(); }
+void aui_update_rect(int x, int y, int w, int h) { lcd_update_rect(x, y, w, h); }
+
+/* ------------------------------------------------------------------ */
+/* misc                                                                */
+/* ------------------------------------------------------------------ */
+void aui_time_str(char *buf, size_t n)
+{
+    struct tm *t = get_time();
+    snprintf(buf, n, "%d:%02d %s", t->tm_hour % 12 ? t->tm_hour % 12 : 12,
+             t->tm_min, t->tm_hour >= 12 ? "PM" : "AM");
+}
+
+void aui_fmt_time(char *buf, size_t n, long ms)
+{
+    long s = ms < 0 ? 0 : ms / 1000;
+    if (s >= 3600)
+        snprintf(buf, n, "%ld:%02ld:%02ld", s / 3600, (s / 60) % 60, s % 60);
+    else
+        snprintf(buf, n, "%ld:%02ld", s / 60, s % 60);
+}
+
+int aui_volume_pct(void)
+{
+    int mn = sound_min(SOUND_VOLUME), mx = sound_max(SOUND_VOLUME);
+    if (mx <= mn) return 0;
+    return (global_status.volume - mn) * 100 / (mx - mn);
+}
+
+bool aui_screen_on(void)
+{
+    return is_backlight_on(true);
+}
+
+bool aui_dirty;     /* something drew over the screen: redraw it */
+bool aui_assets_old;
+
+bool aui_woke(void)
+{
+    static bool last_on = true;
+    bool on = is_backlight_on(true), woke = on && !last_on;
+    last_on = on;
+    if (aui_dirty) { aui_dirty = false; woke = true; }
+    if (asher_toast_expired()) woke = true;     /* a pop-up ran out: redraw */
+    return woke;
+}
diff --git a/apps/asher/asher_ui.h b/apps/asher/asher_ui.h
new file mode 100644
index 0000000000..4de45a3f61
--- /dev/null
+++ b/apps/asher/asher_ui.h
@@ -0,0 +1,110 @@
+/* Asher OS shared drawing layer.
+ * Screens are composed into an off-screen buffer (aui_fb): wallpaper,
+ * glass panels and alpha-blended sprites. The buffer is then copied to the
+ * LCD and text is drawn on top with transparent background. */
+#ifndef ASHER_UI_H
+#define ASHER_UI_H
+#include <stdbool.h>
+#include <stddef.h>
+#include "config.h"
+#include "lcd.h"
+
+#define AUI_W   LCD_WIDTH
+#define AUI_H   LCD_HEIGHT
+#define AUI_BAR 30               /* height of the top bar on every screen */
+
+extern fb_data aui_fb[LCD_WIDTH * LCD_HEIGHT];
+
+struct aui_theme {
+    bool light;                  /* Classic (white) look */
+    bool wallpaper;              /* show the live wallpaper behind screens */
+    unsigned bg_top, bg_bot;     /* background gradient */
+    unsigned text, sub, accent;  /* text colours */
+    unsigned sel1, sel2;         /* selection bar gradient */
+    unsigned seltext;
+    unsigned panel;              /* solid panel colour (light theme) */
+    unsigned track;              /* progress bar track */
+    bool modern;                 /* Modern (phone-style) look */
+};
+const struct aui_theme *aui_theme(void);
+
+/* sprites */
+enum {
+    SPR_MUSIC, SPR_SETTINGS, SPR_STATS, SPR_PLAY,           /* bubbles */
+    SPR_MUSIC_S, SPR_SETTINGS_S, SPR_STATS_S, SPR_PLAY_S,   /* selected */
+    SPR_LBL_MUSIC, SPR_LBL_SETTINGS, SPR_LBL_STATS, SPR_LBL_PLAY,
+    SPR_BAR_DARK, SPR_BAR_LIGHT, SPR_NOTE, SPR_STATS_BG,
+    SPR_MOON0, SPR_MOON1, SPR_MOON2, SPR_MOON3,
+    SPR_MOON4, SPR_MOON5, SPR_MOON6, SPR_MOON7,
+    SPR_M_MUSIC, SPR_M_SETTINGS, SPR_M_STATS, SPR_M_PLAY,   /* Modern app icons */
+    SPR_BAR_MODERN,
+    SPR_M_MUSIC_S, SPR_M_SETTINGS_S, SPR_M_STATS_S, SPR_M_PLAY_S,   /* Modern, selected */
+    SPR_M_NP_REW, SPR_M_NP_PREV, SPR_M_NP_PAUSE, SPR_M_NP_PLAY, SPR_M_NP_NEXT, SPR_M_NP_FF,
+    SPR_M_NPBG,                                             /* Modern Now Playing backdrop */
+    SPR_COUNT
+};
+
+/* fonts */
+enum { AF_BIG, AF_MED, AF_SMALL, AF_SMALLR, AF_RETRO, AF_RETRO_S, AF_COUNT };
+#define AF_RETRO_T (AF_COUNT + 1)   /* compact 3D lettering (Stats widgets) */
+
+/* loading animations */
+enum { LDR_MUSIC, LDR_STATS, LDR_NP, LDR_MODERN, LDR_COUNT };
+
+void aui_init(void);                 /* load fonts + sprites (once) */
+void aui_begin(void);                /* take over the whole screen */
+void aui_end(void);                  /* hand the screen back */
+int  aui_font(int which);
+int  aui_font_h(int which);
