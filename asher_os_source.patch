diff --git a/apps/asher/asher_prefs.c b/apps/asher/asher_prefs.c
new file mode 100644
index 0000000000..957d1b7184
--- /dev/null
+++ b/apps/asher/asher_prefs.c
@@ -0,0 +1,154 @@
+#include <stdio.h>
+#include <string.h>
+#include <fcntl.h>
+#include "config.h"
+#include "file.h"
+#include "settings.h"
+#include "powermgmt.h"
+#include "storage.h"
+#include "usb.h"
+#include "asher_prefs.h"
+
+#define PREFS_FILE "/.rockbox/asher/prefs.txt"
+
+int asher_organize = ORG_ALPHA;
+int asher_shufmode = SHUF_OFF;
+int asher_wheel = 24;          /* steps in one full turn: everything else */
+int asher_wheel_main = 24;     /* ... on the main (home) menu */
+int asher_wheel_music = 24;    /* ... anywhere in Music */
+static int wheel_zone = WZ_OTHER;
+int asher_boot_mode = BOOT_WHEEL;
+int asher_boot_chime = 1;
+
+void button_set_wheel_steps(int steps);
+
+static void wheel_set(int steps)
+{
+#if !defined(SIMULATOR) && !defined(IPOD_NANO) && !defined(IPOD_NANO2G) \
+    && (CONFIG_KEYPAD == IPOD_4G_PAD)
+    button_set_wheel_steps(steps);
+#else
+    (void)steps;
+#endif
+}
+
+int asher_wheel_for(int zone)
+{
+    switch (zone)
+    {
+        case WZ_MAIN:   return asher_wheel_main;
+        case WZ_MUSIC:  return asher_wheel_music;
+        case WZ_SEARCH: return WHEEL_DEFAULT;     /* search always uses the default */
+        case WZ_BOOT:   return 30;                /* the logo screen: 30 per spin */
+        default:        return asher_wheel;
+    }
+}
+
+static int wheel_now = -1;
+/* the wheel speed for the screen being shown */
+void asher_wheel_zone(int zone)
+{
+    wheel_zone = zone;
+    int v = asher_wheel_for(zone);
+    if (v != wheel_now) { wheel_now = v; wheel_set(v); }
+}
+int asher_wheel_zone_get(void) { return wheel_zone; }
+
+/* set a speed directly (Scroll Speed screen, while trying one out) */
+void asher_wheel_try(int steps)
+{
+    if (steps != wheel_now) { wheel_now = steps; wheel_set(steps); }
+}
+
+void asher_wheel_apply(void)
+{
+    wheel_now = -1;
+    asher_wheel_zone(wheel_zone);
+}
+
+void asher_prefs_load(void)
+{
+    char buf[96];
+    int fd = open(PREFS_FILE, O_RDONLY), n = 0;
+    if (fd >= 0) { n = read(fd, buf, sizeof(buf) - 1); close(fd); }
+    if (n < 0) n = 0;
+    buf[n] = '\0';
+    bool got_m = false, got_u = false;     /* older files have one speed for all */
+    int batt = -1;
+    bool seen_h = false;
+    for (char *p = buf; *p; p++)
+    {
+        if (p[1] != '=' || p[2] < '0' || p[2] > '9') continue;
+        int v = p[2] - '0';
+        bool two = p[3] >= '0' && p[3] <= '9';
+        if (two) v = v * 10 + (p[3] - '0');
+        if (p[0] == 'o' && v <= ORG_OFF) asher_organize = v;
+        if (p[0] == 's' && v <= SHUF_PLAYLISTS) asher_shufmode = v;
+        if (p[0] == 'w')
+        {
+            if (!two && v >= 1 && v <= 8) v = 96 / v;   /* old "clicks per step" */
+            if (v >= 5 && v <= 50) { asher_wheel = v; if (!got_m) asher_wheel_main = v;
+                                     if (!got_u) asher_wheel_music = v; }
+        }
+        if (p[0] == 'b' && v <= 99) batt = v;
+        if (p[0] == 'h') seen_h = true;
+        if (p[0] == 'g' && v <= BOOT_SELECT) asher_boot_mode = v;
+        if (p[0] == 'c' && v <= 1) asher_boot_chime = v;
+        if (p[0] == 'm' && v >= 5 && v <= 50) { asher_wheel_main = v; got_m = true; }
+        if (p[0] == 'u' && v >= 5 && v <= 50) { asher_wheel_music = v; got_u = true; }
+    }
+    /* the player's own shuffle switch is the truth for on/off */
+    if (!global_settings.playlist_shuffle) asher_shufmode = SHUF_OFF;
+    else if (asher_shufmode == SHUF_OFF) asher_shufmode = SHUF_SONGS;
+    asher_wheel_apply();
+#ifdef HAVE_HEADPHONE_DETECTION
+    /* 2.4: pause when the headphones come out, unless set otherwise */
+    if (!seen_h && global_settings.unplug_mode == 0)
+    {
+        global_settings.unplug_mode = 1;
+        settings_save();
+    }
+#endif
+    /* 2.5.3: the battery % is Rockbox's own reading again (no saved
+     * number carried over a restart) */
+    (void)batt;
+}
+
+void asher_prefs_save(void)
+{
+    char buf[96];
+    int b = battery_level();
+    if (b > 99) b = 99;
+    int n = snprintf(buf, sizeof(buf), "o=%d\ns=%d\nm=%d\nu=%d\nw=%d\nb=%02d\nh=1\ng=%d\nc=%d\n",
+                     asher_organize, asher_shufmode, asher_wheel_main,
+                     asher_wheel_music, asher_wheel, b < 0 ? 0 : b,
+                     asher_boot_mode, asher_boot_chime);
+    int fd = open(PREFS_FILE, O_WRONLY | O_CREAT | O_TRUNC, 0666);
+    if (fd >= 0) { write(fd, buf, n); close(fd); }
+}
+
+/* the battery % is kept in the prefs file so a reboot starts from the same
+ * number. The power task only notes that it has moved 2% since the last
+ * save; the save itself happens here in the UI the next time the hard
+ * drive is spinning anyway (2.4.4: it used to run inside the hard drive's
+ * own task, whose tiny stack a file write can overflow and crash) */
+static int saved_batt = -1;
+static volatile bool batt_pending;
+void asher_batt_changed(int pct)
+{
+    if (saved_batt < 0) { saved_batt = pct; return; }
+    if (pct - saved_batt >= 2 || saved_batt - pct >= 2)
+    {
+        saved_batt = pct;
+        batt_pending = true;
+    }
+}
+void asher_batt_save_if_due(void)
+{
+    if (!batt_pending) return;
+#ifndef SIMULATOR
+    if (usb_inserted() || !storage_disk_is_active()) return;
+#endif
+    batt_pending = false;
+    asher_prefs_save();
+}
diff --git a/apps/asher/asher_prefs.h b/apps/asher/asher_prefs.h
new file mode 100644
index 0000000000..8ff3b022d0
--- /dev/null
+++ b/apps/asher/asher_prefs.h
@@ -0,0 +1,24 @@
+#ifndef ASHER_PREFS_H
+#define ASHER_PREFS_H
+/* small Asher OS preferences kept in /.rockbox/asher/prefs.txt */
+enum { ORG_ALPHA, ORG_ARTIST, ORG_OFF };
+enum { SHUF_OFF, SHUF_SONGS, SHUF_PLAYLISTS };
+extern int asher_organize;     /* Music > Organize */
+extern int asher_shufmode;     /* hold Menu > Shuffle */
+extern int asher_wheel;        /* scroll steps in one full turn (5..50): everything else */
+extern int asher_wheel_main;   /* ... main menu */
+extern int asher_wheel_music;  /* ... Music */
+enum { BOOT_OFF, BOOT_WHEEL, BOOT_SELECT };
+extern int asher_boot_mode;    /* how the logo screen is passed at start-up */
+extern int asher_boot_chime;   /* play the chime when it is */
+#define WHEEL_DEFAULT 24
+enum { WZ_MAIN, WZ_MUSIC, WZ_OTHER, WZ_SEARCH, WZ_BOOT };
+int  asher_wheel_for(int zone);
+void asher_wheel_zone(int zone);   /* use that area's speed from now on */
+int  asher_wheel_zone_get(void);
+void asher_wheel_try(int steps);
+void asher_prefs_load(void);
+void asher_prefs_save(void);
+void asher_batt_save_if_due(void);   /* from the UI */
+void asher_wheel_apply(void);
+#endif
diff --git a/apps/asher/asher_quick.c b/apps/asher/asher_quick.c
new file mode 100644
index 0000000000..ef43eb29a0
--- /dev/null
+++ b/apps/asher/asher_quick.c
@@ -0,0 +1,319 @@
+/* Asher OS "hold Menu" extras.
+ *  - asher_music_mode(): on screens that can't control music (Settings...),
+ *    a music control panel until Menu is held (or pressed) again.
+ *  - asher_shuffle_menu(): on music screens, a small Shuffle / Repeat menu. */
+#include <stdio.h>
+#include <string.h>
+#include "config.h"
+#include "string-extra.h"
+#include "system.h"
+#include "kernel.h"
+#include "action.h"
+#include "audio.h"
+#include "misc.h"
+#include "settings.h"
+#include "metadata.h"
+#include "playlist.h"
+#include "core_alloc.h"
+#include "asher_mem.h"
+#include "lcd.h"
+#include "gui/viewport.h"
+#include "asher_ui.h"
+#include "asher_font3d.h"
+#include "asher_media.h"
+#include "asher_music.h"
+#include "asher_prefs.h"
+#include "asher_quick.h"
+
+/* the screen underneath, dimmed, kept while the panel is up */
+static int snap_handle = -1;
+
+static bool snap_take(void)
+{
+    snap_handle = asher_alloc(sizeof(fb_data) * LCD_WIDTH * LCD_HEIGHT);
+    if (snap_handle <= 0) { snap_handle = -1; return false; }
+    lcd_set_viewport(NULL);
+    memcpy(aui_fb, FBADDR(0, 0), sizeof(fb_data) * LCD_WIDTH * LCD_HEIGHT);
+    aui_shade(0, 0, AUI_W, AUI_H, 0, 110, 0x000000);
+    memcpy(core_get_data(snap_handle), aui_fb, sizeof(fb_data) * LCD_WIDTH * LCD_HEIGHT);
+    return true;
+}
+static void snap_draw(void)
+{
+    if (snap_handle > 0)
+        memcpy(aui_fb, core_get_data(snap_handle), sizeof(fb_data) * LCD_WIDTH * LCD_HEIGHT);
+    else
+        aui_fill(0, 0, AUI_W, AUI_H, 0x101018);
+}
+static void snap_free(void)
+{
+    if (snap_handle > 0) asher_free(snap_handle);
+    snap_handle = -1;
+    aui_dirty = true;       /* screens underneath redraw themselves */
+}
+
+static void card(int x, int y, int w, int h, unsigned *fg, unsigned *sub)
+{
+    const struct aui_theme *t = aui_theme();
+    if (t->light)
+    {
+        aui_round(x, y, w, h, 14, 0xffffff, 0xf4f4f8);
+        *fg = 0x1c1c1e; *sub = 0x6e6e78;
+    }
+    else
+    {
+        aui_round(x - 1, y - 1, w + 2, h + 2, 15, 0x4a4f86, 0x2a2d55);
+        aui_round(x, y, w, h, 14, 0x1d2040, 0x111326);
+        *fg = 0xffffff; *sub = 0xb4bad8;
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* music controls panel                                                */
+/* ------------------------------------------------------------------ */
+static void mm_draw(const struct amedia *m)
+{
+    struct mp3entry *id3 = audio_current_track();
+    int st = audio_status();
+    bool playing = (st & AUDIO_STATUS_PLAY) && id3;
+    unsigned fg, sub;
+    char buf[64], b2[16];
+    int x = 10, y = 118, w = AUI_W - 20, h = 112;
+
+    snap_draw();
+    card(x, y, w, h, &fg, &sub);
+    long pos = playing ? (m->seeking ? m->seek_pos : (long)id3->elapsed) : 0;
+    bool vol = asher_media_show_vol(m);
+    if (vol)
+        aui_progress(x + 14, y + 72, w - 28, 7, aui_volume_pct(), 100);
+    else
+        aui_progress(x + 14, y + 72, w - 28, 7, pos, playing ? (long)id3->length : 1);
+    aui_present();
+
+    aui_text(AF_SMALL, x + 14, y + 8, aui_theme()->accent,
+             !playing ? "MUSIC CONTROLS" : (st & AUDIO_STATUS_PAUSE) ? "MUSIC CONTROLS - PAUSED"
+                                                                      : "MUSIC CONTROLS - PLAYING",
+             w - 28, 0);
+    if (playing)
+    {
+        const char *title = (id3->title && id3->title[0]) ? id3->title : strrchr(id3->path, '/') + 1;
+        aui_text(AF_BIG, x + 14, y + 26, fg, title, w - 28, 0);
+        aui_text(AF_SMALLR, x + 14, y + 50, sub,
+                 (id3->artist && id3->artist[0]) ? id3->artist : "Unknown Artist", w - 28, 0);
+        if (vol)
+            snprintf(buf, sizeof(buf), "Volume %d%%", aui_volume_pct());
+        else
+        {
+            aui_fmt_time(buf, sizeof(buf), pos);
+            aui_fmt_time(b2, sizeof(b2), id3->length);
+            strlcat(buf, " / ", sizeof(buf));
+            strlcat(buf, b2, sizeof(buf));
+        }
+        aui_text(AF_SMALLR, x + 14, y + 84, sub, buf, 150, 0);
+    }
+    else
+        aui_text(AF_BIG, x + 14, y + 30, fg, "Nothing playing", w - 28, 0);
+    aui_text(AF_SMALLR, x + w - 14, y + 84, sub, "hold Menu: back", 140, 2);
+    aui_update();
+}
+
+void asher_music_mode(void)
+{
+    struct amedia m = { 0 };
+    long next = 0;
+    aui_init();
+    viewportmanager_theme_enable(SCREEN_MAIN, false, NULL);
+    snap_take();
+    while (1)
+    {
+        if (aui_woke()) next = 0;
+        if (aui_screen_on() && TIME_AFTER(current_tick, next))
+        {
+            mm_draw(&m);
+            next = current_tick + (m.seeking ? HZ / 10 : HZ / 2);
+        }
+        int a = get_action(CONTEXT_WPS, m.seeking ? HZ / 10 : HZ / 4);
+        if (asher_media(&m, a)) { next = 0; continue; }
+        if (a == ACTION_WPS_QUICKSCREEN || a == ACTION_WPS_MENU)
+            break;
+        if (a == ACTION_WPS_BROWSE)
+        {
+            asher_shuffle_set(!global_settings.playlist_shuffle);
+            next = 0;
+            continue;
+        }
+        if (a == ACTION_NONE)
+        {
+            if (m.vol_until && !asher_media_show_vol(&m)) { m.vol_until = 0; next = 0; }
+            continue;
+        }
+        if (a == ACTION_WPS_STOP) continue;
+        if (default_event_handler(a) == SYS_USB_CONNECTED) break;
+    }
+    snap_free();
+    viewportmanager_theme_undo(SCREEN_MAIN, true);
+}
+
+/* ------------------------------------------------------------------ */
+/* shuffle / repeat menu                                               */
+/* ------------------------------------------------------------------ */
+static const char *shuf_names[3] = { "Off", "Songs", "Playlists" };
+static const char *rep_names[3] = { "Off", "All", "One" };
+
+static int rep_index(void)
+{
+    switch (global_settings.repeat_mode)
+    {
+        case REPEAT_ALL: return 1;
+        case REPEAT_ONE: return 2;
+        default: return 0;
+    }
+}
+
+static void sm_draw(int row, int shuf, int rep)
+{
+    const struct aui_theme *t = aui_theme();
+    unsigned fg, sub;
+    int x = 30, y = 60, w = AUI_W - 60, h = 140, rh = 38;
+
+    snap_draw();
+    card(x, y, w, h, &fg, &sub);
+    for (int r = 0; r < 2; r++)
+        if (r == row)
+            aui_round(x + 8, y + 34 + r * rh, w - 16, rh - 4, 10, t->sel1, t->sel2);
+    aui_present();
+    aui_text(AF_SMALL, x + 16, y + 10, t->accent, "PLAYBACK", w - 32, 0);
+    for (int r = 0; r < 2; r++)
+    {
+        int yy = y + 34 + r * rh + 8;
+        unsigned c = r == row ? 0xffffff : fg;
+        aui_text(AF_MED, x + 20, yy, c, r ? "Repeat" : "Shuffle", 100, 0);
+        char v[24];
+        snprintf(v, sizeof(v), "< %s >", r ? rep_names[rep] : shuf_names[shuf]);
+        aui_text(AF_MED, x + w - 20, yy, c, v, 130, 2);
+    }
+    aui_text(AF_SMALLR, AUI_W / 2, y + h - 18, sub, "centre changes  -  menu closes", w - 20, 1);
+    aui_update();
+}
+
+void asher_shuffle_menu(void)
+{
+    int row = 0, shuf = asher_shufmode, rep = rep_index();
+    int shuf0 = shuf, rep0 = rep;
+    bool redraw = true;
+
+    aui_init();
+    viewportmanager_theme_enable(SCREEN_MAIN, false, NULL);
+    snap_take();
+    while (1)
+    {
+        if (aui_woke()) redraw = true;
+        if (redraw) { sm_draw(row, shuf, rep); redraw = false; }
+        int a = get_action(CONTEXT_STD, HZ);
+        switch (a)
+        {
+            case ACTION_STD_NEXT: case ACTION_STD_NEXTREPEAT:
+            case ACTION_STD_PREV: case ACTION_STD_PREVREPEAT:
+                row ^= 1; redraw = true; break;
+            case ACTION_STD_OK:            /* centre or >> : next value */
+                if (row) rep = (rep + 1) % 3; else shuf = (shuf + 1) % 3;
+                redraw = true; break;
+            case ACTION_STD_MENU:
+            case ACTION_STD_QUICKSCREEN:
+            case ACTION_STD_CANCEL:        /* << also works as "close" */
+                goto done;
+            case ACTION_NONE:
+                break;
+            default:
+                if (default_event_handler(a) == SYS_USB_CONNECTED) goto done;
+                redraw = true;
+                break;
+        }
+    }
+done:
+    if (rep != rep0)
+    {
+        static const int modes[3] = { REPEAT_OFF, REPEAT_ALL, REPEAT_ONE };
+        global_settings.repeat_mode = modes[rep];
+        if (audio_status() & AUDIO_STATUS_PLAY)
+            audio_flush_and_reload_tracks();
+        settings_save();
+    }
+    snap_free();
+    viewportmanager_theme_undo(SCREEN_MAIN, true);
+    if (shuf != shuf0)
+    {
+        if (shuf == SHUF_PLAYLISTS)
+            asher_shuffle_playlists();      /* every playlist, mixed */
+        else
+            asher_shuffle_set(shuf == SHUF_SONGS);
+        asher_shufmode = shuf;
+        asher_prefs_save();
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* pop-up menu (hold Play on a song)                                   */
+/* ------------------------------------------------------------------ */
+static void pop_draw(const char *title, const char *line, const char *const *items,
+                     int n, int row)
+{
+    const struct aui_theme *t = aui_theme();
+    unsigned fg, sub;
+    int rh = 38, w = AUI_W - 60, h = 64 + n * rh + 22;
+    int x = 30, y = (AUI_H - h) / 2 + 10;
+
+    snap_draw();
+    card(x, y, w, h, &fg, &sub);
+    for (int r = 0; r < n; r++)
+        if (r == row)
+            aui_round(x + 8, y + 56 + r * rh, w - 16, rh - 4, 10, t->sel1, t->sel2);
+    aui_present();
+    aui_text(AF_SMALL, x + 16, y + 10, t->accent, title, w - 32, 0);
+    aui_text(AF_SMALLR, x + 16, y + 30, sub, line, w - 32, 0);
+    for (int r = 0; r < n; r++)
+        aui_text(AF_MED, x + 20, y + 56 + r * rh + 8, r == row ? 0xffffff : fg,
+                 items[r], w - 40, 0);
+    aui_text(AF_SMALLR, AUI_W / 2, y + h - 18, sub, "centre picks  -  menu closes", w - 20, 1);
+    aui_update();
+}
+
+int asher_popup(const char *title, const char *line, const char *const *items, int n)
+{
+    int row = 0, picked = -1;
+    bool redraw = true;
+
+    aui_init();
+    viewportmanager_theme_enable(SCREEN_MAIN, false, NULL);
+    snap_take();
+    while (1)
+    {
+        if (aui_woke()) redraw = true;
+        if (redraw) { pop_draw(title, line, items, n, row); redraw = false; }
+        int a = get_action(CONTEXT_STD, asher_toast_tmo(HZ));
+        switch (a)
+        {
+            case ACTION_STD_NEXT: case ACTION_STD_NEXTREPEAT:
+                row = (row + 1) % n; redraw = true; break;
+            case ACTION_STD_PREV: case ACTION_STD_PREVREPEAT:
+                row = (row + n - 1) % n; redraw = true; break;
+            case ACTION_STD_OK:
+                picked = row;
+                goto done;
+            case ACTION_STD_MENU:
+            case ACTION_STD_CANCEL:
+            case ACTION_STD_QUICKSCREEN:
+                goto done;
+            case ACTION_NONE:
+                break;
+            default:
+                if (default_event_handler(a) == SYS_USB_CONNECTED) goto done;
+                redraw = true;
+                break;
+        }
+    }
+done:
+    snap_free();
+    viewportmanager_theme_undo(SCREEN_MAIN, true);
+    return picked;
+}
