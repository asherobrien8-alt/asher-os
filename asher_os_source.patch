diff --git a/apps/asher/asher_list.c b/apps/asher/asher_list.c
new file mode 100644
index 0000000000..84a295e450
--- /dev/null
+++ b/apps/asher/asher_list.c
@@ -0,0 +1,304 @@
+/* Asher OS list screen: thick rounded selection bar, top bar with the
+ * clock, and accelerated scrolling with a first-letter bubble. */
+#include <stdio.h>
+#include <string.h>
+#include <ctype.h>
+#include "config.h"
+#include "system.h"
+#include "kernel.h"
+#include "action.h"
+#include "misc.h"
+#include "timefuncs.h"
+#include "lcd.h"
+#include "asher_ui.h"
+#include "asher_font3d.h"
+#include "asher_list.h"
+#include "asher_quick.h"
+#include "asher_media.h"
+#include "asher_prefs.h"
+#include "audio.h"
+#include "metadata.h"
+#include "string-extra.h"
+
+/* lists: wheel moves, centre picks, Menu goes back (hold: shuffle/repeat),
+ * and in Music the play / skip / seek keys control the music */
+#ifdef BUTTON_SCROLL_FWD
+static const struct button_mapping list_map[] = {
+    { ACTION_STD_NEXT,       BUTTON_SCROLL_FWD,                BUTTON_NONE },
+    { ACTION_STD_NEXTREPEAT, BUTTON_SCROLL_FWD|BUTTON_REPEAT,  BUTTON_NONE },
+    { ACTION_STD_PREV,       BUTTON_SCROLL_BACK,               BUTTON_NONE },
+    { ACTION_STD_PREVREPEAT, BUTTON_SCROLL_BACK|BUTTON_REPEAT, BUTTON_NONE },
+    { ACTION_STD_OK,         BUTTON_SELECT|BUTTON_REL,         BUTTON_SELECT },
+    { ACTION_STD_MENU,       BUTTON_MENU|BUTTON_REL,           BUTTON_MENU },
+    { ACTION_STD_QUICKSCREEN, BUTTON_MENU|BUTTON_REPEAT,       BUTTON_MENU },
+    { ACTION_WPS_PLAY,       BUTTON_PLAY|BUTTON_REL,           BUTTON_PLAY },
+    { ACTION_STD_HOTKEY,     BUTTON_PLAY|BUTTON_REPEAT,        BUTTON_NONE },
+    { ACTION_WPS_SKIPPREV,   BUTTON_LEFT|BUTTON_REL,           BUTTON_LEFT },
+    { ACTION_WPS_SEEKBACK,   BUTTON_LEFT|BUTTON_REPEAT,        BUTTON_NONE },
+    { ACTION_WPS_STOPSEEK,   BUTTON_LEFT|BUTTON_REL,           BUTTON_LEFT|BUTTON_REPEAT },
+    { ACTION_WPS_SKIPNEXT,   BUTTON_RIGHT|BUTTON_REL,          BUTTON_RIGHT },
+    { ACTION_WPS_SEEKFWD,    BUTTON_RIGHT|BUTTON_REPEAT,       BUTTON_NONE },
+    { ACTION_WPS_STOPSEEK,   BUTTON_RIGHT|BUTTON_REL,          BUTTON_RIGHT|BUTTON_REPEAT },
+    LAST_ITEM_IN_LIST
+};
+static const struct button_mapping *list_ctx(int c) { (void)c; return list_map; }
+static int list_action(bool music, int tmo)
+{
+    if (!music) return get_action(CONTEXT_STD, tmo);
+    return get_custom_action(CONTEXT_PLUGIN | 6, tmo, list_ctx);
+}
+#else
+static int list_action(bool music, int tmo) { (void)music; return get_action(CONTEXT_STD, tmo); }
+#endif
+
+static int row_h(const struct aui_list *l) { return l->two_line ? 42 : 35; }
+static int visible(const struct aui_list *l) { return (AUI_H - AUI_BAR) / row_h(l); }
+
+static void clamp_top(struct aui_list *l)
+{
+    int vis = visible(l);
+    if (l->sel < l->top) l->top = l->sel;
+    if (l->sel >= l->top + vis) l->top = l->sel - vis + 1;
+    if (l->top > l->count - vis) l->top = l->count - vis;
+    if (l->top < 0) l->top = 0;
+}
+
+static void chevron(int x, int cy, unsigned c)
+{
+    for (int i = 0; i < 5; i++)
+    {
+        aui_fill(x + i, cy - 5 + i, 2, 1, c);
+        aui_fill(x + i, cy + 5 - i, 2, 1, c);
+    }
+}
+
+void aui_list_draw(struct aui_list *l, int letter)
+{
+    const struct aui_theme *t = aui_theme();
+    char buf[128], sub[128];
+    int rh = row_h(l), vis = visible(l), y0 = AUI_BAR + 2;
+    bool sb = l->count > vis;
+    int right = AUI_W - (sb ? 12 : 6);
+
+    clamp_top(l);
+    aui_vgrad(0, 0, AUI_W, AUI_H, t->bg_top, t->bg_bot);
+    aui_topbar();
+
+    /* Modern: the rows sit on one white rounded card */
+    if (t->modern)
+    {
+        int rows = MIN(vis, l->count - l->top);
+        aui_round(6, y0 + 2, right - 6, rows * rh, 12, 0xffffff, 0xffffff);
+    }
+    /* rows: compose bars first */
+    for (int r = 0; r < vis; r++)
+    {
+        int i = l->top + r;
+        if (i >= l->count) break;
+        int y = y0 + r * rh;
+        if (i == l->sel)
+            aui_round(6, y + 2, right - 6, rh - 4, t->modern ? 11 : 9, t->sel1, t->sel2);
+        else if (t->modern)
+        {
+            if (r < vis - 1 && i < l->count - 1 && i + 1 != l->sel)
+                aui_fill(18, y + rh + 1, right - 24, 1, 0xe2e2e7);
+        }
+        else if (t->light)
+            aui_fill(12, y + rh - 1, right - 18, 1, 0xe3e5ea);
+        if (l->style && (l->style(l, i) & AUI_ROW_DOT))
+        {
+            int dx = right - (l->chevrons ? 34 : 18);
+            unsigned dc = i == l->sel ? 0xffffff : 0xff3b30;
+            aui_round(dx, y + rh / 2 - 4, 9, 9, 4, dc, dc);
+        }
+        if (l->chevrons)
+            chevron(right - 16, y + rh / 2,
+                    i == l->sel ? 0xffffff : (t->modern ? 0xc4c4ca : t->light ? 0x9aa0ab : 0x6c7290));
+    }
+    if (sb)
+    {
+        int th = AUI_H - AUI_BAR - 8, x = AUI_W - 7;
+        int kh = MAX(16, th * vis / l->count);
+        int ky = AUI_BAR + 4 + (th - kh) * l->top / MAX(1, l->count - vis);
+        aui_round(x, AUI_BAR + 4, 4, th, 2, t->track, t->track);
+        aui_round(x, ky, 4, kh, 2, t->sel1, t->sel2);
+    }
+    if (letter)
+    {
+        aui_shade(AUI_W / 2 - 34, 30 + (AUI_H - 30) / 2 - 34, 68, 68, 16, 70, 0x000000);
+    }
+    aui_present();
+
+    /* text */
+    for (int r = 0; r < vis; r++)
+    {
+        int i = l->top + r;
+        if (i >= l->count) break;
+        int y = y0 + r * rh;
+        bool s = (i == l->sel);
+        int maxw = right - 18 - (l->chevrons ? 22 : 4);
+        buf[0] = sub[0] = '\0';
+        l->get(l, i, buf, sizeof(buf), l->two_line ? sub : NULL, sizeof(sub));
+        int st = l->style ? l->style(l, i) : 0;
+        if (st & AUI_ROW_DOT) maxw -= 16;          /* room for the dot */
+        if (st & AUI_ROW_CHECK) maxw -= 26;        /* room for the tick */
+        if (st & AUI_ROW_ACTION)
+        {
+            int fh = aui_font_h(AF_MED);
+            aui_text(AF_MED, (6 + right) / 2, y + (rh - fh) / 2, s ? t->seltext : t->accent,
+                     buf, right - 30, 1);
+        }
+        else if (l->two_line)
+        {
+            aui_text(AF_MED, 18, y + 5, s ? t->seltext : t->text, buf, maxw, 0);
+            aui_text(AF_SMALLR, 18, y + 23, s ? 0xe6ecff : t->sub, sub, maxw, 0);
+        }
+        else
+        {
+            int fh = aui_font_h(AF_BIG);
+            aui_text(AF_BIG, 18, y + (rh - fh) / 2, s ? t->seltext : t->text, buf, maxw, 0);
+        }
+        if (st & AUI_ROW_CHECK)
+        {
+            /* a bold tick at the end of the row */
+            unsigned cc = s ? 0xffffff : (t->modern ? 0x0a84ff : t->accent);
+            int cw = 16, ch = 12;
+            int cx = right - (l->chevrons ? 38 : 22) - cw / 2, cy = y + (rh - ch) / 2;
+            int mx = cx + 6, my = cy + ch;
+            lcd_set_viewport(NULL);
+            lcd_set_drawmode(DRMODE_SOLID);
+            lcd_set_foreground(LCD_RGBPACK((cc >> 16) & 255, (cc >> 8) & 255, cc & 255));
+            for (int k = 0; k < 3; k++)
+            {
+                lcd_drawline(cx, cy + ch / 2 + k - 1, mx, my + k - 1);
+                lcd_drawline(mx, my + k - 1, cx + cw, cy + k - 1);
+            }
+        }
+    }
+    if (letter)
+    {
+        char lb[2] = { (char)letter, 0 };
+        int fh = aui_font_h(AF_BIG);
+        aui_text(AF_BIG, AUI_W / 2, 30 + (AUI_H - 30) / 2 - fh / 2, 0xffffff, lb, 0, 1);
+    }
+    aui_topbar_text(l->title);
+    aui_update();
+}
+
+static int first_letter(struct aui_list *l)
+{
+    char buf[128];
+    if (l->style && (l->style(l, l->sel) & AUI_ROW_ACTION)) return 0;
+    buf[0] = '\0';
+    l->get(l, l->sel, buf, sizeof(buf), NULL, 0);
+    const char *p = buf;
+    if (!strncasecmp(p, "the ", 4)) p += 4;
+    int c = toupper((unsigned char)*p);
+    if (c >= 'A' && c <= 'Z') return c;
+    return 0;            /* numbers and symbols: no bubble (no "#") */
+}
+
+int aui_list_run(struct aui_list *l)
+{
+    long last_move = 0, letter_until = 0;
+    int streak = 0, minute = -1;
+    struct amedia media = { 0 };
+    bool redraw = true;
+
+    if (l->count <= 0) return 0;
+    if (l->sel >= l->count) l->sel = 0;
+    aui_begin();
+    while (1)
+    {
+        /* the letter bubble only makes sense when the list is A to Z */
+        bool show_letter = l->letter_jump && asher_organize == ORG_ALPHA
+                           && TIME_BEFORE(current_tick, letter_until);
+        if (aui_woke()) redraw = true;
+        if (redraw)
+        {
+            aui_list_draw(l, show_letter ? first_letter(l) : 0);
+            redraw = false;
+        }
+        /* every list here is part of Music, so the music keys always work */
+        int action = list_action(true, asher_toast_tmo(media.seeking ? HZ / 10
+                                                       : (show_letter ? HZ / 5 : HZ)));
+        if (asher_media(&media, action))
+        {
+            if (media.seeking || l->style) redraw = true;   /* the dot may move */
+            continue;
+        }
+        switch (action)
+        {
+            case ACTION_STD_NEXT:
+            case ACTION_STD_NEXTREPEAT:
+            case ACTION_STD_PREV:
+            case ACTION_STD_PREVREPEAT:
+            {
+                int dir = (action == ACTION_STD_NEXT || action == ACTION_STD_NEXTREPEAT) ? 1 : -1;
+                if (TIME_BEFORE(current_tick, last_move + HZ / 8)) streak++;
+                else streak = 0;
+                last_move = current_tick;
+                int step = 1;
+                if (l->count > 40 && streak > 6)
+                    step = MIN(1 + (streak - 6) / 3, MAX(1, l->count / 40));
+                l->sel += dir * step;
+                if (step == 1 && l->sel < 0) l->sel = l->count - 1;
+                else if (step == 1 && l->sel >= l->count) l->sel = 0;
+                if (l->sel < 0) l->sel = 0;
+                if (l->sel >= l->count) l->sel = l->count - 1;
+                if (step > 1) letter_until = current_tick + HZ * 2 / 3;
+                redraw = true;
+                break;
+            }
+            case ACTION_STD_OK:
+            {
+                int r = l->select ? l->select(l, l->sel) : 0;
+                if (r == AUI_BACK) { aui_end(); return 0; }
+                if (r > 0) { aui_end(); return r; }
+                redraw = true;
+                break;
+            }
+            case ACTION_STD_CANCEL:
+            case ACTION_STD_MENU:
+                aui_end();
+                return 0;
+            case ACTION_STD_QUICKSCREEN:      /* hold Menu: shuffle / repeat */
+                asher_shuffle_menu();
+                redraw = true;
+                break;
+            case ACTION_STD_HOTKEY:           /* hold Play: the song menu */
+            {
+                action_wait_for_release();
+                if (!l->hold) break;
+                int r = l->hold(l, l->sel);
+                if (r == AUI_BACK) { aui_end(); return 0; }
+                if (r > 0) { aui_end(); return r; }
+                redraw = true;
+                break;
+            }
+            case ACTION_NONE:
+            {
+                /* a new song started: move the "playing" dot */
+                if (l->style)
+                {
+                    static char last[MAX_PATH];
+                    struct mp3entry *id3 = audio_current_track();
+                    const char *p = id3 ? id3->path : "";
+                    if (strcmp(p, last)) { strlcpy(last, p, sizeof(last)); redraw = true; }
+                }
+                if (media.vol_until && !asher_media_show_vol(&media)) media.vol_until = 0;
+                /* redraw for the clock, or to hide the letter bubble */
+                int m = get_time()->tm_min;
+                if (m != minute || (l->letter_jump && !show_letter && letter_until)) redraw = true;
+                if (!show_letter) letter_until = 0;
+                minute = m;
+                break;
+            }
+            default:
+                if (default_event_handler(action) == SYS_USB_CONNECTED)
+                    { aui_end(); return 0; }
+                redraw = true;
+                break;
+        }
+    }
+}
diff --git a/apps/asher/asher_list.h b/apps/asher/asher_list.h
