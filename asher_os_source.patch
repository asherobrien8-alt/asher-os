diff --git a/tools/asher/make_assets.py b/tools/asher/make_assets.py
new file mode 100644
index 0000000..7f41d79
--- /dev/null
+++ b/tools/asher/make_assets.py
@@ -0,0 +1,173 @@
+#!/usr/bin/env python3
+"""Generates Asher OS placeholder wallpapers (.awp), backdrops and theme cfgs."""
+import os, math, struct, sys
+import numpy as np
+from PIL import Image, ImageDraw, ImageFilter
+W,H,FR,MS=320,240,12,400
+OUT=sys.argv[1] if len(sys.argv)>1 else "asher_pkg"
+R=os.path.join(OUT,".rockbox","asher")
+for d in("themes","wallpaper","backdrops"): os.makedirs(os.path.join(R,d),exist_ok=True)
+
+def lerp(a,b,t): return tuple(int(a[i]+(b[i]-a[i])*t) for i in range(3))
+def sky(top,bot):
+    im=Image.new("RGB",(W,H)); d=ImageDraw.Draw(im)
+    for y in range(H): d.line([(0,y),(W,y)],fill=lerp(top,bot,y/H))
+    return im
+def town(d,col):
+    # anime-style neighbourhood silhouette + power poles and lines
+    x=0; import random; rnd=random.Random(7)
+    while x<W:
+        w=rnd.randint(28,50); h=rnd.randint(30,60)
+        d.rectangle([x,H-h,x+w,H],fill=col)
+        d.polygon([(x-3,H-h),(x+w//2,H-h-14),(x+w+3,H-h)],fill=col)
+        x+=w+rnd.randint(0,6)
+    for px in(50,170,290):
+        d.rectangle([px,120,px+3,H],fill=col)
+        d.line([(px-14,128),(px+18,128)],fill=col,width=2)
+    for y0 in(128,136):
+        pts=[(50+i*(240/20),y0+int(7*math.sin(i/20*math.pi*3+0*1))) for i in range(21)]
+        d.line([(50,y0),(170,y0+6),(290,y0)],fill=col,width=1)
+def disc(d,cx,cy,r,col): d.ellipse([cx-r,cy-r,cx+r,cy+r],fill=col)
+def moon(im,cx,cy,r,phase):
+    from PIL import ImageChops
+    bg=im.copy(); d=ImageDraw.Draw(im); disc(d,cx,cy,r,(240,240,215))
+    mask=Image.new("L",im.size,0); ImageDraw.Draw(mask).ellipse([cx-r,cy-r,cx+r,cy+r],fill=255)
+    if phase==4: return
+    if phase==0: im.paste(bg,mask=mask); d.ellipse([cx-r,cy-r,cx+r,cy+r],outline=(90,90,130)); return
+    k=[0,0.5,1.0,1.5,0,1.5,1.0,0.5][phase]      # shadow-disc offset in radii
+    sgn=-1 if phase<4 else 1                    # waxing lit right, waning lit left
+    off=int(k*r)*sgn
+    sh=Image.new("L",im.size,0); ImageDraw.Draw(sh).ellipse([cx-r+off,cy-r,cx+r+off,cy+r],fill=255)
+    im.paste(bg,mask=ImageChops.multiply(sh,mask))
+from PIL import ImageChops
+SS=3
+PAL={  # sky_top, sky_horizon, cloud_top, cloud_shade, tint, wall, pool
+ "sunrise":((70,150,240),(255,176,150),(255,244,236),(246,170,190),(1.0,0.9,0.95),(255,235,225),(90,205,225)),
+ "sunup":((0,128,236),(170,226,255),(255,255,255),(170,200,240),(1.0,1.0,1.0),(255,255,255),(60,215,235)),
+ "sunset":((75,70,175),(255,140,112),(255,205,190),(170,110,170),(0.85,0.7,0.85),(255,205,190),(120,160,210)),
+ "moonrise":((18,24,90),(120,70,140),(120,110,190),(60,50,130),(0.35,0.35,0.6),(120,115,170),(40,70,140)),
+ "moonhigh":((8,12,52),(40,40,110),(70,80,160),(35,40,110),(0.22,0.25,0.5),(80,85,150),(25,50,110)),
+}
+def tint(c,t): return tuple(max(0,min(255,int(c[k]*t[k]))) for k in range(3))
+def circ(m,cx,cy,r): ImageDraw.Draw(m).ellipse([cx-r,cy-r,cx+r,cy+r],fill=255)
+def cloud(im,cx,cy,sz,top,shade,flat_y):
+    w,h=im.size
+    m=Image.new("L",(w,h),0)
+    for dx,dy,r in [(-40,0,26),(-12,-16,34),(24,-8,30),(50,4,22),(0,6,30),(-62,8,18)]:
+        circ(m,int(cx+dx*sz*SS),int(cy+dy*sz*SS),int(r*sz*SS))
+    cut=Image.new("L",(w,h),0); ImageDraw.Draw(cut).rectangle([0,0,w,int(flat_y)],fill=255)
+    m=ImageChops.multiply(m,cut)
+    low=ImageChops.offset(m,0,int(-9*sz*SS)) # lit top = mask shifted up, intersected
+    lit=ImageChops.multiply(m,ImageChops.offset(m,0,int(10*sz*SS)))
+    im.paste(shade,mask=m); im.paste(top,mask=lit)
+def palm(im,x,base,height,lean,col,hi):
+    d=ImageDraw.Draw(im)
+    pts=[]
+    for k in range(21):
+        t=k/20; px=x+lean*t*t*SS; py=base-height*t*SS
+        pts.append((px,py)); r=(5.5-3*t)*SS; d.ellipse([px-r,py-r,px+r,py+r],fill=col)
+    cx,cy=pts[-1]
+    import math
+    for ang in (-170,-140,-110,-70,-40,-10,20,200):
+        a=math.radians(ang); L=46*SS
+        for k in range(17):
+            t=k/16; px=cx+math.cos(a)*L*t; py=cy+math.sin(a)*L*t*0.55+ (t*t)*34*SS
+            r=(4.5*(1-t)+1)*SS
+            d.ellipse([px-r,py-r,px+r,py+r],fill=col if k%3 else hi)
+def nagai(name,i,phase=4):
+    W2,H2=W*SS,H*SS
+    sky_t,sky_h,ct,cs,tn,wall,pool=PAL[name]; t=i/FR
+    hz=150*SS
+    im=Image.new("RGB",(W2,H2)); d=ImageDraw.Draw(im)
+    for y in range(H2):
+        u=min(1,y/hz); u=u**1.4
+        d.line([(0,y),(W2,y)],fill=lerp(sky_t,sky_h,u))
+    # sun / moon
+    if name=="sunrise": sx,sy,sr,sc=150,int(172-40*t),24,(255,236,190)
+    elif name=="sunup": sx,sy,sr,sc=235,52,22,(255,252,215)
+    elif name=="sunset": sx,sy,sr,sc=100,int(110+40*t),24,(255,196,140)
+    else: sx=sy=sr=sc=None
+    if sx is not None:
+        glow=Image.new("RGB",im.size,sc); gm=Image.new("L",im.size,0); circ(gm,sx*SS,sy*SS,sr*SS*3)
+        gm=gm.filter(ImageFilter.GaussianBlur(sr*SS*1.2)).point(lambda v:int(v*0.45)); im.paste(glow,mask=gm)
+        d=ImageDraw.Draw(im); circ_d=d.ellipse([(sx-sr)*SS,(sy-sr)*SS,(sx+sr)*SS,(sy+sr)*SS],fill=sc)
+    if name.startswith("moon"):
+        import random; rnd=random.Random(5); d=ImageDraw.Draw(im)
+        if name=="moonhigh":
+            for k in range(46):
+                x,y=rnd.randint(0,W2),rnd.randint(0,110*SS)
+                if (k+i)%4: d.ellipse([x,y,x+SS,y+SS],fill=(255,255,255))
+    # clouds drift, seamless loop
+    P=480
+    for (x0,y0,sz,k) in [(40,62,0.8,0),(215,38,0.65,1),(340,92,0.9,2),(125,108,0.55,3)]:
+        x=((x0+P*t*(0.6+0.15*k)/ (0.6+0.15*k)) % P)-80
+        cloud(im,x*SS,y0*SS,sz,ct,cs,(y0+26*sz)*SS)
+    # moon after clouds-behind? keep in front for clarity
+    if name.startswith("moon"):
+        mm=im.resize((W,H),Image.LANCZOS)
+        moon(mm,230 if name=="moonrise" else 200, int(210-110*t) if name=="moonrise" else 60,22,phase)
+        im=mm.resize((W2,H2),Image.LANCZOS)
+    d=ImageDraw.Draw(im)
+    # building (right), flat mid-century block with stripes and windows
+    wl=tint(wall,tn); sh=tint((190,200,225),tn); wn=tint((70,160,220),tn)
+    d.rectangle([186*SS,104*SS,W2,176*SS],fill=wl)
+    d.rectangle([186*SS,100*SS,W2,106*SS],fill=sh)
+    for k in range(4):
+        y=112+k*15; d.rectangle([196*SS,y*SS,W2-10*SS,(y+8)*SS],fill=wn)
+    # ground + pool
+    d.rectangle([0,176*SS,W2,H2],fill=tint((255,224,196),tn))
+    pc=tint(pool,tn); d.rectangle([-4*SS,190*SS,W2+4*SS,H2],fill=tint((250,250,250),tn))
+    d.rectangle([-4*SS,196*SS,W2+4*SS,H2-8*SS],fill=pc)
+    import math
+    for r in range(5):
+        yy=(204+r*7)*SS
+        pts=[(x, yy+int(2.5*SS*math.sin((x/SS)/18+t*2*math.pi+r))) for x in range(0,W2+1,6)]
+        d.line(pts,fill=tint((235,255,255),tn),width=SS)
+    # palms
+    pc2=tint((22,92,84),tn); ph=tint((60,170,130),tn)
+    palm(im,64*SS,182*SS,100,-16,pc2,ph)
+    palm(im,28*SS,186*SS,78,10,pc2,ph)
+    return im.resize((W,H),Image.LANCZOS)
+def scene(name,i,phase=4):
+    t=i/FR
+    if name in PAL: return nagai(name,i,phase)
+    if name=="glass":
+        im=sky((60,90,200),(170,110,230)); d=ImageDraw.Draw(im)
+        for k,(cx,cy,r,c) in enumerate([(70,70,60,(120,200,255)),(250,160,70,(200,140,255)),(160,200,50,(255,170,220))]):
+            ox=int(18*math.sin(t*2*math.pi+k*2)); oy=int(14*math.cos(t*2*math.pi+k))
+            disc(d,cx+ox,cy+oy,r,c)
+        return im.filter(ImageFilter.GaussianBlur(22))
+def rgb565(im):
+    a=np.asarray(im.convert("RGB"),dtype=np.uint16)
+    v=((a[...,0]>>3)<<11)|((a[...,1]>>2)<<5)|(a[...,2]>>3)
+    return v.astype("<u2").tobytes()
+def pack(fname,name,phase=4):
+    with open(os.path.join(R,"wallpaper",fname+".awp"),"wb") as f:
+        f.write(b"AWP1"+struct.pack("<HHHH",W,H,FR,MS))
+        for i in range(FR): f.write(rgb565(scene(name,i,phase)))
+for n in("sunrise","sunup","sunset","glass"): pack(n,n)
+for p in range(8):
+    pack(f"moonrise{p}","moonrise",p); pack(f"moonhigh{p}","moonhigh",p)
+# static first-frame backdrops (needed so the skin engine allocates a buffer)
+for n,sc in(("daybreak","sunup"),("glass","glass")):
+    scene(sc,0).save(os.path.join(R,"backdrops",n+".bmp"))
+Image.new("RGB",(W,H),(18,18,22)).save(os.path.join(R,"backdrops","dark.bmp"))
+cfg={
+"daybreak":("backdrop: /.rockbox/asher/backdrops/daybreak.bmp","FFFFFF","000000","4A90E2","FFFFFF"),
+"glass":("backdrop: /.rockbox/asher/backdrops/glass.bmp","FFFFFF","000000","FFFFFF","6A5AE0"),
+"dark":("backdrop: /.rockbox/asher/backdrops/dark.bmp","E6E6E6","121216","3A7BD5","FFFFFF"),
+"classic":("backdrop: -","000000","FFFFFF","3A7BD5","FFFFFF"),
+}
+for n,(bd,fg,bg,sel,selfg) in cfg.items():
+    open(os.path.join(R,"themes",n+".cfg"),"w").write(
+f"""{bd}
+foreground color: {fg}
+background color: {bg}
+line selector start color: {sel}
+line selector end color: {sel}
+line selector text color: {selfg}
+selector type: bar (color)
+show icons: off
+statusbar: top
+""")
+print("done")
