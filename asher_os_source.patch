+/* Asher OS: the picture can be dimmed toward black (screen fade-out),
+ * 256 = normal, 0 = black. Only the copy sent to the LCD is dimmed. */
+static int lcd_dim = 256;
+
+static void dim_copy(uint16_t *out, const fb_data *p, int n, int d)
+{
+    while (n--)
+    {
+        unsigned v = *p++;
+        unsigned r = ((v >> 11) * d) >> 8;
+        unsigned g = (((v >> 5) & 63) * d) >> 8;
+        unsigned b = ((v & 31) * d) >> 8;
+        *out++ = (r << 11) | (g << 5) | b;
+    }
+}
