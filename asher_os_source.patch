new file mode 100644
index 0000000000..7942994676
--- /dev/null
+++ b/tools/asher/make_assets.py
@@ -0,0 +1,10 @@
+#!/usr/bin/env python3
+"""Asher OS: the wallpapers/themes are shipped separately (asher_os_assets.zip),
+so the build only needs to create a harmless placeholder package."""
+import os, sys
+out = sys.argv[1] if len(sys.argv) > 1 else "assets"
+d = os.path.join(out, ".rockbox", "asher")
+os.makedirs(d, exist_ok=True)
+with open(os.path.join(d, "README.txt"), "w") as f:
+    f.write("Asher OS. Wallpapers and themes come from asher_os_assets.zip.\n")
+print("ok")
diff --git a/tools/asher/video_to_awp.py b/tools/asher/video_to_awp.py
new file mode 100644
index 0000000000..226944833a
--- /dev/null
+++ b/tools/asher/video_to_awp.py
@@ -0,0 +1,23 @@
+#!/usr/bin/env python3
+"""Turn any short video or GIF into an Asher OS live wallpaper (.awp).
+Usage: python video_to_awp.py input.mp4 name [fps=10] [seconds=6]
+Needs ffmpeg installed. Copy the result to /.rockbox/asher/wallpaper/ on the iPod."""
+import subprocess, sys, struct, tempfile, glob, os
+from PIL import Image
+import numpy as np
+src,name=sys.argv[1],sys.argv[2]
+fps=int(sys.argv[3]) if len(sys.argv)>3 else 10
+secs=float(sys.argv[4]) if len(sys.argv)>4 else 6
+W,H=320,240
+tmp=tempfile.mkdtemp()
+subprocess.check_call(["ffmpeg","-v","error","-i",src,"-t",str(secs),"-vf",
+    f"fps={fps},scale={W}:{H}:force_original_aspect_ratio=increase,crop={W}:{H}",
+    os.path.join(tmp,"f%04d.png")])
+files=sorted(glob.glob(os.path.join(tmp,"f*.png")))
+with open(name+".awp","wb") as f:
+    f.write(b"AWP1"+struct.pack("<HHHH",W,H,len(files),1000//fps))
+    for p in files:
+        a=np.asarray(Image.open(p).convert("RGB"),dtype=np.uint16)
+        v=((a[...,0]>>3)<<11)|((a[...,1]>>2)<<5)|(a[...,2]>>3)
+        f.write(v.astype("<u2").tobytes())
+print(len(files),"frames written to",name+".awp")
