+#ifndef ASHER_MOONPHASE_H
+#define ASHER_MOONPHASE_H
+/* Returns moon phase index 0..7 (0=new, 2=first quarter, 4=full,
+ * 6=last quarter) from the calendar date. No live data needed. */
+int asher_moon_phase(int year, int month, int day);
+#endif
