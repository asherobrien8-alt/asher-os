+/* nothing playing (e.g. after a reboot): load the last song but keep it
+ * paused, so Now Playing and Stats can show what's queued up */
+void asher_resume_paused(void)
+{
+    if (audio_status() || global_status.resume_index == -1)
+        return;
+    if (playlist_resume() != -1)
+    {
+        playlist_resume_track(global_status.resume_index,
+            global_status.resume_crc32,
+            global_status.resume_elapsed,
+            global_status.resume_offset);
+        audio_pause();
+        get_wps_state()->paused = true;
+        /* give playback a moment to read the track's info and art */
+        for (int i = 0; i < 20 && !audio_current_track(); i++)
+            sleep(HZ / 20);
+    }
+}
+
+int asher_nowplaying(void)
+{
+    struct amedia m = { 0 };
+    bool was_playing = false;
+    long shuf_until = 0, next_text = 0;
+
+    asher_wheel_zone(WZ_MUSIC);
+    aui_begin();
+    if (asher_np_skip_intro) asher_np_skip_intro = false;   /* the record player just played */
+    else aui_intro(LDR_NP);
+    while (1)
+    {
+        int st = audio_status();
+        bool on = aui_screen_on();
+        if (aui_woke()) next_text = 0;
+        bool show_shuf = TIME_BEFORE(current_tick, shuf_until);
+
+        if (st & AUDIO_STATUS_PLAY) was_playing = true;
+        else if (was_playing) break;           /* playlist finished */
+
+        if (on && TIME_AFTER(current_tick, next_text))
+        {
+            draw(&m, show_shuf);
+            /* a new song's art can arrive a moment late: look again soon */
+            bool waiting_art = !np_key_art && TIME_BEFORE(current_tick, np_since + 4 * HZ);
+            /* redraw exactly when the song's time steps to the next second */
+            next_text = current_tick + (m.seeking ? HZ / 10
+                        : (waiting_art ? MIN(HZ / 4, asher_ticks_to_next_second())
+                                       : asher_ticks_to_next_second()));
+        }
+        long wait = next_text - current_tick;
+        if (wait < 1) wait = 1;
+        int a = get_action(CONTEXT_WPS, !on ? 2 * HZ : (m.seeking ? HZ / 10 : wait));
+        if (asher_media(&m, a))
+        {
+            if (m.vol_until) shuf_until = 0;
+            next_text = 0;
+            continue;
+        }
+        switch (a)
+        {
+            case ACTION_WPS_STOP:              /* hold Play: the queue */
+            {
+                action_wait_for_release();
+                int r = asher_queue_screen();
+                if (r > 0) { aui_end(); return r; }
+                next_text = 0;
+                break;
+            }
+            case ACTION_WPS_BROWSE:            /* centre button: shuffle on/off */
+                asher_shuffle_set(!global_settings.playlist_shuffle);
+                shuf_until = current_tick + HZ * 3 / 2;
+                m.vol_until = 0;
+                next_text = 0;
+                break;
+            case ACTION_WPS_QUICKSCREEN:          /* hold Menu: shuffle / repeat */
+                asher_shuffle_menu();
+                next_text = 0;
+                break;
+            case ACTION_WPS_MENU:
+                aui_end();
+                return GO_TO_PREVIOUS;
+            case ACTION_NONE:
+                if (m.vol_until && !asher_media_show_vol(&m)) { m.vol_until = 0; next_text = 0; }
+                if (shuf_until && !show_shuf) { shuf_until = 0; next_text = 0; }
+                break;
+            default:
+                if (default_event_handler(a) == SYS_USB_CONNECTED)
+                    { aui_end(); return GO_TO_ROOT; }
+                break;
+        }
+    }
+    aui_end();
+    return GO_TO_PREVIOUS;
+}
diff --git a/apps/asher/asher_power.c b/apps/asher/asher_power.c
new file mode 100644
index 0000000000..11249ef4be
--- /dev/null
+++ b/apps/asher/asher_power.c
@@ -0,0 +1,150 @@
+/* Asher OS power down: a retro sunset. The big number counts 3, 2, 1 while
+ * the sun sinks below the neon horizon, then the picture switches off like
+ * an old TV. Pressing Menu during the countdown cancels it. */
+#include <stdio.h>
+#include <string.h>
+#include "config.h"
+#include "system.h"
+#include "kernel.h"
+#include "button.h"
+#include "lcd.h"
+#include "backlight.h"
+#include "gui/viewport.h"
+#include "asher_ui.h"
+#include "asher_power.h"
+#include "asher_prefs.h"
+
+#define SECS 5
+
+#if defined(IPOD_6G) || defined(IPOD_VIDEO) || defined(IPOD_NANO3G)
+#include "bitmaps/pdsky.h"
+#include "bitmaps/pdsun.h"
+#include "bitmaps/pddigits.h"
+
+#define HZN    150                          /* horizon line */
+#define SUN_S  BMPWIDTH_pdsun
+#define SUN_R  (SUN_S / 2)
+#define DIG_W  (BMPWIDTH_pddigits / SECS)
+#define DIG_H  BMPHEIGHT_pddigits
+#define DIG_Y  (92 - DIG_H / 2)
+
+/* drop-in with a little bounce: offset in pixels for progress 0..32 */
+static const signed char drop[33] = {
+    -60, -56, -52, -47, -42, -37, -32, -27, -22, -18, -14, -10, -7, -4, -2, 0,
+    -3, -5, -6, -6, -5, -3, 0, -1, -2, -2, -1, 0, 0, 0, 0, 0, 0 };
+
+static void frame(long t)
+{
+    lcd_set_viewport(NULL);
+    lcd_set_drawmode(DRMODE_SOLID);
+    lcd_bitmap((const fb_data *)bm_pdsky.data, 0, 0, LCD_WIDTH, LCD_HEIGHT);
+
+    /* the sun sinks behind the horizon as time runs out */
+    long total = SECS * HZ;
+    if (t > total) t = total;
+    int cy = 112 + (int)((HZN + SUN_R + 2 - 112) * t / total);
+    int sy = cy - SUN_R, vis = HZN - sy;
+    if (vis > SUN_S) vis = SUN_S;
+    if (vis > 0)
+        lcd_bitmap_transparent_part((const fb_data *)bm_pdsun.data, 0, 0, SUN_S,
+                                    LCD_WIDTH / 2 - SUN_R, sy, SUN_S, vis);
+
+    /* 3, 2, 1 drops in each second */
+    int left = (int)((total - t + HZ - 1) / HZ);
+    if (left >= 1 && left <= SECS)
+    {
+        long into = t - (long)(SECS - left) * HZ;
+        int p = (int)(into * 32 * 10 / (HZ * 4));       /* 0.4s drop */
+        if (p > 32) p = 32;
+        lcd_bitmap_transparent_part((const fb_data *)bm_pddigits.data,
+                                    (SECS - left) * DIG_W, 0, BMPWIDTH_pddigits,
+                                    LCD_WIDTH / 2 - DIG_W / 2, DIG_Y + drop[p],
+                                    DIG_W, DIG_H);
+    }
+    lcd_update();
+}
+
+/* old-TV switch off: the picture squashes into a line, then a dot */
+static void tv_off(void)
+{
+    const fb_data *fb = FBADDR(0, 0);
+    memcpy(aui_fb, fb, sizeof(fb_data) * LCD_WIDTH * LCD_HEIGHT);
+    long t0 = current_tick, len = HZ * 3 / 10;
+    while (TIME_BEFORE(current_tick, t0 + len))
+    {
+        long t = current_tick - t0;
+        int h = (int)(LCD_HEIGHT - (LCD_HEIGHT - 2) * t * t / (len * len));
+        int top = (LCD_HEIGHT - h) / 2;
+        lcd_set_foreground(LCD_BLACK);
+        lcd_fillrect(0, 0, LCD_WIDTH, LCD_HEIGHT);
+        for (int y = 0; y < h; y++)
+            lcd_bitmap_part(aui_fb, 0, y * LCD_HEIGHT / h, LCD_WIDTH,
+                            0, top + y, LCD_WIDTH, 1);
+        lcd_update();
+        sleep(1);
+    }
+    t0 = current_tick; len = HZ / 5;
+    while (TIME_BEFORE(current_tick, t0 + len))
+    {
+        long t = current_tick - t0;
+        int w = (int)(LCD_WIDTH - (LCD_WIDTH - 4) * t / len);
+        lcd_set_foreground(LCD_BLACK);
+        lcd_fillrect(0, 0, LCD_WIDTH, LCD_HEIGHT);
+        lcd_set_foreground(LCD_RGBPACK(255, 236, 214));
+        lcd_fillrect((LCD_WIDTH - w) / 2, LCD_HEIGHT / 2 - 1, w, 2);
+        lcd_update();
+        sleep(1);
+    }
+    lcd_set_foreground(LCD_BLACK);
+    lcd_fillrect(0, 0, LCD_WIDTH, LCD_HEIGHT);
+    lcd_update();
+}
+#endif /* IPOD_6G || IPOD_VIDEO */
+
+bool asher_shutdown_countdown(void)
+{
+#if defined(IPOD_6G) || defined(IPOD_VIDEO) || defined(IPOD_NANO3G)
+    long start = current_tick, end = start + SECS * HZ;
+    bool go = true;
+
+    aui_init();
+    viewportmanager_theme_enable(SCREEN_MAIN, false, NULL);
+    backlight_on();
+    button_clear_queue();
+    while (TIME_BEFORE(current_tick, end))
+    {
+        frame(current_tick - start);
+        long btn = button_get_w_tmo(HZ / 25);
+        if (btn != BUTTON_NONE && !(btn & SYS_EVENT))
+        {
+            backlight_on();
+            if ((btn & BUTTON_MENU) && !(btn & (BUTTON_REL | BUTTON_REPEAT)))
+            {
+                go = false;
+                break;
+            }
+        }
+    }
+    if (go)
+    {
+        asher_prefs_save();              /* keeps the battery % for next time */
+        frame(SECS * HZ);
+        tv_off();                        /* stays black while things are saved */
+        return true;                     /* the bar stays off (see below) */
+    }
+    viewportmanager_theme_undo(SCREEN_MAIN, true);
+    aui_dirty = true;
+    return false;
+#else
+    return true;
+#endif
+}
+
+/* shutting down was stopped after the countdown (e.g. database busy) */
+void asher_shutdown_aborted(void)
+{
+#if defined(IPOD_6G) || defined(IPOD_VIDEO) || defined(IPOD_NANO3G)
+    viewportmanager_theme_undo(SCREEN_MAIN, true);
+    aui_dirty = true;
+#endif
+}
