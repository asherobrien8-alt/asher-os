+/* ---- the full keyboard, laid out like a phone's ---- */
+#define KB_ROWS 5
+static const char *kb_row[KB_ROWS] = { "123456789", "QWERTYUIOP", "ASDFGHJKL", "ZXCVBNM\b", " \n" };
+#define KB_Y   106
+#define KB_RH  26
+
+static int kb_len(int r) { return (int)strlen(kb_row[r]); }
+
+/* where key c of row r sits */
+static void kb_key(int r, int c, int *x, int *w)
+{
+    if (r == 4)                       /* space bar and Enter */
+    {
+        if (c == 0) { *x = 4; *w = 206; } else { *x = 214; *w = 102; }
+        return;
+    }
+    if (r == 3)                       /* letters, then a wide delete key */
+    {
+        int kw = 30;
+        if (c < 7) { *x = 4 + 12 + c * (kw + 2); *w = kw; }
+        else { *x = 4 + 12 + 7 * (kw + 2) + 4; *w = 316 - (4 + 12 + 7 * (kw + 2) + 4); }
+        return;
+    }
+    int n = kb_len(r), kw = 30, total = n * kw + (n - 1) * 2;
+    *x = (AUI_W - total) / 2 + c * (kw + 2);
+    *w = kw;
+}
+
+static void kb_draw(const char *q, int kr, int kc)
+{
+    const struct aui_theme *t = aui_theme();
+    char buf[48];
+    unsigned kbg = t->light ? 0xffffff : 0x2c2f52, kbase = t->light ? 0xd1d4db : 0x14162e;
+    aui_vgrad(0, 0, AUI_W, AUI_H, t->bg_top, t->bg_bot);
+    aui_topbar();
+    aui_round(8, AUI_BAR + 3, AUI_W - 16, 28, 9, t->light ? 0xeef0f4 : 0x23264a,
+              t->light ? 0xe4e7ed : 0x1a1c38);
+    aui_fill(0, KB_Y - 4, AUI_W, AUI_H - KB_Y + 4, kbase);
+    for (int r = 0; r < KB_ROWS; r++)
+        for (int c = 0; c < kb_len(r); c++)
+        {
+            int x, w;
+            kb_key(r, c, &x, &w);
+            bool sel = r == kr && c == kc;
+            if (sel) aui_round(x, KB_Y + r * KB_RH, w, KB_RH - 3, 6, t->sel1, t->sel2);
+            else     aui_round(x, KB_Y + r * KB_RH, w, KB_RH - 3, 6, kbg, kbg);
+        }
+    aui_present();
+    snprintf(buf, sizeof(buf), "%s_", q);
+    aui_text(AF_MED, 18, AUI_BAR + 9, q[0] ? t->text : t->sub, q[0] ? buf : "Type to search", AUI_W - 110, 0);
+    if (q[0])
+    {
+        snprintf(buf, sizeof(buf), lib_res == 1 ? "%d song" : "%d songs", lib_res);
+        aui_text(AF_SMALLR, AUI_W - 18, AUI_BAR + 11, t->sub, buf, 90, 2);
+    }
+    /* the first results, as you type */
+    for (int k = 0; k < 2 && k < lib_res; k++)
+    {
+        int e = results[k];
+        snprintf(buf, sizeof(buf), "%s", T(e));
+        aui_text(AF_SMALL, 14, AUI_BAR + 36 + k * 18, t->text, buf, 170, 0);
+        aui_text(AF_SMALLR, AUI_W - 14, AUI_BAR + 36 + k * 18, t->sub, AR(e), 120, 2);
+    }
+    if (q[0] && lib_res == 0)
+        aui_text(AF_SMALLR, AUI_W / 2, AUI_BAR + 44, t->sub, "No matches", AUI_W - 20, 1);
+    for (int r = 0; r < KB_ROWS; r++)
+        for (int c = 0; c < kb_len(r); c++)
+        {
+            int x, w;
+            kb_key(r, c, &x, &w);
+            char ch = kb_row[r][c];
+            char lb[8] = { ch, 0 };
+            const char *label = ch == ' ' ? "space" : ch == '\n' ? "Enter" : ch == '\b' ? "Del" : lb;
+            int font = (ch == ' ' || ch == '\n' || ch == '\b') ? AF_SMALL : AF_MED;
+            unsigned col = (r == kr && c == kc) ? 0xffffff : t->text;
+            aui_text(font, x + w / 2, KB_Y + r * KB_RH + (KB_RH - 3 - aui_font_h(font)) / 2,
+                     col, label, w, 1);
+        }
+    aui_topbar_text("Keyboard");
+    aui_update();
+}
+
+/* nearest key in row r to the middle of key (pr, pc) */
+static int kb_near(int r, int pr, int pc)
+{
+    int x, w, best = 0, bd = 9999;
+    kb_key(pr, pc, &x, &w);
+    int mid = x + w / 2;
+    for (int c = 0; c < kb_len(r); c++)
+    {
+        int x2, w2;
+        kb_key(r, c, &x2, &w2);
+        int d = abs(x2 + w2 / 2 - mid);
+        if (d < bd) { bd = d; best = c; }
+    }
+    return best;
+}
+
+/* returns when the keyboard closes (Enter or hold Play); the text stays */
+static bool kb_run_inner(char *q, size_t qn);
+/* the wheel does nothing in the keyboard, so it doesn't click either */
+static bool kb_run(char *q, size_t qn)
+{
+    extern bool keyclick_wheel_quiet;
+    keyclick_wheel_quiet = true;
+    bool r = kb_run_inner(q, qn);
+    keyclick_wheel_quiet = false;
+    return r;
+}
+static bool kb_run_inner(char *q, size_t qn)
+{
+    static int kr = 1, kc = 0;
+    bool redraw = true;
+    while (1)
+    {
+        if (aui_woke()) redraw = true;
+        if (redraw) { kb_draw(q, kr, kc); redraw = false; }
+        int a = kb_action(HZ);
+        size_t len = strlen(q);
+        switch (a)
+        {
+            case ACTION_STD_NEXT: case ACTION_STD_NEXTREPEAT:
+                if (++kc >= kb_len(kr)) { kr = (kr + 1) % KB_ROWS; kc = 0; }
+                redraw = true; break;
+            case ACTION_STD_PREV: case ACTION_STD_PREVREPEAT:
+                if (--kc < 0) { kr = (kr + KB_ROWS - 1) % KB_ROWS; kc = kb_len(kr) - 1; }
+                redraw = true; break;
+            case KB_LEFT:
+                kc = (kc + kb_len(kr) - 1) % kb_len(kr); redraw = true; break;
+            case KB_RIGHT:
+                kc = (kc + 1) % kb_len(kr); redraw = true; break;
+            case KB_UP:
+                if (kr > 0) { kc = kb_near(kr - 1, kr, kc); kr--; }
+                redraw = true; break;
+            case KB_DOWN:
+                if (kr < KB_ROWS - 1) { kc = kb_near(kr + 1, kr, kc); kr++; }
+                redraw = true; break;
+            case ACTION_STD_OK:
+            {
+                char ch = kb_row[kr][kc];
+                if (ch == '\n') return true;                     /* Enter */
+                if (ch == '\b') { if (len) q[len - 1] = 0; }
+                else if (ch == ' ') { if (len && len < qn - 1 && q[len - 1] != ' ') { q[len] = ' '; q[len + 1] = 0; } }
+                else if (len < qn - 1)
+                {
+                    q[len] = (ch >= 'A' && ch <= 'Z') ? ch - 'A' + 'a' : ch;
+                    q[len + 1] = 0;
+                }
+                run_search(q);
+                redraw = true; break;
+            }
+            case ACT_KEYBOARD:                   /* hold Play again: close */
+                action_wait_for_release();
+                return true;
+            case ACT_CONTROLS:
+                action_wait_for_release();
+                asher_music_mode();
+                redraw = true; break;
+            case ACTION_NONE:
+                break;
+            default:
+                if (default_event_handler(a) == SYS_USB_CONNECTED) return false;
+                redraw = true; break;
+        }
+    }
+}
+
+static int search_inner(void);
+/* search keeps the default wheel speed, whatever Music is set to */
+static int search(void)
+{
+    asher_wheel_zone(WZ_SEARCH);
+    int r = search_inner();
+    asher_wheel_zone(WZ_MUSIC);
+    return r;
+}
+
+static int search_inner(void)
+{
+    static char q[32];
+    static int letter = 0;
+    bool in_results = false;
+    int rsel = 0, rtop = 0, minute = -1;
+    bool redraw = true;
+
+    run_search(q);
+    aui_begin();
+    while (1)
+    {
+        if (aui_woke()) redraw = true;
+        if (redraw) { draw_search(q, letter, in_results, rsel, rtop); redraw = false; }
+        int a = search_action(HZ);
+        size_t len = strlen(q);
+        switch (a)
+        {
+            case ACTION_STD_NEXT: case ACTION_STD_NEXTREPEAT:
+                if (in_results) { if (rsel < lib_res - 1) rsel++; }
+                else letter = (letter + 1) % NCH;
+                redraw = true; break;
+            case ACTION_STD_PREV: case ACTION_STD_PREVREPEAT:
+                if (in_results) { if (rsel > 0) rsel--; }
+                else letter = (letter + NCH - 1) % NCH;
+                redraw = true; break;
+            case ACTION_STD_OK:
+                if (in_results)
+                {
+                    int r = play_entries(results, lib_res, rsel, false);
+                    if (r > 0) { aui_end(); return r; }
+                }
+                else if (letter < 36)
+                {
+                    if (len < sizeof(q) - 1) { q[len] = strip_label(letter)[0] + ('a' - 'A') * (letter < 26); q[len + 1] = 0; }
+                    run_search(q); rsel = rtop = 0;
+                }
+                else if (letter == 36)
+                {
+                    if (len && len < sizeof(q) - 1 && q[len - 1] != ' ') { q[len] = ' '; q[len + 1] = 0; }
+                }
+                else if (letter == 37)
+                {
+                    if (len) { q[len - 1] = 0; run_search(q); rsel = rtop = 0; }
+                }
+                else if (lib_res > 0) { in_results = true; rsel = rtop = 0; }
+                redraw = true; break;
+            case ACT_RESULTS:                     /* Play: to the results and back */
+                if (!in_results && lib_res > 0) { in_results = true; rsel = rtop = 0; }
+                else if (in_results) in_results = false;
+                redraw = true; break;
+            case ACT_KEYBOARD:                    /* hold Play: the full keyboard */
+                action_wait_for_release();
+                if (in_results && lib_res > 0)
+                {
+                    /* on a result: the song menu instead */
+                    song_menu_lib(results[rsel]);
+                    redraw = true; break;
+                }
+                if (!kb_run(q, sizeof(q))) { aui_end(); return 0; }
+                run_search(q);
+                in_results = lib_res > 0; rsel = rtop = 0;
+                redraw = true; break;
+            case ACT_DELETE:
+                if (in_results) in_results = false;
+                else if (len) { q[len - 1] = 0; run_search(q); rsel = rtop = 0; }
+                redraw = true; break;
+            case ACT_CONTROLS:                    /* hold Menu: music controls */
+                action_wait_for_release();
+                asher_music_mode();
+                redraw = true;
+                break;
+            case ACTION_STD_MENU:
+                if (in_results) { in_results = false; redraw = true; break; }
+                aui_end();
+                return 0;
+            case ACTION_NONE:
+                if (get_time()->tm_min != minute) { minute = get_time()->tm_min; redraw = true; }
+                break;
+            default:
+                if (default_event_handler(a) == SYS_USB_CONNECTED) { aui_end(); return 0; }
+                redraw = true; break;
+        }
+        if (rsel < rtop) rtop = rsel;
+        if (rsel >= rtop + 3) rtop = rsel - 2;
+    }
+}
+
+
+/* ------------------------------------------------------------------ */
+/* playlists: playlist files and plain folders of songs in /Playlists  */
+/* ------------------------------------------------------------------ */
+#define PL_DIR "/Playlists"
+#define MAX_PL 200
+/* every place someone might drop their playlist folders */
+static const char *pl_dirs[] = { "/Playlists", "/Playlist", "/Music/Playlists", "/Music/Playlist" };
+struct plent { char name[80]; char path[MAX_PATH]; char kind; };   /* d=folder p=file l=loose */
+static struct plent pls[MAX_PL];
+static int npls;
+
+static int pl_cmp(const void *a, const void *b)
+{
+    const struct plent *x = a, *y = b;
+    if ((x->kind == 'l') != (y->kind == 'l')) return x->kind == 'l' ? 1 : -1;
+    return strnatcasecmp(x->name, y->name);
+}
+
+static bool has_ext(const char *n, const char *const *exts)
+{
+    const char *e = strrchr(n, '.');
+    if (!e) return false;
+    for (int i = 0; exts[i]; i++)
+        if (!strcasecmp(e, exts[i])) return true;
+    return false;
+}
+static const char *const pl_exts[] = { ".m3u", ".m3u8", NULL };
+static const char *const audio_exts[] = { ".mp3", ".m4a", ".aac", ".flac", ".ogg", ".opus",
+                                          ".wav", ".wma", ".aiff", ".ape", ".wv", ".mpc", NULL };
+
+/* every folder that looks like a playlists folder: the usual names, plus
+ * any folder at the top of the drive (or in Music) with "playlist" in its
+ * name, whatever the capitals or spaces */
+#define MAX_PLDIRS 8
+static char pl_found[MAX_PLDIRS][MAX_PATH];
+static int pl_nfound;
+
+static bool ci_contains(const char *hay, const char *needle)
+{
+    size_t n = strlen(needle);
+    for (; *hay; hay++)
+        if (!strncasecmp(hay, needle, n)) return true;
+    return false;
+}
+static void pl_add_dir(const char *path)
+{
+    for (int i = 0; i < pl_nfound; i++)
+        if (!strcasecmp(pl_found[i], path)) return;
+    if (pl_nfound < MAX_PLDIRS && dir_exists(path))
+        strlcpy(pl_found[pl_nfound++], path, MAX_PATH);
+}
+static void pl_find_dirs(void)
+{
+    static const char *roots[] = { "/", "/Music/" };
+    pl_nfound = 0;
+    for (unsigned k = 0; k < sizeof(pl_dirs) / sizeof(pl_dirs[0]); k++)
+        pl_add_dir(pl_dirs[k]);
+    for (unsigned r = 0; r < 2; r++)
+    {
+        DIR *d = opendir(roots[r]);
+        struct dirent *ent;
+        if (!d) continue;
+        while ((ent = readdir(d)))
+        {
+            if (ent->d_name[0] == '.') continue;
+            if (!(dir_get_info(d, ent).attribute & ATTR_DIRECTORY)) continue;
+            if (!ci_contains(ent->d_name, "playlist")) continue;
+            char path[MAX_PATH];
+            snprintf(path, sizeof(path), "%s%s", roots[r], ent->d_name);
+            pl_add_dir(path);
+        }
+        closedir(d);
+    }
+}
+
+static void pl_scan(void)
+{
+    npls = 0;
+    pl_find_dirs();
+    for (int k = 0; k < pl_nfound; k++)
+    {
+        DIR *d = opendir(pl_found[k]);
+        struct dirent *ent;
+        bool loose = false;
+        if (!d) continue;
+        while (npls < MAX_PL - 1 && (ent = readdir(d)))
+        {
+            if (ent->d_name[0] == '.') continue;
+            bool isdir = dir_get_info(d, ent).attribute & ATTR_DIRECTORY;
+            if (!isdir && !has_ext(ent->d_name, pl_exts))
+            {
+                if (has_ext(ent->d_name, audio_exts)) loose = true;
+                continue;
+            }
+            strlcpy(pls[npls].name, ent->d_name, sizeof(pls[npls].name));
+            snprintf(pls[npls].path, sizeof(pls[npls].path), "%s/%s", pl_found[k], ent->d_name);
+            pls[npls].kind = isdir ? 'd' : 'p';
+            npls++;
+        }
+        closedir(d);
+        if (loose && npls < MAX_PL)          /* songs dropped straight in */
+        {
+            strlcpy(pls[npls].name, "Songs in the Playlists folder", sizeof(pls[npls].name));
+            strlcpy(pls[npls].path, pl_found[k], sizeof(pls[npls].path));
+            pls[npls].kind = 'l';
+            npls++;
+        }
+    }
+    qsort(pls, npls, sizeof(pls[0]), pl_cmp);
+}
+
+static void pl_get(struct aui_list *l, int i, char *buf, size_t n, char *sub, size_t subn)
+{
+    (void)l;
+    strlcpy(buf, pls[i].name, n);
+    if (pls[i].kind == 'p')
+    {
+        char *e = strrchr(buf, '.');
+        if (e) *e = '\0';
+    }
+    if (sub) strlcpy(sub, pls[i].kind == 'p' ? "Playlist" : "Folder of songs", subn);
+}
+
+/* ---- the songs inside one playlist (folder, .m3u or loose songs) ---- */
+#define FS_MAX   4000
+#define FS_POOL  (448 * 1024)
+struct fse { uint32_t off; int32_t ent; };      /* path, library entry (-1) */
+static int fs_handle = -1;
+static int fs_n;
+static struct fse *fs_e;
+static char *fs_pool;
+static size_t fs_used;
+static bool fs_full;
+/* while mixing every playlist, songs go straight into the play queue */
+static struct playlist_insert_context *mix_ctx;
+static const char *mix_skip;
+static int mix_count;
+
+static void fs_free(void)
+{
+    if (fs_handle > 0) { core_unpin(fs_handle); asher_free(fs_handle); }
+    fs_handle = -1;
+    fs_n = 0;
+}
+
+static int fs_max = FS_MAX;
+static size_t fs_poolsz = FS_POOL;
+static bool fs_alloc(void)
+{
+    fs_free();
+    /* less memory to spare (5th gen 30GB, nano): try smaller lists */
+    for (int div = 1; div <= 8; div *= 2)
+    {
+        fs_max = FS_MAX / div;
+        fs_poolsz = FS_POOL / div;
+        fs_handle = asher_alloc(fs_max * sizeof(struct fse) + fs_poolsz);
+        if (fs_handle > 0) break;
+    }
+    if (fs_handle <= 0) { fs_handle = -1; return false; }
+    fs_e = core_get_data_pinned(fs_handle);         /* pinned while in use */
+    fs_pool = (char *)(fs_e + fs_max);
+    fs_used = 0;
+    fs_full = false;
+    return true;
+}
+
+static void fs_add(const char *path)
+{
+    if (mix_ctx)
+    {
+        if (mix_skip && !strcmp(path, mix_skip)) return;
+        if (mix_count >= queue_cap()) { fs_full = true; return; }
+        if (playlist_insert_context_add(mix_ctx, path) >= 0) mix_count++;
+        else fs_full = true;                  /* queue full: stop looking */
+        return;
+    }
+    size_t len = strlen(path) + 1;
+    if (fs_n >= fs_max || fs_used + len > fs_poolsz) { fs_full = true; return; }
+    memcpy(fs_pool + fs_used, path, len);
+    fs_e[fs_n].off = fs_used;
+    fs_e[fs_n].ent = -1;
+    fs_n++;
+    fs_used += len;
+}
+static const char *FS(int i) { return fs_pool + fs_e[i].off; }
+
+/* song name: from the music library when it knows the file, else the
+ * file name without its extension */
+static void fse_title(const struct fse *e, char *buf, size_t n)
+{
+    if (e->ent >= 0) { strlcpy(buf, T(e->ent), n); return; }
+    const char *path = fs_pool + e->off, *b = strrchr(path, '/');
+    strlcpy(buf, b ? b + 1 : path, n);
+    char *dot = strrchr(buf, '.');
+    if (dot && dot != buf) *dot = '\0';
+}
+static const char *fse_artist(const struct fse *e) { return e->ent >= 0 ? AR(e->ent) : ""; }
+static void fs_title(int i, char *buf, size_t n) { fse_title(&fs_e[i], buf, n); }
+static const char *fs_artist(int i) { return fse_artist(&fs_e[i]); }
+
+static int fs_cmp_title(const void *a, const void *b)
+{
+    char x[128], y[128];
+    fse_title(a, x, sizeof(x));
+    fse_title(b, y, sizeof(y));
+    /* "9" before "10", "159" before "160" (natural number order) */
+    int r = strnatcasecmp(skip_the(x), skip_the(y));
+    return r ? r : strnatcasecmp(fse_artist(a), fse_artist(b));
+}
+static int fs_cmp_artist(const void *a, const void *b)
+{
+    int r = strnatcasecmp(skip_the(fse_artist(a)), skip_the(fse_artist(b)));
+    return r ? r : fs_cmp_title(a, b);
+}
+
+/* every song in a folder (and the folders inside it, a few levels deep) */
+static void fs_scan(char *path, size_t cap, int depth)
+{
+    DIR *d = opendir(path);
+    struct dirent *ent;
+    size_t base = strlen(path);
+    if (!d) return;
+    while (!fs_full && (ent = readdir(d)))
+    {
+        if (ent->d_name[0] == '.') continue;
+        bool isdir = dir_get_info(d, ent).attribute & ATTR_DIRECTORY;
+        if (base + 1 + strlen(ent->d_name) + 1 > cap) continue;
+        snprintf(path + base, cap - base, "/%s", ent->d_name);
+        if (isdir)
+        {
+            if (depth > 0) fs_scan(path, cap, depth - 1);
+        }
+        else if (has_ext(ent->d_name, audio_exts))
+            fs_add(path);
+        path[base] = '\0';
+        loading_tick("LOADING", NULL);
+    }
+    closedir(d);
+}
+
+/* the songs listed in an .m3u / .m3u8 file */
+static void fs_read_m3u(const char *file)
+{
+    char line[MAX_PATH], full[MAX_PATH], dir[MAX_PATH];
+    int fd = open(file, O_RDONLY);
+    if (fd < 0) return;
+    strlcpy(dir, file, sizeof(dir));
+    char *sl = strrchr(dir, '/');
+    if (sl) *sl = '\0';
+    while (!fs_full && read_line(fd, line, sizeof(line)) > 0)
+    {
+        char *p = line;
+        if (!strncmp(p, "\xef\xbb\xbf", 3)) p += 3;      /* UTF-8 marker */
+        while (*p == ' ' || *p == '\t') p++;
+        size_t len = strlen(p);
+        while (len && (p[len - 1] == '\r' || p[len - 1] == ' ')) p[--len] = '\0';
+        if (!len || *p == '#') continue;
+        for (char *c = p; *c; c++) if (*c == '\\') *c = '/';
+        if (p[1] == ':') continue;                   /* a Windows path, not on the iPod */
+        if (*p == '/') strlcpy(full, p, sizeof(full));
+        else snprintf(full, sizeof(full), "%s/%s", dir, p);
+        if (file_exists(full)) fs_add(full);
+        loading_tick("LOADING", NULL);
+    }
+    close(fd);
+}
+
+static void fs_read_playlist(int i)
+{
+    char path[MAX_PATH];
+    if (pls[i].kind == 'p')
+        fs_read_m3u(pls[i].path);
+    else
+    {
+        strlcpy(path, pls[i].path, sizeof(path));
+        fs_scan(path, sizeof(path), pls[i].kind == 'd' ? 4 : 0);
+    }
+}
+
+/* the playlist that is playing (for the dot in the Playlists list) */
+static char playing_pl[MAX_PATH];
+static int open_pl = -1;          /* the playlist whose songs are shown */
+
+#define FS_TOP 2                  /* SHUFFLE SONGS, PLAY IN ORDER, then the songs */
+static void fs_get(struct aui_list *l, int i, char *buf, size_t n, char *sub, size_t subn)
+{
+    (void)l;
+    if (i < FS_TOP)
+    {
+        strlcpy(buf, i == 0 ? "SHUFFLE SONGS" : "PLAY IN ORDER", n);
+        if (sub) strlcpy(sub, "", subn);
+        return;
+    }
+    fs_title(i - FS_TOP, buf, n);
+    if (sub) strlcpy(sub, fs_artist(i - FS_TOP), subn);
+}
+static int fs_style(struct aui_list *l, int i)
+{
+    (void)l;
+    if (i < FS_TOP) return AUI_ROW_ACTION;
+    const char *p = now_path();
+    return (p[0] && !strcmp(p, FS(i - FS_TOP))) ? AUI_ROW_DOT : 0;
+}
+
+/* play the playlist's songs, starting with song 'start' (-1 = shuffle all,
+ * -2 = all of them in the order shown) */
+static int fs_play(int start)
+{
+    struct playlist_insert_context ctx;
+    aui_begin();
+    loading_screen("LOADING", NULL);
+    if (new_playlist() < 0
+        || playlist_insert_context_create(NULL, &ctx, PLAYLIST_INSERT_LAST, false, false) < 0)
+        { aui_end(); splash(2 * HZ, "Couldn't load those songs"); return 0; }
+    int cap = queue_cap();
+    for (int k = 0; k < fs_n && k < cap; k++)
+    {
+        if (playlist_insert_context_add(&ctx, FS(k)) < 0)
+            break;                            /* queue full: play what fits */
+        loading_tick("LOADING", NULL);
+    }
+    playlist_insert_context_release(&ctx);
+    if (playlist_amount() <= 0)
+        { aui_end(); splash(2 * HZ, "Couldn't load those songs"); return 0; }
+    if (open_pl >= 0) strlcpy(playing_pl, pls[open_pl].path, sizeof(playing_pl));
+    if (start == -2)
+    {
+        /* in order: shuffle off for this one */
+        if (global_settings.playlist_shuffle)
+        {
+            global_settings.playlist_shuffle = false;
+            settings_save();
+        }
+        if (asher_shufmode != SHUF_OFF) { asher_shufmode = SHUF_OFF; asher_prefs_save(); }
+        return begin_play(0, false);
+    }
+    return begin_play(start < 0 ? 0 : start, start == -1);
+}
+
+static int fs_hold(struct aui_list *l, int i)
+{
+    (void)l;
+    if (i < FS_TOP) return song_menu(NULL, NULL);    /* SHUFFLE / PLAY rows */
+    char name[80];
+    fs_title(i - FS_TOP, name, sizeof(name));
+    static char path[MAX_PATH];
+    strlcpy(path, FS(i - FS_TOP), sizeof(path));
+    return song_menu(path, name);
+}
+static int fs_select(struct aui_list *l, int i)
+{
+    (void)l;
+    if (i == 0) return fs_play(-1);
+    if (i == 1) return fs_play(-2);
+    return fs_play(i - FS_TOP);
+}
+
+static int pl_select(struct aui_list *l, int i)
+{
+    int r = 0;
+    if (!fs_alloc()) { splash(2 * HZ, "Not enough memory"); return 0; }
+    aui_begin();
+    loading_screen("LOADING", NULL);
+    fs_read_playlist(i);
+    /* real song names and artists from the music library */
+    if (lib_handle <= 0 && tagcache_is_usable())
+    {
+        /* only the quick saved index here - building the whole library just
+         * to open a playlist would take a minute on older iPods */
+        struct tagcache_search tcs;
+        if (tagcache_search(&tcs, tag_filename))
+        {
+            long cnt = tcs.entry_count;
+            tagcache_search_finish(&tcs);
+            lib_cache_load(cnt);
+        }
+    }
+    {
+        if (lib_handle > 0)
+            for (int k = 0; k < fs_n; k++)
+            {
+                fs_e[k].ent = lib_find(FS(k));
+                if ((k & 15) == 0) loading_tick("LOADING", NULL);
+            }
+    }
+    if (asher_organize == ORG_ALPHA)
+        qsort(fs_e, fs_n, sizeof(struct fse), fs_cmp_title);
+    else if (asher_organize == ORG_ARTIST)
+        qsort(fs_e, fs_n, sizeof(struct fse), fs_cmp_artist);
+    if (fs_n == 0)
+        splash(2 * HZ, "No songs in there");
+    else
+    {
+        char title[80];
+        struct aui_list sl = { 0 };
+        pl_get(l, i, title, sizeof(title), NULL, 0);
+        sl.title = title; sl.count = fs_n + FS_TOP; sl.two_line = true;
+        sl.letter_jump = fs_n > 40 && asher_organize == ORG_ALPHA;
+        sl.get = fs_get; sl.select = fs_select; sl.style = fs_style;
+        sl.hold = fs_hold;
+        open_pl = i;
+        r = aui_list_run(&sl);
+        open_pl = -1;
+    }
+    aui_end();
+    fs_free();
+    return r > 0 ? r : 0;
+}
+
+/* hold Menu > Shuffle > Playlists: every song from every playlist, mixed.
+ * The song that's playing keeps playing where it was. */
+void asher_shuffle_playlists(void)
+{
+    struct playlist_insert_context ctx;
+    static char cur[MAX_PATH];
+    struct mp3entry *id3 = audio_current_track();
+    int st = audio_status();
+    unsigned long elapsed = 0, offset = 0;
+    cur[0] = '\0';
+    if ((st & AUDIO_STATUS_PLAY) && id3)
+    {
+        strlcpy(cur, id3->path, sizeof(cur));
+        elapsed = id3->elapsed;
+        offset = id3->offset;
+    }
+    pl_scan();
+    if (npls == 0) { splash(2 * HZ, "No playlists yet"); return; }
+    playing_pl[0] = '\0';          /* a mix of all of them, not one */
+    aui_begin();
+    loading_screen("LOADING", NULL);
+    if (new_playlist() < 0
+        || playlist_insert_context_create(NULL, &ctx, PLAYLIST_INSERT_LAST, false, false) < 0)
+        { aui_end(); return; }
+    mix_count = 0;
+    if (cur[0] && playlist_insert_context_add(&ctx, cur) >= 0) mix_count++;
+    mix_ctx = &ctx;
+    mix_skip = cur[0] ? cur : NULL;
+    fs_full = false;
+    for (int i = 0; i < npls; i++)
+        fs_read_playlist(i);
+    mix_ctx = NULL;
+    mix_skip = NULL;
+    playlist_insert_context_release(&ctx);
+    aui_end();
+    if (mix_count == 0) { splash(2 * HZ, "No songs in your playlists"); return; }
+    global_settings.playlist_shuffle = true;
+    settings_save();
+    int start = playlist_shuffle(current_tick, cur[0] ? 0 : -1);
+    if (!cur[0]) start = 0;
+    asher_queue_unstarted = false;
+    playlist_start(start, cur[0] ? elapsed : 0, cur[0] ? offset : 0);
+    queue_restore();
+    if (st & AUDIO_STATUS_PAUSE)
+    {
+        audio_pause();
+        get_wps_state()->paused = true;
+    }
+}
+
+static int pl_style(struct aui_list *l, int i)
+{
+    (void)l;
+    return (playing_pl[0] && now_path()[0] && !strcmp(playing_pl, pls[i].path)) ? AUI_ROW_DOT : 0;
+}
+
+static int playlists(void)
+{
+    struct aui_list l = { 0 };
+    pl_scan();
+    if (npls == 0)
+    {
+        if (!dir_exists(PL_DIR)) mkdir(PL_DIR);
+        splash(3 * HZ, "No playlists yet\nCopy folders of songs into\nthe Playlists folder");
+        return 0;
+    }
+    l.title = "Playlists"; l.count = npls; l.two_line = true; l.chevrons = true;
+    l.letter_jump = npls > 40; l.get = pl_get; l.select = pl_select; l.style = pl_style;
+    return aui_list_run(&l);
+}
+
+/* ------------------------------------------------------------------ */
+/* Music menu                                                          */
+/* ------------------------------------------------------------------ */
+static int queue_screen(void);
+/* Now Playing: hold Play opens the queue */
+int asher_queue_screen(void) { return queue_screen(); }
+/* the song after this one, for Now Playing (false if none) */
+bool asher_up_next(char *buf, size_t n, bool *queued)
+{
+    struct playlist_info *pl = playlist_get_current();
+    struct playlist_track_info info;
+    buf[0] = 0;
+    if (queued) *queued = false;
+    if (!pl->started || pl->amount <= 1 || pl->index < 0) return false;
+    int idx = pl->index + 1;
+    if (idx >= pl->amount)
+    {
+        if (global_settings.repeat_mode != REPEAT_ALL
+            && global_settings.repeat_mode != REPEAT_SHUFFLE) return false;
+        idx = 0;
+    }
+    if (queued) *queued = playlist_is_queued_ahead(1);
+    /* the same answer as last time while nothing moved (Now Playing asks
+     * every second; this keeps the hard drive out of it) */
+    static int c_idx = -1, c_amt = -1;
+    static char c_buf[160];
+    if (c_idx == pl->index && c_amt == pl->amount && c_buf[0])
+    {
+        strlcpy(buf, c_buf, n);
+        return true;
+    }
+    c_idx = pl->index; c_amt = pl->amount; c_buf[0] = 0;
+    /* the playlist says what's next; the library gives its name */
+    if (playlist_get_track_info(NULL, idx, &info) >= 0)
+    {
+        int e = lib_handle > 0 ? lib_find(info.filename) : -1;
+        struct mp3entry *nx = audio_next_track();
+        if (e >= 0) snprintf(buf, n, "%s - %s", T(e), AR(e));
+        else if (nx && nx->title && nx->title[0] && !strcmp(nx->path, info.filename))
+        {
+            if (nx->artist && nx->artist[0]) snprintf(buf, n, "%s - %s", nx->title, nx->artist);
+            else strlcpy(buf, nx->title, n);
+        }
+        else
+        {
+            const char *b = strrchr(info.filename, '/');
+            strlcpy(buf, b ? b + 1 : info.filename, n);
+            char *dot = strrchr(buf, '.');
+            if (dot && dot != buf) *dot = '\0';
+        }
+    }
+    else return false;
+    strlcpy(c_buf, buf, sizeof(c_buf));
+    return true;
+}
+
+static const char *music_items[] = { "Playlists", "Shuffle", "All Songs", "Search", "Artists",
+                                     "Organize", "Queue" };
+
+/* Music > Queue: what's playing and what's next */
+#define QROWS 40
+static char q_path[QROWS][MAX_PATH];
+static bool q_queued[QROWS];
+static int q_n;
+static char q_for[MAX_PATH];         /* the song the list was made for */
+
+static void queue_build(void)
+{
+    struct playlist_info *pl = playlist_get_current();
+    struct playlist_track_info info;
+    q_n = 0;
+    strlcpy(q_for, now_path(), sizeof(q_for));
+    if (!q_for[0] || !pl->started || pl->amount <= 0 || pl->index < 0) return;
+    strlcpy(q_path[0], q_for, MAX_PATH);
+    q_queued[0] = false;
+    q_n = 1;
+    bool wrap = global_settings.repeat_mode == REPEAT_ALL
+                || global_settings.repeat_mode == REPEAT_SHUFFLE;
+    for (int k = 1; k < pl->amount && q_n < QROWS; k++)
+    {
+        int idx = (pl->index + k) % pl->amount;
+        /* without Repeat, playback stops at the end of the list */
+        if (!wrap && idx == pl->first_index) break;
+        if (playlist_get_track_info(NULL, idx, &info) < 0) break;
+        strlcpy(q_path[q_n], info.filename, MAX_PATH);
+        q_queued[q_n] = (info.attr & PLAYLIST_ATTR_QUEUED) != 0;
+        q_n++;
+    }
+}
+static void queue_names(int i, char *buf, size_t n, char *sub, size_t subn)
+{
+    int e = lib_handle > 0 ? lib_find(q_path[i]) : -1;
+    const char *artist = "";
+    if (e >= 0) { strlcpy(buf, T(e), n); artist = AR(e); }
+    else
+    {
+        const char *b = strrchr(q_path[i], '/');
+        strlcpy(buf, b ? b + 1 : q_path[i], n);
+        char *dot = strrchr(buf, '.');
+        if (dot && dot != buf) *dot = '\0';
+    }
+    if (sub)
+    {
+        if (i == 0) snprintf(sub, subn, artist[0] ? "Now Playing  -  %s" : "Now Playing", artist);
+        else if (q_queued[i]) snprintf(sub, subn, artist[0] ? "Queued  -  %s" : "Queued", artist);
+        else strlcpy(sub, artist, subn);
+    }
+}
+static void queue_get(struct aui_list *l, int i, char *buf, size_t n, char *sub, size_t subn)
+{
+    (void)l;
+    if (i >= q_n) { strlcpy(buf, "", n); if (sub) sub[0] = 0; return; }
+    queue_names(i, buf, n, sub, subn);
+}
+static int queue_style(struct aui_list *l, int i)
+{
+    /* a new song started (or the queue changed): make the list again */
+    if (i == 0 && strcmp(now_path(), q_for))
+    {
+        queue_build();
+        l->count = MAX(1, q_n);
+        if (l->sel >= l->count) l->sel = l->count - 1;
+    }
+    return i == 0 ? AUI_ROW_DOT : 0;
+}
+static int queue_select(struct aui_list *l, int i)
+{
+    if (i <= 0 || i >= q_n) return 0;
+    audio_skip(i);                   /* jump ahead to that song */
+    sleep(HZ / 4);
+    queue_build();
+    l->count = MAX(1, q_n);
+    l->sel = 0; l->top = 0;
+    return 0;
+}
+static int queue_hold(struct aui_list *l, int i)
+{
+    char name[80];
+    if (i < 0 || i >= q_n) return 0;
+    queue_names(i, name, sizeof(name), NULL, 0);
+    song_menu(i == 0 ? NULL : q_path[i], name);
+    queue_build();
+    l->count = MAX(1, q_n);
+    if (l->sel >= l->count) l->sel = l->count - 1;
+    return 0;
+}
+static int queue_screen(void)
+{
+    aui_begin();
+    loading_screen("LOADING", NULL);            /* the record player */
+    queue_build();
+    aui_end();
+    if (q_n == 0) { splash(HZ * 3 / 2, "Nothing playing"); return 0; }
+    struct aui_list l = { 0 };
+    l.title = "Queue"; l.count = q_n; l.two_line = true;
+    l.get = queue_get; l.select = queue_select; l.style = queue_style; l.hold = queue_hold;
+    return aui_list_run(&l);
+}
+
+/* Music > Organize: how song lists are sorted */
+static const char *org_names[3] = { "Alphabet", "Artist", "Off" };
+static const char *org_subs[3] = { "Song names A to Z", "Artist names A to Z",
+                                   "Leave songs where they are" };
+static void org_get(struct aui_list *l, int i, char *buf, size_t n, char *sub, size_t subn)
+{
+    (void)l;
+    strlcpy(buf, org_names[i], n);
+    if (sub) strlcpy(sub, org_subs[i], subn);
+}
+static int org_style(struct aui_list *l, int i)
+{
+    (void)l;
+    return i == asher_organize ? AUI_ROW_CHECK : 0;
+}
+static int org_select(struct aui_list *l, int i)
+{
+    (void)l;
+    asher_organize = i;
+    asher_prefs_save();
+    return AUI_BACK;
+}
+static int organize(void)
+{
+    struct aui_list l = { 0 };
+    l.title = "Organize"; l.count = 3; l.two_line = true; l.sel = asher_organize;
+    l.get = org_get; l.select = org_select; l.style = org_style;
+    return aui_list_run(&l);
+}
+
+/* All Songs in the chosen order */
+static const int *all_songs_order(void)
+{
+    if (asher_organize == ORG_ARTIST) return by_artist;
+    if (asher_organize == ORG_OFF)
+    {
+        int u = 0;
+        for (int k = 0; k < lib_n; k++)        /* as stored, no duplicates */
+            if (!L[k].dup) results[u++] = k;
+        lib_res = 0;
+        return results;
+    }
+    return by_title;
+}
+
+static void music_get(struct aui_list *l, int i, char *buf, size_t n, char *sub, size_t subn)
+{
+    (void)l; (void)sub; (void)subn;
+    strlcpy(buf, music_items[i], n);
+}
+
+static int music_select(struct aui_list *l, int i)
+{
+    (void)l;
+    switch (i)
+    {
+        case 0: return playlists();
+        case 1: return shuffle_all();
+        case 2: return library_ready() ? songs_list("All Songs", all_songs_order(), lib_u) : 0;
+        case 3: return library_ready() ? search() : 0;
+        case 4: return library_ready() ? artists() : 0;
+        case 5: return organize();
+        case 6: return queue_screen();
+    }
+    return 0;
+}
+
+/* a short spin of the record player on the way into Music */
+static void music_intro(void)
+{
+    long t0 = current_tick;
+    if (!aui_screen_on()) return;
+    load_last = 0; load_start = 0;
+    while (TIME_BEFORE(current_tick, t0 + HZ * 6 / 5))
+    {
+        loading_tick("LOADING", NULL);
+        if (get_action(CONTEXT_STD, 1) != ACTION_NONE) break;   /* any button skips */
+    }
+}
+
+int asher_music(void)
+{
+    static int sel = 0;
+    struct aui_list l = { 0 };
+    asher_wheel_zone(WZ_MUSIC);
+    aui_begin();            /* held across the intro so nothing flashes between */
+    music_intro();
+    l.title = "Music"; l.count = 7; l.chevrons = true;
+    l.get = music_get; l.select = music_select; l.sel = sel;
+    int r = aui_list_run(&l);
+    aui_end();
+    sel = l.sel;
+    return r;
+}
+
+/* Settings > Music Library: rebuild the database from scratch */
+static int library_rebuild(void)
+{
+    lib_free();
+    remove(LIB_CACHE);
+    rebuild_requested = true;
+    tagcache_rebuild();
+    splash(3 * HZ, "Rebuilding your music library in the background");
+    return 0;
+}
+MENUITEM_FUNCTION(asher_library_item, 0, "Rebuild Music Library",
+                  library_rebuild, NULL, Icon_NOICON);
