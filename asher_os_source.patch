diff --git a/apps/asher/asher_home.c b/apps/asher/asher_home.c
new file mode 100644
index 0000000..03a309c
--- /dev/null
+++ b/apps/asher/asher_home.c
@@ -0,0 +1,298 @@
+/* Asher OS bubble home screen: rounded icon bubbles in a grid.
+ * Turning right moves right, then wraps down to the first box on the
+ * left; turning left moves left, then up to the last box on the right. */
+#include <stdio.h>
+#include <string.h>
+#include "config.h"
+#include "system.h"
+#include "kernel.h"
+#include "lcd.h"
+#include "font.h"
+#include "action.h"
+#include "audio.h"
+#include "menu.h"
+#include "lang.h"
+#include "misc.h"
+#include "settings.h"
+#include "powermgmt.h"
+#include "timefuncs.h"
+#include "root_menu.h"
+#include "gui/viewport.h"
+#include "asher_home.h"
+
+#define COLS     3
+#define ROWS     2
+#define PER_PAGE (COLS * ROWS)
+#define BR       32            /* bubble radius */
+
+static int home_sel = 0;
+
+static int isqrt_i(int v)
+{
+    int r = 0;
+    while ((r + 1) * (r + 1) <= v) r++;
+    return r;
+}
+static int lerp(int a, int b, int t256) { return a + (((b - a) * t256) >> 8); }
+static void setc(int r, int g, int b) { lcd_set_foreground(LCD_RGBPACK(r, g, b)); }
+
+static void fill_circle(int cx, int cy, int r)
+{
+    for (int dy = -r; dy <= r; dy++)
+    {
+        int dx = isqrt_i(r * r - dy * dy);
+        lcd_hline(cx - dx, cx + dx, cy + dy);
+    }
+}
+
+static void bubble(int cx, int cy, int r, const int *base, const int *light)
+{
+    for (int dy = -r; dy <= r; dy++)
+    {
+        int dx = isqrt_i(r * r - dy * dy);
+        int t = ((dy + r) * 256) / (2 * r);
+        setc(lerp(light[0], base[0], t), lerp(light[1], base[1], t),
+             lerp(light[2], base[2], t));
+        lcd_hline(cx - dx, cx + dx, cy + dy);
+    }
+    /* soft gloss on the upper half */
+    for (int dy = -r + 4; dy < -r / 5; dy++)
+    {
+        int dx = isqrt_i(r * r - dy * dy) * 3 / 4;
+        int t = ((dy + r) * 256) / (2 * r);
+        setc(lerp(255, light[0], 100 + t / 2), lerp(255, light[1], 100 + t / 2),
+             lerp(255, light[2], 100 + t / 2));
+        lcd_hline(cx - dx, cx + dx, cy + dy);
+    }
+}
+
+/* ---- tiny white glyphs drawn with primitives ---- */
+static void g_music(int cx, int cy)
+{
+    setc(255, 255, 255);
+    fill_circle(cx - 9, cy + 10, 6);
+    fill_circle(cx + 9, cy + 7, 6);
+    lcd_fillrect(cx - 5, cy - 14, 3, 25);
+    lcd_fillrect(cx + 13, cy - 17, 3, 24);
+    lcd_fillrect(cx - 5, cy - 17, 21, 6);
+}
+static void g_play(int cx, int cy)
+{
+    setc(255, 255, 255);
+    for (int i = -14; i <= 14; i++)
+        lcd_hline(cx - 8, cx - 8 + (28 - (i < 0 ? -i : i) * 2) * 24 / 28, cy + i);
+}
+static void g_shuffle(int cx, int cy)
+{
+    setc(255, 255, 255);
+    for (int k = -1; k <= 1; k++)
+    {
+        lcd_drawline(cx - 14, cy - 9 + k, cx + 8, cy + 9 + k);
+        lcd_drawline(cx - 14, cy + 9 + k, cx + 8, cy - 9 + k);
+    }
+    for (int i = 0; i < 7; i++)
+    {
+        lcd_hline(cx + 8, cx + 8 + i, cy - 9 - 6 + i);
+        lcd_hline(cx + 8, cx + 8 + i, cy + 9 + 6 - i);
+    }
+}
+static void g_bars(int cx, int cy)
+{
+    setc(255, 255, 255);
+    lcd_fillrect(cx - 15, cy + 2, 8, 14);
+    lcd_fillrect(cx - 4, cy - 8, 8, 24);
+    lcd_fillrect(cx + 7, cy - 16, 8, 32);
+}
+static void g_gear(int cx, int cy, const int *base)
+{
+    setc(255, 255, 255);
+    fill_circle(cx, cy, 12);
+    lcd_fillrect(cx - 3, cy - 17, 7, 8);
+    lcd_fillrect(cx - 3, cy + 10, 7, 8);
+    lcd_fillrect(cx - 17, cy - 3, 8, 7);
+    lcd_fillrect(cx + 10, cy - 3, 8, 7);
+    setc(base[0], base[1], base[2]);
+    fill_circle(cx, cy, 5);
+}
+static void g_letter(int cx, int cy, const char *name)
+{
+    char s[2] = { name[0], 0 };
+    int w, h;
+    setc(255, 255, 255);
+    lcd_getstringsize(s, &w, &h);
+    lcd_putsxy(cx - w / 2, cy - h / 2, s);
+}
+
+static const char *item_label(const struct menu_item_ex *it, char *buf, size_t n)
+{
+    if (it->flags & MENU_DYNAMIC_DESC)
+        return it->menu_get_name_and_icon->list_get_name(0,
+                   it->menu_get_name_and_icon->list_get_name_data, buf, n);
+    return P2STR(it->callback_and_desc->desc);
+}
+
+static void draw_home(const struct menu_item_ex *root, int count, int sel)
+{
+    static const int cols[6][2][3] = {
+        { {255,140,20}, {255,205,100} },   /* Music */
+        { { 30,110,230}, {120,185,255} },  /* Shuffle */
+        { {140, 50,215}, {205,135,255} },  /* Now Playing */
+        { { 35,170, 80}, {130,230,150} },  /* Stats */
+        { { 85,105,140}, {165,185,215} },  /* Settings */
+        { {200, 55, 60}, {255,140,140} },  /* other */
+    };
+    char buf[48], tbuf[24];
+    int bg_light = (RGB_UNPACK_RED(global_settings.bg_color) +
+                    RGB_UNPACK_GREEN(global_settings.bg_color) +
+                    RGB_UNPACK_BLUE(global_settings.bg_color)) > 384;
+    int page = sel / PER_PAGE, pages = (count + PER_PAGE - 1) / PER_PAGE;
+    struct tm *t = get_time();
+    int w, h, bat = battery_level();
+
+    /* background */
+    for (int y = 0; y < LCD_HEIGHT; y++)
+    {
+        if (bg_light) setc(205, 208, 214);
+        else setc(lerp(16, 3, y * 256 / LCD_HEIGHT), lerp(18, 3, y * 256 / LCD_HEIGHT),
+                  lerp(44, 14, y * 256 / LCD_HEIGHT));
+        lcd_hline(0, LCD_WIDTH - 1, y);
+    }
+    /* top bar: time centered, battery on the right */
+    if (bg_light) setc(30, 30, 40); else setc(255, 255, 255);
+    snprintf(tbuf, sizeof(tbuf), "%d:%02d %s", t->tm_hour % 12 ? t->tm_hour % 12 : 12,
+             t->tm_min, t->tm_hour >= 12 ? "PM" : "AM");
+    lcd_getstringsize(tbuf, &w, &h);
+    lcd_putsxy((LCD_WIDTH - w) / 2, 4, tbuf);
+    if (bat >= 0)
+    {
+        snprintf(tbuf, sizeof(tbuf), "%d%%", bat);
+        lcd_getstringsize(tbuf, &w, &h);
+        lcd_putsxy(LCD_WIDTH - w - 8, 4, tbuf);
+    }
+
+    for (int k = 0; k < PER_PAGE; k++)
+    {
+        int idx = page * PER_PAGE + k;
+        if (idx >= count) break;
+        const struct menu_item_ex *it = root->submenus[idx];
+        const char *name = item_label(it, buf, sizeof(buf));
+        int col = k % COLS, row = k / COLS;
+        int cx = 53 + col * 107, cy = 74 + row * 100;
+        int ci = 5;
+        if (!strcmp(name, "Music")) ci = 0;
+        else if (!strcmp(name, "Shuffle")) ci = 1;
+        else if (!strncmp(name, "Now", 3) || !strncmp(name, "Resume", 6)) ci = 2;
+        else if (!strcmp(name, "Stats")) ci = 3;
+        else if (!strcmp(name, "Settings")) ci = 4;
+
+        if (idx == sel)    /* selection ring */
+        {
+            if (bg_light) setc(40, 120, 230); else setc(255, 255, 255);
+            fill_circle(cx, cy, BR + 4);
+            if (bg_light) setc(205, 208, 214); else setc(10, 10, 30);
+            fill_circle(cx, cy, BR + 1);
+        }
+        bubble(cx, cy, BR, cols[ci][0], cols[ci][1]);
+        switch (ci)
+        {
+            case 0: g_music(cx, cy); break;
+            case 1: g_shuffle(cx, cy); break;
+            case 2: g_play(cx, cy); break;
+            case 3: g_bars(cx, cy); break;
+            case 4: g_gear(cx, cy, cols[4][0]); break;
+            default: g_letter(cx, cy, name); break;
+        }
+        if (idx == sel) { if (bg_light) setc(0, 0, 0); else setc(255, 255, 255); }
+        else            { if (bg_light) setc(80, 84, 96); else setc(170, 176, 196); }
+        lcd_getstringsize(name, &w, &h);
+        lcd_putsxy(cx - w / 2, cy + BR + 6, name);
+    }
+    if (pages > 1)   /* page dots */
+        for (int p = 0; p < pages; p++)
+        {
+            if (p == page) { if (bg_light) setc(40, 40, 50); else setc(255, 255, 255); }
+            else           { if (bg_light) setc(150, 154, 164); else setc(90, 96, 120); }
+            fill_circle(LCD_WIDTH / 2 - (pages - 1) * 7 + p * 14, LCD_HEIGHT - 8, 3);
+        }
+    lcd_update();
+}
+
+static int run_item(const struct menu_item_ex *it, bool *stay)
+{
+    int r;
+    *stay = false;
+    switch (it->flags & MENU_TYPE_MASK)
+    {
+        case MT_RETURN_VALUE:
+            return it->value;
+        case MT_MENU:
+            return do_menu(it, NULL, NULL, false);
+        case MT_FUNCTION_CALL:
+            r = it->function->function();
+            if ((it->flags & MENU_FUNC_CHECK_RETVAL) && r != 0) return r;
+            *stay = true;
+            return 0;
+        case MT_FUNCTION_CALL_W_PARAM:
+            r = it->function_param->function_w_param(it->function_param->param);
+            if ((it->flags & MENU_FUNC_CHECK_RETVAL) && r != 0) return r;
+            *stay = true;
+            return 0;
+        default:
+            *stay = true;
+            return 0;
+    }
+}
+
+int asher_home(const struct menu_item_ex *root, int *selected)
+{
+    int count = MENU_GET_COUNT(root->flags);
+    (void)selected;
+    if (count <= 0) return GO_TO_PREVIOUS;
+    if (home_sel >= count) home_sel = 0;
+
+    viewportmanager_theme_enable(SCREEN_MAIN, false, NULL);
+    lcd_setfont(FONT_UI);
+    while (1)
+    {
+        int action;
+        draw_home(root, count, home_sel);
+        action = get_action(CONTEXT_MAINMENU, HZ);
+        switch (action)
+        {
+            case ACTION_STD_NEXT:
+            case ACTION_STD_NEXTREPEAT:
+                home_sel = (home_sel + 1) % count;
+                break;
+            case ACTION_STD_PREV:
+            case ACTION_STD_PREVREPEAT:
+                home_sel = (home_sel + count - 1) % count;
+                break;
+            case ACTION_STD_OK:
+            {
+                bool stay;
+                int ret;
+                viewportmanager_theme_undo(SCREEN_MAIN, false);
+                ret = run_item(root->submenus[home_sel], &stay);
+                if (!stay) return ret;
+                viewportmanager_theme_enable(SCREEN_MAIN, false, NULL);
+                lcd_setfont(FONT_UI);
+                break;
+            }
+            case ACTION_STD_CANCEL:
+            case ACTION_STD_MENU:
+                if (audio_status())
+                {
+                    viewportmanager_theme_undo(SCREEN_MAIN, false);
+                    return GO_TO_WPS;
+                }
+                break;
+            default:
+                if (default_event_handler(action) == SYS_USB_CONNECTED)
+                {
+                    viewportmanager_theme_undo(SCREEN_MAIN, false);
+                    return MENU_ATTACHED_USB;
+                }
+                break;
+        }
+    }
+}
