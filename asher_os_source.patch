+}
+
+/* while waiting on work we can't measure: creep toward 'cap' */
+static void ej_creep(int cap)
+{
+    if (!ej_on || ej_pct >= cap) return;
+    ej_pct += MAX(1, (cap - ej_pct) / 12);
+    ej_bar();
+}
+
+/* a step of the work is done: glide the bar up to 'target' */
+static void ej_to(int target)
+{
+    if (!ej_on) return;
+    while (ej_pct < target)
+    {
+        ej_pct += MAX(8, (target - ej_pct) / 4);
+        if (ej_pct > target) ej_pct = target;
+        ej_bar();
+        sleep(HZ / 50);
+    }
+}
