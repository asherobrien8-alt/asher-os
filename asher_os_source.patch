diff --git a/apps/asher/asher_check.h b/apps/asher/asher_check.h
new file mode 100644
index 0000000000..7aed25e428
--- /dev/null
+++ b/apps/asher/asher_check.h
@@ -0,0 +1,27 @@
+#ifndef ASHER_CHECK_H
+#define ASHER_CHECK_H
+/* Asher OS: menu choices that show a checkmark next to the one that's set.
+ * The name gets a "\x01" on the end, which the list drawing turns into a
+ * tick at the right edge of the row (apps/gui/bitmap/list.c). */
+#include <stdio.h>
+#include <stdint.h>
+#include "menu.h"
+
+struct asher_chk { const char *label; int (*get)(void); int val; };
+
+static inline char *asher_chk_text(int sel, void *data, char *buf, size_t n)
+{
+    (void)sel;
+    const struct asher_chk *c = data;
+    snprintf(buf, n, "%s%s", c->label, c->get() == c->val ? "\x01" : "");
+    return buf;
+}
+
+/* a choice: runs func(param) when clicked, ticked while get() == val */
+#define ASHER_CHOICE(name, label, func, param, getter, value)                \
+    static const struct asher_chk name##_chk = { label, getter, value };     \
+    MENUITEM_FUNCTION_DYNTEXT_W_PARAM(name,                                  \
+        MENU_EXITAFTERTHISMENU | MENU_FUNC_USEPARAM, func,                   \
+        (void *)(intptr_t)(param), asher_chk_text, NULL,             \
+        (void *)&name##_chk, NULL, Icon_NOICON)
+#endif
diff --git a/apps/asher/asher_font3d.c b/apps/asher/asher_font3d.c
new file mode 100644
index 0000000000..06c63876a7
--- /dev/null
+++ b/apps/asher/asher_font3d.c
@@ -0,0 +1,306 @@
+/* Asher OS 2.5: the 3D retro lettering and the pop-up messages.
+ *
+ * Letters (from Oswald, SIL Open Font License) come pre-drawn in
+ * /.rockbox/asher/ui/f3d_big.atf and f3d_small.atf as three 8-bit planes:
+ * a black outline, a teal 3D side and the face, which is drawn in the text
+ * colour. They're drawn straight onto the screen, like the other text.
+ *
+ * Pop-ups ("Added to Queue" and every other message) are a small box in the
+ * middle of the screen. On Asher OS screens they don't hold anything up:
+ * the box stays on top while you keep scrolling, and goes away by itself
+ * after a moment. On Rockbox's own lists (inside Settings) it shows for at
+ * most 3/4 of a second, since those can't draw it again themselves. */
+#include <stdio.h>
+#include <string.h>
+#include "config.h"
+#include "system.h"
+#include "kernel.h"
+#include "file.h"
+#include "lcd.h"
+#include "asher_ui.h"
+#include "asher_font3d.h"
+
+#define UI_DIR "/.rockbox/asher/ui/"
+
+struct atf {
+    int h, first, count, aw;
+    unsigned short ox[96];
+    unsigned char w[96], adv[96];
+    const unsigned char *pl[3];
+    bool ok;
+};
+static struct atf f3[3];
+static unsigned char f3_big[32 * 1300 * 3];
+static unsigned char f3_small[20 * 900 * 3];
+static unsigned char f3_tiny[16 * 760 * 3];
+
+static bool load_atf(struct atf *f, const char *name, unsigned char *buf, size_t cap)
+{
+    char path[64];
+    unsigned char hd[8];
+    snprintf(path, sizeof(path), UI_DIR "%s", name);
+    int fd = open(path, O_RDONLY);
+    if (fd < 0) return false;
+    bool ok = false;
+    if (read(fd, hd, 8) == 8 && !memcmp(hd, "ATF1", 4) && hd[6] <= 96)
+    {
+        f->h = hd[4]; f->first = hd[5]; f->count = hd[6];
+        unsigned char m[4];
+        ok = true;
+        for (int i = 0; i < f->count && ok; i++)
+        {
+            if (read(fd, m, 4) != 4) { ok = false; break; }
+            f->ox[i] = m[0] | m[1] << 8; f->w[i] = m[2]; f->adv[i] = m[3];
+        }
+        unsigned char aw[2];
+        if (ok && read(fd, aw, 2) == 2)
+        {
+            f->aw = aw[0] | aw[1] << 8;
+            size_t plane = (size_t)f->aw * f->h;
+            if (plane * 3 <= cap && read(fd, buf, plane * 3) == (ssize_t)(plane * 3))
+            {
+                for (int i = 0; i < 3; i++) f->pl[i] = buf + plane * i;
+            }
+            else ok = false;
+        }
+        else ok = false;
+    }
+    close(fd);
+    f->ok = ok;
+    return ok;
+}
+
+void f3d_init(void)
+{
+    if (!f3[0].ok) load_atf(&f3[0], "f3d_big.atf", f3_big, sizeof(f3_big));
+    if (!f3[1].ok) load_atf(&f3[1], "f3d_small.atf", f3_small, sizeof(f3_small));
+    if (!f3[2].ok) load_atf(&f3[2], "f3d_tiny.atf", f3_tiny, sizeof(f3_tiny));
+}
+
+bool f3d_ok(int which) { return which >= 0 && which < 3 && f3[which].ok; }
+int f3d_h(int which) { return f3d_ok(which) ? f3[which].h : 0; }
+
+static int glyph(const struct atf *f, unsigned char c)
+{
+    int i = (int)c - f->first;
+    if (i < 0 || i >= f->count) i = '?' - f->first;
+    return i;
+}
+
+int f3d_text_w(int which, const char *s)
+{
+    if (!f3d_ok(which) || !s) return 0;
+    const struct atf *f = &f3[which];
+    int w = 0, last_extra = 0;
+    for (; *s; s++)
+    {
+        unsigned char c = *s;
+        if ((c & 0xc0) == 0x80) continue;     /* UTF-8 continuation */
+        int g = glyph(f, c >= 0x80 ? '?' : c);
+        w += f->adv[g];
+        last_extra = f->w[g] - f->adv[g];
+    }
+    return w + (last_extra > 0 ? last_extra : 0);
+}
+
+static inline fb_data mix(fb_data d, unsigned r, unsigned g, unsigned b, unsigned a)
+{
+    /* a: 0..255 */
+    unsigned dr = RGB_UNPACK_RED(d), dg = RGB_UNPACK_GREEN(d), db = RGB_UNPACK_BLUE(d);
+    dr = (dr * (255 - a) + r * a) / 255;
+    dg = (dg * (255 - a) + g * a) / 255;
+    db = (db * (255 - a) + b * a) / 255;
+    return FB_RGBPACK(dr, dg, db);
+}
+
+void f3d_draw(int which, int x, int y, unsigned rgb, const char *s)
+{
+    if (!f3d_ok(which) || !s) return;
+    const struct atf *f = &f3[which];
+    /* F3D_PLAIN in the colour: just the letters (on a coloured tag) */
+    bool plain = (rgb & F3D_PLAIN) != 0;
+    unsigned fr = (rgb >> 16) & 255, fg = (rgb >> 8) & 255, fb = rgb & 255;
+    /* dark letters get a light outline, light ones a black one */
+    bool dark = fr * 3 + fg * 6 + fb < 1100;
+    const unsigned col[3][3] = {
+        { dark ? 255 : 0, dark ? 250 : 0, dark ? 240 : 0 },    /* outline */
+        { 26, 166, 160 },                               /* teal side */
+        { (rgb >> 16) & 255, (rgb >> 8) & 255, rgb & 255 },   /* face */
+    };
+    for (; *s; s++)
+    {
+        unsigned char c = *s;
+        if ((c & 0xc0) == 0x80) continue;
+        int g = glyph(f, c >= 0x80 ? '?' : c);
+        int gw = f->w[g];
+        for (int p = plain ? 2 : 0; p < 3; p++)
+        {
+            const unsigned char *pl = f->pl[p] + f->ox[g];
+            for (int j = 0; j < f->h; j++)
+            {
+                int yy = y + j;
+                if (yy < 0 || yy >= LCD_HEIGHT) continue;
+                const unsigned char *a = pl + (size_t)j * f->aw;
+                fb_data *d = FBADDR(0, yy);
+                for (int i = 0; i < gw; i++)
+                {
+                    int xx = x + i;
+                    if (!a[i] || xx < 0 || xx >= LCD_WIDTH) continue;
+                    d[xx] = a[i] >= 250 ? FB_RGBPACK(col[p][0], col[p][1], col[p][2])
+                                        : mix(d[xx], col[p][0], col[p][1], col[p][2], a[i]);
+                }
+            }
+        }
+        x += f->adv[g];
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* pop-ups                                                             */
+/* ------------------------------------------------------------------ */
+#define TMAXL 4
+static char t_text[200];
+static char t_line[TMAXL][64];
+static int t_lines, t_x, t_y, t_w, t_h;
+static long t_until;
+static bool t_up;
+int aui_depth;                         /* > 0 while an Asher OS screen runs */
+
+static void t_layout(void)
+{
+    const int maxw = LCD_WIDTH - 60;
+    t_lines = 0;
+    const char *p = t_text;
+    while (*p && t_lines < TMAXL)
+    {
+        /* one source line (up to \n), word-wrapped */
+        char src[200];
+        size_t n = strcspn(p, "\n");
+        if (n >= sizeof(src)) n = sizeof(src) - 1;
+        memcpy(src, p, n); src[n] = 0;
+        p += n; if (*p == '\n') p++;
+        char *w = src;
+        while (*w == ' ') w++;
+        if (!*w) continue;
+        char cur[64] = "";
+        while (*w && t_lines < TMAXL)
+        {
+            char word[64];
+            size_t wl = strcspn(w, " ");
+            if (wl >= sizeof(word)) wl = sizeof(word) - 1;
+            memcpy(word, w, wl); word[wl] = 0;
+            w += wl; while (*w == ' ') w++;
+            char test[130];
+            snprintf(test, sizeof(test), cur[0] ? "%s %s" : "%s%s", cur, word);
+            if (cur[0] && f3d_text_w(F3D_BIG, test) > maxw)
+            {
+                strlcpy(t_line[t_lines++], cur, sizeof(t_line[0]));
+                strlcpy(cur, word, sizeof(cur));
+            }
+            else
+                strlcpy(cur, test, sizeof(cur));
+        }
+        if (cur[0] && t_lines < TMAXL) strlcpy(t_line[t_lines++], cur, sizeof(t_line[0]));
+    }
+    int lh = f3d_h(F3D_BIG) - 4, wmax = 0;
+    for (int i = 0; i < t_lines; i++)
+    {
+        int lw = f3d_text_w(F3D_BIG, t_line[i]);
+        if (lw > wmax) wmax = lw;
+    }
+    t_w = MIN(LCD_WIDTH - 24, wmax + 28);
+    t_h = t_lines * lh + 18;
+    t_x = (LCD_WIDTH - t_w) / 2;
+    t_y = (LCD_HEIGHT - t_h) / 2;
+}
+
+static void t_draw(void)
+{
+    struct viewport *old = lcd_set_viewport(NULL);
+    unsigned old_fg = lcd_get_foreground();
+    int x = t_x, y = t_y, w = t_w, h = t_h, r = 9;
+    /* rounded box: dark plum with a cream edge */
+    lcd_set_drawmode(DRMODE_SOLID);
+    for (int j = 0; j < h; j++)
+    {
+        int inset = 0;
+        if (j < r || j >= h - r)
+        {
+            int dy = j < r ? r - j : j - (h - r - 1);
+            int dx = 0;
+            while (dx * dx + dy * dy <= r * r) dx++;
+            inset = r - dx + 1;
+            if (inset < 0) inset = 0;
+        }
+        bool edge = j == 0 || j == h - 1 || j == 1 || j == h - 2;
+        lcd_set_foreground(edge ? LCD_RGBPACK(243, 238, 220) : LCD_RGBPACK(34, 26, 54));
+        lcd_hline(x + inset, x + w - 1 - inset, y + j);
+        if (!edge)
+        {
+            lcd_set_foreground(LCD_RGBPACK(243, 238, 220));
+            lcd_hline(x + inset, x + inset + 1, y + j);
+            lcd_hline(x + w - 2 - inset, x + w - 1 - inset, y + j);
+        }
+    }
+    int lh = f3d_h(F3D_BIG) - 4;
+    int ty = y + 9 - 2;
+    for (int i = 0; i < t_lines; i++, ty += lh)
+    {
+        int lw = f3d_text_w(F3D_BIG, t_line[i]);
+        f3d_draw(F3D_BIG, x + (w - lw) / 2, ty, 0xf3eedc, t_line[i]);
+    }
+    lcd_set_foreground(old_fg);
+    lcd_set_viewport(old);
+}
+
+bool asher_toast(const char *text, int ticks, bool rockbox_screen)
+{
+    if (!f3d_ok(F3D_BIG) || !text || !text[0]) return false;
+    strlcpy(t_text, text, sizeof(t_text));
+    t_layout();
+    if (t_lines == 0) return true;
+    /* short: about a second, a little longer for long messages */
+    int len = strlen(t_text);
+    long dur = HZ * 7 / 10 + (long)len * HZ / 40;
+    if (dur > HZ * 5 / 2) dur = HZ * 5 / 2;
+    if (ticks > 0 && ticks < dur) dur = MAX(ticks, HZ * 7 / 10);
+    t_until = current_tick + dur;
+    t_draw();
+    lcd_update_rect(t_x, t_y, t_w, t_h);
+    if (!rockbox_screen && aui_depth > 0)
+    {
+        t_up = true;              /* stays on top of the screen's redraws */
+        return true;
+    }
+    /* a Rockbox screen: show it for a moment */
+    t_up = false;
+    if (ticks > 0) sleep(MIN(dur, HZ * 3 / 4));
+    return true;
+}
+
+/* called by aui_update(): keep the pop-up on top while it lasts */
+void asher_toast_overlay(void)
+{
+    if (!t_up) return;
+    if (TIME_BEFORE(current_tick, t_until)) t_draw();
+    else t_up = false;
+}
+
+/* true once, when a pop-up has run out and the screen should redraw */
+bool asher_toast_expired(void)
+{
+    static bool was_up;
+    if (t_up && !TIME_BEFORE(current_tick, t_until)) t_up = false;
+    bool r = was_up && !t_up;
+    was_up = t_up;
+    return r;
+}
+
+/* how long a screen may wait for a button before the pop-up needs clearing */
+int asher_toast_tmo(int tmo)
+{
+    if (!t_up) return tmo;
+    long left = t_until - current_tick + 1;
+    if (left < 1) left = 1;
+    return left < tmo ? (int)left : tmo;
+}
diff --git a/apps/asher/asher_font3d.h b/apps/asher/asher_font3d.h
new file mode 100644
index 0000000000..541fe549c4
--- /dev/null
+++ b/apps/asher/asher_font3d.h
@@ -0,0 +1,19 @@
+#ifndef ASHER_FONT3D_H
+#define ASHER_FONT3D_H
+#include <stdbool.h>
+/* the 3D retro lettering (see asher_font3d.c) */
+enum { F3D_BIG, F3D_SMALL, F3D_TINY };
+#define F3D_PLAIN 0x01000000   /* or into the colour: no outline or side */
+void f3d_init(void);
+bool f3d_ok(int which);
+int  f3d_h(int which);
+int  f3d_text_w(int which, const char *s);
+void f3d_draw(int which, int x, int y, unsigned rgb, const char *s);
+
+/* pop-up messages: true if shown (false: use the old splash) */
+bool asher_toast(const char *text, int ticks, bool rockbox_screen);
+void asher_toast_overlay(void);
+bool asher_toast_expired(void);
+int  asher_toast_tmo(int tmo);
+extern int aui_depth;
+#endif
diff --git a/apps/asher/asher_home.c b/apps/asher/asher_home.c
new file mode 100644
index 0000000000..2707cfcb0b
--- /dev/null
+++ b/apps/asher/asher_home.c
@@ -0,0 +1,307 @@
+/* Asher OS home screen.
+ *  Bubbles / Dark: four glossy bubbles in an even 2x2 grid over the live
+ *  wallpaper. Turning right moves right, then wraps down to the first box
+ *  on the left; turning left moves left, then up to the box on the right.
+ *  Classic: white and blue list with a preview pane, like the iPod. */
+#include <stdio.h>
+#include <string.h>
+#include "config.h"
+#include "system.h"
+#include "kernel.h"
+#include "action.h"
+#include "audio.h"
+#include "misc.h"
+#include "menu.h"
+#include "timefuncs.h"
+#include "root_menu.h"
+#include "asher_ui.h"
+#include "asher_prefs.h"
+#include "asher_home.h"
+#include "asher_theme.h"
+#include "asher_wallpaper.h"
+#include "asher_stats.h"
+#include "asher_music.h"
+#include "asher_media.h"
+#include "asher_quick.h"
+#include "button.h"
+
+/* home screen buttons: the wheel and centre pick an item, Menu opens Now
+ * Playing, and << >> play/pause control the music like on Now Playing */
+#ifdef BUTTON_SCROLL_FWD
+static const struct button_mapping home_map[] = {
+    { ACTION_STD_NEXT,       BUTTON_SCROLL_FWD,                BUTTON_NONE },
+    { ACTION_STD_NEXTREPEAT, BUTTON_SCROLL_FWD|BUTTON_REPEAT,  BUTTON_NONE },
+    { ACTION_STD_PREV,       BUTTON_SCROLL_BACK,               BUTTON_NONE },
+    { ACTION_STD_PREVREPEAT, BUTTON_SCROLL_BACK|BUTTON_REPEAT, BUTTON_NONE },
+    { ACTION_STD_OK,         BUTTON_SELECT|BUTTON_REL,         BUTTON_SELECT },
+    { ACTION_STD_MENU,       BUTTON_MENU|BUTTON_REL,           BUTTON_MENU },
+    { ACTION_STD_QUICKSCREEN, BUTTON_MENU|BUTTON_REPEAT,       BUTTON_MENU },
+    { ACTION_WPS_PLAY,       BUTTON_PLAY|BUTTON_REL,           BUTTON_PLAY },
+    { ACTION_WPS_SKIPPREV,   BUTTON_LEFT|BUTTON_REL,           BUTTON_LEFT },
+    { ACTION_WPS_SEEKBACK,   BUTTON_LEFT|BUTTON_REPEAT,        BUTTON_NONE },
+    { ACTION_WPS_STOPSEEK,   BUTTON_LEFT|BUTTON_REL,           BUTTON_LEFT|BUTTON_REPEAT },
+    { ACTION_WPS_SKIPNEXT,   BUTTON_RIGHT|BUTTON_REL,          BUTTON_RIGHT },
+    { ACTION_WPS_SEEKFWD,    BUTTON_RIGHT|BUTTON_REPEAT,       BUTTON_NONE },
+    { ACTION_WPS_STOPSEEK,   BUTTON_RIGHT|BUTTON_REL,          BUTTON_RIGHT|BUTTON_REPEAT },
+    LAST_ITEM_IN_LIST
+};
+static const struct button_mapping *home_ctx(int c) { (void)c; return home_map; }
+static int home_action(int timeout) { return get_custom_action(CONTEXT_PLUGIN | 2, timeout, home_ctx); }
+#else
+static int home_action(int timeout) { return get_action(CONTEXT_MAINMENU, timeout); }
+#endif
+
+#define NITEMS 4
+static const char *names[NITEMS] = { "Music", "Settings", "Stats", "Now Playing" };
+static int home_sel = 0;
+
+static void draw_bubbles(int sel)
+{
+    aui_background(true);
+    aui_topbar();
+    for (int i = 0; i < NITEMS; i++)
+    {
+        int col = i % 2, row = i / 2;
+        int cx = col ? 234 : 86;
+        int top = AUI_BAR + row * ((AUI_H - AUI_BAR) / 2);
+        int cy = top + 46;
+        bool s = (i == sel);
+        if (!aui_sprite_c(s ? SPR_MUSIC_S + i : SPR_MUSIC + i, cx, cy))
+            aui_round(cx - 34, cy - 34, 68, 68, 34, 0x7b5cff, 0x2f8cff);
+        aui_sprite_ca(SPR_LBL_MUSIC + i, cx, top + 93, s ? 256 : 190);
+    }
+    aui_present();
+    if (!aui_sprite_w(SPR_MUSIC))
+    {
+        /* the picture files aren't on the iPod: say so instead of guessing */
+        aui_text(AF_SMALL, AUI_W / 2, AUI_H / 2 - 16, 0xffffff, "Asher OS picture files are missing", AUI_W - 10, 1);
+        aui_text(AF_SMALLR, AUI_W / 2, AUI_H / 2 + 2, 0xffffff, "Unzip asher_os_assets.zip onto the iPod", AUI_W - 10, 1);
+    }
+    aui_topbar_text("");
+    aui_update();
+}
+
+static void draw_list(int sel)
+{
+    const struct aui_theme *t = aui_theme();
+    int rh = 40, y0 = AUI_BAR + 4, pane = 190;
+
+    aui_background(true);
+    if (t->light)
+    {
+        aui_vgrad(pane, AUI_BAR, AUI_W - pane, AUI_H - AUI_BAR, 0xf4f5f8, 0xdfe2e8);
+        aui_fill(pane, AUI_BAR, 1, AUI_H - AUI_BAR, 0xc5c9d2);
+    }
+    else
+    {
+        aui_shade(0, AUI_BAR, pane, AUI_H - AUI_BAR, 0, 70, t->bg_bot);
+        aui_fill(pane, AUI_BAR, 1, AUI_H - AUI_BAR, 0x3a3c46);
+    }
+    aui_topbar();
+    for (int i = 0; i < NITEMS; i++)
+    {
+        int y = y0 + i * rh;
+        if (i == sel) aui_vgrad(0, y, pane, rh, t->sel1, t->sel2);
+        unsigned c = i == sel ? 0xffffff : (t->light ? 0x9aa0ab : 0x80869c);
+        for (int k = 0; k < 5; k++)
+        {
+            aui_fill(pane - 22 + k, y + rh / 2 - 5 + k, 2, 1, c);
+            aui_fill(pane - 22 + k, y + rh / 2 + 5 - k, 2, 1, c);
+        }
+    }
+    int cx = pane + (AUI_W - pane) / 2;
+    aui_sprite_c(SPR_MUSIC_S + sel, cx, 112);
+    aui_sprite_c(SPR_LBL_MUSIC + sel, cx, 168);
+    aui_present();
+    for (int i = 0; i < NITEMS; i++)
+    {
+        int y = y0 + i * rh, fh = aui_font_h(AF_BIG);
+        aui_text(AF_BIG, 12, y + (rh - fh) / 2,
+                 i == sel ? 0xffffff : t->text, names[i], pane - 40, 0);
+    }
+    aui_topbar_text("Asher OS");
+    aui_update();
+}
+
+/* drawn icon, used if the icon pictures aren't on the iPod */
+static void modern_icon(int i, int cx, int cy, unsigned col)
+{
+    unsigned top = ((((col >> 16) & 255) * 5 / 4 > 255 ? 255 : ((col >> 16) & 255) * 5 / 4) << 16)
+                 | ((((col >> 8) & 255) * 5 / 4 > 255 ? 255 : ((col >> 8) & 255) * 5 / 4) << 8)
+                 | ((col & 255) * 5 / 4 > 255 ? 255 : (col & 255) * 5 / 4);
+    const unsigned W = 0xffffff;
+    aui_round(cx - 30, cy - 30, 60, 60, 15, top, col);
+    switch (i)
+    {
+        case 0:   /* two notes */
+            aui_round(cx - 15, cy + 6, 12, 9, 4, W, W);
+            aui_round(cx + 3, cy + 2, 12, 9, 4, W, W);
+            aui_fill(cx - 6, cy - 14, 3, 24, W);
+            aui_fill(cx + 12, cy - 18, 3, 24, W);
+            aui_fill(cx - 6, cy - 18, 21, 5, W);
+            break;
+        case 1:   /* gear */
+            for (int a = 0; a < 8; a++)
+            {
+                static const signed char d[8][2] = { {0,-17},{12,-12},{17,0},{12,12},
+                                                     {0,17},{-12,12},{-17,0},{-12,-12} };
+                aui_round(cx + d[a][0] - 4, cy + d[a][1] - 4, 9, 9, 2, W, W);
+            }
+            aui_round(cx - 15, cy - 15, 30, 30, 15, W, W);
+            aui_round(cx - 6, cy - 6, 12, 12, 6, col, col);
+            break;
+        case 2:   /* rising bars */
+            aui_round(cx - 14, cy + 2, 7, 13, 3, W, W);
+            aui_round(cx - 3, cy - 6, 7, 21, 3, W, W);
+            aui_round(cx + 8, cy - 14, 7, 29, 3, W, W);
+            break;
+        default:  /* play */
+            for (int y = -14; y <= 14; y++)
+            {
+                int w = (14 - (y < 0 ? -y : y)) * 24 / 14;
+                aui_fill(cx - 9, cy + y, w + 1, 1, W);
+            }
+            break;
+    }
+}
+
+/* Modern: the same 2 x 2 layout as Bubbles, with app icons on the chosen
+ * wallpaper (or a soft colour blend when there's none) */
+static void draw_modern(int sel)
+{
+    asher_wp_prepare();
+    const fb_data *f = asher_wp_full();
+    if (f) memcpy(aui_fb, f, sizeof(fb_data) * AUI_W * AUI_H);
+    else
+    {
+        const fb_data *bg = aui_modern_wallpaper();
+        if (bg) memcpy(aui_fb, bg, sizeof(fb_data) * AUI_W * AUI_H);
+        else aui_vgrad(0, 0, AUI_W, AUI_H, 0x7aa8ff, 0xc89cff);
+    }
+    aui_topbar();
+    static const unsigned fallback[NITEMS] = { 0xfa2346, 0x8e8e93, 0x0a84ff, 0xe5e5ea };
+    for (int i = 0; i < NITEMS; i++)
+    {
+        int cx = (i % 2) ? 234 : 86;
+        int top = AUI_BAR + (i / 2) * ((AUI_H - AUI_BAR) / 2);
+        int cy = top + 46;
+        bool s = i == sel;
+        if (s)          /* a soft frosted tile behind the chosen app */
+            aui_shade(cx - 50, top + 4, 100, 102, 22, 160, 0xffffff);
+        if (!aui_sprite_c((s ? SPR_M_MUSIC_S : SPR_M_MUSIC) + i, cx, cy)
+            && !aui_sprite_c(SPR_M_MUSIC + i, cx, cy))
+            modern_icon(i, cx, cy, fallback[i]);
+    }
+    aui_present();
+    for (int i = 0; i < NITEMS; i++)
+    {
+        int cx = (i % 2) ? 234 : 86;
+        int top = AUI_BAR + (i / 2) * ((AUI_H - AUI_BAR) / 2);
+        bool s = i == sel;
+        const char *nm = i == 2 ? "Info" : names[i];       /* Modern calls Stats "Info" */
+        aui_text(AF_SMALL, cx + 1, top + 87, 0x202028, nm, 110, 1);   /* shadow */
+        aui_text(AF_SMALL, cx, top + 86, s ? 0xffffff : 0xeeeef4, nm, 110, 1);
+    }
+    if (aui_assets_old)
+    {
+        aui_text(AF_SMALL, AUI_W / 2, AUI_H - 30, 0xff3b30, "Picture files are out of date", AUI_W - 10, 1);
+        aui_text(AF_SMALLR, AUI_W / 2, AUI_H - 15, 0xffffff, "Copy the whole .rockbox folder from the zip", AUI_W - 10, 1);
+    }
+    aui_topbar_text("");
+    aui_update();
+}
+
+static void draw(int sel)
+{
+    if (asher_layout == 3) draw_modern(sel);
+    else if (asher_layout == 1) draw_list(sel);
+    else if (asher_layout == 2) draw_list(sel);
+    else draw_bubbles(sel);
+}
+
+/* run the chosen item: 0 = stay on the home screen */
+static int open_item(int i)
+{
+    switch (i)
+    {
+        case 0: return asher_music();
+        case 1: return GO_TO_MAINMENU;
+        case 2: asher_wheel_zone(WZ_OTHER); asher_stats_screen(); return 0;
+        case 3: return GO_TO_WPS;
+    }
+    return 0;
+}
+
+int asher_home(const struct menu_item_ex *root, int *selected)
+{
+    int frame = -1, minute = -1;
+    bool redraw = true;
+    struct amedia media = { 0 };
+    (void)root; (void)selected;
+
+    aui_begin();
+#ifdef SIMULATOR
+    {   /* test hook: ASHER_SS=1 opens Scroll Speed straight away */
+        extern char *getenv(const char *);
+        static bool once;
+        int asher_scroll_speed_screen(void);
+        if (!once && getenv("ASHER_SS")) { once = true; aui_end(); asher_scroll_speed_screen(); aui_begin(); }
+    }
+#endif
+    while (1)
+    {
+        asher_wheel_zone(WZ_MAIN);
+        bool anim = asher_wp_animated() && (aui_theme()->wallpaper || aui_theme()->modern);
+        if (aui_woke()) redraw = true;
+        if (aui_screen_on())
+        {
+            int f = asher_wp_frame_no(), m = get_time()->tm_min;
+            if (redraw || (anim && f != frame) || m != minute)
+            {
+                draw(home_sel);
+                frame = f; minute = m;
+                redraw = false;
+            }
+        }
+        int action = home_action(!aui_screen_on() ? 2 * HZ : (anim ? asher_wp_frame_ticks() : HZ));
+        if (asher_media(&media, action)) continue;
+        switch (action)
+        {
+            case ACTION_STD_NEXT:
+            case ACTION_STD_NEXTREPEAT:
+                home_sel = (home_sel + 1) % NITEMS;
+                redraw = true;
+                break;
+            case ACTION_STD_PREV:
+            case ACTION_STD_PREVREPEAT:
+                home_sel = (home_sel + NITEMS - 1) % NITEMS;
+                redraw = true;
+                break;
+            case ACTION_STD_OK:
+            {
+                int ret;
+                aui_end();
+                ret = open_item(home_sel);
+                if (ret != 0) return ret;
+                aui_begin();
+                redraw = true;
+                break;
+            }
+            case ACTION_STD_QUICKSCREEN:          /* hold Menu: shuffle / repeat */
+                asher_shuffle_menu();
+                redraw = true;
+                break;
+            case ACTION_STD_CANCEL:
+            case ACTION_STD_MENU:
+                if (audio_status()) { aui_end(); return GO_TO_WPS; }
+                break;
+            case ACTION_NONE:
+                break;
+            default:
+                if (default_event_handler(action) == SYS_USB_CONNECTED)
+                    { aui_end(); return MENU_ATTACHED_USB; }
+                redraw = true;
+                break;
+        }
+    }
+}
