diff --git a/apps/asher/asher_wallpaper.c b/apps/asher/asher_wallpaper.c
new file mode 100644
index 0000000..f99d0ba
--- /dev/null
+++ b/apps/asher/asher_wallpaper.c
@@ -0,0 +1,82 @@
+#include <stdio.h>
+#include <string.h>
+#include <fcntl.h>
+#include "config.h"
+#include "system.h"
+#include "kernel.h"
+#include "file.h"
+#include "timefuncs.h"
+#include "lcd.h"
+#include "string-extra.h"
+#include "asher_wallpaper.h"
+#include "moonphase.h"
+
+#define AWP_DIR "/.rockbox/asher/wallpaper/"
+#define AWP_HDR 12
+
+extern void skin_backdrop_animate(const void *frame, size_t bytes);
+
+bool asher_wallpaper_enabled = true;
+
+static int fd = -1;
+static int nframes, frame_ms, cur;
+static long next_tick;
+static char scene[32];
+/* Frame buffer; the iPod Classic has 64 MB so a static 150 KB is fine. */
+static fb_data frame_buf[LCD_WIDTH * LCD_HEIGHT];
+
+void asher_wallpaper_stop(void)
+{
+    if (fd >= 0) { close(fd); fd = -1; }
+    scene[0] = '\0';
+}
+
+void asher_wallpaper_set_scene(const char *name)
+{
+    char path[MAX_PATH];
+    unsigned char h[AWP_HDR];
+    if (!strcmp(name, scene) && fd >= 0) return;   /* already playing */
+    asher_wallpaper_stop();
+    snprintf(path, sizeof(path), AWP_DIR "%s.awp", name);
+    fd = open(path, O_RDONLY);
+    if (fd < 0) return;
+    if (read(fd, h, AWP_HDR) != AWP_HDR || memcmp(h, "AWP1", 4)
+        || (h[4] | h[5] << 8) != LCD_WIDTH || (h[6] | h[7] << 8) != LCD_HEIGHT)
+    { close(fd); fd = -1; return; }
+    nframes  = h[8] | h[9] << 8;
+    frame_ms = h[10] | h[11] << 8;
+    if (nframes < 1) { close(fd); fd = -1; return; }
+    strmemccpy(scene, name, sizeof(scene));
+    cur = 0;
+    next_tick = current_tick;
+}
+
+bool asher_wallpaper_auto = false;   /* follow time of day */
+static long next_check;
+
+const char *asher_scene_for_time(void)
+{
+    struct tm *t = get_time();
+    int h = t->tm_hour;
+    if (h >= 5 && h < 12)  return "morning";   /* 5 AM - 11:59 AM */
+    if (h >= 12 && h < 19) return "midday";    /* 12 PM - 6:59 PM */
+    return "night";                            /* 7 PM - 4:59 AM */
+}
+
+bool asher_wallpaper_tick(void)
+{
+    if (asher_wallpaper_auto && !TIME_BEFORE(current_tick, next_check))
+    {
+        next_check = current_tick + 30 * HZ;
+        asher_wallpaper_set_scene(asher_scene_for_time());
+    }
+    if (!asher_wallpaper_enabled || fd < 0 || TIME_BEFORE(current_tick, next_tick))
+        return false;
+    next_tick = current_tick + (frame_ms * HZ) / 1000;
+    if (lseek(fd, AWP_HDR + (off_t)cur * sizeof(frame_buf), SEEK_SET) < 0 ||
+        read(fd, frame_buf, sizeof(frame_buf)) != (ssize_t)sizeof(frame_buf))
+        { cur = 0; return false; }
+    cur = (cur + 1) % nframes;
+    skin_backdrop_animate(frame_buf, sizeof(frame_buf));
+    return true;
+}
