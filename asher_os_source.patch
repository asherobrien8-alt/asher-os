diff --git a/apps/asher/asher_mem.c b/apps/asher/asher_mem.c
new file mode 100644
index 0000000000..e8c45e0799
--- /dev/null
+++ b/apps/asher/asher_mem.c
@@ -0,0 +1,90 @@
+/* Asher OS memory reserve.
+ *
+ * Rockbox gives all spare memory to the music buffer. When something asks
+ * for memory while a song plays, the music buffer has to shrink, and
+ * shrinking it stops and restarts playback: a short pause in the music.
+ *
+ * So Asher OS sets memory aside at start-up (before any music plays) and
+ * hands it out from there: the reserve is let go just before an
+ * allocation, and taken back again, as large as it can be without
+ * touching the music buffer, right after. Freed memory goes back into the
+ * reserve the same way. */
+#include <string.h>
+#include "config.h"
+#include "system.h"
+#include "core_alloc.h"
+#include "asher_mem.h"
+
+static int res_h = -1;
+static size_t res_sz;            /* size of the reserve right now */
+static size_t res_want;          /* how big the reserve should be */
+
+#define MAXH 24
+static struct { int h; size_t sz; } held[MAXH];
+
+static void res_drop(void)
+{
+    if (res_h > 0) core_free(res_h);
+    res_h = -1;
+    res_sz = 0;
+}
+
+static void res_take(void)
+{
+    size_t used = 0;
+    for (int i = 0; i < MAXH; i++) if (held[i].h > 0) used += held[i].sz;
+    size_t want = res_want > used ? res_want - used : 0;
+    size_t can = core_allocatable();          /* without shrinking music */
+    if (can > 64 * 1024) can -= 64 * 1024;    /* leave a little slack */
+    else can = 0;
+    if (want > can) want = can;
+    if (want >= 32 * 1024)
+    {
+        res_h = core_alloc(want);
+        res_sz = res_h > 0 ? want : 0;
+        if (res_h <= 0) res_h = -1;
+    }
+}
+
+void asher_mem_init(size_t pool)
+{
+    if (res_want) return;
+    res_want = pool;
+    res_h = core_alloc(pool);                 /* at start-up: nothing playing yet */
+    res_sz = pool;
+    if (res_h <= 0) { res_h = -1; res_sz = 0; res_take(); }
+}
+
+int asher_alloc(size_t size)
+{
+    res_drop();
+    int h = core_alloc(size);
+    if (h > 0)
+    {
+        for (int i = 0; i < MAXH; i++)
+            if (held[i].h <= 0) { held[i].h = h; held[i].sz = size; break; }
+    }
+    res_take();
+    return h;
+}
+
+/* let Rockbox itself use the reserve for a moment (theme skins and fonts
+ * load through it), then take what's left back */
+void asher_mem_lend(void) { res_drop(); }
+void asher_mem_back(void) { if (res_h <= 0) res_take(); }
+
+/* how much can be handed out without touching the music buffer */
+size_t asher_mem_avail(void)
+{
+    return res_sz + core_allocatable();
+}
+
+void asher_free(int handle)
+{
+    if (handle <= 0) return;
+    for (int i = 0; i < MAXH; i++)
+        if (held[i].h == handle) { held[i].h = 0; held[i].sz = 0; break; }
+    core_free(handle);
+    res_drop();
+    res_take();
+}
diff --git a/apps/asher/asher_mem.h b/apps/asher/asher_mem.h
new file mode 100644
index 0000000000..303fd28d90
--- /dev/null
+++ b/apps/asher/asher_mem.h
@@ -0,0 +1,12 @@
+#ifndef ASHER_MEM_H
+#define ASHER_MEM_H
+#include <stddef.h>
+/* memory set aside so screens never make the music buffer shrink (which
+ * pauses the music); see asher_mem.c */
+void asher_mem_init(size_t pool);
+int  asher_alloc(size_t size);       /* like core_alloc */
+void asher_free(int handle);         /* like core_free */
+size_t asher_mem_avail(void);
+void asher_mem_lend(void);           /* around Rockbox loading skins/fonts */
+void asher_mem_back(void);        /* free without pausing the music */
+#endif
diff --git a/apps/asher/asher_model.c b/apps/asher/asher_model.c
new file mode 100644
index 0000000000..2d95516292
--- /dev/null
+++ b/apps/asher/asher_model.c
@@ -0,0 +1,227 @@
+/* Asher OS 2.5.2: which iPod this is, exactly.
+ *
+ * The model number (like MB150) says the model, capacity, colour and year.
+ * It is read once and kept in /.rockbox/asher/model.txt:
+ *  - 6th/7th gen and nano 3rd gen: from the iPod's own settings chip (SysCfg)
+ *  - 5th/5.5 gen: from the SysInfo file Apple's software keeps on the drive
+ *    (iPod_Control/Device/SysInfo)
+ * If neither is there, a good guess from the hardware is shown instead (and
+ * not kept, so the real number is picked up once it can be read). */
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+#include "config.h"
+#include "system.h"
+#include "file.h"
+#include "string-extra.h"
+#include "disk.h"
+#include "asher_model.h"
+#if (CONFIG_CPU == S5L8702) && !defined(SIMULATOR)
+#include "norboot-target.h"
+#endif
+
+#define MODEL_FILE "/.rockbox/asher/model.txt"
+
+struct known { const char *code, *name, *detail; };
+static const struct known models[] = {
+    /* iPod Video, 5th gen (October 2005) */
+    { "A002", "iPod Video 5th gen", "30 GB  -  White  -  Late 2005" },
+    { "A146", "iPod Video 5th gen", "30 GB  -  Black  -  Late 2005" },
+    { "A003", "iPod Video 5th gen", "60 GB  -  White  -  Late 2005" },
+    { "A147", "iPod Video 5th gen", "60 GB  -  Black  -  Late 2005" },
+    { "A452", "iPod Video 5th gen", "30 GB  -  U2 Special Edition  -  2005" },
+    /* iPod Video, 5.5 gen (September 2006) */
+    { "A444", "iPod Video 5.5 gen", "30 GB  -  White  -  Late 2006" },
+    { "A446", "iPod Video 5.5 gen", "30 GB  -  Black  -  Late 2006" },
+    { "A448", "iPod Video 5.5 gen", "80 GB  -  White  -  Late 2006" },
+    { "A450", "iPod Video 5.5 gen", "80 GB  -  Black  -  Late 2006" },
+    { "A664", "iPod Video 5.5 gen", "30 GB  -  U2 Special Edition  -  2006" },
+    /* iPod Classic */
+    { "B029", "iPod Classic 6th gen", "80 GB  -  Silver  -  2007" },
+    { "B147", "iPod Classic 6th gen", "80 GB  -  Black  -  2007" },
+    { "B145", "iPod Classic 6th gen", "160 GB  -  Silver  -  2007" },
+    { "B150", "iPod Classic 6th gen", "160 GB  -  Black  -  2007" },
+    { "B562", "iPod Classic 6.5 gen", "120 GB  -  Silver  -  2008" },
+    { "B565", "iPod Classic 6.5 gen", "120 GB  -  Black  -  2008" },
+    { "C293", "iPod Classic 7th gen", "160 GB  -  Silver  -  2009" },
+    { "C297", "iPod Classic 7th gen", "160 GB  -  Black  -  2009" },
+    /* iPod nano, 3rd gen (September 2007) */
+    { "A978", "iPod nano 3rd gen", "4 GB  -  Silver  -  2007" },
+    { "A980", "iPod nano 3rd gen", "8 GB  -  Silver  -  2007" },
+    { "B261", "iPod nano 3rd gen", "8 GB  -  Black  -  2007" },
+    { "B249", "iPod nano 3rd gen", "8 GB  -  Blue  -  2007" },
+    { "B253", "iPod nano 3rd gen", "8 GB  -  Green  -  2007" },
+    { "B257", "iPod nano 3rd gen", "8 GB  -  (PRODUCT) RED  -  2007" },
+    { "B453", "iPod nano 3rd gen", "8 GB  -  Pink  -  2008" },
+};
+
+static char m_code[16];      /* "MB150" style */
+static char m_serial[24];
+static char m_name[48], m_detail[64];
+static bool m_done;
+
+/* "xB150", "MB150LL/A", "B150" -> "B150" (the letter and 3 digits) */
+static bool short_code(const char *s, char *out)
+{
+    while (*s == ' ') s++;
+    size_t n = strlen(s);
+    for (size_t i = 0; i + 4 <= n; i++)
+        if ((s[i] == 'A' || s[i] == 'B' || s[i] == 'C')
+            && s[i + 1] >= '0' && s[i + 1] <= '9' && s[i + 2] >= '0' && s[i + 2] <= '9'
+            && s[i + 3] >= '0' && s[i + 3] <= '9')
+        {
+            memcpy(out, s + i, 4);
+            out[4] = 0;
+            return true;
+        }
+    return false;
+}
+
+static void clean(char *s)
+{
+    char *e = s + strlen(s);
+    while (e > s && (e[-1] == '\n' || e[-1] == '\r' || e[-1] == ' ')) *--e = 0;
+}
+
+static bool read_saved(void)
+{
+    char buf[64];
+    int fd = open(MODEL_FILE, O_RDONLY);
+    if (fd < 0) return false;
+    int n = read(fd, buf, sizeof(buf) - 1);
+    close(fd);
+    if (n <= 0) return false;
+    buf[n] = 0;
+    char *nl = strchr(buf, '\n');
+    if (nl) { *nl = 0; strlcpy(m_serial, nl + 1, sizeof(m_serial)); clean(m_serial); }
+    clean(buf);
+    strlcpy(m_code, buf, sizeof(m_code));
+    return m_code[0] != 0;
+}
+
+static void save(void)
+{
+    char buf[64];
+    int n = snprintf(buf, sizeof(buf), "%s\n%s\n", m_code, m_serial);
+    int fd = open(MODEL_FILE, O_WRONLY | O_CREAT | O_TRUNC, 0666);
+    if (fd >= 0) { write(fd, buf, n); close(fd); }
+}
+
+#if (CONFIG_CPU == S5L8702) && !defined(SIMULATOR)
+static bool read_syscfg(void)
+{
+    static struct SysCfg sc;
+    if (syscfg_read(&sc) != 0) return false;
+    size_t n = MIN(sc.header.num_entries, SYSCFG_MAX_ENTRIES);
+    bool got = false;
+    for (size_t i = 0; i < n; i++)
+    {
+        char v[17];
+        memcpy(v, sc.entries[i].data, 16);
+        v[16] = 0;
+        if (sc.entries[i].tag == SYSCFG_TAG_MODN && v[0])
+        {
+            char c[8];
+            if (short_code(v, c)) { snprintf(m_code, sizeof(m_code), "M%s", c); got = true; }
+        }
+        else if (sc.entries[i].tag == SYSCFG_TAG_SRNM && v[0])
+            strlcpy(m_serial, v, sizeof(m_serial));
+    }
+    return got;
+}
+#endif
+
+/* SysInfo: lines like "ModelNumStr: xA446" and "pszSerialNumber: 8K6..." */
+static bool read_sysinfo(void)
+{
+    static char buf[2048];
+    int fd = open("/iPod_Control/Device/SysInfo", O_RDONLY);
+    if (fd < 0) return false;
+    int n = read(fd, buf, sizeof(buf) - 1);
+    close(fd);
+    if (n <= 0) return false;
+    buf[n] = 0;
+    bool got = false;
+    for (char *line = buf; line && *line; )
+    {
+        char *next = strchr(line, '\n');
+        if (next) *next++ = 0;
+        clean(line);
+        char c[8];
+        if (!strncmp(line, "ModelNumStr:", 12) && short_code(line + 12, c))
+            { snprintf(m_code, sizeof(m_code), "M%s", c); got = true; }
+        else if (!strncmp(line, "pszSerialNumber:", 16))
+        {
+            const char *v = line + 16;
+            while (*v == ' ') v++;
+            strlcpy(m_serial, v, sizeof(m_serial));
+        }
+        line = next;
+    }
+    return got;
+}
+
+/* no model number anywhere: a good guess from the hardware */
+static void guess(void)
+{
+    sector_t size = 0, freek = 0;
+    volume_size(IF_MV(0,) &size, &freek);
+    int gb = (int)(((unsigned long long)size * 1024ULL) / 1000000000ULL);   /* marketing GB */
+#if defined(IPOD_VIDEO)
+    /* 2.5.4: there's a 5th gen and a 5.5 gen version of Asher OS; each
+     * knows which iPod it was made for. The capacity comes from the
+     * memory (30 GB ones have 32 MB) and the drive */
+    int cap = 30;
+#ifndef SIMULATOR
+    extern unsigned char probed_ramsize;
+    if (probed_ramsize > 32) cap = gb > 65 ? 80 : 60;
+#endif
+#if defined(ASHER_VIDEO_GEN) && ASHER_VIDEO_GEN == 55
+    strlcpy(m_name, "iPod Video 5.5 gen", sizeof(m_name));
+    snprintf(m_detail, sizeof(m_detail), "%d GB  -  Late 2006", cap == 60 ? 80 : cap);
+#else
+    strlcpy(m_name, "iPod Video 5th gen", sizeof(m_name));
+    snprintf(m_detail, sizeof(m_detail), "%d GB  -  Late 2005", cap == 80 ? 60 : cap);
+#endif
+#elif defined(IPOD_NANO3G)
+    strlcpy(m_name, "iPod nano 3rd gen", sizeof(m_name));
+    snprintf(m_detail, sizeof(m_detail), "%d GB  -  2007", gb > 6 ? 8 : 4);
+#else
+    strlcpy(m_name, "iPod Classic", sizeof(m_name));
+    snprintf(m_detail, sizeof(m_detail), "%d GB", gb > 140 ? 160 : (gb > 100 ? 120 : 80));
+#endif
+}
+
+static void describe(void)
+{
+    char c[8];
+    if (short_code(m_code, c))
+        for (unsigned i = 0; i < sizeof(models) / sizeof(models[0]); i++)
+            if (!strcmp(models[i].code, c))
+            {
+                strlcpy(m_name, models[i].name, sizeof(m_name));
+                strlcpy(m_detail, models[i].detail, sizeof(m_detail));
+                return;
+            }
+    /* a number we don't know: the hardware guess, with the number */
+    guess();
+}
+
+static void detect(void)
+{
+    if (m_done) return;
+    m_done = true;
+    if (read_saved()) { describe(); return; }
+    bool got = false;
+#if (CONFIG_CPU == S5L8702) && !defined(SIMULATOR)
+    got = read_syscfg();
+#endif
+    if (!got) got = read_sysinfo();
+    if (got) { save(); describe(); }
+    else guess();
+}
+
+const char *asher_model_name(void)   { detect(); return m_name; }
+const char *asher_model_detail(void) { detect(); return m_detail; }
+const char *asher_model_number(void) { detect(); return m_code; }
+const char *asher_model_serial(void) { detect(); return m_serial; }
