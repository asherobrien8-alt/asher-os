+/* ------------------------------------------------------------------ */
+/* Scroll Speed: exact steps per full turn of the wheel (5..50), set    */
+/* separately for the main menu, Music and everything else, with a      */
+/* pretend menu to try it on and a steps-per-second meter               */
+/* ------------------------------------------------------------------ */
+#define SS_LEFT  ACTION_WPS_SKIPPREV
+#define SS_RIGHT ACTION_WPS_SKIPNEXT
+#ifdef BUTTON_SCROLL_FWD
+static const struct button_mapping ss_map[] = {
+    { ACTION_STD_NEXT,          BUTTON_SCROLL_FWD,                BUTTON_NONE },
+    { ACTION_STD_NEXTREPEAT,    BUTTON_SCROLL_FWD|BUTTON_REPEAT,  BUTTON_NONE },
+    { ACTION_STD_PREV,          BUTTON_SCROLL_BACK,               BUTTON_NONE },
+    { ACTION_STD_PREVREPEAT,    BUTTON_SCROLL_BACK|BUTTON_REPEAT, BUTTON_NONE },
+    { ACTION_STD_OK,            BUTTON_SELECT|BUTTON_REL,         BUTTON_SELECT },
+    { SS_RIGHT,                 BUTTON_RIGHT|BUTTON_REL,          BUTTON_RIGHT },
+    { SS_LEFT,                  BUTTON_LEFT|BUTTON_REL,           BUTTON_LEFT },
+    { ACTION_STD_MENU,          BUTTON_MENU|BUTTON_REL,           BUTTON_MENU },
+    { ACTION_STD_QUICKSCREEN,   BUTTON_MENU|BUTTON_REPEAT,        BUTTON_MENU },
+    LAST_ITEM_IN_LIST
+};
+static const struct button_mapping *ss_ctx(int c) { (void)c; return ss_map; }
+static int ss_action(int tmo) { return get_custom_action(CONTEXT_PLUGIN | 4, tmo, ss_ctx); }
+#else
+static int ss_action(int tmo) { return get_action(CONTEXT_STD, tmo); }
+#endif
+
+#define SS_ITEMS 120
+#define SS_AREAS 3
+static const char *ss_words[12] = { "Blue", "Night", "Drive", "Summer", "Neon", "Ocean",
+                                    "Golden", "Midnight", "City", "Rain", "Velvet", "Echo" };
+static const char *ss_area[SS_AREAS] = { "Main Menu", "Music Menu", "Everything Else" };
+
+static void ss_draw(const int *vals, int area, bool editing, int sel, int top,
+                    int rate, int peak)
+{
+    const struct aui_theme *t = aui_theme();
+    unsigned card1 = t->light ? 0xffffff : 0x22253f, card2 = t->light ? 0xf4f5f8 : 0x1a1c33;
+    char buf[48];
+    const int ly = 100, rh = 26, rows = 5, lx = 8, lw = 196;
+    int steps = vals[area];
+
+    aui_vgrad(0, 0, AUI_W, AUI_H, t->bg_top, t->bg_bot);
+    aui_topbar();
+    /* the setting */
+    if (editing) aui_round(8, AUI_BAR + 4, AUI_W - 16, 44, 12, t->sel1, t->sel2);
+    else         aui_round(8, AUI_BAR + 4, AUI_W - 16, 44, 12, card1, card2);
+    /* which menu: three dots */
+    for (int k = 0; k < SS_AREAS; k++)
+    {
+        unsigned c = k == area ? (editing ? 0xffffff : t->accent)
+                               : (editing ? 0x9aa0c8 : (t->light ? 0xc8c8d0 : 0x4a4f78));
+        aui_round(22 + k * 12, AUI_BAR + 36, 7, 7, 3, c, c);
+    }
+    /* the pretend menu */
+    aui_round(lx, ly - 4, lw, rows * rh + 8, 12, card1, card2);
+    for (int r = 0; r < rows; r++)
+        if (top + r == sel)
+            aui_round(lx + 4, ly + r * rh + 1, lw - 8, rh - 2, 9, t->sel1, t->sel2);
+    /* speed meter */
+    aui_round(212, ly - 4, AUI_W - 220, rows * rh + 8, 12, card1, card2);
+    aui_progress(222, ly + 96, AUI_W - 240, 8, MIN(rate, 60), 60);
+    if (peak) aui_fill(222 + MIN(60, peak) * (AUI_W - 240) / 60 - 1, ly + 92, 2, 16, t->accent);
+    aui_present();
+
+    unsigned tc = editing ? 0xffffff : t->text;
+    snprintf(buf, sizeof(buf), "< %s >", ss_area[area]);
+    aui_text(AF_MED, 22, AUI_BAR + 11, tc, buf, 200, 0);
+    snprintf(buf, sizeof(buf), editing ? "< %d >" : "%d", steps);
+    aui_text(AF_BIG, AUI_W - 22, AUI_BAR + 13, tc, buf, 90, 2);
+    aui_text(AF_SMALLR, 70, AUI_BAR + 33, editing ? 0xdfe2ff : t->sub, "steps per spin", 120, 0);
+    aui_text(AF_SMALLR, AUI_W / 2, AUI_BAR + 52, t->sub,
+             editing ? "turn: speed  -  << >>: menu  -  centre: keep"
+                     : "<< >>: pick menu  -  centre: change  -  try below", AUI_W - 16, 1);
+    for (int r = 0; r < rows; r++)
+    {
+        int i = top + r;
+        snprintf(buf, sizeof(buf), "%d. %s %s", i + 1, ss_words[i % 12], ss_words[(i * 7 + 3) % 12]);
+        aui_text(AF_MED, lx + 14, ly + r * rh + 5, i == sel ? 0xffffff : t->text, buf, lw - 24, 0);
+    }
+    aui_text(AF_SMALL, 260, ly + 4, t->sub, "SPEED", 90, 1);
+    snprintf(buf, sizeof(buf), "%d", rate);
+    aui_text(AF_BIG, 260, ly + 22, t->text, buf, 90, 1);
+    aui_text(AF_SMALLR, 260, ly + 44, t->sub, "steps / sec", 92, 1);
+    snprintf(buf, sizeof(buf), "%d.%d turns / sec", rate * 10 / MAX(1, steps) / 10,
+             rate * 10 / MAX(1, steps) % 10);
+    aui_text(AF_SMALLR, 260, ly + 62, t->sub, buf, 96, 1);
+    snprintf(buf, sizeof(buf), peak ? "fastest %d" : "spin it!", peak);
+    aui_text(AF_SMALLR, 260, ly + 110, t->sub, buf, 92, 1);
+    aui_topbar_text("Scroll Speed");
+    aui_update();
+}
+
+static int scroll_speed_screen(void);
+int asher_scroll_speed_screen(void) { return scroll_speed_screen(); }
+static int scroll_speed_screen(void)
+{
+    int vals[SS_AREAS] = { asher_wheel_main, asher_wheel_music, asher_wheel };
+    int area = 0, sel = 0, top = 0, rate = 0, peak = 0;
+    bool editing = false, redraw = true;
+    long hits[128]; int nh = 0;
+    long last_move = 0; int streak = 0;
+
+    aui_begin();
+    asher_wheel_try(vals[area]);          /* the test menu uses the chosen menu's speed */
+    while (1)
+    {
+        /* steps over the last second (exact, from each step's time) */
+        while (nh && TIME_AFTER(current_tick, hits[0] + HZ))
+        {
+            memmove(hits, hits + 1, sizeof(long) * (nh - 1));
+            nh--;
+        }
+        if (nh != rate) { rate = nh; redraw = true; }
+        if (rate > peak) peak = rate;
+        if (aui_woke()) redraw = true;
+        if (redraw) { ss_draw(vals, area, editing, sel, top, rate, peak); redraw = false; }
+        int a = ss_action(HZ / 10);
+        switch (a)
+        {
+            case ACTION_STD_NEXT: case ACTION_STD_NEXTREPEAT:
+            case ACTION_STD_PREV: case ACTION_STD_PREVREPEAT:
+            {
+                bool fwd = a == ACTION_STD_NEXT || a == ACTION_STD_NEXTREPEAT;
+                if (nh < 128) hits[nh++] = current_tick;
+                if (editing)
+                {
+                    vals[area] += fwd ? 1 : -1;
+                    if (vals[area] < 5) vals[area] = 5;
+                    if (vals[area] > 50) vals[area] = 50;
+                }
+                else
+                {
+                    /* moves like the real lists: speeds up on long spins */
+                    if (TIME_BEFORE(current_tick, last_move + HZ / 8)) streak++;
+                    else streak = 0;
+                    last_move = current_tick;
+                    int step = streak > 6 ? MIN(1 + (streak - 6) / 3, SS_ITEMS / 40) : 1;
+                    sel += fwd ? step : -step;
+                    if (sel < 0) sel = step == 1 ? SS_ITEMS - 1 : 0;
+                    if (sel >= SS_ITEMS) sel = step == 1 ? 0 : SS_ITEMS - 1;
+                    if (sel < top) top = sel;
+                    if (sel >= top + 5) top = sel - 4;
+                }
+                redraw = true;
+                break;
+            }
+            case SS_LEFT:
+            case SS_RIGHT:
+                area = (area + (a == SS_RIGHT ? 1 : SS_AREAS - 1)) % SS_AREAS;
+                asher_wheel_try(vals[area]);
+                peak = 0;
+                redraw = true;
+                break;
+            case ACTION_STD_OK:
+                if (editing)
+                {
+                    asher_wheel_main = vals[0];
+                    asher_wheel_music = vals[1];
+                    asher_wheel = vals[2];
+                    asher_prefs_save();
+                    asher_wheel_try(vals[area]);   /* try it out right away */
+                    peak = 0;
+                }
+                editing = !editing;
+                redraw = true;
+                break;
+            case ACTION_STD_QUICKSCREEN:
+                asher_wheel_zone(WZ_OTHER);
+                asher_music_mode();
+                asher_wheel_try(vals[area]);
+                redraw = true;
+                break;
+            case ACTION_STD_MENU:
+            case ACTION_STD_CANCEL:
+                if (editing)
+                {
+                    editing = false;
+                    vals[0] = asher_wheel_main; vals[1] = asher_wheel_music; vals[2] = asher_wheel;
+                    asher_wheel_try(vals[area]);
+                    redraw = true;
+                    break;
+                }
+                asher_wheel_zone(WZ_OTHER);
+                aui_end();
+                return 0;
+            case ACTION_NONE:
+                break;
+            default:
+                if (default_event_handler(a) == SYS_USB_CONNECTED)
+                    { asher_wheel_zone(WZ_OTHER); aui_end(); return 0; }
+                redraw = true;
+                break;
+        }
+    }
+}
+MENUITEM_FUNCTION(asher_scroll_item, 0, "Scroll Speed", scroll_speed_screen, NULL, Icon_NOICON);
+
+/* ------------------------------------------------------------------ */
+/* USB Check: what the USB connection is doing right now               */
+/* ------------------------------------------------------------------ */
+#include "usb.h"
+#if !defined(SIMULATOR) && defined(HAVE_USBSTACK)
+bool usb_core_host_active(void);
+#define HOST_ACTIVE() usb_core_host_active()
+#else
+#define HOST_ACTIVE() false
+#endif
+#ifdef SIMULATOR
+void usb_get_diag(struct usb_diag *d) { memset(d, 0, sizeof(*d)); }
+#endif
+
+static void uc_draw(void)
+{
+    const struct aui_theme *t = aui_theme();
+    unsigned card1 = t->light ? 0xffffff : 0x22253f, card2 = t->light ? 0xf4f5f8 : 0x1a1c33;
+    struct usb_diag d;
+    char buf[96];
+    usb_get_diag(&d);
+    bool talk = HOST_ACTIVE();
+    static const char *rows[4] = { "Cable plugged in", "Computer talking to iPod",
+                                   "Drive asked for", "Drive handed to computer" };
+    bool val[4] = { d.cable, talk, d.requested, d.handed_over };
+
+    aui_vgrad(0, 0, AUI_W, AUI_H, t->bg_top, t->bg_bot);
+    aui_topbar();
+    aui_round(8, AUI_BAR + 6, AUI_W - 16, 4 * 26 + 10, 12, card1, card2);
+    for (int r = 0; r < 4; r++)
+    {
+        unsigned c = val[r] ? 0x34c759 : 0xff453a;
+        aui_round(20, AUI_BAR + 16 + r * 26, 12, 12, 6, c, c);
+    }
+    aui_round(8, AUI_BAR + 126, AUI_W - 16, AUI_H - AUI_BAR - 132, 12, card1, card2);
+    aui_present();
+    for (int r = 0; r < 4; r++)
+    {
+        aui_text(AF_MED, 42, AUI_BAR + 12 + r * 26, t->text, rows[r], 200, 0);
+        aui_text(AF_MED, AUI_W - 22, AUI_BAR + 12 + r * 26, t->sub, val[r] ? "yes" : "no", 60, 2);
+    }
+    snprintf(buf, sizeof(buf), "Parts still to answer: %d", d.requested ? d.acks_left : 0);
+    aui_text(AF_SMALL, 20, AUI_BAR + 134, t->text, buf, AUI_W - 40, 0);
+    strlcpy(buf, "Answered: ", sizeof(buf));
+    for (int i = 0; i < d.nacked; i++)
+    {
+        if (i) strlcat(buf, ", ", sizeof(buf));
+        strlcat(buf, d.acked[i], sizeof(buf));
+    }
+    aui_text(AF_SMALLR, 20, AUI_BAR + 150, t->sub, d.nacked ? buf : "Answered last time: (nothing yet)", AUI_W - 40, 0);
+    if (d.nacked)
+    {
+        snprintf(buf, sizeof(buf), "Didn't answer: %s", d.missing[0] ? d.missing : "none");
+        aui_text(AF_SMALL, 20, AUI_BAR + 168, d.missing[0] ? 0xff453a : t->text, buf, AUI_W - 40, 0);
+    }
+    aui_topbar_text("USB Check");
+    aui_update();
+}
+
+static int usb_check_screen(void)
+{
+    aui_begin();
+    while (1)
+    {
+        uc_draw();
+        int a = get_action(CONTEXT_STD, HZ / 3);
+        if (a == ACTION_STD_CANCEL || a == ACTION_STD_MENU || a == ACTION_STD_OK) break;
+        if (a == ACTION_STD_QUICKSCREEN) { asher_music_mode(); continue; }
+        if (a != ACTION_NONE && default_event_handler(a) == SYS_USB_CONNECTED) break;
+    }
+    aui_end();
+    return 0;
+}
+MENUITEM_FUNCTION(asher_usbcheck_item, 0, "USB Check", usb_check_screen, NULL, Icon_NOICON);
+
+/* ------------------------------------------------------------------ */
+/* Brightness: a slider, the screen changes as you turn the wheel      */
+/* ------------------------------------------------------------------ */
+#ifdef HAVE_BACKLIGHT_BRIGHTNESS
+/* the slider moves 1% per wheel step; the backlight gets the nearest level.
+ * 6th/7th gen: levels above ~70% of the range look the same, so 100% is
+ * the brightest level you can actually see */
+#ifdef IPOD_6G
+#define BR_TOP 44
+#else
+#define BR_TOP MAX_BRIGHTNESS_SETTING
+#endif
+static int br_level(int pct)
+{
+    return MIN_BRIGHTNESS_SETTING
+         + ((pct - 1) * (BR_TOP - MIN_BRIGHTNESS_SETTING) + 49) / 99;
+}
+static int br_pct(int level)
+{
+    if (level >= BR_TOP) return 100;
+    if (level <= MIN_BRIGHTNESS_SETTING) return 1;
+    return 1 + ((level - MIN_BRIGHTNESS_SETTING) * 99 + (BR_TOP - MIN_BRIGHTNESS_SETTING) / 2)
+               / (BR_TOP - MIN_BRIGHTNESS_SETTING);
+}
+
+static void br_draw(int pct)
+{
+    const struct aui_theme *t = aui_theme();
+    unsigned card1 = t->light ? 0xffffff : 0x22253f, card2 = t->light ? 0xf4f5f8 : 0x1a1c33;
+    char buf[16];
+
+    aui_vgrad(0, 0, AUI_W, AUI_H, t->bg_top, t->bg_bot);
+    aui_topbar();
+    aui_round(10, 66, AUI_W - 20, 110, 16, card1, card2);
+    aui_progress(30, 128, AUI_W - 60, 16, pct, 100);
+    /* little sun icons at each end */
+    aui_round(18, 130, 8, 8, 4, t->sub, t->sub);
+    aui_round(AUI_W - 29, 127, 14, 14, 7, t->accent, t->accent);
+    aui_present();
+    aui_text(AF_SMALL, AUI_W / 2, 78, t->sub, "BRIGHTNESS", 200, 1);
+    snprintf(buf, sizeof(buf), "%d%%", pct);
+    aui_text(AF_BIG, AUI_W / 2, 96, t->text, buf, 200, 1);
+    aui_text(AF_SMALLR, AUI_W / 2, 152, t->sub, "turn the wheel  -  centre or menu saves", AUI_W - 40, 1);
+    aui_topbar_text("Brightness");
+    aui_update();
+}
+
+static int brightness_screen(void)
+{
+    int old = global_settings.brightness;
+    int pct = br_pct(old), lvl = old;
+    bool redraw = true;
+    aui_begin();
+    while (1)
+    {
+        if (aui_woke()) redraw = true;
+        if (redraw) { br_draw(pct); redraw = false; }
+        int a = get_action(CONTEXT_STD, HZ);
+        switch (a)
+        {
+            case ACTION_STD_NEXT: case ACTION_STD_NEXTREPEAT:
+            case ACTION_STD_PREV: case ACTION_STD_PREVREPEAT:
+            {
+                bool up = a == ACTION_STD_NEXT || a == ACTION_STD_NEXTREPEAT;
+                pct += up ? 1 : -1;            /* one number per step */
+                if (pct < 1) pct = 1;
+                if (pct > 100) pct = 100;
+                int l = br_level(pct);
+                if (l != lvl) { lvl = l; backlight_set_brightness(lvl); }
+                redraw = true;
+                break;
+            }
+            case ACTION_STD_QUICKSCREEN:
+                asher_music_mode();
+                redraw = true;
+                break;
+            case ACTION_STD_OK:
+            case ACTION_STD_MENU:
+            case ACTION_STD_CANCEL:
+                global_settings.brightness = lvl;
+                if (lvl != old) settings_save();
+                aui_end();
+                return 0;
+            case ACTION_NONE:
+                break;
+            default:
+                if (default_event_handler(a) == SYS_USB_CONNECTED)
+                    { global_settings.brightness = lvl; settings_save(); aui_end(); return 0; }
+                redraw = true;
+                break;
+        }
+    }
+}
+MENUITEM_FUNCTION(asher_brightness_item, 0, "Brightness", brightness_screen, NULL, Icon_NOICON);
+#endif
