diff --git a/apps/asher/asher_stats.c b/apps/asher/asher_stats.c
new file mode 100644
index 0000000000..74979441be
--- /dev/null
+++ b/apps/asher/asher_stats.c
@@ -0,0 +1,143 @@
+/* Asher OS Stats screen, laid out as retro desktop windows:
+ * album_art.jpg, wallpaper.gif (live), now_playing.txt and moon.jpeg. */
+#include <stdio.h>
+#include <string.h>
+#include "config.h"
+#include "system.h"
+#include "kernel.h"
+#include "action.h"
+#include "audio.h"
+#include "misc.h"
+#include "metadata.h"
+#include "timefuncs.h"
+#include "asher_ui.h"
+#include "asher_stats.h"
+#include "asher_theme.h"
+#include "asher_wallpaper.h"
+#include "moonphase.h"
+
+static const char *moon_l1[8] = { "New", "Waxing", "First", "Waxing", "Full", "Waning", "Last", "Waning" };
+static const char *moon_l2[8] = { "Moon", "Crescent", "Quarter", "Gibbous", "Moon", "Gibbous", "Quarter", "Crescent" };
+
+/* window bodies (must match the stats_bg picture) */
+#define ART_X 10
+#define ART_Y 51
+#define WALL_X 147
+#define WALL_Y 51
+#define INFO_X 6
+#define INFO_Y 181
+#define MOON_X 212
+#define MOON_Y 181
+
+#define C_TEXT   0x3d2f9e
+#define C_SUB    0x6a5cc0
+#define C_PLAY   0x14935a
+#define C_PAUSE  0xd2691e
+
+static const char *track_title(struct mp3entry *id3)
+{
+    if (id3->title && id3->title[0]) return id3->title;
+    const char *p = strrchr(id3->path, '/');
+    return p ? p + 1 : id3->path;
+}
+
+static void draw(void)
+{
+    struct mp3entry *id3 = audio_current_track();
+    int st = audio_status();
+    bool playing = (st & AUDIO_STATUS_PLAY) && id3;
+    bool paused = st & AUDIO_STATUS_PAUSE;
+    char buf[160], b2[16];
+    struct tm *tm = get_time();
+    int ph = asher_moon_phase(tm->tm_year + 1900, tm->tm_mon + 1, tm->tm_mday);
+    const char *wname = asher_wallpaper_name();
+
+    if (!aui_sprite(SPR_STATS_BG, 0, 0))
+        aui_vgrad(0, 0, AUI_W, AUI_H, 0xffd6f6, 0xa6baff);
+    aui_topbar();
+
+    /* album art */
+    if (!aui_albumart(ART_X, ART_Y, 120))
+    {
+        aui_vgrad(ART_X, ART_Y, 120, 120, 0xfde6fb, 0xead6ff);
+        aui_sprite_c(SPR_NOTE, ART_X + 60, ART_Y + 60);
+    }
+    /* live wallpaper + its name */
+    const fb_data *wp = asher_wp_small();
+    if (wp)
+    {
+        aui_blit(wp, ASHER_BOX_W, ASHER_BOX_H, WALL_X, WALL_Y);
+        aui_shade(WALL_X, WALL_Y + ASHER_BOX_H - 15, ASHER_BOX_W, 15, 0, 110, 0x2a1f6e);
+    }
+    else
+        aui_vgrad(WALL_X, WALL_Y, ASHER_BOX_W, ASHER_BOX_H, 0xfde6fb, 0xead6ff);
+    /* moon */
+    aui_sprite(SPR_MOON0 + ph, MOON_X + 5, MOON_Y + 17);
+    /* progress */
+    if (playing)
+        aui_progress(INFO_X + 5, INFO_Y + 44, 128, 5, id3->elapsed, id3->length);
+    aui_present();
+
+    if (wp)
+        aui_text(AF_RETRO_S, WALL_X + 5, WALL_Y + ASHER_BOX_H - 12, 0xfff2c8,
+                 wname ? wname : "", ASHER_BOX_W - 10, 0);
+    else
+        aui_text(AF_RETRO_S, WALL_X + ASHER_BOX_W / 2, WALL_Y + 55, C_SUB, "no wallpaper", 150, 1);
+
+    if (playing)
+    {
+        aui_text(AF_RETRO_S, INFO_X + 5, INFO_Y + 17, paused ? C_PAUSE : C_PLAY,
+                 paused ? "> currently paused" : "> currently playing", 130, 0);
+        if (id3->bitrate)
+        {
+            snprintf(buf, sizeof(buf), "%d kbps", id3->bitrate);
+            aui_text(AF_RETRO_S, INFO_X + 194, INFO_Y + 17, C_SUB, buf, 60, 2);
+        }
+        snprintf(buf, sizeof(buf), "%s - %s", track_title(id3),
+                 (id3->artist && id3->artist[0]) ? id3->artist : "Unknown Artist");
+        aui_text(AF_SMALL, INFO_X + 5, INFO_Y + 28, C_TEXT, buf, 188, 0);
+        aui_fmt_time(buf, sizeof(buf), id3->elapsed);
+        aui_fmt_time(b2, sizeof(b2), id3->length);
+        strlcat(buf, "/", sizeof(buf));
+        strlcat(buf, b2, sizeof(buf));
+        aui_text(AF_RETRO_S, INFO_X + 194, INFO_Y + 41, C_SUB, buf, 60, 2);
+    }
+    else
+    {
+        aui_text(AF_RETRO_S, INFO_X + 5, INFO_Y + 17, C_SUB, "> nothing playing", 180, 0);
+        aui_text(AF_SMALL, INFO_X + 5, INFO_Y + 30, C_TEXT, "Pick something in Music", 188, 0);
+    }
+    aui_text(AF_RETRO_S, MOON_X + 44, MOON_Y + 22, C_TEXT, moon_l1[ph], 56, 0);
+    aui_text(AF_RETRO_S, MOON_X + 44, MOON_Y + 34, C_TEXT, moon_l2[ph], 56, 0);
+    aui_topbar_text("Stats");
+    aui_update();
+}
+
+void asher_stats_screen(void)
+{
+    long next_text = 0;
+    int frame = -1;
+    aui_begin();
+    aui_intro(LDR_STATS);
+    while (1)
+    {
+        bool on = aui_screen_on();
+        bool anim = asher_wp_animated();
+        if (on)
+        {
+            int f = asher_wp_frame_no();
+            if (TIME_AFTER(current_tick, next_text) || (anim && f != frame))
+            {
+                draw();
+                frame = f;
+                if (TIME_AFTER(current_tick, next_text)) next_text = current_tick + HZ / 2;
+            }
+        }
+        int action = get_action(CONTEXT_STD, (on && anim) ? asher_wp_frame_ticks() : HZ / 2);
+        if (action == ACTION_STD_CANCEL || action == ACTION_STD_MENU || action == ACTION_STD_OK)
+            break;
+        if (action != ACTION_NONE && default_event_handler(action) == SYS_USB_CONNECTED)
+            break;
+    }
+    aui_end();
+}
