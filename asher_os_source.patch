+#ifndef ASHER_WALLPAPER_H
+#define ASHER_WALLPAPER_H
+#include <stdbool.h>
+#include "config.h"
+#include "lcd.h"
+/* Wallpaper pack (.awp): "AWP1", u16 width, u16 height, u16 frames,
+ * u16 frame_ms, then raw RGB565 frames. Packs are loaded into RAM once so
+ * the hard drive can sleep. Each wallpaper has a full-screen pack and a
+ * small 160x120 pack ("<name>_s") for the Stats screen box. */
+#define ASHER_BOX_W 160
+#define ASHER_BOX_H 120
+
+void asher_wallpaper_set(const char *scene, bool follow_time); /* NULL = off */
+const fb_data *asher_wp_full(void);   /* current 320x240 frame or NULL */
+const fb_data *asher_wp_small(void);  /* current 160x120 frame or NULL */
+const fb_data *asher_wp_small_still(void); /* its first frame, no animation */
+bool asher_wp_animated(void);         /* more than one frame? */
+int  asher_wp_frame_ticks(void);      /* ticks between frames */
+int  asher_wp_frame_no(void);         /* changes whenever the frame changes */
+const char *asher_scene_for_time(void);
+void asher_wp_prepare(void);           /* load the wallpaper now if needed */
+void asher_wp_set_loading_cb(void (*cb)(int pct));
+
+/* Settings > Wallpaper preview */
+#define ASHER_PV_W 224
+#define ASHER_PV_H 168
+bool asher_wp_preview_open(const char *scene, bool timed);
+void asher_wp_preview_close(void);
+int  asher_wp_preview_load(int count);     /* returns percent loaded */
+bool asher_wp_preview_ready(void);
+bool asher_wp_preview_loading(void);
+int  asher_wp_preview_ticks(void);
+int  asher_wp_preview_frame_no(void);
+const fb_data *asher_wp_preview_frame(void);
+#endif
diff --git a/apps/asher/moonphase.c b/apps/asher/moonphase.c
new file mode 100644
index 0000000000..3308c53781
--- /dev/null
+++ b/apps/asher/moonphase.c
@@ -0,0 +1,47 @@
+#include <stdint.h>
+#include "moonphase.h"
+#include "moontab.inc"
+
+#define NEV ((int)(sizeof(moon_events) / sizeof(moon_events[0])))
+
+/* days since 2025-01-01 for a civil date */
+static long days_from_2025(int y, int m, int d)
+{
+    int a = (14 - m) / 12;
+    long yy = y + 4800 - a, mm = m + 12 * a - 3;
+    long jdn = d + (153 * mm + 2) / 5 + 365 * yy + yy / 4 - yy / 100 + yy / 400 - 32045;
+    return jdn - 2460677L;              /* JDN of 2025-01-01 */
+}
+
+static long floor_div(long a, long b) { return a >= 0 ? a / b : -((-a + b - 1) / b); }
+
+int asher_moon_phase(int year, int month, int day, int hour, int minute)
+{
+    long today = days_from_2025(year, month, day);
+    long now = today * 1440 + hour * 60 + minute;
+    int i;
+
+    if (now >= (moon_events[0] >> 2) && now < (moon_events[NEV - 1] >> 2))
+    {
+        for (i = 0; i + 1 < NEV && (moon_events[i + 1] >> 2) <= now; i++)
+            ;
+        long t0 = moon_events[i] >> 2, t1 = moon_events[i + 1] >> 2;
+        int k0 = moon_events[i] & 3, k1 = moon_events[i + 1] & 3;
+        if (floor_div(t0, 1440) == today) return k0 * 2;   /* exact phase today */
+        if (floor_div(t1, 1440) == today) return k1 * 2;
+        return k0 * 2 + 1;                                 /* in between */
+    }
+
+    /* outside the table: mean lunation from a known new moon */
+    long age = (now - (moon_events[0] >> 2)) % 42524;      /* 29.53 days in minutes */
+    if (age < 0) age += 42524;
+    long d10 = age * 10 / 1440;                            /* age in tenths of days */
+    if (d10 < 10 || d10 >= 285) return 0;
+    if (d10 < 64) return 1;
+    if (d10 < 84) return 2;
+    if (d10 < 138) return 3;
+    if (d10 < 158) return 4;
+    if (d10 < 212) return 5;
+    if (d10 < 232) return 6;
+    return 7;
+}
