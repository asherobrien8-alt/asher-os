diff --git a/apps/asher/asher_wallpaper.c b/apps/asher/asher_wallpaper.c
new file mode 100644
index 0000000..ac1f2f5
--- /dev/null
+++ b/apps/asher/asher_wallpaper.c
@@ -0,0 +1,81 @@
+#include <stdio.h>
+#include <string.h>
+#include <fcntl.h>
+#include "config.h"
+#include "system.h"
+#include "kernel.h"
+#include "file.h"
+#include "timefuncs.h"
+#include "lcd.h"
+#include "asher_wallpaper.h"
+#include "moonphase.h"
+
+#define AWP_DIR "/.rockbox/asher/wallpaper/"
+#define AWP_HDR 12
+
+extern void skin_backdrop_animate(const void *frame, size_t bytes);
+
+bool asher_wallpaper_enabled = true;
+
+static int fd = -1;
+static int nframes, frame_ms, cur;
+static long next_tick;
+static char scene[32];
+/* Frame buffer; the iPod Classic has 64 MB so a static 150 KB is fine. */
+static fb_data frame_buf[LCD_WIDTH * LCD_HEIGHT];
+
+void asher_wallpaper_stop(void)
+{
+    if (fd >= 0) { close(fd); fd = -1; }
+    scene[0] = '\0';
+}
+
+void asher_wallpaper_set_scene(const char *name)
+{
+    char path[MAX_PATH];
+    unsigned char h[AWP_HDR];
+    if (!strcmp(name, scene) && fd >= 0) return;   /* already playing */
+    asher_wallpaper_stop();
+    snprintf(path, sizeof(path), AWP_DIR "%s.awp", name);
+    fd = open(path, O_RDONLY);
+    if (fd < 0) return;
+    if (read(fd, h, AWP_HDR) != AWP_HDR || memcmp(h, "AWP1", 4)
+        || (h[4] | h[5] << 8) != LCD_WIDTH || (h[6] | h[7] << 8) != LCD_HEIGHT)
+    { close(fd); fd = -1; return; }
+    nframes  = h[8] | h[9] << 8;
+    frame_ms = h[10] | h[11] << 8;
+    if (nframes < 1) { close(fd); fd = -1; return; }
+    strmemccpy(scene, name, sizeof(scene));
+    cur = 0;
+    next_tick = current_tick;
+}
+
+const char *asher_scene_for_time(void)
+{
+    static char name[24];
+    struct tm *t = get_time();
+    int h = t->tm_hour;
+    if (h >= 5 && h < 9)       return "sunrise";
+    if (h >= 9 && h < 16)      return "sunup";
+    if (h >= 16 && h < 20)     return "sunset";
+    {
+        int p = asher_moon_phase(t->tm_year + 1900, t->tm_mon + 1, t->tm_mday);
+        /* 20:00-23:00 moon rising, 23:00-05:00 moon high */
+        snprintf(name, sizeof(name), (h >= 20 && h < 23) ? "moonrise%d"
+                                                          : "moonhigh%d", p);
+    }
+    return name;
+}
+
+bool asher_wallpaper_tick(void)
+{
+    if (!asher_wallpaper_enabled || fd < 0 || TIME_BEFORE(current_tick, next_tick))
+        return false;
+    next_tick = current_tick + (frame_ms * HZ) / 1000;
+    if (lseek(fd, AWP_HDR + (off_t)cur * sizeof(frame_buf), SEEK_SET) < 0 ||
+        read(fd, frame_buf, sizeof(frame_buf)) != (ssize_t)sizeof(frame_buf))
+        { cur = 0; return false; }
+    cur = (cur + 1) % nframes;
+    skin_backdrop_animate(frame_buf, sizeof(frame_buf));
+    return true;
+}
diff --git a/apps/asher/asher_wallpaper.h b/apps/asher/asher_wallpaper.h
new file mode 100644
index 0000000..72bef1c
--- /dev/null
+++ b/apps/asher/asher_wallpaper.h
@@ -0,0 +1,11 @@
+#ifndef ASHER_WALLPAPER_H
+#define ASHER_WALLPAPER_H
+#include <stdbool.h>
+/* Frame-pack (.awp) format: "AWP1", u16 width, u16 height, u16 frames,
+ * u16 frame_ms, then frames of raw RGB565 (little endian). */
+void asher_wallpaper_set_scene(const char *name);   /* e.g. "sunrise" */
+void asher_wallpaper_stop(void);
+bool asher_wallpaper_tick(void);   /* true if a new frame was shown */
+const char *asher_scene_for_time(void);  /* time-of-day + moon phase */
+extern bool asher_wallpaper_enabled;
+#endif
diff --git a/apps/asher/moonphase.c b/apps/asher/moonphase.c
new file mode 100644
index 0000000..bbe9d9a
--- /dev/null
+++ b/apps/asher/moonphase.c
@@ -0,0 +1,20 @@
+#include "moonphase.h"
+
+/* Days since a known new moon (2000-01-06 18:14 UTC), mod synodic month. */
+int asher_moon_phase(int year, int month, int day)
+{
+    /* Julian day number at noon for the given date */
+    int a = (14 - month) / 12;
+    int y = year + 4800 - a;
+    int m = month + 12 * a - 3;
+    long jdn = day + (153 * m + 2) / 5 + 365L * y + y / 4 - y / 100
+               + y / 400 - 32045;
+
+    /* Work in hundredths of a day to avoid floats on the iPod CPU.
+     * Reference new moon JD = 2451550.26, synodic month = 29.530589 d */
+    long since = (jdn - 2451550L) * 100 - 26;
+    long cycle = 2953;                       /* 29.53 days, x100 */
+    long pos = since % cycle;
+    if (pos < 0) pos += cycle;
+    return (int)((pos * 8 + cycle / 2) / cycle) & 7;
+}
diff --git a/apps/asher/moonphase.h b/apps/asher/moonphase.h
new file mode 100644
index 0000000..c667aaf
--- /dev/null
+++ b/apps/asher/moonphase.h
@@ -0,0 +1,6 @@
+#ifndef ASHER_MOONPHASE_H
+#define ASHER_MOONPHASE_H
+/* Returns moon phase index 0..7 (0=new, 2=first quarter, 4=full,
+ * 6=last quarter) from the calendar date. No live data needed. */
+int asher_moon_phase(int year, int month, int day);
+#endif
