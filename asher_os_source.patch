+ * 4 Full, 5 Waning Gibbous, 6 Last Quarter, 7 Waning Crescent.
+ * The quarter names are used only on the calendar day the exact phase
+ * happens (like a calendar shows it). */
+int asher_moon_phase(int year, int month, int day, int hour, int minute);
+#endif
