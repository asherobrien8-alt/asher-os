+/* the menu itself; name is shown under the title */
+static int song_menu(const char *path, const char *name)
+{
+    const char *items[2];
+    int act[2], n = 0;
+    if (path) { items[n] = "Add to Queue"; act[n++] = 1; }
+    if (playlist_queued_ahead() > 0) { items[n] = "Cancel Queue"; act[n++] = 2; }
+    if (n == 0) return 0;
+    int r = asher_popup("SONG", name ? name : "", items, n);
+    if (r < 0) return 0;
+    if (act[r] == 1) queue_add(path);
+    else queue_cancel();
+    return 0;
