+++ b/apps/asher/asher_ui.c
@@ -0,0 +1,543 @@
+/* Asher OS shared drawing layer. See asher_ui.h. */
+#include <stdio.h>
+#include <string.h>
+#include <fcntl.h>
+#include "config.h"
+#include "system.h"
+#include "kernel.h"
+#include "file.h"
