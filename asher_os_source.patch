diff --git a/apps/asher/asher_music.c b/apps/asher/asher_music.c
new file mode 100644
index 0000000000..36c9cfbfc3
--- /dev/null
+++ b/apps/asher/asher_music.c
@@ -0,0 +1,2059 @@
+/* Asher OS Music section: Search, Artists, Playlists, Shuffle, All Songs.
+ * A compact index of the music database (title, artist) is built once and
+ * kept in RAM, so browsing and searching are instant. */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <ctype.h>
+#include "config.h"
+#include "string-extra.h"
+#include "system.h"
+#include "kernel.h"
+#include "action.h"
+#include "button.h"
+#include "audio.h"
+#include "misc.h"
+#include "menu.h"
+#include "splash.h"
+#include "settings.h"
+#include "playlist.h"
+#include "tagcache.h"
+#include "dir.h"
+#include "file.h"
+#include "core_alloc.h"
+#include "asher_mem.h"
+#include "strnatcmp.h"
+#include "crc32.h"
+#include "asher_prefs.h"
+#include "asher_check.h"
+#include "asher_quick.h"
+#include "gui/wps.h"
+#include "playback.h"
+#ifdef HAVE_DIRCACHE
+#include "dircache.h"
+#endif
+#include "timefuncs.h"
+#include "root_menu.h"
+#include "asher_ui.h"
+#include "asher_list.h"
+#include "asher_music.h"
+
+/* ------------------------------------------------------------------ */
+/* library index                                                       */
+/* ------------------------------------------------------------------ */
+struct lent   { int32_t idx; uint32_t title, artist, crc; uint8_t dup; };
+struct artist { uint32_t name; int start, count; };
+
+static int lib_handle = -1;
+static int lib_n, lib_cap, lib_nart, lib_res;
+static int lib_u;               /* songs without duplicates (by_title / by_artist length) */
+static size_t lib_size;
+static long lib_dbcount = -1;
+static struct lent *L;          /* entries */
+static int *by_title, *by_artist, *results, *by_crc;
+static struct artist *A;
+static char *pool;
+static size_t pool_used, pool_cap;
+static bool rebuild_requested;
+
+static void lib_free(void)
+{
+    if (lib_handle > 0) { core_unpin(lib_handle); asher_free(lib_handle); }
+    lib_handle = -1;
+    lib_n = lib_u = lib_nart = lib_res = 0;
+    lib_dbcount = -1;
+}
+
+static uint32_t pool_add(const char *s)
+{
+    size_t len = strlen(s) + 1;
+    if (pool_used + len > pool_cap) return 0;   /* offset 0 is "" */
+    uint32_t off = pool_used;
+    memcpy(pool + off, s, len);
+    pool_used += len;
+    return off;
+}
+
+static const char *T(int e) { return pool + L[e].title; }
+static const char *AR(int e) { return pool + L[e].artist; }
+
+static const char *skip_the(const char *s)
+{
+    return strncasecmp(s, "the ", 4) ? s : s + 4;
+}
+static int cmp_title(const void *a, const void *b)
+{
+    int r = strnatcasecmp(skip_the(T(*(const int *)a)), skip_the(T(*(const int *)b)));
+    return r ? r : strnatcasecmp(AR(*(const int *)a), AR(*(const int *)b));
+}
+static int cmp_artist(const void *a, const void *b)
+{
+    int r = strnatcasecmp(skip_the(AR(*(const int *)a)), skip_the(AR(*(const int *)b)));
+    return r ? r : strnatcasecmp(T(*(const int *)a), T(*(const int *)b));
+}
+
+/* ---- duplicate finding: the same song stored more than once -------- */
+/* a title/artist cut down to what makes it that song: lower case letters
+ * and digits only, no track number in front, no "The", and none of the
+ * tags copies pick up ("(Remastered 2011)", "[Explicit]", "(1)", "copy",
+ * "feat. ..."). Live / remix / acoustic versions stay different songs. */
+static bool tag_is_junk(const char *s, int n)
+{
+    static const char *const junk[] = { "remaster", "explicit", "clean", "feat", "ft.",
+        "with ", "official", "audio", "video", "lyric", "hq", "hd", "bonus", "deluxe",
+        "album version", "single version", "radio edit", "mono", "stereo", "copy", "version" };
+    static const char *const keep[] = { "live", "remix", "mix", "acoustic", "instrumental",
+        "demo", "cover", "karaoke", "slowed", "sped", "reverb", "nightcore", "edit)" };
+    char t[64]; int m = 0;
+    for (int i = 0; i < n && m < 63; i++) t[m++] = tolower((unsigned char)s[i]);
+    t[m] = '\0';
+    bool digits = m > 0;
+    for (int i = 0; i < m; i++) if (!isdigit((unsigned char)t[i]) && t[i] != ' ') digits = false;
+    if (digits) return true;                       /* "(1)", "(2)", "(2011)" */
+    for (unsigned i = 0; i < sizeof(keep) / sizeof(*keep); i++)
+        if (strstr(t, keep[i]) && !strstr(t, "remaster")) return false;
+    for (unsigned i = 0; i < sizeof(junk) / sizeof(*junk); i++)
+        if (strstr(t, junk[i])) return true;
+    return false;
+}
+static void dup_key(const char *s, char *out, int n, bool artist)
+{
+    int o = 0;
+    while (*s == ' ') s++;
+    if (!artist)
+    {
+        /* "01 Song", "01. Song", "1-03 Song", "01 - Song" */
+        const char *q = s; int d = 0;
+        while (isdigit((unsigned char)*q) && d < 3) { q++; d++; }
+        if (d && *q == '-' && isdigit((unsigned char)q[1]))
+            { q++; while (isdigit((unsigned char)*q)) q++; }
+        if (d && (*q == ' ' || *q == '.' || *q == '_' || *q == '-'))
+        {
+            while (*q == ' ' || *q == '.' || *q == '_' || *q == '-') q++;
+            if (*q) s = q;
+        }
+    }
+    if (!strncasecmp(s, "the ", 4)) s += 4;
+    for (const char *p = s; *p && o < n - 1; p++)
+    {
+        unsigned char c = *p;
+        if (c == '(' || c == '[' || c == '{')
+        {
+            char close = c == '(' ? ')' : c == '[' ? ']' : '}';
+            const char *e = strchr(p + 1, close);
+            if (e && tag_is_junk(p + 1, e - p - 1)) { p = e; continue; }
+            if (!e && tag_is_junk(p + 1, strlen(p + 1))) break;
+            continue;
+        }
+        if (c == ' ' || c == '-' || c == ',' || c == '&' || c == ';' || c == '/')
+        {
+            const char *w = p; while (*w == ' ' || *w == '-' || *w == ',') w++;
+            if (artist)
+            {
+                /* only the main artist: "A feat. B", "A, B", "A & B", "A x B" */
+                if (c == ',' || c == '&' || c == ';' || c == '/') break;
+                if (!strncasecmp(w, "feat", 4) || !strncasecmp(w, "ft.", 3)
+                    || !strncasecmp(w, "ft ", 3) || !strncasecmp(w, "x ", 2)
+                    || !strncasecmp(w, "with ", 5)) break;
+            }
+            else
+            {
+                if (!strncasecmp(w, "feat", 4) || !strncasecmp(w, "ft.", 3)
+                    || !strncasecmp(w, "ft ", 3)) break;
+                /* " - Remastered 2011", " copy" at the very end */
+                if (c == '-' && tag_is_junk(w, strlen(w))) break;
+                if (!strcasecmp(w, "copy")) break;
+            }
+            continue;
+        }
+        if (isalnum(c)) out[o++] = tolower(c);
+        else if (c >= 0x80) out[o++] = c;          /* accents / other scripts as is */
+    }
+    out[o] = '\0';
+    if (!o && n > 1) { strlcpy(out, s, n); }       /* nothing left: use it whole */
+}
+static bool unknown_artist(int e) { return !strcmp(AR(e), "Unknown Artist"); }
+static int cmp_dup(const void *a, const void *b)
+{
+    int x = *(const int *)a, y = *(const int *)b;
+    char ka[96], kb[96];
+    dup_key(T(x), ka, sizeof(ka), false);
+    dup_key(T(y), kb, sizeof(kb), false);
+    int r = strcmp(ka, kb);
+    if (r) return r;
+    bool ux = unknown_artist(x), uy = unknown_artist(y);
+    if (ux != uy) return ux - uy;                  /* tagged copies first */
+    dup_key(AR(x), ka, sizeof(ka), true);
+    dup_key(AR(y), kb, sizeof(kb), true);
+    r = strcmp(ka, kb);
+    return r ? r : x - y;                          /* the first one found stays */
+}
+
+static int cmp_crc(const void *a, const void *b)
+{
+    uint32_t x = L[*(const int *)a].crc, y = L[*(const int *)b].crc;
+    return x < y ? -1 : x > y;
+}
+
+/* the library entry for a file, so folders can show real song names */
+static int lib_find(const char *path)
+{
+    if (lib_handle <= 0 || !lib_n) return -1;
+    uint32_t c = crc_32(path, strlen(path), 0xffffffff);
+    int lo = 0, hi = lib_n - 1;
+    while (lo <= hi)
+    {
+        int mid = (lo + hi) / 2;
+        uint32_t v = L[by_crc[mid]].crc;
+        if (v == c) return by_crc[mid];
+        if (v < c) lo = mid + 1; else hi = mid - 1;
+    }
+    return -1;
+}
+
+/* the spinning record player: call as often as you like while working,
+ * it only redraws when the animation moves on a frame. Always just one
+ * calm line of text ("LOADING"), so nothing jumps around. */
+static long load_start, load_last;
+static int load_frame = -1;
+static void loading_screen(const char *line1, const char *line2)
+{
+    if (!load_start || TIME_AFTER(current_tick, load_last + HZ))
+        { load_start = current_tick; load_frame = -1; }
+    load_last = current_tick;
+    load_frame = (current_tick - load_start) / aui_loading_ticks(LDR_MUSIC);
+    /* only the "build the library" screen keeps its own words */
+    bool building = line1 && !strncmp(line1, "BUILDING", 8);
+    aui_loading(LDR_MUSIC, building ? line1 : "LOADING",
+                building ? line2 : NULL, load_start, false);
+}
+static void loading_tick(const char *line1, const char *line2)
+{
+    long f = (current_tick - load_start) / aui_loading_ticks(LDR_MUSIC);
+    if (TIME_AFTER(current_tick, load_last + HZ) || f != load_frame)
+        loading_screen(line1, line2);
+    else
+        load_last = current_tick;
+}
+
+bool asher_np_skip_intro;
+
+/* playback was started: keep the record player going until the song is
+ * actually loaded (at least a moment, so it never just flashes) */
+static int playback_started(void)
+{
+    long t0 = current_tick;
+    while (TIME_BEFORE(current_tick, t0 + HZ * 4)
+           && (TIME_BEFORE(current_tick, t0 + HZ * 7 / 10) || !audio_current_track()))
+    {
+        loading_tick("LOADING", NULL);
+        sleep(1);
+    }
+    aui_end();
+    asher_np_skip_intro = true;
+    /* Now Playing opens on top of this list, so Menu comes back here */
+    asher_nowplaying();
+    return 0;
+}
+
+/* ---- the play queue survives starting something else ---------------
+ * Queued songs are kept aside when a new playlist is made and put back in
+ * front of it once it starts, so songs queued from different playlists
+ * stay in one queue */
+#define QKEEP 60
+static char qk_path[QKEEP][MAX_PATH];
+static int qk_n;
+static bool qk_front;      /* put them first, before the new list's first song */
+static void queue_keep(void)
+{
+    struct playlist_info *pl = playlist_get_current();
+    struct playlist_track_info info;
+    if (qk_front) return;              /* already set aside (queue_start) */
+    qk_n = 0;
+    if (!pl->started || pl->amount <= 0 || pl->index < 0) return;
+    for (int ahead = 1; pl->index + ahead < pl->amount && qk_n < QKEEP; ahead++)
+        if (playlist_is_queued_ahead(ahead)
+            && playlist_get_track_info(NULL, pl->index + ahead, &info) >= 0)
+            strlcpy(qk_path[qk_n++], info.filename, MAX_PATH);
+}
+static void queue_restore(void)
+{
+    for (int k = 0; k < qk_n; k++)
+        playlist_insert_track(NULL, qk_path[k], PLAYLIST_INSERT, true, k == qk_n - 1);
+    qk_n = 0;
+}
+/* a queued song that will play first anyway (left out of the shuffle) */
+static bool queued_first(const char *path)
+{
+    if (!qk_front) return false;
+    for (int k = 0; k < qk_n; k++)
+        if (!strcmp(qk_path[k], path)) return true;
+    return false;
+}
+/* a new playlist, keeping what's queued */
+static int new_playlist(void)
+{
+    queue_keep();
+    return playlist_create(NULL, NULL);
+}
+/* songs added while nothing was loaded: the list waits for Play */
+bool asher_queue_unstarted;
+static int shuffle_all(void);
+/* Play on that waiting queue: play the queued songs, then keep going with
+ * a shuffle of every song (it used to stop after the last one) */
+void asher_queue_start(void)
+{
+    struct playlist_track_info info;
+    int n = playlist_amount();
+    asher_queue_unstarted = false;
+    qk_n = 0;
+    for (int i = 0; i < n && qk_n < QKEEP; i++)
+        if (playlist_get_track_info(NULL, i, &info) >= 0)
+            strlcpy(qk_path[qk_n++], info.filename, MAX_PATH);
+    if (qk_n == 0) return;
+    qk_front = true;
+    if (shuffle_all() <= 0 && qk_front)
+    {
+        /* couldn't make the shuffle: just play what was queued */
+        qk_front = false;
+        qk_n = 0;
+        playlist_start(0, 0, 0);
+    }
+}
+
+/* start the current playlist at 'start'; honours the Shuffle setting.
+ * force_shuffle: shuffle everything (the Shuffle item) */
+static int begin_play(int start, bool force_shuffle)
+{
+    if (force_shuffle && !global_settings.playlist_shuffle)
+    {
+        global_settings.playlist_shuffle = true;
+        settings_save();
+    }
+    if (force_shuffle && asher_shufmode == SHUF_OFF)
+    {
+        asher_shufmode = SHUF_SONGS;
+        asher_prefs_save();
+    }
+    if (global_settings.playlist_shuffle)
+    {
+        int r = playlist_shuffle(current_tick, force_shuffle ? -1 : start);
+        start = force_shuffle ? 0 : r;
+    }
+    asher_queue_unstarted = false;
+    if (qk_front)
+    {
+        /* the queue comes first, then the (shuffled) list carries on */
+        qk_front = false;
+        for (int k = 0; k < qk_n; k++)
+            playlist_insert_track(NULL, qk_path[k], k, true, k == qk_n - 1);
+        qk_n = 0;
+        playlist_start(0, 0, 0);
+        return playback_started();
+    }
+    playlist_start(start, 0, 0);
+    queue_restore();
+    return playback_started();
+}
+
+/* turn shuffle on/off, also for what is playing right now */
+void asher_shuffle_set(bool on)
+{
+    struct playlist_info *pl = playlist_get_current();
+    global_settings.playlist_shuffle = on;
+    if (pl->started && (audio_status() & AUDIO_STATUS_PLAY))
+    {
+        if (on) playlist_randomise(pl, current_tick, true);
+        else    playlist_sort(pl, true);
+    }
+    settings_save();
+    if (on != (asher_shufmode != SHUF_OFF))
+    {
+        asher_shufmode = on ? SHUF_SONGS : SHUF_OFF;
+        asher_prefs_save();
+    }
+}
+
+static int shuffle_set_item(void *p)
+{
+    asher_shuffle_set((int)(intptr_t)p != 0);
+    splash(HZ, global_settings.playlist_shuffle ? "Shuffle: On" : "Shuffle: Off");
+    return 0;
+}
+static int shuffle_get(void) { return global_settings.playlist_shuffle ? 1 : 0; }
+ASHER_CHOICE(shf1, "On", shuffle_set_item, 1, shuffle_get, 1);
+ASHER_CHOICE(shf0, "Off", shuffle_set_item, 0, shuffle_get, 0);
+MAKE_MENU(asher_shuffle_item, "Shuffle", NULL, Icon_NOICON, &shf1, &shf0);
+
+/* where everything lives inside the one memory block */
+static void lib_layout(int n)
+{
+    char *base = core_get_data_pinned(lib_handle);   /* stays pinned */
+    L = (struct lent *)base;
+    by_title = (int *)(L + n);
+    by_artist = by_title + n;
+    results = by_artist + n;
+    by_crc = results + n;
+    A = (struct artist *)(by_crc + n);
+    pool = (char *)(A + n);
+}
+
+/* The finished index is saved to the drive, so the next time the iPod
+ * starts, opening All Songs / Artists / Search takes a moment instead of
+ * reading the whole music database again (very slow on older iPods). */
+#define LIB_CACHE "/.rockbox/asher/library.idx"
+#define DB_IDX    "/.rockbox/database_idx.tcd"
+struct lib_hdr { char magic[4]; int32_t n, u, nart, dbcount; uint32_t pool_used, pool_cap, size, dbsize; };
+
+static uint32_t db_size(void)
+{
+    int fd = open(DB_IDX, O_RDONLY);
+    if (fd < 0) return 0;
+    uint32_t sz = (uint32_t)lseek(fd, 0, SEEK_END);
+    close(fd);
+    return sz;
+}
+
+static void lib_cache_save(void)
+{
+    struct lib_hdr h = { { 'A', 'L', 'B', '4' }, lib_n, lib_u, lib_nart, lib_dbcount,
+                         pool_used, pool_cap, lib_size, db_size() };
+    int fd = open(LIB_CACHE, O_WRONLY | O_CREAT | O_TRUNC, 0666);
+    if (fd < 0) return;
+    bool ok = write(fd, &h, sizeof(h)) == sizeof(h)
+              && write(fd, core_get_data(lib_handle), lib_size) == (ssize_t)lib_size;
+    close(fd);
+    if (!ok) remove(LIB_CACHE);
+}
+
+static bool lib_cache_load(long dbcount)
+{
+    struct lib_hdr h;
+    int fd = open(LIB_CACHE, O_RDONLY);
+    if (fd < 0) return false;
+    if (read(fd, &h, sizeof(h)) != sizeof(h) || memcmp(h.magic, "ALB4", 4)
+        || h.dbcount != dbcount || h.dbsize != db_size() || h.n <= 0)
+        { close(fd); return false; }
+    lib_free();
+    lib_handle = asher_alloc(h.size);
+    if (lib_handle <= 0) { lib_handle = -1; close(fd); return false; }
+    lib_layout(h.n);
+    bool ok = read(fd, (void *)L, h.size) == (ssize_t)h.size;
+    close(fd);
+    if (!ok) { lib_free(); return false; }
+    lib_size = h.size; lib_n = h.n; lib_u = h.u; lib_nart = h.nart;
+    lib_cap = h.n; pool_used = h.pool_used; pool_cap = h.pool_cap;
+    lib_dbcount = h.dbcount;
+    return true;
+}
+
+static bool lib_build(void)
+{
+    struct tagcache_search tcs;
+    static char fname[MAX_PATH];
+    char tb[128], ab[128], msg[48];
+    int n, i = 0;
+
+    if (!tagcache_search(&tcs, tag_filename)) return false;
+    n = tcs.entry_count;
+    if (n <= 0) { tagcache_search_finish(&tcs); return false; }
+
+    lib_free();
+    pool_cap = (size_t)n * 72 + 4096;
+    if (pool_cap > 3 * 1024 * 1024) pool_cap = 3 * 1024 * 1024;
+    size_t sz = (size_t)n * (sizeof(struct lent) + 4 * sizeof(int) + sizeof(struct artist))
+                + pool_cap + 64;
+    lib_handle = asher_alloc(sz);
+    if (lib_handle <= 0) { tagcache_search_finish(&tcs); lib_handle = -1; return false; }
+    lib_size = sz;
+    lib_layout(n);
+    pool[0] = '\0';
+    pool_used = 1;
+    lib_cap = n;
+
+    while (i < n && tagcache_get_next(&tcs, fname, sizeof(fname)))
+    {
+        int32_t idx = tcs.idx_id;
+        if (!tagcache_retrieve(&tcs, idx, tag_title, tb, sizeof(tb)) || !tb[0]
+            || !strcmp(tb, UNTAGGED))
+        {
+            const char *b = strrchr(fname, '/');
+            strlcpy(tb, b ? b + 1 : fname, sizeof(tb));
+            char *dot = strrchr(tb, '.');
+            if (dot && dot != tb) *dot = '\0';
+        }
+        if (!tagcache_retrieve(&tcs, idx, tag_artist, ab, sizeof(ab)) || !ab[0]
+            || !strcmp(ab, UNTAGGED))
+            strlcpy(ab, "Unknown Artist", sizeof(ab));
+        L[i].idx = idx;
+        L[i].dup = 0;
+        L[i].crc = crc_32(fname, strlen(fname), 0xffffffff);
+        L[i].title = pool_add(tb);
+        L[i].artist = pool_add(ab);
+        by_title[i] = by_artist[i] = i;
+        i++;
+        if ((i & 63) == 0)
+        {
+            snprintf(msg, sizeof(msg), "%d of %d songs", i, n);
+            loading_screen("LOADING LIBRARY", msg);
+            yield();
+        }
+        else if ((i & 7) == 0)
+            loading_tick("LOADING LIBRARY", NULL);
+    }
+    tagcache_search_finish(&tcs);
+    lib_n = i;
+    lib_dbcount = n;
+
+    for (int k = 0; k < lib_n; k++) by_crc[k] = k;
+    qsort(by_crc, lib_n, sizeof(int), cmp_crc);
+    /* the same song more than once (same cleaned-up name and main artist,
+     * or a copy with no artist next to a tagged one): keep only one */
+    loading_screen("LOADING LIBRARY", "finding duplicates");
+    qsort(by_artist, lib_n, sizeof(int), cmp_dup);
+    {
+        char kt[96], ka[96], pt[96] = "", pa[96] = "";
+        bool group_kept = false;
+        for (int k = 0; k < lib_n; k++)
+        {
+            int e = by_artist[k];
+            dup_key(T(e), kt, sizeof(kt), false);
+            bool same_title = !strcmp(kt, pt);
+            if (!same_title) { strcpy(pt, kt); pa[0] = '\0'; group_kept = false; }
+            if (unknown_artist(e))
+            {
+                if (group_kept) L[e].dup = 1;
+                else group_kept = true;
+                continue;
+            }
+            dup_key(AR(e), ka, sizeof(ka), true);
+            if (group_kept && !strcmp(ka, pa)) L[e].dup = 1;
+            else { strcpy(pa, ka); group_kept = true; }
+            if ((k & 255) == 0) yield();
+        }
+    }
+    for (int k = 0; k < lib_n; k++) by_artist[k] = k;
+    qsort(by_title, lib_n, sizeof(int), cmp_title);
+    qsort(by_artist, lib_n, sizeof(int), cmp_artist);
+    lib_u = 0;
+    for (int k = 0; k < lib_n; k++)
+        if (!L[by_title[k]].dup) by_title[lib_u++] = by_title[k];
+    int u2 = 0;
+    for (int k = 0; k < lib_n; k++)
+        if (!L[by_artist[k]].dup) by_artist[u2++] = by_artist[k];
+    lib_nart = 0;
+    for (int k = 0; k < lib_u; k++)
+    {
+        int e = by_artist[k];
+        if (lib_nart && !strcasecmp(pool + A[lib_nart - 1].name, AR(e)))
+            A[lib_nart - 1].count++;
+        else
+        {
+            A[lib_nart].name = L[e].artist;
+            A[lib_nart].start = k;
+            A[lib_nart].count = 1;
+            lib_nart++;
+        }
+    }
+    lib_cache_save();
+    return lib_n > 0;
+}
+
+/* make sure the database is ready and our index is current */
+static bool library_ready(void)
+{
+    struct tagcache_search tcs;
+    if (!tagcache_is_usable())
+    {
+        struct tagcache_stat *st = tagcache_get_stat();
+        aui_begin();
+        while (!tagcache_is_usable())
+        {
+            char msg[64];
+            st = tagcache_get_stat();
+            /* 2.5.5: right after start-up the database is still being
+             * opened (a hard drive takes a few seconds to spin up). That
+             * used to look like "no database" and wiped and rebuilt the
+             * whole library every time, and saving the rebuilt library
+             * then stopped the music. Now it waits for the check, and only
+             * builds a library when there really isn't one */
+            bool checked = st->initialized && (st->ready || st->readyvalid);
+            if (checked && !st->ready && st->commit_step == 0
+                && !st->commit_delayed && !rebuild_requested)
+            {
+                rebuild_requested = true;
+                tagcache_rebuild();
+            }
+            if (!checked)
+                snprintf(msg, sizeof(msg), "Opening your library...");
+            else if (st->commit_delayed && audio_status() != 0)
+                snprintf(msg, sizeof(msg), "Finishes when the music stops");
+            else if (st->commit_delayed)
+                snprintf(msg, sizeof(msg), "Restart your iPod to finish");
+            else if (st->commit_step > 0)
+                snprintf(msg, sizeof(msg), "Finishing up... step %d", st->commit_step);
+            else
+                snprintf(msg, sizeof(msg), "Found %d files so far", st->processed_entries);
+            loading_screen("BUILDING LIBRARY", msg);
+            int a = get_action(CONTEXT_STD, aui_loading_ticks(LDR_MUSIC));
+            if (a == ACTION_STD_CANCEL || a == ACTION_STD_MENU) { aui_end(); return false; }
+            if (a != ACTION_NONE) default_event_handler(a);
+        }
+        aui_end();
+    }
+    if (lib_handle > 0)
+    {
+        if (!tagcache_search(&tcs, tag_filename)) return lib_n > 0;
+        long cnt = tcs.entry_count;
+        tagcache_search_finish(&tcs);
+        if (cnt == lib_dbcount) return lib_n > 0;
+    }
+    aui_begin();
+    loading_screen("LOADING LIBRARY", NULL);
+    bool ok = false;
+    if (tagcache_search(&tcs, tag_filename))
+    {
+        long cnt = tcs.entry_count;
+        tagcache_search_finish(&tcs);
+        ok = lib_cache_load(cnt);
+    }
+    if (!ok) ok = lib_build();
+    aui_end();
+    if (!ok) splash(2 * HZ, "No songs found");
+    return ok;
+}
