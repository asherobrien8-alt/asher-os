+static bool ej_on;       /* the eject screen is up */
+static int  ej_pct;      /* how full the bar is drawn, 0..1000 */
+
+static void ej_bar(void)
+{
+    lcd_set_viewport(NULL);
+    lcd_set_drawmode(DRMODE_SOLID);
+    if (m_modern())
+    {
+        /* grey track, blue fill, on white */
+        int w = (EJ_BW - 4) * ej_pct / 1000;
+        lcd_set_foreground(LCD_WHITE);
+        lcd_fillrect(EJ_BX, EJ_BY, EJ_BW, EJ_BH);
+        lcd_set_foreground(LCD_RGBPACK(229, 229, 234));
+        lcd_fillrect(EJ_BX + 2, EJ_BY + 4, EJ_BW - 4, EJ_BH - 8);
+        lcd_set_foreground(LCD_RGBPACK(0, 122, 255));
+        if (w > 0) lcd_fillrect(EJ_BX + 2, EJ_BY + 4, w, EJ_BH - 8);
+        lcd_update_rect(EJ_BX, EJ_BY, EJ_BW, EJ_BH);
+        return;
+    }
+    lcd_bitmap_part((const fb_data *)bm_usbok.data, EJ_BX, EJ_BY, LCD_WIDTH,
+                    EJ_BX, EJ_BY, EJ_BW, EJ_BH);
+    lcd_set_foreground(LCD_WHITE);
+    lcd_drawrect(EJ_BX + 1, EJ_BY, EJ_BW - 2, EJ_BH);
+    lcd_drawrect(EJ_BX, EJ_BY + 1, EJ_BW, EJ_BH - 2);
+    int w = (EJ_BW - 8) * ej_pct / 1000;
+    if (w > 0) lcd_fillrect(EJ_BX + 4, EJ_BY + 4, w, EJ_BH - 8);
+    lcd_update_rect(EJ_BX, EJ_BY, EJ_BW, EJ_BH);
+}
+
+static void ej_begin(void)
+{
+    if (ej_on) return;
+    ej_on = true;
+    ej_pct = 0;
+    lcd_set_viewport(NULL);
+    lcd_set_drawmode(DRMODE_SOLID);
+    if (m_modern())
+    {
+        lcd_set_foreground(LCD_WHITE);
+        lcd_fillrect(0, 0, LCD_WIDTH, LCD_HEIGHT);
+        lcd_bitmap(m_frame(&m_usb, 0), (LCD_WIDTH - m_usb.w) / 2, M_AY, m_usb.w, m_usb.h);
+        lcd_bitmap(m_frame(&m_txt, 1), (LCD_WIDTH - m_txt.w) / 2, M_AY + m_usb.h + 6,
+                   m_txt.w, m_txt.h);
+    }
