@@ -0,0 +1,37 @@
+#ifndef ASHER_LIST_H
+#define ASHER_LIST_H
+#include <stdbool.h>
+#include <stddef.h>
+
+#define AUI_BACK (-1)
+
+struct aui_list;
+/* fill buf with the item's main text, sub (may be NULL) with its second line */
+typedef void (*aui_list_get_fn)(struct aui_list *l, int i, char *buf, size_t n,
+                                char *sub, size_t subn);
+/* return 0 to stay, AUI_BACK to leave the list, or a GO_TO_* code (> 0) */
+typedef int (*aui_list_sel_fn)(struct aui_list *l, int i);
+
+struct aui_list {
+    const char *title;
+    int count;
+    int sel, top;
+    bool two_line;
+    bool chevrons;        /* show ">" on every row (submenus) */
+    bool letter_jump;     /* big first-letter bubble while fast scrolling */
+    aui_list_get_fn get;
+    aui_list_sel_fn select;
+    void *data;
+    /* optional: how row i looks (AUI_ROW_* flags) */
+    int (*style)(struct aui_list *l, int i);
+    bool music;           /* the music keys (play, skip, seek) work here */
+    /* optional: hold Play on row i (the song menu); returns like select */
+    int (*hold)(struct aui_list *l, int i);
+};
+#define AUI_ROW_ACTION 1   /* a button row (e.g. SHUFFLE SONGS): centred, no letter bubble */
+#define AUI_ROW_DOT    2   /* what's playing right now: a red dot */
+#define AUI_ROW_CHECK  4   /* the option that's set: a checkmark */
+
+int aui_list_run(struct aui_list *l);
+void aui_list_draw(struct aui_list *l, int letter);
+#endif
diff --git a/apps/asher/asher_media.c b/apps/asher/asher_media.c
new file mode 100644
index 0000000000..e1068145d5
--- /dev/null
+++ b/apps/asher/asher_media.c
@@ -0,0 +1,114 @@
+/* Asher OS music controls shared by several screens. */
+#include "config.h"
+#include "system.h"
+#include "kernel.h"
+#include "action.h"
+#include "audio.h"
+#include "metadata.h"
+#include "misc.h"
+#include "settings.h"
+#include "playlist.h"
+#include "gui/wps.h"
+#include "asher_music.h"
+#include "asher_media.h"
+
+static void play_pause(void)
+{
+    struct wps_state *ws = get_wps_state();
+    int st = audio_status();
+    if (!st && asher_queue_unstarted)
+    {
+        /* songs were added to the queue while nothing was loaded */
+        asher_queue_start();
+        return;
+    }
+    if (!st)
+    {
+        asher_resume_paused();             /* nothing loaded: the last song */
+        st = audio_status();
+        if (!st) return;
+    }
+    if (st & AUDIO_STATUS_PAUSE)
+    {
+        ws->paused = false;
+        wps_do_action(WPS_PLAY, false);
+    }
+    else
+    {
+        ws->paused = true;
+        wps_do_action(WPS_PAUSE, false);
+    }
+}
+
+bool asher_media_show_vol(const struct amedia *m)
+{
+    return m->vol_until && TIME_BEFORE(current_tick, m->vol_until);
+}
+
+bool asher_media(struct amedia *m, int a)
+{
+    struct mp3entry *id3 = audio_current_track();
+    int st = audio_status();
+    switch (a)
+    {
+        case ACTION_WPS_PLAY:
+            play_pause();
+            return true;
+        case ACTION_WPS_SKIPNEXT:
+            if (st) audio_next();
+            return true;
+        case ACTION_WPS_SKIPPREV:
+            if (!st) return true;
+            if (id3 && id3->elapsed > 3000)
+            {
+                audio_pre_ff_rewind();
+                audio_ff_rewind(0);
+            }
+            else
+                audio_prev();
+            return true;
+        case ACTION_WPS_SEEKFWD:
+        case ACTION_WPS_SEEKBACK:
+        {
+            int dir = a == ACTION_WPS_SEEKFWD ? 1 : -1;
+            if (!m->seeking)
+            {
+                if (!(st & AUDIO_STATUS_PLAY) || !id3 || !id3->length) return true;
+                audio_pre_ff_rewind();
+                m->seeking = true;
+                m->seek_pos = id3->elapsed;
+                m->step = 1000 * MAX(1, global_settings.ff_rewind_min_step);
+            }
+            m->seek_pos += dir * m->step;
+            m->step += m->step >> 3;
+            if (m->seek_pos < 0) m->seek_pos = 0;
+            if (id3 && m->seek_pos > (long)id3->length) m->seek_pos = id3->length;
+            return true;
+        }
+        case ACTION_WPS_STOPSEEK:
+            if (m->seeking)
+            {
+                audio_ff_rewind(m->seek_pos);
+                m->seeking = false;
+            }
+            return true;
+        case ACTION_WPS_VOLUP:
+        case ACTION_WPS_VOLDOWN:
+            adjust_volume(a == ACTION_WPS_VOLUP ? 1 : -1);
+            setvol();
+            m->vol_until = current_tick + HZ * 3 / 2;
+            return true;
+    }
+    return false;
+}
+
+long asher_ticks_to_next_second(void)
+{
+    struct mp3entry *id3 = audio_current_track();
+    int st = audio_status();
+    if (!(st & AUDIO_STATUS_PLAY) || (st & AUDIO_STATUS_PAUSE) || !id3)
+        return HZ;
+    long ms = 1000 - (long)(id3->elapsed % 1000) + 15;   /* just after it ticks over */
+    long t = ms * HZ / 1000;
+    return t < 1 ? 1 : t;
+}
