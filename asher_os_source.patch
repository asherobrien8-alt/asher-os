+/* Asher OS Now Playing: album art, song + artist, play/pause status,
+ * kbps, elapsed / total time. The background is the album art blown up
+ * and blurred (or a soft colour blend when a song has no art). */
+#include <stdio.h>
+#include <string.h>
+#include "config.h"
+#include "string-extra.h"
+#include "system.h"
+#include "kernel.h"
+#include "action.h"
