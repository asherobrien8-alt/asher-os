diff --git a/apps/asher/asher_theme.c b/apps/asher/asher_theme.c
new file mode 100644
index 0000000..17354d1
--- /dev/null
+++ b/apps/asher/asher_theme.c
@@ -0,0 +1,64 @@
+#include <stdio.h>
+#include <string.h>
+#include <fcntl.h>
+#include "config.h"
+#include "file.h"
+#include "settings.h"
+#include "menu.h"
+#include "splash.h"
+#include "lang.h"
+#include "asher_theme.h"
+#include "asher_wallpaper.h"
+
+#define ASHER_THEME_DIR  "/.rockbox/asher/themes/"
+#define STATE_FILE "/.rockbox/asher/theme.txt"
+#define NUM_THEMES 5
+
+static const char *theme_file[NUM_THEMES] = { "street", "glass", "dark", "classic", "arcade" };
+static const char *theme_name[NUM_THEMES] = { "Street", "Glass", "Dark", "Classic", "Arcade" };
+static int cur_theme = 0;
+
+static void save_state(void)
+{
+    int fd = open(STATE_FILE, O_WRONLY | O_CREAT | O_TRUNC, 0666);
+    if (fd >= 0) { char c = '0' + cur_theme; write(fd, &c, 1); close(fd); }
+}
+
+static void apply(int i)
+{
+    char path[MAX_PATH];
+    cur_theme = i;
+    snprintf(path, sizeof(path), ASHER_THEME_DIR "%s.cfg", theme_file[i]);
+    settings_load_config(path, true);
+    asher_wallpaper_auto = (i == 0);   /* Street follows the time of day */
+    if (i == 0)      asher_wallpaper_set_scene(asher_scene_for_time());
+    else if (i == 1) asher_wallpaper_set_scene("glass");
+    else if (i == 4) asher_wallpaper_set_scene("arcade");
+    else             asher_wallpaper_stop();
+    save_state();
+}
+
+void asher_theme_apply_saved(void)
+{
+    int fd = open(STATE_FILE, O_RDONLY);
+    int i = 0;
+    if (fd >= 0) { char c; if (read(fd, &c, 1) == 1 && c >= '0' && c < '0' + NUM_THEMES) i = c - '0'; close(fd); }
+    apply(i);
+}
+
+static int theme_cycle(void)
+{
+    apply((cur_theme + 1) % NUM_THEMES);
+    splashf(HZ, "Theme: %s", theme_name[cur_theme]);
+    return 0;
+}
+
+static int wallpaper_toggle(void)
+{
+    asher_wallpaper_enabled = !asher_wallpaper_enabled;
+    splashf(HZ, "Live wallpaper: %s", asher_wallpaper_enabled ? "On" : "Off");
+    return 0;
+}
+
+MENUITEM_FUNCTION(asher_theme_item, 0, "Theme (tap to switch)", theme_cycle, NULL, Icon_NOICON);
+MENUITEM_FUNCTION(asher_wallpaper_item, 0, "Live Wallpaper On/Off", wallpaper_toggle, NULL, Icon_NOICON);
