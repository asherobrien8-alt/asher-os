+static void queue_cancel(void)
+{
+    loading_screen("LOADING", NULL);
+    int k = playlist_cancel_queue();
+    if (k == 1) splash(HZ, "Queue cleared");
+    else splashf(HZ, "Queue cleared (%d)", k);
+}
