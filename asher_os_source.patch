+#ifndef ASHER_WALLPAPER_H
+#define ASHER_WALLPAPER_H
+#include <stdbool.h>
+/* Frame-pack (.awp) format: "AWP1", u16 width, u16 height, u16 frames,
+ * u16 frame_ms, then frames of raw RGB565 (little endian). */
+void asher_wallpaper_set_scene(const char *name);   /* e.g. "sunrise" */
+void asher_wallpaper_stop(void);
+bool asher_wallpaper_tick(void);   /* true if a new frame was shown */
+const char *asher_scene_for_time(void);  /* morning / midday / night */
+extern bool asher_wallpaper_enabled;
+extern bool asher_wallpaper_auto;   /* follow time of day */
+#endif
diff --git a/apps/asher/moonphase.c b/apps/asher/moonphase.c
new file mode 100644
index 0000000..bbe9d9a
--- /dev/null
+++ b/apps/asher/moonphase.c
@@ -0,0 +1,20 @@
+#include "moonphase.h"
+
+/* Days since a known new moon (2000-01-06 18:14 UTC), mod synodic month. */
+int asher_moon_phase(int year, int month, int day)
+{
+    /* Julian day number at noon for the given date */
+    int a = (14 - month) / 12;
+    int y = year + 4800 - a;
+    int m = month + 12 * a - 3;
+    long jdn = day + (153 * m + 2) / 5 + 365L * y + y / 4 - y / 100
+               + y / 400 - 32045;
+
+    /* Work in hundredths of a day to avoid floats on the iPod CPU.
+     * Reference new moon JD = 2451550.26, synodic month = 29.530589 d */
+    long since = (jdn - 2451550L) * 100 - 26;
+    long cycle = 2953;                       /* 29.53 days, x100 */
+    long pos = since % cycle;
+    if (pos < 0) pos += cycle;
+    return (int)((pos * 8 + cycle / 2) / cycle) & 7;
+}
