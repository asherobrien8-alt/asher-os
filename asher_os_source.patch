diff --git a/apps/debug_menu.c b/apps/debug_menu.c
index c98d54ad64..8f3e244662 100644
--- a/apps/debug_menu.c
+++ b/apps/debug_menu.c
@@ -2815,7 +2815,7 @@ static bool view_ram_info(void)
     simplelist_info_init(&info, "RAM Info", 0, NULL);
 
     simplelist_reset_lines();
-    simplelist_addline("Rockbox: %d MB", MEMORYSIZE);
+    simplelist_addline("Asher OS: %d MB", MEMORYSIZE);
 
     struct sysinfo sys_info;
     if (sysinfo(&sys_info) == 0) {
diff --git a/apps/gui/bitmap/list.c b/apps/gui/bitmap/list.c
index c2e8896a3e..391389a290 100644
--- a/apps/gui/bitmap/list.c
+++ b/apps/gui/bitmap/list.c
@@ -350,6 +350,20 @@ void list_draw(struct screen *display, struct gui_synclist *list)
             line_indent++;
             entry_name++;
         }
+        /* Asher OS: a "\x01" at the end of an item's name means it's the
+         * option picked right now: draw a checkmark at the end of the row */
+        bool asher_check = false;
+        {
+            static unsigned char chk_buf[128];
+            size_t len = strlen((char *)entry_name);
+            if (len && entry_name[len - 1] == 0x01 && len < sizeof(chk_buf))
+            {
+                memcpy(chk_buf, entry_name, len - 1);
+                chk_buf[len - 1] = '\0';
+                entry_name = chk_buf;
+                asher_check = true;
+            }
+        }
         if (line_indent)
         {
             if (list->show_icons)
@@ -445,6 +459,28 @@ void list_draw(struct screen *display, struct gui_synclist *list)
         list_info.item_offset = item_offset;
 
         callback_draw_item(&list_info);
+#ifdef HAVE_LCD_COLOR
+        if (asher_check)
+        {
+            /* a bold tick, sized to the row, at the right edge */
+            int lh = linedes.height;
+            int ch = lh * 9 / 20, cw = ch * 4 / 3;
+            int cx = list_text_vp->width - cw - 10;
+            int cy = list_info.y + (lh - ch) / 2;
+            unsigned old_fg = display->get_foreground();
+            if (is_selected && (style & STYLE_GRADIENT))
+                display->set_foreground(linedes.text_color);
+            else
+                display->set_foreground(LCD_RGBPACK(10, 132, 255));
+            int mx = cx + cw * 3 / 8, my = cy + ch;
+            for (int t = 0; t < 3; t++)
+            {
+                display->drawline(cx, cy + ch / 2 + t - 1, mx, my + t - 1);
+                display->drawline(mx, my + t - 1, cx + cw, cy + t - 1);
+            }
+            display->set_foreground(old_fg);
+        }
+#endif
     }
     display->set_viewport(last_vp);
 }
diff --git a/apps/gui/list.c b/apps/gui/list.c
index 12f17cefef..f0af5ca1fc 100644
--- a/apps/gui/list.c
+++ b/apps/gui/list.c
@@ -119,7 +119,8 @@ void list_init_item_height(struct gui_synclist *list, enum screen_type screen)
     else
         list->line_height[screen] = line_height + global_settings.list_line_padding;
 #else
