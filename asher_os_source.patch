+#include "timefuncs.h"
+#include "root_menu.h"
+#include "gui/wps.h"
+#include "asher_ui.h"
+#include "asher_music.h"
+#include "asher_wallpaper.h"
+
+#define ART 120
+#define ART_X 20
+#define ART_Y (AUI_BAR + 16)
+#define COL_X (ART_X + ART + 14)
+#define COL_W (AUI_W - COL_X - 18)
+
+static const char *track_title(struct mp3entry *id3)
+{
+    if (id3->title && id3->title[0]) return id3->title;
+    const char *p = strrchr(id3->path, '/');
+    return p ? p + 1 : id3->path;
+}
+
+/* split s so the first line fits in w (break at a space when possible) */
+static void wrap2(const char *s, int font, int w, char *l1, char *l2, size_t n)
+{
+    size_t len = strlen(s), best = 0;
+    l1[0] = l2[0] = '\0';
+    if (aui_text_w(font, s) <= w) { strlcpy(l1, s, n); return; }
+    for (size_t i = 1; i <= len && i < n; i++)
+    {
+        if (s[i] != ' ' && s[i] != '\0') continue;
+        char tmp[160];
+        strlcpy(tmp, s, MIN(i + 1, sizeof(tmp)));
+        if (aui_text_w(font, tmp) <= w) best = i; else break;
+    }
+    if (!best) { strlcpy(l1, s, n); return; }   /* one long word: truncate */
+    strlcpy(l1, s, MIN(best + 1, n));
+    while (s[best] == ' ') best++;
+    strlcpy(l2, s + best, n);
+}
+
+static void draw(bool seeking, long seek_pos, bool show_vol)
+{
+    const struct aui_theme *t = aui_theme();
+    struct mp3entry *id3 = audio_current_track();
+    int st = audio_status();
+    bool playing = (st & AUDIO_STATUS_PLAY) && id3;
+    bool paused = st & AUDIO_STATUS_PAUSE;
+    bool glass = t->wallpaper && asher_wp_full();
+    char l1[160], l2[160], buf[48], b2[16];
+    long pos = playing ? (seeking ? seek_pos : (long)id3->elapsed) : 0;
+    long len = playing ? (long)id3->length : 0;
+
+    aui_background(true);
+    if (glass)
+        aui_shade(8, AUI_BAR + 6, AUI_W - 16, AUI_H - AUI_BAR - 12, 14, 70, 0x05060f);
+    aui_topbar();
+
+    /* album art */
+    aui_round(ART_X - 2, ART_Y - 2, ART + 4, ART + 4, 9,
+              t->light ? 0xd4d7de : 0x2e3258, t->light ? 0xd4d7de : 0x2e3258);
+    if (!aui_albumart(ART_X, ART_Y, ART))
+    {
+        aui_round(ART_X, ART_Y, ART, ART, 8, t->light ? 0xeef0f4 : 0x1c1f3d,
+                  t->light ? 0xdfe2e8 : 0x10122a);
+        aui_sprite_c(SPR_NOTE, ART_X + ART / 2, ART_Y + ART / 2);
+    }
+
+    /* progress or volume */
+    if (show_vol)
+        aui_progress(ART_X, 188, AUI_W - 2 * ART_X, 8, aui_volume_pct(), 100);
+    else if (playing)
+        aui_progress(ART_X, 188, AUI_W - 2 * ART_X, 8, pos, len);
+    else
+        aui_progress(ART_X, 188, AUI_W - 2 * ART_X, 8, 0, 1);
+    aui_present();
+
+    unsigned tc = glass ? 0xffffff : t->text;
+    unsigned sc = glass ? 0xc9cfee : t->sub;
+    if (playing)
+    {
+        aui_text(AF_SMALL, COL_X, ART_Y + 2, paused ? 0xffb347 : 0x5ee38a,
+                 paused ? "Currently Paused" : "Currently Playing", COL_W, 0);
+        wrap2(track_title(id3), AF_BIG, COL_W, l1, l2, sizeof(l1));
+        aui_text(AF_BIG, COL_X, ART_Y + 22, tc, l1, COL_W, 0);
+        int y = ART_Y + 44;
+        if (l2[0]) { aui_text(AF_BIG, COL_X, y, tc, l2, COL_W, 0); y += 22; }
+        aui_text(AF_MED, COL_X, y + 4,
+                 sc, (id3->artist && id3->artist[0]) ? id3->artist : "Unknown Artist", COL_W, 0);
+        if (id3->bitrate)
+        {
+            snprintf(buf, sizeof(buf), "%d kbps", id3->bitrate);
+            aui_text(AF_SMALLR, COL_X, ART_Y + ART - 14, sc, buf, COL_W, 0);
+        }
+    }
+    else
+    {
+        aui_text(AF_SMALL, COL_X, ART_Y + 2, sc, "Not Playing", COL_W, 0);
+        aui_text(AF_BIG, COL_X, ART_Y + 22, tc, "Nothing playing", COL_W, 0);
+        aui_text(AF_SMALLR, COL_X, ART_Y + 48, sc, "Pick something in Music", COL_W, 0);
+    }
+
+    if (show_vol)
+    {
+        snprintf(buf, sizeof(buf), "Volume %d%%", aui_volume_pct());
+        aui_text(AF_SMALL, AUI_W / 2, 202, tc, buf, 200, 1);
+    }
+    else if (playing)
+    {
+        aui_fmt_time(buf, sizeof(buf), pos);
+        aui_fmt_time(b2, sizeof(b2), len);
+        aui_text(AF_SMALL, ART_X, 202, tc, buf, 100, 0);
+        aui_text(AF_SMALL, AUI_W - ART_X, 202, tc, b2, 100, 2);
+    }
+    aui_topbar_text("Now Playing");
+    aui_update();
+}
+
+static void play_pause(void)
+{
+    struct wps_state *ws = get_wps_state();
+    if (audio_status() & AUDIO_STATUS_PAUSE)
+    {
+        ws->paused = false;
+        wps_do_action(WPS_PLAY, false);
+    }
+    else
+    {
+        ws->paused = true;
+        wps_do_action(WPS_PAUSE, false);
+    }
+}
+
+int asher_nowplaying(void)
+{
+    bool seeking = false, was_playing = false;
+    long seek_pos = 0, step = 1000, vol_until = 0, next_text = 0;
+    int frame = -1;
+
+    aui_begin();
+    aui_intro(LDR_NP);
+    while (1)
+    {
+        struct mp3entry *id3 = audio_current_track();
+        int st = audio_status();
+        bool on = aui_screen_on();
+        bool anim = asher_wp_animated() && aui_theme()->wallpaper;
+        bool show_vol = TIME_BEFORE(current_tick, vol_until);
+
+        if (st & AUDIO_STATUS_PLAY) was_playing = true;
+        else if (was_playing) break;           /* playlist finished */
+
+        if (on)
+        {
+            int f = asher_wp_frame_no();
+            if (TIME_AFTER(current_tick, next_text) || (anim && f != frame))
+            {
+                draw(seeking, seek_pos, show_vol);
+                frame = f;
+                next_text = current_tick + (seeking ? HZ / 10 : HZ / 2);
+            }
+        }
+        int timeout = !on ? HZ : (anim ? MIN(asher_wp_frame_ticks(), HZ / 2) : HZ / 2);
+        if (seeking) timeout = HZ / 10;
+        int a = get_action(CONTEXT_WPS, timeout);
+        switch (a)
+        {
+            case ACTION_WPS_PLAY:
+                play_pause();
+                next_text = 0;
+                break;
+            case ACTION_WPS_STOP:
+                audio_stop();
+                aui_end();
+                return GO_TO_PREVIOUS;
+            case ACTION_WPS_SKIPNEXT:
+                audio_next();
+                next_text = 0;
+                break;
+            case ACTION_WPS_SKIPPREV:
+                if (id3 && id3->elapsed > 3000)
+                {
+                    audio_pre_ff_rewind();
+                    audio_ff_rewind(0);
+                }
+                else
+                    audio_prev();
+                next_text = 0;
+                break;
+            case ACTION_WPS_SEEKFWD:
+            case ACTION_WPS_SEEKBACK:
+            {
+                int dir = a == ACTION_WPS_SEEKFWD ? 1 : -1;
+                if (!seeking)
+                {
+                    if (!(st & AUDIO_STATUS_PLAY) || !id3 || !id3->length) break;
+                    audio_pre_ff_rewind();
+                    seeking = true;
+                    seek_pos = id3->elapsed;
+                    step = 1000 * MAX(1, global_settings.ff_rewind_min_step);
+                }
+                seek_pos += dir * step;
+                step += step >> 3;
+                if (seek_pos < 0) seek_pos = 0;
+                if (id3 && seek_pos > (long)id3->length) seek_pos = id3->length;
+                next_text = 0;
+                break;
+            }
+            case ACTION_WPS_STOPSEEK:
+                if (seeking)
+                {
+                    audio_ff_rewind(seek_pos);
+                    seeking = false;
+                    next_text = 0;
+                }
+                break;
+            case ACTION_WPS_VOLUP:
+            case ACTION_WPS_VOLDOWN:
+                adjust_volume(a == ACTION_WPS_VOLUP ? 1 : -1);
+                setvol();
+                vol_until = current_tick + HZ * 3 / 2;
+                next_text = 0;
+                break;
+            case ACTION_WPS_MENU:
+                aui_end();
+                return GO_TO_PREVIOUS;
+            case ACTION_NONE:
+                if (!show_vol && vol_until) { vol_until = 0; next_text = 0; }
+                break;
+            default:
+                if (default_event_handler(a) == SYS_USB_CONNECTED)
+                    { aui_end(); return GO_TO_ROOT; }
+                break;
+        }
+    }
+    aui_end();
+    return GO_TO_PREVIOUS;
+}
diff --git a/apps/asher/asher_settings.c b/apps/asher/asher_settings.c
new file mode 100644
index 0000000000..ed28635245
