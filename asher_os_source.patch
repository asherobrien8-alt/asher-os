+/* everything in this menu back to how it came, except the volume (and
+ * playback things like crossfade, which would interrupt the music) */
+static int asher_sound_reset(void)
+{
+    static const char *line[] = { "Reset audio settings?" };
+    static const struct text_message msg = { line, 1 };
+    if (gui_syncyesno_run(&msg, NULL, NULL) != YESNO_YES)
+        return 0;
+    int count;
+    const struct settings_list *list = get_settings_list(&count);
+    for (int i = 0; i < count; i++)
+    {
+        const struct settings_list *st = &list[i];
+        if (!(st->flags & (F_SOUNDSETTING | F_EQSETTING))) continue;
+        void *v = st->setting;
+        if (v == &global_status.volume || v == &global_settings.volume_limit
+            || v == &global_status.resume_pitch || v == &global_status.resume_speed
+            || v == &global_settings.crossfade || v == &global_settings.timestretch_enabled
+            || v == &global_settings.crossfade_fade_in_delay
+            || v == &global_settings.crossfade_fade_out_delay
+            || v == &global_settings.crossfade_fade_in_duration
+            || v == &global_settings.crossfade_fade_out_duration
+            || v == &global_settings.crossfade_fade_out_mixmode)
+            continue;
+#ifdef HAVE_SPDIF_POWER
+        if (v == &global_settings.spdif_enable) continue;
+#endif
+        if (st->flags & F_DEPRECATED) continue;
+        reset_setting(st, v);
+    }
+    sound_settings_apply();
+    settings_apply(false);
+    settings_save();
+    splash(HZ, "Audio settings reset");
+    return 0;
+}
+MENUITEM_FUNCTION(asher_sound_reset_item, 0, "Reset Audio Settings",
+                  asher_sound_reset, NULL, Icon_NOICON);
