diff --git a/apps/asher/asher_boot.c b/apps/asher/asher_boot.c
new file mode 100644
index 0000000000..fc5dce5a48
--- /dev/null
+++ b/apps/asher/asher_boot.c
@@ -0,0 +1,166 @@
+/* Asher OS boot gate: after power-on the Asher OS logo stays up until the
+ * click wheel has been turned one full rotation. A bar fills as you turn
+ * and keeps its progress if you stop. Finishing plays a little chime. */
+#include <stdio.h>
+#include <string.h>
+#include "config.h"
+#include "system.h"
+#include "kernel.h"
+#include "button.h"
+#include "misc.h"
+#include "lcd.h"
+#include "backlight.h"
+#include "usb.h"
+#include "bitmaps/rockboxlogo.h"
+#include "asher_ui.h"
+#include "asher_boot.h"
+#include "asher_prefs.h"
+#include "gui/viewport.h"
+#if (defined(IPOD_6G) || defined(IPOD_VIDEO) || defined(IPOD_NANO3G)) && !defined(SIMULATOR)
+#include "piezo.h"
+#endif
+
+/* wheel events in one full turn: 96 clicks / clicks per step (Scroll Speed) */
+#define STEPS 30                 /* one full turn at 30 steps per spin */
+#define BAR_W 200
+#define BAR_H 10
+#define BAR_X ((AUI_W - BAR_W) / 2)
+#define BAR_Y 213
+
+static int boot_pending;
+
+static void chime(void)
+{
+#if (defined(IPOD_6G) || defined(IPOD_NANO3G)) && !defined(SIMULATOR)
+    /* three rising notes on the click speaker */
+    static const unsigned short notes[3][2] = { { 30, 150 }, { 24, 188 }, { 19, 236 } };
+    for (int i = 0; i < 3; i++)
+    {
+        piezo_note(notes[i][0], notes[i][1]);
+        sleep(HZ / 10);
+    }
+#elif defined(IPOD_VIDEO) && !defined(SIMULATOR)
+    static const unsigned short hz[3] = { 1320, 1660, 2090 };
+    for (int i = 0; i < 3; i++)
+    {
+        piezo_play_for_tick(piezo_hz(hz[i]), 0x80, HZ / 12);
+        sleep(HZ / 10);
+    }
+#endif
+}
+
+static bool by_button;           /* Start-Up: press the center button */
+static void draw(int steps)
+{
+    int fill = (BAR_W - 6) * steps / STEPS;
+    lcd_set_viewport(NULL);
+    lcd_bmp(&bm_rockboxlogo, (LCD_WIDTH - BMPWIDTH_rockboxlogo) / 2, 0);
+    /* chunky pixel bar in the logo's cream colour */
+    lcd_set_drawmode(DRMODE_SOLID);
+    lcd_set_foreground(LCD_RGBPACK(38, 38, 38));
+    lcd_fillrect(BAR_X - 4, BAR_Y - 4, BAR_W + 8, BAR_H + 22);
+    if (by_button) goto text;
+    lcd_set_foreground(LCD_RGBPACK(240, 230, 200));
+    lcd_fillrect(BAR_X + 2, BAR_Y, BAR_W - 4, 2);
+    lcd_fillrect(BAR_X + 2, BAR_Y + BAR_H - 2, BAR_W - 4, 2);
+    lcd_fillrect(BAR_X, BAR_Y + 2, 2, BAR_H - 4);
+    lcd_fillrect(BAR_X + BAR_W - 2, BAR_Y + 2, 2, BAR_H - 4);
+    for (int x = 0; x < fill; x += 6)          /* blocky fill, like a loading bar */
+    {
+        int t = x * 256 / (BAR_W - 6);
+        lcd_set_foreground(LCD_RGBPACK(176 + (t * (60 - 176) >> 8), 34 + (t * (82 - 34) >> 8),
+                                       60 + (t * (190 - 60) >> 8)));
+        lcd_fillrect(BAR_X + 3 + x, BAR_Y + 3, MIN(5, fill - x), BAR_H - 6);
+    }
+text:
+    {
+        const char *msg = steps >= STEPS ? "welcome" :
+                          by_button ? "press the center button" : "turn the wheel to start";
+        aui_text(AF_RETRO_S, AUI_W / 2, by_button ? BAR_Y + 2 : BAR_Y + BAR_H,
+                 0xf0e6c8, msg, AUI_W - 20, 1);
+    }
+    lcd_set_drawmode(DRMODE_SOLID);
+    lcd_update();
+}
+
+/* redraw the plain logo (used while starting up, before the gate) */
+void asher_boot_logo(void)
+{
+    lcd_set_viewport(NULL);
+    lcd_bmp(&bm_rockboxlogo, (LCD_WIDTH - BMPWIDTH_rockboxlogo) / 2, 0);
+    lcd_update();
+}
+
+void asher_boot_gate(void)
+{
+    int steps = 0;
+    aui_begin();
+    /* already plugged into a computer: skip the wheel turn so the computer
+     * can see the drive right away */
+    if (usb_inserted() || asher_boot_mode == BOOT_OFF)
+    {
+        boot_pending = 2;
+        return;
+    }
+    asher_wheel_zone(WZ_BOOT);
+    by_button = asher_boot_mode == BOOT_SELECT;
+    bool pressed = false;
+    draw(0);
+    while (steps < STEPS)
+    {
+        long btn = button_get_w_tmo(HZ);
+        if (btn == BUTTON_NONE) continue;
+        if (btn == SYS_USB_CONNECTED)
+        {
+            /* plugged in at the logo: skip the wheel turn, start up behind
+             * the scenes and hand the drive to the computer straight away */
+            boot_pending = 2;
+            asher_boot_release();
+            default_event_handler(btn);
+            return;
+        }
+        if (btn & SYS_EVENT)
+        {
+            default_event_handler(btn);
+            draw(steps);
+            continue;
+        }
+        if (by_button)
+        {
+            /* finish on letting go, so the release doesn't reach the
+             * home screen and open something */
+            if ((btn & BUTTON_SELECT) && !(btn & BUTTON_REL)) pressed = true;
+            else if (pressed && btn == (BUTTON_SELECT | BUTTON_REL))
+                { steps = STEPS; draw(steps); }
+            continue;
+        }
+#ifdef BUTTON_SCROLL_FWD
+        if ((btn & (BUTTON_SCROLL_FWD | BUTTON_SCROLL_BACK)) && !(btn & BUTTON_REL))
+        {
+            steps++;
+            draw(steps);
+        }
+#else
+        if (!(btn & BUTTON_REL)) { steps = STEPS; draw(steps); }
+#endif
+    }
+    if (asher_boot_chime) chime();
+    sleep(HZ / 4);
+    /* keep the status bar switched off until the home screen has drawn
+     * itself (asher_boot_release), so it never flashes up in between */
+    boot_pending = 2;          /* the boot entry + this screen's entry */
+}
+
+void asher_boot_release(void)
+{
+    if (boot_pending <= 0) return;
+    while (boot_pending > 0)
+    {
+        viewportmanager_theme_undo(SCREEN_MAIN, false);
+        boot_pending--;
+    }
+    /* start the screen-off timer from now: start-up can take long enough
+     * (5th gen) that it would otherwise run out right after the home
+     * screen appears */
+    backlight_on();
+}
