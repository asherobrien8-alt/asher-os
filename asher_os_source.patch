+/* ------------------------------------------------------------------ */
+/* playing                                                             */
+/* ------------------------------------------------------------------ */
+/* how many songs the play queue can take */
+static int queue_cap(void)
+{
+    int cap = MAX(1, global_settings.max_files_in_playlist - 1);
+#if CONFIG_CPU == PP5022 || CONFIG_CPU == PP5020
+    if (cap > 3000) cap = 3000;      /* the 5th gen fills its queue slowly */
+#endif
+    return cap;
+}
+
+static int play_entries(const int *order, int count, int start, bool shuffle)
+{
+    /* shuffle = the Shuffle item: everything, in random order */
+    struct tagcache_search tcs;
+    struct playlist_insert_context ctx;
+    static char path[MAX_PATH];
+    int added = 0, newstart = 0;
+
+    if (count <= 0) return 0;
+    const char *msg = shuffle ? "SHUFFLING" : "LOADING MUSIC";
+    aui_begin();
+    loading_screen(msg, NULL);
+    if (new_playlist() < 0 || !tagcache_search(&tcs, tag_filename))
+        { aui_end(); return 0; }
+    if (playlist_insert_context_create(NULL, &ctx, PLAYLIST_INSERT_LAST, false, false) < 0)
+        { tagcache_search_finish(&tcs); aui_end(); return 0; }
+    /* skip songs that were deleted since the library was built (they make
+     * playback stop); only when the folder cache makes checking instant */
+    bool check = false;
+#ifdef HAVE_DIRCACHE
+    struct dircache_info dci;
+    dircache_get_info(&dci);
+    check = dci.status == DIRCACHE_READY;
+#endif
+    /* the play queue has a size limit (smaller and slower to fill on the
+     * 5th gen): play up to that many, starting at the chosen song, or for
+     * Shuffle a spread from across the whole library */
+    int cap = queue_cap();
+    int take = MIN(count, cap);
+    int stride = 1, first = start;
+    if (shuffle && count > cap)
+    {
+        stride = count / cap;
+        first = (int)(current_tick % (unsigned)stride);
+    }
+    else if (!shuffle && count > cap)
+        first = start;
+    else
+        first = 0;
+    for (int j = 0; j < take; j++)
+    {
+        int k = (shuffle && count > cap) ? first + j * stride
+              : (count > cap ? (first + j) % count : j);
+        if (k >= count) break;
+        if (tagcache_retrieve(&tcs, L[order[k]].idx, tag_filename, path, sizeof(path))
+            && path[0] && (!check || file_exists(path)) && !queued_first(path))
+        {
+            if (playlist_insert_context_add(&ctx, path) < 0)
+                break;                      /* queue full: play what fits */
+            if (k == start) newstart = added;
+            added++;
+        }
+        if ((j & 15) == 0) loading_tick(msg, NULL);
+    }
+    playlist_insert_context_release(&ctx);
+    tagcache_search_finish(&tcs);
+    if (added == 0) { aui_end(); splash(2 * HZ, "Couldn't load those songs"); return 0; }
+    loading_screen(msg, NULL);
+    return begin_play(newstart, shuffle);
+}
+
+static int shuffle_all(void)
+{
+    if (tagcache_is_usable() && library_ready())
+        return play_entries(by_title, lib_u, 0, true);
+    /* no database yet: shuffle every song on the disk */
+    aui_begin();
+    loading_screen("SHUFFLING", NULL);
+    new_playlist();
+    playlist_insert_directory(NULL, "/", PLAYLIST_INSERT_LAST, false, true, NULL);
+    if (playlist_amount() > 0)
+        return begin_play(0, true);
+    aui_end();
+    splash(2 * HZ, "No songs found");
+    return 0;
+}
