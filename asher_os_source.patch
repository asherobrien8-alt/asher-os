+static const char *moon_l1[8] = { "New", "Waxing", "First", "Waxing", "Full", "Waning", "Last", "Waning" };
+static const char *moon_l2[8] = { "Moon", "Crescent", "Quarter", "Gibbous", "Moon", "Gibbous", "Quarter", "Crescent" };
+
+/* window bodies (must match the stats_bg picture) */
+#define ART_X 10
+#define ART_Y 51
+#define WALL_X 147
+#define WALL_Y 51
+#define INFO_X 6
+#define INFO_Y 181
+#define MOON_X 212
+#define MOON_Y 181
+
+#define C_TEXT   0x3d2f9e
+#define C_SUB    0x6a5cc0
+#define C_PLAY   0x14935a
+#define C_PAUSE  0xd2691e
+
+/* free / total space in GB (one decimal, Windows-style GB) */
+static bool storage_str(char *fr, size_t fn, char *tot, size_t tn)
+{
+    sector_t size = 0, freek = 0;
+    volume_size(IF_MV(0,) &size, &freek);
+    if (!size) return false;
+    unsigned long long a = ((unsigned long long)freek * 10 + 524288) / 1048576;
+    unsigned long long b = ((unsigned long long)size * 10 + 524288) / 1048576;
+    snprintf(fr, fn, "%llu.%llu", a / 10, a % 10);
+    snprintf(tot, tn, "%llu.%llu", b / 10, b % 10);
+    return true;
+}
+
+static int storage_pct_used(void)
+{
+    sector_t size = 0, freek = 0;
+    volume_size(IF_MV(0,) &size, &freek);
+    if (!size) return -1;
+    return (int)(((unsigned long long)(size - freek) * 100 + size / 2) / size);
+}
+
+static const char *track_title(struct mp3entry *id3)
+{
+    if (id3->title && id3->title[0]) return id3->title;
+    const char *p = strrchr(id3->path, '/');
+    return p ? p + 1 : id3->path;
+}
+
+/* Modern theme: iOS-style widgets (frosted white tiles) on the wallpaper */
+static void wtile(int x, int y, int w, int h)
+{
+    aui_shade(x, y, w, h, 16, 40, 0xffffff);      /* mostly white, a hint of what's behind */
+}
+
+/* the wallpaper, shrunk into a small box (nearest pixel) */
+static void thumb(const fb_data *src, int sw, int sh, int x, int y, int w, int h)
+{
+    for (int j = 0; j < h; j++)
+    {
+        const fb_data *row = src + (j * sh / h) * sw;
+        for (int i = 0; i < w; i++)
+            aui_fb[(y + j) * AUI_W + x + i] = row[i * sw / w];
+    }
+}
+
+static void draw_modern(const struct amedia *m)
+{
+    struct mp3entry *id3 = audio_current_track();
+    int st = audio_status();
+    bool playing = (st & AUDIO_STATUS_PLAY) && id3;
+    bool paused = st & AUDIO_STATUS_PAUSE;
+    bool vol = asher_media_show_vol(m);
+    long pos = playing ? (m->seeking ? m->seek_pos : (long)id3->elapsed) : 0;
+    char buf[64], b2[16];
+    struct tm *tm = get_time();
+    int ph = asher_moon_phase(tm->tm_year + 1900, tm->tm_mon + 1, tm->tm_mday,
+                              tm->tm_hour, tm->tm_min);
+    int bat = battery_level();
+    const unsigned tc = 0x1c1c1e, sc = 0x6e6e78;
+
+    asher_wp_prepare();
+    const fb_data *f = asher_wp_full();
+    if (f) { memcpy(aui_fb, f, sizeof(fb_data) * AUI_W * AUI_H); aui_shade(0, 0, AUI_W, AUI_H, 0, 200, 0x000000); }
+    else if (!aui_sprite_fill(SPR_M_NPBG)) aui_vgrad(0, 0, AUI_W, AUI_H, 0xb48cff, 0x6aa0ff);
+    aui_topbar();
+
+    /* now playing widget */
+    int ny = AUI_BAR + 6, nh = 94;
+    wtile(8, ny, AUI_W - 16, nh);
+    int ax = 18, ay = ny + 10, as = 74;
+    if (!aui_albumart_scaled(ax, ay, as))
+    {
+        aui_round(ax, ay, as, as, 12, 0xff5e6c, 0xfa2346);
+        aui_sprite_c(SPR_NOTE, ax + as / 2, ay + as / 2);
+    }
+    int px0 = 104, pw = AUI_W - px0 - 20;
+    long p = vol ? aui_volume_pct() : pos, q = vol ? 100 : (playing && id3->length ? (long)id3->length : 1);
+    int fill = (int)((long long)pw * MIN(p, q) / q);
+    aui_round(px0, ay + 62, pw, 5, 2, 0xc7c7cc, 0xc7c7cc);
+    if (fill > 0) aui_round(px0, ay + 62, MAX(5, fill), 5, 2, 0xed1c24, 0xed1c24);
+
+    /* four small widgets */
+    int wy = ny + nh + 6, wh = AUI_H - wy - 6, ww = (AUI_W - 16 - 3 * 6) / 4;
+    int wx[4];
+    for (int k = 0; k < 4; k++) { wx[k] = 8 + k * (ww + 6); wtile(wx[k], wy, ww, wh); }
+    /* battery bar */
+    if (bat >= 0)
+    {
+        unsigned c = aui_batt_rgb(bat);
+        aui_round(wx[0] + 8, wy + wh - 20, ww - 16, 9, 4, 0xe5e5ea, 0xe5e5ea);
+        aui_round(wx[0] + 8, wy + wh - 20, MAX(9, (ww - 16) * bat / 100), 9, 4, c, c);
+    }
+    /* moon */
+    aui_sprite_c(SPR_MOON0 + ph, wx[1] + ww / 2, wy + 44);
+    /* storage bar */
+    int used = storage_pct_used();
+    if (used >= 0)
+    {
+        aui_round(wx[2] + 8, wy + wh - 20, ww - 16, 9, 4, 0xe5e5ea, 0xe5e5ea);
+        aui_round(wx[2] + 8, wy + wh - 20, MAX(9, (ww - 16) * used / 100), 9, 4, 0x007aff, 0x007aff);
+    }
+    /* wallpaper thumbnail */
+    const fb_data *sm = asher_wp_small_still();
+    int tw = ww - 12, th = tw * 3 / 4;
+    if (sm) thumb(sm, ASHER_BOX_W, ASHER_BOX_H, wx[3] + 6, wy + 22, tw, th);
+    else aui_round(wx[3] + 6, wy + 22, tw, th, 6, 0xd1d1d6, 0xd1d1d6);
+    aui_present();
+
+    /* now playing text */
+    aui_text(AF_SMALL, px0, ay, paused ? 0xff9500 : 0xed1c24,
+             !playing ? "NOT PLAYING" : paused ? "PAUSED" : "NOW PLAYING", pw, 0);
+    if (playing)
+    {
+        aui_text(AF_BIG, px0, ay + 15, tc, track_title(id3), pw, 0);
+        aui_text(AF_SMALLR, px0, ay + 38, sc,
+                 (id3->artist && id3->artist[0]) ? id3->artist : "Unknown Artist", pw, 0);
+        if (vol) snprintf(buf, sizeof(buf), "Volume %d%%", aui_volume_pct());
+        else
+        {
+            aui_fmt_time(buf, sizeof(buf), pos);
+            aui_fmt_time(b2, sizeof(b2), id3->length);
+            strlcat(buf, " / ", sizeof(buf)); strlcat(buf, b2, sizeof(buf));
+        }
+        aui_text(AF_SMALLR, px0, ay + 70, sc, buf, 120, 0);
+        aui_text(AF_SMALLR, AUI_W - 20, ay + 70, global_settings.playlist_shuffle ? 0x007aff : sc,
+                 global_settings.playlist_shuffle ? "Shuffle On" : "Shuffle Off", 90, 2);
+    }
+    else
+        aui_text(AF_MED, px0, ay + 20, tc, "Pick something in Music", pw, 0);
+
+    /* widget labels */
+    static const char *lbl[4] = { "BATTERY", "MOON", "STORAGE", "WALLPAPER" };
+    for (int k = 0; k < 4; k++)
+        aui_text(AF_SMALLR, wx[k] + ww / 2, wy + 6, sc, lbl[k], ww - 4, 1);
+    snprintf(buf, sizeof(buf), bat >= 0 ? "%d%%" : "--", bat);
+    aui_text(AF_BIG, wx[0] + ww / 2, wy + 30, tc, buf, ww - 4, 1);
+    snprintf(buf, sizeof(buf), "%s", moon_l1[ph]);
+    aui_text(AF_SMALLR, wx[1] + ww / 2, wy + wh - 30, tc, buf, ww - 4, 1);
+    aui_text(AF_SMALLR, wx[1] + ww / 2, wy + wh - 17, tc, moon_l2[ph], ww - 4, 1);
+    {
+        char f1[16], t1[16];
+        if (storage_str(f1, sizeof(f1), t1, sizeof(t1)))
+        {
+            snprintf(buf, sizeof(buf), "%s GB", f1);
+            aui_text(AF_SMALL, wx[2] + ww / 2, wy + 26, tc, buf, ww - 4, 1);
+            snprintf(buf, sizeof(buf), "free of %s", t1);
+            aui_text(AF_SMALLR, wx[2] + ww / 2, wy + 42, sc, buf, ww - 4, 1);
+        }
+    }
+    const char *wn = asher_wallpaper_name();
+    aui_text(AF_SMALLR, wx[3] + ww / 2, wy + wh - 17, tc, wn ? wn : "None", ww - 4, 1);
+    aui_topbar_text("Info");
+    aui_update();
+}
+
+static void draw(const struct amedia *m)
+{
+    if (aui_theme()->modern) { draw_modern(m); return; }
+    struct mp3entry *id3 = audio_current_track();
+    int st = audio_status();
+    bool playing = (st & AUDIO_STATUS_PLAY) && id3;
+    bool paused = st & AUDIO_STATUS_PAUSE;
+    char buf[160], b2[16];
+    struct tm *tm = get_time();
+    int ph = asher_moon_phase(tm->tm_year + 1900, tm->tm_mon + 1, tm->tm_mday,
+                              tm->tm_hour, tm->tm_min);
+    const char *wname = asher_wallpaper_name();
+
+    asher_wp_prepare();         /* may show the loading screen first */
+
+    if (!aui_sprite(SPR_STATS_BG, 0, 0))
+        aui_vgrad(0, 0, AUI_W, AUI_H, 0xffd6f6, 0xa6baff);
+    aui_topbar();
+
+    /* album art */
+    if (!aui_albumart(ART_X, ART_Y, 120))
+    {
+        aui_vgrad(ART_X, ART_Y, 120, 120, 0xfde6fb, 0xead6ff);
+        aui_sprite_c(SPR_NOTE, ART_X + 60, ART_Y + 60);
+    }
+    /* live wallpaper + its name */
+    const fb_data *wp = asher_wp_small_still();   /* still picture: saves battery */
+    if (wp)
+    {
+        aui_blit(wp, ASHER_BOX_W, ASHER_BOX_H, WALL_X, WALL_Y);
+        aui_shade(WALL_X, WALL_Y + ASHER_BOX_H - 15, ASHER_BOX_W, 15, 0, 110, 0x2a1f6e);
+    }
+    else
+        aui_vgrad(WALL_X, WALL_Y, ASHER_BOX_W, ASHER_BOX_H, 0xfde6fb, 0xead6ff);
+    /* moon */
+    aui_sprite(SPR_MOON0 + ph, MOON_X + 5, MOON_Y + 17);
+    /* progress */
+    long pos = playing ? (m->seeking ? m->seek_pos : (long)id3->elapsed) : 0;
+    bool vol = asher_media_show_vol(m);
+    if (vol)
+        aui_progress(INFO_X + 5, INFO_Y + 44, 128, 5, aui_volume_pct(), 100);
+    else if (playing)
+        aui_progress(INFO_X + 5, INFO_Y + 44, 128, 5, pos, id3->length);
+    /* 2.5.2: play state and shuffle in the same style as the rest of the
+     * window's text (deep colours with the light outline): easy to read */
+    const char *state = !playing ? NULL : (paused ? "> currently paused" : "> currently playing");
+    const char *shuf = global_settings.playlist_shuffle ? "shuffle:on" : "shuffle:off";
+    aui_present();
+
+    if (wp)
+        aui_text(AF_RETRO_T, WALL_X + 5, WALL_Y + ASHER_BOX_H - 12, 0xfff2c8,
+                 wname ? wname : "", ASHER_BOX_W - 10, 0);
+    else
+        aui_text(AF_RETRO_T, WALL_X + ASHER_BOX_W / 2, WALL_Y + 55, C_SUB, "no wallpaper", 150, 1);
+
+    if (playing)
+    {
+        aui_text(AF_RETRO_T, INFO_X + 5, INFO_Y + 16, paused ? 0xa8440c : 0x0d6b3c, state, 130, 0);
+        if (id3->bitrate)
+        {
+            snprintf(buf, sizeof(buf), "%d kbps", id3->bitrate);
+            aui_text(AF_RETRO_T, INFO_X + 194, INFO_Y + 17, C_SUB, buf, 60, 2);
+        }
+        snprintf(buf, sizeof(buf), "%s - %s", track_title(id3),
+                 (id3->artist && id3->artist[0]) ? id3->artist : "Unknown Artist");
+        aui_text(AF_SMALL, INFO_X + 5, INFO_Y + 28, C_TEXT, buf, 188, 0);
+        if (vol)
+            snprintf(buf, sizeof(buf), "vol %d%%", aui_volume_pct());
+        else
+        {
+            aui_fmt_time(buf, sizeof(buf), pos);
+            aui_fmt_time(b2, sizeof(b2), id3->length);
+            strlcat(buf, "/", sizeof(buf));
+            strlcat(buf, b2, sizeof(buf));
+        }
+        aui_text(AF_RETRO_T, INFO_X + 194, INFO_Y + 41, C_SUB, buf, 62, 2);
+    }
+    else
+    {
+        aui_text(AF_RETRO_T, INFO_X + 5, INFO_Y + 17, C_SUB, "> nothing playing", 180, 0);
+        aui_text(AF_SMALL, INFO_X + 5, INFO_Y + 30, C_TEXT, "Pick something in Music", 188, 0);
+    }
+    /* shuffle state in the now_playing.txt title bar (centre button flips it) */
+    aui_text(AF_RETRO_T, INFO_X + 166, INFO_Y + 1,
+             global_settings.playlist_shuffle ? 0x0d6b3c : 0x5446c8, shuf, 76, 2);
+    /* moon phase, then the free space under it (the date is in the top bar) */
+    {
+        char f1[16], t1[16];
+        bool st = storage_str(f1, sizeof(f1), t1, sizeof(t1));
+        /* 2.5.2: below the title bar (it used to touch it) */
+        int ly = st ? MOON_Y + 14 : MOON_Y + 22;
+        aui_text(AF_RETRO_T, MOON_X + 43, ly, C_TEXT, moon_l1[ph], 57, 0);
+        aui_text(AF_RETRO_T, MOON_X + 43, ly + 9, C_TEXT, moon_l2[ph], 57, 0);
+        if (st)
+        {
+            snprintf(buf, sizeof(buf), "%s GB", f1);
+            aui_text(AF_RETRO_T, MOON_X + 43, ly + 18, C_PLAY, buf, 57, 0);
+            snprintf(buf, sizeof(buf), "free of %s", t1);
+            if (aui_text_w(AF_RETRO_T, buf) > 57) strcpy(buf, "free");
+            aui_text(AF_RETRO_T, MOON_X + 43, ly + 27, C_SUB, buf, 57, 0);
+        }
+    }
+    aui_topbar_text("Stats");
+    aui_update();
+}
+
+void asher_stats_screen(void)
+{
+    struct amedia m = { 0 };
+    long next_text = 0;
+    aui_begin();
+    /* the loader's first picture goes up straight away, before the last
+     * song is looked up from the drive */
+    if (aui_screen_on() && !(aui_quiet_until && TIME_BEFORE(current_tick, aui_quiet_until)))
+        aui_loading(LDR_STATS, NULL, NULL, current_tick, true);
+    asher_resume_paused();      /* show the paused song, not "nothing playing" */
+    aui_intro(LDR_STATS);
+    while (1)
+    {
+        bool on = aui_screen_on();
+        if (aui_woke()) next_text = 0;
+        if (on && TIME_AFTER(current_tick, next_text))
+        {
+            draw(&m);
+            next_text = current_tick + (m.seeking ? HZ / 10 : asher_ticks_to_next_second());
+        }
+        long wait = next_text - current_tick;
+        if (wait < 1) wait = 1;
+        /* same buttons as Now Playing: wheel = volume, << >> = skip (hold
+         * to seek), play = play/pause, centre = shuffle, menu = back */
+        int action = get_action(CONTEXT_WPS, !on ? 2 * HZ : (m.seeking ? HZ / 10 : wait));
+        if (asher_media(&m, action)) { next_text = 0; continue; }
+        if (action == ACTION_WPS_MENU)
+            break;
+        if (action == ACTION_WPS_QUICKSCREEN)     /* hold Menu: shuffle / repeat */
+        {
+            asher_shuffle_menu();
+            next_text = 0;
+            continue;
+        }
+        if (action == ACTION_WPS_BROWSE)
+        {
+            asher_shuffle_set(!global_settings.playlist_shuffle);
+            next_text = 0;
+            continue;
+        }
+        if (action == ACTION_NONE)
+        {
+            if (m.vol_until && !asher_media_show_vol(&m)) { m.vol_until = 0; next_text = 0; }
+            continue;
+        }
+        if (action == ACTION_WPS_STOP)
+            continue;           /* holding play: leave it for power off */
+        if (default_event_handler(action) == SYS_USB_CONNECTED)
+            break;
+    }
+    aui_end();
+}
