diff --git a/apps/asher/asher_theme.c b/apps/asher/asher_theme.c
new file mode 100644
index 0000000000..f17983c61a
--- /dev/null
+++ b/apps/asher/asher_theme.c
@@ -0,0 +1,131 @@
+#include <stdio.h>
+#include <string.h>
+#include <fcntl.h>
+#include "config.h"
+#include "file.h"
+#include "settings.h"
+#include "menu.h"
+#include "splash.h"
+#include "lang.h"
+#include "asher_theme.h"
+#include "asher_wallpaper.h"
+#include "asher_ui.h"
+
+#define ASHER_THEME_DIR "/.rockbox/asher/themes/"
+#define STATE_FILE      "/.rockbox/asher/state.txt"
+#define NUM_THEMES 3
+
+int asher_layout = 0;
+
+static const char *theme_file[NUM_THEMES] = { "bubbles", "classic", "dark" };
+static const char *theme_name[NUM_THEMES] = { "Bubbles", "Classic", "Dark" };
+
+struct wpdef { const char *name; const char *scene; bool timed; };
+static const struct wpdef wps[] = {
+    { "Street (Time of Day)", "street",     true  },
+    { "Arcade",               "arcade",     false },
+    { "Pumpkin Witch",        "witch",      false },
+    { "Rainy Cabin",          "cabin",      false },
+    { "Snowy Cafe",           "cafe",       false },
+    { "Bus Stop",             "busstop",    false },
+    { "Frozen Creek",         "creek",      false },
+    { "City Sunset",          "citysunset", false },
+    { "Lantern Alley",        "alley",      false },
+    { "Dusk Street",          "dusk",       false },
+    { "Blossom Lane",         "blossom",    false },
+    { "Off",                  NULL,         false },
+};
+#define NUM_WPS ((int)(sizeof(wps) / sizeof(wps[0])))
+
+static int cur_theme = 0, cur_wp = 0;
+
+const char *asher_wallpaper_name(void)
+{
+    return wps[cur_wp].scene ? wps[cur_wp].name : NULL;
+}
+
+static void save_state(void)
+{
+    char s[2] = { '0' + cur_theme, 'a' + cur_wp };
+    int fd = open(STATE_FILE, O_WRONLY | O_CREAT | O_TRUNC, 0666);
+    if (fd >= 0) { write(fd, s, 2); close(fd); }
+}
+
+static void apply_wallpaper(int i)
+{
+    cur_wp = i;
+    asher_wallpaper_set(wps[i].scene, wps[i].timed);
+}
+
+static void apply_theme(int i)
+{
+    char path[MAX_PATH];
+    cur_theme = i;
+    asher_layout = i;
+    snprintf(path, sizeof(path), ASHER_THEME_DIR "%s.cfg", theme_file[i]);
+    settings_load_config(path, true);
+}
+
+void asher_theme_apply_saved(void)
+{
+    char s[2];
+    int t = 0, w = 0;
+    int fd = open(STATE_FILE, O_RDONLY);
+    if (fd >= 0)
+    {
+        if (read(fd, s, 2) == 2)
+        {
+            if (s[0] >= '0' && s[0] < '0' + NUM_THEMES) t = s[0] - '0';
+            if (s[1] >= 'a' && s[1] < 'a' + NUM_WPS) w = s[1] - 'a';
+        }
+        close(fd);
+    }
+    apply_theme(t);
+    apply_wallpaper(w);
+    aui_init();     /* fonts, icons and the album art slot */
+}
+
+static int pick_wallpaper(void *p)
+{
+    int i = (int)(intptr_t)p;
+    apply_wallpaper(i);
+    save_state();
+    splashf(HZ, "Wallpaper: %s", wps[i].name);
+    return 0;
+}
+
+static int pick_theme(void *p)
+{
+    int i = (int)(intptr_t)p;
+    apply_theme(i);
+    save_state();
+    splashf(HZ, "Theme: %s", theme_name[i]);
+    return 0;
+}
+
+#define WPI(n, label) \
+    MENUITEM_FUNCTION_W_PARAM(wpi##n, MENU_EXITAFTERTHISMENU, label, \
+                              pick_wallpaper, (void *)(intptr_t)(n), NULL, Icon_NOICON)
+WPI(0, "Street (Time of Day)");
+WPI(1, "Arcade");
+WPI(2, "Pumpkin Witch");
+WPI(3, "Rainy Cabin");
+WPI(4, "Snowy Cafe");
+WPI(5, "Bus Stop");
+WPI(6, "Frozen Creek");
+WPI(7, "City Sunset");
+WPI(8, "Lantern Alley");
+WPI(9, "Dusk Street");
+WPI(10, "Blossom Lane");
+WPI(11, "Off");
+MAKE_MENU(asher_wallpaper_menu, "Wallpaper", NULL, Icon_NOICON,
+          &wpi0, &wpi1, &wpi2, &wpi3, &wpi4, &wpi5, &wpi6, &wpi7, &wpi8,
+          &wpi9, &wpi10, &wpi11);
+
+#define THI(n, label) \
+    MENUITEM_FUNCTION_W_PARAM(thi##n, MENU_EXITAFTERTHISMENU, label, \
+                              pick_theme, (void *)(intptr_t)(n), NULL, Icon_NOICON)
+THI(0, "Bubbles");
+THI(1, "Classic");
+THI(2, "Dark");
+MAKE_MENU(asher_theme_menu, "Theme", NULL, Icon_NOICON, &thi0, &thi1, &thi2);
