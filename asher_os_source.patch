+struct m_anim { int handle, w, h, n, ms; size_t fsz; };
+static struct m_anim m_usb = { -1 }, m_txt = { -1 };
+
+static bool m_anim_load(struct m_anim *a, const char *path)
+{
+    unsigned char hd[12];
+    if (a->handle > 0) return true;
+    int fd = open(path, O_RDONLY);
+    if (fd < 0) return false;
+    if (read(fd, hd, 12) != 12 || memcmp(hd, "AWP1", 4)) { close(fd); return false; }
+    a->w = hd[4] | hd[5] << 8; a->h = hd[6] | hd[7] << 8;
+    a->n = hd[8] | hd[9] << 8; a->ms = hd[10] | hd[11] << 8;
+    if (a->ms < 20) a->ms = 20;
+    a->fsz = (size_t)a->w * a->h * sizeof(fb_data);
+    if (a->w <= 0 || a->w > LCD_WIDTH || a->h <= 0 || a->h > LCD_HEIGHT || a->n <= 0)
+        { close(fd); return false; }
+    a->handle = asher_alloc(a->fsz * a->n);
+    if (a->handle <= 0) { a->handle = -1; close(fd); return false; }
+    bool ok = read(fd, core_get_data(a->handle), a->fsz * a->n) == (ssize_t)(a->fsz * a->n);
+    close(fd);
+    if (!ok) { asher_free(a->handle); a->handle = -1; }
+    return ok;
+}
+static void m_anim_free(void)
+{
+    if (m_usb.handle > 0) asher_free(m_usb.handle);
+    if (m_txt.handle > 0) asher_free(m_txt.handle);
+    m_usb.handle = m_txt.handle = -1;
+}
+static bool m_modern(void) { return aui_theme()->modern && m_usb.handle > 0 && m_txt.handle > 0; }
+static const fb_data *m_frame(struct m_anim *a, int i)
+{
+    return (const fb_data *)((char *)core_get_data(a->handle) + a->fsz * (i % a->n));
+}
