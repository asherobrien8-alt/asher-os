--- a/apps/gui/skin_engine/skin_backdrops.c
+++ b/apps/gui/skin_engine/skin_backdrops.c
@@ -383,3 +383,18 @@ void skin_backdrop_show(int backdrop_id)
     (void) backdrop_id;
 }
 #endif
+
+
+#if defined(HAVE_BACKDROP_IMAGE)
+/* Asher OS: overwrite the active main-screen backdrop with a new frame. */
+void skin_backdrop_animate(const void *frame, size_t bytes)
+{
+    int id = current_lcd_backdrop[SCREEN_MAIN];
+    if (id < 0 || !backdrops[id].buffer || bytes > LCD_BACKDROP_BYTES)
+        return;
+    core_pin(backdrops[id].buflib_handle);
+    memcpy(backdrops[id].buffer, frame, bytes);
+    core_unpin(backdrops[id].buflib_handle);
+    skin_backdrop_show(id);
+}
+#endif
