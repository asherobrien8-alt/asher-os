+#include "asher_quick.h"
+
+#define ART 120
+#define ART_X 20
+#define ART_Y (AUI_BAR + 16)
+#define COL_X (ART_X + ART + 14)
+#define COL_W (AUI_W - COL_X - 18)
+
+/* ------------------------------------------------------------------ */
+/* blurred background                                                  */
+/* ------------------------------------------------------------------ */
+#define SW 40                      /* worked on small, then smoothly scaled up */
+#define SH 30
+static fb_data np_bg[LCD_WIDTH * LCD_HEIGHT];
+static char np_key[MAX_PATH];      /* song the background was made for */
+static bool np_key_art;            /* ... and whether it had art */
+static long np_since;              /* when that song first showed */
+
+static int sm[SH][SW][3];
+
+static void blur_small(int passes)
+{
+    static int tmp[SH][SW][3];
+    for (int p = 0; p < passes; p++)
+    {
+        for (int y = 0; y < SH; y++)          /* horizontal, radius 3 */
+            for (int x = 0; x < SW; x++)
+                for (int c = 0; c < 3; c++)
+                {
+                    int sum = 0;
+                    for (int k = -3; k <= 3; k++)
+                        sum += sm[y][MIN(SW - 1, MAX(0, x + k))][c];
+                    tmp[y][x][c] = sum / 7;
+                }
+        for (int y = 0; y < SH; y++)          /* vertical */
+            for (int x = 0; x < SW; x++)
+                for (int c = 0; c < 3; c++)
+                {
+                    int sum = 0;
+                    for (int k = -3; k <= 3; k++)
+                        sum += tmp[MIN(SH - 1, MAX(0, y + k))][x][c];
+                    sm[y][x][c] = sum / 7;
+                }
+    }
+}
+
+/* scale the small picture up to the screen, smoothly, with a light
+ * dither so the colour steps don't show */
+static void upscale(int keep256)
+{
+    static const signed char dith[4][4] = {
+        { -6, 2, -4, 4 }, { 6, -2, 4, -4 }, { -3, 5, -5, 3 }, { 5, -3, 3, -5 } };
+    for (int y = 0; y < LCD_HEIGHT; y++)
+    {
+        int fy = y * (SH - 1) * 256 / (LCD_HEIGHT - 1);
+        int y0 = fy >> 8, y1 = MIN(SH - 1, y0 + 1), wy = fy & 255;
+        for (int x = 0; x < LCD_WIDTH; x++)
+        {
+            int fx = x * (SW - 1) * 256 / (LCD_WIDTH - 1);
+            int x0 = fx >> 8, x1 = MIN(SW - 1, x0 + 1), wx = fx & 255;
+            int c3[3];
+            for (int c = 0; c < 3; c++)
+            {
+                int a = sm[y0][x0][c] * (256 - wx) + sm[y0][x1][c] * wx;
+                int b = sm[y1][x0][c] * (256 - wx) + sm[y1][x1][c] * wx;
+                int v = ((a >> 8) * (256 - wy) + (b >> 8) * wy) >> 8;
+                v = v * keep256 / 256 + dith[y & 3][x & 3];
+                c3[c] = MIN(255, MAX(0, v));
+            }
+            np_bg[y * LCD_WIDTH + x] = LCD_RGBPACK(c3[0], c3[1], c3[2]);
+        }
+    }
+}
+
+static void bg_from_art(const fb_data *src, int w, int h)
+{
+    /* centre crop to the screen's shape, averaged down to SW x SH */
+    int cw = w, ch = w * 3 / 4;
+    if (ch > h) { ch = h; cw = h * 4 / 3; }
+    int ox = (w - cw) / 2, oy = (h - ch) / 2;
+    for (int y = 0; y < SH; y++)
+        for (int x = 0; x < SW; x++)
+        {
+            int xa = ox + x * cw / SW, xb = MAX(xa + 1, ox + (x + 1) * cw / SW);
+            int ya = oy + y * ch / SH, yb = MAX(ya + 1, oy + (y + 1) * ch / SH);
+            int r = 0, g = 0, b = 0, n = 0;
+            for (int yy = ya; yy < yb && yy < h; yy++)
+                for (int xx = xa; xx < xb && xx < w; xx++)
+                {
+                    unsigned v = src[yy * w + xx];
+                    r += ((v >> 11) & 31) * 255 / 31;
+                    g += ((v >> 5) & 63) * 255 / 63;
+                    b += (v & 31) * 255 / 31;
+                    n++;
+                }
+            if (!n) n = 1;
+            sm[y][x][0] = r / n; sm[y][x][1] = g / n; sm[y][x][2] = b / n;
+        }
+    blur_small(3);
+    upscale(170);                  /* a bit darker so the text stands out */
+}
+
+static void bg_no_art(void)
+{
+    /* pink, blue, red, purple and orange, melted together */
+    static const int blob[5][5] = {    /* x, y, r, g, b */
+        { 6, 5, 255, 105, 180 }, { 34, 4, 70, 120, 255 }, { 5, 26, 240, 60, 80 },
+        { 21, 15, 150, 70, 230 }, { 35, 26, 255, 150, 50 } };
+    for (int y = 0; y < SH; y++)
+        for (int x = 0; x < SW; x++)
+        {
+            long wsum = 0, c[3] = { 0, 0, 0 };
+            for (int i = 0; i < 5; i++)
+            {
+                int dx = x - blob[i][0], dy = y - blob[i][1];
+                long d = 1 + (dx * dx + dy * dy) / 6;
+                long wgt = 1000000 / (d * d);
+                wsum += wgt;
+                for (int k = 0; k < 3; k++) c[k] += wgt * blob[i][2 + k];
+            }
+            for (int k = 0; k < 3; k++) sm[y][x][k] = (int)(c[k] / wsum);
+        }
+    blur_small(2);
+    upscale(190);
+}
+
+/* returns true when the background was (re)made */
+static bool np_background(struct mp3entry *id3)
+{
+    const fb_data *art; int w, h;
+    bool has = aui_albumart_bitmap(&art, &w, &h);
+    const char *key = id3 ? id3->path : "";
+    bool same = !strcmp(key, np_key);
+    if (!same) np_since = current_tick;
+    if (same && has == np_key_art) return false;
+    if (same && !has) return false;        /* art went away: keep what we have */
+    strmemccpy(np_key, key, sizeof(np_key));
+    np_key_art = has;
+    if (has) bg_from_art(art, w, h);
+    else     bg_no_art();
+    /* bake the dark glass panel in once, not on every redraw (battery) */
+    memcpy(aui_fb, np_bg, sizeof(np_bg));
+    aui_shade(8, AUI_BAR + 6, AUI_W - 16, AUI_H - AUI_BAR - 12, 14, 200, 0x05060f);
+    memcpy(np_bg, aui_fb, sizeof(np_bg));
+    return true;
+}
+
+/* ------------------------------------------------------------------ */
+static const char *track_title(struct mp3entry *id3)
+{
+    if (id3->title && id3->title[0]) return id3->title;
+    const char *p = strrchr(id3->path, '/');
+    return p ? p + 1 : id3->path;
+}
+
+/* split s so the first line fits in w (break at a space when possible) */
+static void wrap2(const char *s, int font, int w, char *l1, char *l2, size_t n)
+{
+    size_t len = strlen(s), best = 0;
+    l1[0] = l2[0] = '\0';
+    if (aui_text_w(font, s) <= w) { strlcpy(l1, s, n); return; }
+    for (size_t i = 1; i <= len && i < n; i++)
+    {
+        if (s[i] != ' ' && s[i] != '\0') continue;
+        char tmp[160];
+        strlcpy(tmp, s, MIN(i + 1, sizeof(tmp)));
+        if (aui_text_w(font, tmp) <= w) best = i; else break;
+    }
+    if (!best) { strlcpy(l1, s, n); return; }   /* one long word: truncate */
+    strlcpy(l1, s, MIN(best + 1, n));
+    while (s[best] == ' ') best++;
+    strlcpy(l2, s + best, n);
+}
+
+/* Modern: the blurred colour blend behind a frosted white card, and the
+ * player bar look: red progress with a knob, grey buttons under it */
+static void draw_modern(const struct amedia *m, bool show_shuf)
+{
+    struct mp3entry *id3 = audio_current_track();
+    int st = audio_status();
+    bool playing = (st & AUDIO_STATUS_PLAY) && id3;
+    bool paused = st & AUDIO_STATUS_PAUSE;
+    bool show_vol = asher_media_show_vol(m);
+    char l1[160], l2[160], buf[48], b2[16];
+    long pos = playing ? (m->seeking ? m->seek_pos : (long)id3->elapsed) : 0;
+    long len = playing ? (long)id3->length : 0;
+    const int AX = 22, AY = AUI_BAR + 16, AS = 104, TX = AX + AS + 14, TW = AUI_W - TX - 22;
+
+    if (!aui_sprite_fill(SPR_M_NPBG))
+        aui_vgrad(0, 0, AUI_W, AUI_H, 0xb48cff, 0x6aa0ff);
+    aui_topbar();
+    aui_shade(10, AUI_BAR + 6, AUI_W - 20, AUI_H - AUI_BAR - 12, 18, 70, 0xffffff);
+    /* art */
+    if (!aui_albumart_scaled(AX, AY, AS))
+    {
+        aui_round(AX, AY, AS, AS, 12, 0xff5e6c, 0xfa2346);
+        aui_sprite_c(SPR_NOTE, AX + AS / 2, AY + AS / 2);
+    }
+    /* progress (or volume): grey track, red fill and knob */
+    int bx = 26, by = AY + AS + 16, bw = AUI_W - 26 - 76;
+    long p = show_vol ? aui_volume_pct() : pos, q = show_vol ? 100 : (len > 0 ? len : 1);
+    int fill = (int)((long long)bw * MIN(p, q) / q);
+    aui_round(bx, by, bw, 6, 3, 0xc7c7cc, 0xc7c7cc);
+    if (fill > 0) aui_round(bx, by, MAX(6, fill), 6, 3, 0xed1c24, 0xed1c24);
+    aui_round(bx + fill - 6, by - 3, 12, 12, 6, 0xed1c24, 0xed1c24);
+    /* buttons */
+    int cy = by + 34;
+    aui_sprite_c(SPR_M_NP_REW, AUI_W / 2 - 96, cy);
+    aui_sprite_c(SPR_M_NP_PREV, AUI_W / 2 - 50, cy);
+    aui_sprite_c((playing && !paused) ? SPR_M_NP_PAUSE : SPR_M_NP_PLAY, AUI_W / 2, cy);
+    aui_sprite_c(SPR_M_NP_NEXT, AUI_W / 2 + 50, cy);
+    aui_sprite_c(SPR_M_NP_FF, AUI_W / 2 + 96, cy);
+    aui_present();
+
+    const unsigned tc = 0x1c1c1e, sc = 0x6e6e78;
+    if (playing)
+    {
+        aui_text(AF_SMALL, TX, AY + 2, paused ? 0xff9500 : 0xed1c24,
+                 paused ? "PAUSED" : "NOW PLAYING", TW, 0);
+        wrap2(track_title(id3), AF_BIG, TW, l1, l2, sizeof(l1));
+        aui_text(AF_BIG, TX, AY + 20, tc, l1, TW, 0);
+        int y = AY + 42;
+        if (l2[0]) { aui_text(AF_BIG, TX, y, tc, l2, TW, 0); y += 22; }
+        aui_text(AF_MED, TX, y + 2, sc,
+                 (id3->artist && id3->artist[0]) ? id3->artist : "Unknown Artist", TW, 0);
+        aui_text(AF_SMALLR, TX, AY + AS - 14,
+                 global_settings.playlist_shuffle ? 0x007aff : sc,
+                 show_shuf ? (global_settings.playlist_shuffle ? "Shuffle turned on" : "Shuffle turned off")
+                           : (global_settings.playlist_shuffle ? "Shuffle On" : "Shuffle Off"), TW, 0);
+    }
+    else
+    {
+        aui_text(AF_SMALL, TX, AY + 2, sc, "NOT PLAYING", TW, 0);
+        aui_text(AF_BIG, TX, AY + 20, tc, "Nothing playing", TW, 0);
+        aui_text(AF_SMALLR, TX, AY + 46, sc, "Pick something in Music", TW, 0);
+    }
+    if (show_vol)
+        snprintf(buf, sizeof(buf), "%d%%", aui_volume_pct());
+    else
+    {
+        aui_fmt_time(buf, sizeof(buf), pos);
+        aui_fmt_time(b2, sizeof(b2), len);
+        strlcat(buf, "/", sizeof(buf));
+        strlcat(buf, b2, sizeof(buf));
+        if (!playing) strlcpy(buf, "0:00", sizeof(buf));
+    }
+    aui_text(AF_SMALLR, AUI_W - 22, by - 5, sc, buf, 70, 2);
+    if (playing)
+    {
+        /* the song after this one, under the buttons */
+        char nx[120], line[140];
+        bool q = false;
+        if (asher_up_next(nx, sizeof(nx), &q))
+        {
+            snprintf(line, sizeof(line), "%s: %s", q ? "Queued next" : "Up next", nx);
+            aui_text(AF_SMALLR, AUI_W / 2, cy + 20, q ? 0x007aff : sc, line, AUI_W - 40, 1);
+        }
+    }
+    aui_topbar_text("Now Playing");
+    aui_update();
+}
+
+static void draw(const struct amedia *m, bool show_shuf)
+{
+    const struct aui_theme *t = aui_theme();
+    struct mp3entry *id3 = audio_current_track();
+    int st = audio_status();
+    bool playing = (st & AUDIO_STATUS_PLAY) && id3;
+    bool paused = st & AUDIO_STATUS_PAUSE;
+    bool show_vol = asher_media_show_vol(m);
+    char l1[160], l2[160], buf[48], b2[16];
+    long pos = playing ? (m->seeking ? m->seek_pos : (long)id3->elapsed) : 0;
+    long len = playing ? (long)id3->length : 0;
+
+    if (t->modern) { draw_modern(m, show_shuf); return; }
+    np_background(playing ? id3 : NULL);
+    memcpy(aui_fb, np_bg, sizeof(np_bg));
+    aui_topbar();
+
+    /* album art */
+    aui_round(ART_X - 2, ART_Y - 2, ART + 4, ART + 4, 9, 0x2e3258, 0x2e3258);
+    if (!aui_albumart(ART_X, ART_Y, ART))
+    {
+        aui_round(ART_X, ART_Y, ART, ART, 8, 0x1c1f3d, 0x10122a);
+        aui_sprite_c(SPR_NOTE, ART_X + ART / 2, ART_Y + ART / 2);
+    }
+
+    /* progress or volume */
+    if (show_shuf)
+        ;
+    else if (show_vol)
+        aui_progress(ART_X, 188, AUI_W - 2 * ART_X, 8, aui_volume_pct(), 100);
+    else if (playing)
+        aui_progress(ART_X, 188, AUI_W - 2 * ART_X, 8, pos, len);
+    else
+        aui_progress(ART_X, 188, AUI_W - 2 * ART_X, 8, 0, 1);
+    aui_present();
+
+    unsigned tc = 0xffffff, sc = 0xd6dbf2;
+    if (playing)
+    {
+        aui_text(AF_SMALL, COL_X, ART_Y + 2, paused ? 0xffb347 : 0x5ee38a,
+                 paused ? "Currently Paused" : "Currently Playing", COL_W, 0);
+        wrap2(track_title(id3), AF_BIG, COL_W, l1, l2, sizeof(l1));
+        aui_text(AF_BIG, COL_X, ART_Y + 22, tc, l1, COL_W, 0);
+        int y = ART_Y + 44;
+        if (l2[0]) { aui_text(AF_BIG, COL_X, y, tc, l2, COL_W, 0); y += 22; }
+        aui_text(AF_MED, COL_X, y + 4,
+                 sc, (id3->artist && id3->artist[0]) ? id3->artist : "Unknown Artist", COL_W, 0);
+        {
+            /* the song after this one (was the kbps line) */
+            char nx[120], line[140];
+            bool q = false;
+            if (asher_up_next(nx, sizeof(nx), &q))
+            {
+                snprintf(line, sizeof(line), "%s: %s", q ? "Queued next" : "Up next", nx);
+                aui_text(AF_SMALLR, COL_X, ART_Y + ART - 14, q ? 0x9fd8ff : sc, line, COL_W, 0);
+            }
+            else if (id3->bitrate)
+            {
+                snprintf(buf, sizeof(buf), "%d kbps", id3->bitrate);
+                aui_text(AF_SMALLR, COL_X, ART_Y + ART - 14, sc, buf, COL_W, 0);
+            }
+        }
+        aui_text(AF_SMALLR, COL_X, ART_Y + ART - 30,
+                 global_settings.playlist_shuffle ? 0x9fd8ff : sc,
+                 global_settings.playlist_shuffle ? "Shuffle On" : "Shuffle Off", COL_W, 0);
+    }
+    else
+    {
+        aui_text(AF_SMALL, COL_X, ART_Y + 2, sc, "Not Playing", COL_W, 0);
+        aui_text(AF_BIG, COL_X, ART_Y + 22, tc, "Nothing playing", COL_W, 0);
+        aui_text(AF_SMALLR, COL_X, ART_Y + 48, sc, "Pick something in Music", COL_W, 0);
+    }
+
+    if (show_shuf)
+        aui_text(AF_SMALL, AUI_W / 2, 202, tc,
+                 global_settings.playlist_shuffle ? "Shuffle On" : "Shuffle Off", 200, 1);
+    else if (show_vol)
+    {
+        snprintf(buf, sizeof(buf), "Volume %d%%", aui_volume_pct());
+        aui_text(AF_SMALL, AUI_W / 2, 202, tc, buf, 200, 1);
+    }
+    else if (playing)
+    {
+        aui_fmt_time(buf, sizeof(buf), pos);
+        aui_fmt_time(b2, sizeof(b2), len);
+        aui_text(AF_SMALL, ART_X, 202, tc, buf, 100, 0);
+        aui_text(AF_SMALL, AUI_W - ART_X, 202, tc, b2, 100, 2);
+    }
+    (void)t;
+    aui_topbar_text("Now Playing");
+    aui_update();
+}
