@@ -0,0 +1,86 @@
+/* Asher OS settings extras: click wheel sound toggle and the version screen. */
+#include <stdio.h>
+#include <string.h>
+#include "config.h"
+#include "system.h"
+#include "kernel.h"
+#include "action.h"
+#include "misc.h"
+#include "menu.h"
+#include "splash.h"
+#include "settings.h"
+#include "powermgmt.h"
+#include "tagcache.h"
+#include "mv.h"
+#include "asher_ui.h"
+#include "asher_settings.h"
+
+#define ASHER_OS_VERSION "1.2"
+
+static int click_toggle(void)
+{
+#ifdef HAVE_HARDWARE_CLICK
+    global_settings.keyclick_hardware = !global_settings.keyclick_hardware;
+    global_settings.keyclick_repeats = true;
+    settings_save();
+    splash(HZ, global_settings.keyclick_hardware ? "Click Wheel Sound: On"
+                                                 : "Click Wheel Sound: Off");
+#else
+    splash(HZ, "Not available on this device");
+#endif
+    return 0;
+}
+MENUITEM_FUNCTION(asher_click_item, 0, "Click Wheel Sound", click_toggle, NULL, Icon_NOICON);
+
+static void version_draw(void)
+{
+    const struct aui_theme *t = aui_theme();
+    char buf[64];
+    sector_t size = 0, freek = 0;
+    int bat = battery_level();
+    int y = AUI_BAR + 14;
+
+    volume_size(IF_MV(0,) &size, &freek);
+    aui_vgrad(0, 0, AUI_W, AUI_H, t->bg_top, t->bg_bot);
+    aui_topbar();
+    aui_sprite_c(SPR_MUSIC_S, AUI_W / 2, y + 30);
+    aui_present();
+    y += 68;
+    aui_text(AF_RETRO, AUI_W / 2, y, t->accent, "ASHER OS", AUI_W - 20, 1);
+    y += 26;
+    aui_text(AF_BIG, AUI_W / 2, y, t->text, "Version " ASHER_OS_VERSION, AUI_W - 20, 1);
+    y += 24;
+    aui_text(AF_SMALLR, AUI_W / 2, y, t->sub, "Built " __DATE__ "  -  iPod Classic", AUI_W - 20, 1);
+    y += 16;
+    if (size)
+    {
+        snprintf(buf, sizeof(buf), "%lu.%lu GB free of %lu GB",
+                 (unsigned long)(freek / (1024 * 1024)),
+                 (unsigned long)((freek % (1024 * 1024)) * 10 / (1024 * 1024)),
+                 (unsigned long)((size + 512 * 1024) / (1024 * 1024)));
+        aui_text(AF_SMALLR, AUI_W / 2, y, t->sub, buf, AUI_W - 20, 1);
+        y += 16;
+    }
+    if (bat >= 0)
+    {
+        snprintf(buf, sizeof(buf), "Battery %d%%", bat);
+        aui_text(AF_SMALLR, AUI_W / 2, y, t->sub, buf, AUI_W - 20, 1);
+    }
+    aui_topbar_text("About");
+    aui_update();
+}
+
+static int version_screen(void)
+{
+    aui_begin();
+    while (1)
+    {
+        version_draw();
+        int a = get_action(CONTEXT_STD, HZ * 5);
+        if (a == ACTION_STD_CANCEL || a == ACTION_STD_MENU || a == ACTION_STD_OK) break;
+        if (a != ACTION_NONE && default_event_handler(a) == SYS_USB_CONNECTED) break;
+    }
+    aui_end();
+    return 0;
+}
+MENUITEM_FUNCTION(asher_version_item, 0, "Asher OS Version", version_screen, NULL, Icon_NOICON);
