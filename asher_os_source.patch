+#define ASHER_THEME_DIR "/.rockbox/asher/themes/"
+#define STATE_FILE      "/.rockbox/asher/state.txt"
+#define NUM_THEMES 4
+
+int asher_layout = 0;
+
+static const char *theme_file[NUM_THEMES] = { "bubbles", "classic", "dark", "modern" };
+static const char *theme_name[NUM_THEMES] = { "Retro", "Classic", "Dark", "Modern" };
+
+/* which themes may use a wallpaper: 1 << theme number */
+#define WT_ALL    0x0f                     /* "Off" */
+#define WT_OLD    ((1 << 0) | (1 << 1) | (1 << 2))   /* Retro, Classic, Dark */
+#define WT_MODERN ((1 << 2) | (1 << 3))      /* Dark and Modern */
+struct wpdef { const char *name; const char *scene; bool timed; unsigned char themes; };
+static const struct wpdef wps[] = {
+    { "Street (Time of Day)", "street",     true, WT_OLD },
+    { "Arcade",               "arcade",     false, WT_OLD },
+    { "Pumpkin Witch",        "witch",      false, WT_OLD },
+    { "Rainy Cabin",          "cabin",      false, WT_OLD },
+    { "Snowy Cafe",           "cafe",       false, WT_OLD },
+    { "Bus Stop",             "busstop",    false, WT_OLD },
+    { "Frozen Creek",         "creek",      false, WT_OLD },
+    { "City Sunset",          "citysunset", false, WT_OLD },
+    { "Lantern Alley",        "alley",      false, WT_OLD },
+    { "Dusk Street",          "dusk",       false, WT_OLD },
+    { "Blossom Lane",         "blossom",    false, WT_OLD },
+    { "Cyber Rain Street",    "neonrain",   false, WT_OLD },
+    { "Cyber Biker Alley",    "biker",      false, WT_OLD },
+    { "Cyber Bunny Market",   "bunny",      false, WT_OLD },
+    { "Cyber City Skyline",   "skyline",    false, WT_OLD },
+    { "Night Train",          "train",      false, WT_OLD },
+    { "Ramen Tower",          "ramen",      false, WT_OLD },
+    { "Christmas Toy Shop",   "toyshop",    false, WT_OLD },
+    { "Snowy Cottage",        "cottage",    false, WT_OLD },
+    { "Moonlit Castle",       "castle",     false, WT_OLD },
+    { "Sunset Beach",         "sunbeach",   false, WT_MODERN },
+    { "Cabin in the Woods",   "cabinwoods", false, WT_MODERN },
+    { "Mountain Peak",        "peak",       false, WT_MODERN },
+    { "Planets",              "planets",    false, WT_MODERN },
+    { "Desert Dunes",         "dunes",      false, WT_MODERN },
+    { "Grey Waves",           "greywaves",  false, WT_MODERN },
+    { "Off",                  NULL,         false, WT_ALL },
+};
+#define NUM_WPS ((int)(sizeof(wps) / sizeof(wps[0])))
+
+static int cur_theme = 0, cur_wp = 0;
+static int keep_wp = -1;     /* the old-style wallpaper to go back to */
+#define FIRST_MODERN_WP 20   /* Sunset Beach */
+
+static bool wp_ok(int i, int theme) { return (wps[i].themes >> theme) & 1; }
+static int wp_index(const char *scene)
+{
+    for (int i = 0; i < NUM_WPS; i++)
+        if (wps[i].scene && scene && !strcmp(wps[i].scene, scene)) return i;
+    return -1;
+}
+
+const char *asher_wallpaper_name(void)
+{
+    return wps[cur_wp].scene ? wps[cur_wp].name : NULL;
+}
+
+static void save_state(void)
+{
+    char s[48];
+    int n = snprintf(s, sizeof(s), "%c:%s:%s\n", '0' + cur_theme,
+                     wps[cur_wp].scene ? wps[cur_wp].scene : "off",
+                     (keep_wp >= 0 && wps[keep_wp].scene) ? wps[keep_wp].scene : "-");
+    int fd = open(STATE_FILE, O_WRONLY | O_CREAT | O_TRUNC, 0666);
+    if (fd >= 0) { write(fd, s, n); close(fd); }
+}
+
+static void apply_wallpaper(int i)
+{
+    cur_wp = i;
+    asher_wallpaper_set(wps[i].scene, wps[i].timed);
+}
+
+static void apply_theme_real(int i);
+static void apply_theme(int i)
+{
+    /* the skin and fonts load into Asher's reserve, so the music buffer
+     * never has to shrink (which pauses the music) */
+    asher_mem_lend();
+    apply_theme_real(i);
+    asher_mem_back();
+}
+static void apply_theme_real(int i)
+{
+    char path[MAX_PATH];
+    cur_theme = i;
+    asher_layout = i;
+    snprintf(path, sizeof(path), ASHER_THEME_DIR "%s.cfg", theme_file[i]);
+    if (!settings_load_config(path, true) && i == 3)
+    {
+        /* Modern theme file missing: still give Settings its light grey look */
+        global_settings.fg_color = LCD_RGBPACK(28, 28, 30);
+        global_settings.bg_color = LCD_RGBPACK(242, 242, 247);
+        global_settings.lss_color = LCD_RGBPACK(10, 132, 255);
+        global_settings.lse_color = LCD_RGBPACK(0, 122, 255);
+        global_settings.lst_color = LCD_RGBPACK(255, 255, 255);
+        settings_apply(false);
+    }
+}
+
+void asher_theme_apply_saved(void)
+{
+    char s[48];
+    int t = 0, w = 0, len = 0;
+    int fd = open(STATE_FILE, O_RDONLY);
+    if (fd >= 0)
+    {
+        len = read(fd, s, sizeof(s) - 1);
+        close(fd);
+    }
+    if (len >= 2)
+    {
+        s[len] = '\0';
+        if (s[0] >= '0' && s[0] < '0' + NUM_THEMES) t = s[0] - '0';
+        if (s[1] == ':')
+        {
+            char *nl = strchr(s, '\n');
+            if (nl) *nl = '\0';
+            char *k = strchr(s + 2, ':');           /* 2.3: theme:wallpaper:kept */
+            if (k) { *k++ = '\0'; keep_wp = wp_index(k); }
+            for (int i = 0; i < NUM_WPS; i++)
+                if (wps[i].scene ? !strcmp(wps[i].scene, s + 2) : !strcmp(s + 2, "off"))
+                    w = i;
+        }
+        else if (s[1] >= 'a' && s[1] <= 'l')        /* old format */
+            w = (s[1] == 'l') ? NUM_WPS - 1 : s[1] - 'a';
+    }
+    apply_theme(t);
+    if (!wp_ok(w, t)) w = (t == 3) ? FIRST_MODERN_WP : (keep_wp >= 0 ? keep_wp : 0);
+    apply_wallpaper(w);
+    aui_init();     /* fonts, icons and the album art slot */
+    asher_prefs_load();
+    /* one click when buttons are held (e.g. Menu+Select to reset), the
+     * wheel still clicks on every step */
+    global_settings.keyclick_repeats = false;
+    /* a bigger play queue (used from the next start-up) so Shuffle and
+     * All Songs don't run out of room; 5th gen keeps a smaller one */
+#if CONFIG_CPU == PP5022 || CONFIG_CPU == PP5020
+    const int want_queue = 4000;
+#else
+    const int want_queue = 10000;
+#endif
+    if (global_settings.max_files_in_playlist < want_queue)
+    {
+        global_settings.max_files_in_playlist = want_queue;
+        settings_save();
+    }
+#if defined(USB_ENABLE_HID) && (defined(IPOD_NANO3G) || defined(IPOD_6G))
+    /* nano: plain USB drive only, the same setup as its start-up program's
+     * USB mode, which is the one known to work on the nano */
+    if (global_settings.usb_hid)
+    {
+        global_settings.usb_hid = false;
+        usb_set_hid(false);
+        settings_save();
+    }
+#elif defined(USB_ENABLE_HID)
+    /* keep the USB setup exactly as it was before 2.0: turning the extra
+     * USB remote part off made Windows stop recognising some iPods */
+    if (!global_settings.usb_hid)
+    {
+        global_settings.usb_hid = true;
+        usb_set_hid(true);
+        settings_save();
+    }
+#endif
+    /* battery savers: the screen controller sleeps 1 second after the
+     * fade, and the hard drive spins down as soon as it's allowed to */
+#ifdef HAVE_LCD_SLEEP_SETTING
+    /* (5th gen: the panel is only blanked, the screen chip stays on, so
+     * waking can't fail the way it used to) */
+    global_settings.lcd_sleep_after_backlight_off = 1;
+    lcd_set_sleep_after_backlight_off(1);
+#endif
+#ifdef HAVE_DISK_STORAGE
+    global_settings.disk_spindown = 3;
+    storage_spindown(3);
+#endif
+#if defined(IPOD_VIDEO) && (CONFIG_BACKLIGHT_FADING == BACKLIGHT_FADING_PWM)
+    /* 5th gen: its backlight can fade by itself, two seconds out */
+    global_settings.backlight_fade_out = 2000;
+    backlight_set_fade_out(2000);
+#endif
+    /* the settings above can start the "screen controller sleep" countdown
+     * while the screen is still coming up, which blanked it a second or two
+     * after boot; this restarts the normal screen timer instead */
+    backlight_on();
+#ifdef HAS_BUTTON_HOLD
+    /* sliding the hold switch on fades the screen straight out */
+    global_settings.backlight_on_button_hold = 1;
+    backlight_set_on_button_hold(1);
+#endif
+}
+
+static int pick_theme(void *p)
+{
+    int i = (int)(intptr_t)p;
+    /* Modern gets its own wallpapers; the others go back to the one that
+     * was in use before (the new ones only show in Modern and Dark) */
+    if (i == 3 && !wp_ok(cur_wp, 3))
+    {
+        keep_wp = cur_wp;
+        apply_wallpaper(FIRST_MODERN_WP);
+    }
+    else if (!wp_ok(cur_wp, i))
+        apply_wallpaper(keep_wp >= 0 && wp_ok(keep_wp, i) ? keep_wp : 0);
+    apply_theme(i);
+    save_state();
+    splashf(HZ, "Theme: %s", theme_name[i]);
+    return 0;
+}
+
+/* ---- Settings > Wallpaper: scroll through live previews ---- */
+/* << and >> step through the previews too (they don't pick one) */
+#ifdef BUTTON_SCROLL_FWD
+static const struct button_mapping picker_map[] = {
+    { ACTION_STD_NEXT,        BUTTON_SCROLL_FWD,                BUTTON_NONE },
+    { ACTION_STD_NEXTREPEAT,  BUTTON_SCROLL_FWD|BUTTON_REPEAT,  BUTTON_NONE },
+    { ACTION_STD_PREV,        BUTTON_SCROLL_BACK,               BUTTON_NONE },
+    { ACTION_STD_PREVREPEAT,  BUTTON_SCROLL_BACK|BUTTON_REPEAT, BUTTON_NONE },
+    { ACTION_STD_NEXT,        BUTTON_RIGHT,                     BUTTON_NONE },
+    { ACTION_STD_NEXTREPEAT,  BUTTON_RIGHT|BUTTON_REPEAT,       BUTTON_NONE },
+    { ACTION_STD_PREV,        BUTTON_LEFT,                      BUTTON_NONE },
+    { ACTION_STD_PREVREPEAT,  BUTTON_LEFT|BUTTON_REPEAT,        BUTTON_NONE },
+    { ACTION_STD_OK,          BUTTON_SELECT|BUTTON_REL,         BUTTON_SELECT },
+    { ACTION_STD_MENU,        BUTTON_MENU|BUTTON_REL,           BUTTON_MENU },
+    { ACTION_STD_QUICKSCREEN, BUTTON_MENU|BUTTON_REPEAT,        BUTTON_MENU },
+    LAST_ITEM_IN_LIST
+};
+static const struct button_mapping *picker_ctx(int c) { (void)c; return picker_map; }
+static int picker_action(int tmo) { return get_custom_action(CONTEXT_PLUGIN | 3, tmo, picker_ctx); }
+#else
+static int picker_action(int tmo) { return get_action(CONTEXT_STD, tmo); }
+#endif
+#define PV_X ((AUI_W - ASHER_PV_W) / 2)
+#define PV_Y (AUI_BAR + 3)
+
+static void picker_draw(int sel, bool shown, int pct)
+{
+    const struct aui_theme *t = aui_theme();
+    char buf[48];
+    const fb_data *f = shown ? asher_wp_preview_frame() : NULL;
+
+    aui_vgrad(0, 0, AUI_W, AUI_H, t->bg_top, t->bg_bot);
+    aui_topbar();
+    aui_round(PV_X - 3, PV_Y - 3, ASHER_PV_W + 6, ASHER_PV_H + 6, 6,
+              t->light ? 0xb9bfcc : 0x3a3f73, t->light ? 0x9aa2b4 : 0x262a55);
+    if (f)
+        aui_blit(f, ASHER_PV_W, ASHER_PV_H, PV_X, PV_Y);
+    else
+        aui_vgrad(PV_X, PV_Y, ASHER_PV_W, ASHER_PV_H, 0x1c1f3d, 0x0b0c1c);
+    if (wps[sel].scene && (!f || !asher_wp_preview_ready()))
+        aui_progress(PV_X + 50, PV_Y + ASHER_PV_H - 18, ASHER_PV_W - 100, 6,
+                     shown ? pct : 0, 100);
+    aui_present();
+
+    if (!wps[sel].scene)
+        aui_text(AF_RETRO, AUI_W / 2, PV_Y + ASHER_PV_H / 2 - 10, 0xc9cfee,
+                 "NO WALLPAPER", ASHER_PV_W - 10, 1);
+    else if (!f)
+        aui_text(AF_RETRO_S, AUI_W / 2, PV_Y + ASHER_PV_H / 2 - 4, 0xc9cfee,
+                 "loading preview", ASHER_PV_W - 10, 1);
+
+    int ny = PV_Y + ASHER_PV_H + 5;
+    aui_text(AF_BIG, AUI_W / 2, ny, t->text, wps[sel].name, AUI_W - 50, 1);
+    aui_text(AF_BIG, 12, ny, t->sub, "<", 20, 0);
+    aui_text(AF_BIG, AUI_W - 12, ny, t->sub, ">", 20, 2);
+    int pos = 0, total = 0;
+    for (int i = 0; i < NUM_WPS; i++)
+        if (wp_ok(i, cur_theme)) { total++; if (i <= sel) pos++; }
+    snprintf(buf, sizeof(buf), sel == cur_wp ? "%d of %d  -  in use" : "%d of %d", pos, total);
+    aui_text(AF_SMALLR, AUI_W / 2, ny + 20, t->sub, buf, AUI_W - 20, 1);
+    aui_topbar_text("Wallpaper");
+    aui_update();
+}
+
+static int wallpaper_picker(void)
+{
+    int sel = cur_wp, shown = -1, frame = -1, pct = 0;
+    long settle = 0;
+    bool redraw = true;
+
+    aui_begin();
+    while (1)
+    {
+        /* open the preview once the wheel has rested on an item */
+        if (shown != sel && TIME_AFTER(current_tick, settle))
+        {
+            asher_wp_preview_open(wps[sel].scene, wps[sel].timed);
+            shown = sel;
+            pct = 0;
+            redraw = true;
+        }
+        bool loading = shown == sel && asher_wp_preview_loading();
+        if (loading)
+        {
+            int before = pct;
+            pct = asher_wp_preview_load(2);      /* a little at a time */
+            if (pct != before) redraw = true;
+        }
+        int f = asher_wp_preview_frame_no();
+        if (f != frame) { frame = f; redraw = true; }
+        if (aui_woke()) redraw = true;
+        if (redraw && aui_screen_on())
+        {
+            picker_draw(sel, shown == sel, pct);
+            redraw = false;
+        }
+
+        int tmo = loading ? 1 : (shown != sel ? HZ / 10
+                  : (asher_wp_preview_ready() ? asher_wp_preview_ticks() : HZ));
+        int a = picker_action(aui_screen_on() ? tmo : HZ);
+        switch (a)
+        {
+            case ACTION_STD_NEXT: case ACTION_STD_NEXTREPEAT:
+            case ACTION_STD_PREV: case ACTION_STD_PREVREPEAT:
+            {
+                bool next = a == ACTION_STD_NEXT || a == ACTION_STD_NEXTREPEAT;
+                do sel = (sel + (next ? 1 : NUM_WPS - 1)) % NUM_WPS;
+                while (!wp_ok(sel, cur_theme));
+                asher_wp_preview_close();       /* stop loading the old one */
+                shown = -1;
+                settle = current_tick + HZ / 4;
+                redraw = true;
+                break;
+            }
+            case ACTION_STD_OK:
+                asher_wp_preview_close();
+                apply_wallpaper(sel);
+                if (wps[sel].themes != WT_MODERN && wps[sel].scene) keep_wp = sel;
+                save_state();
+                aui_end();
+                splashf(HZ, "Wallpaper: %s", wps[sel].name);
+                return 0;
+            case ACTION_STD_QUICKSCREEN:          /* hold Menu: music controls */
+                asher_music_mode();
+                redraw = true;
+                break;
+            case ACTION_STD_CANCEL:
+            case ACTION_STD_MENU:
+                asher_wp_preview_close();
+                aui_end();
+                return 0;
+            case ACTION_NONE:
+                break;
+            default:
+                if (default_event_handler(a) == SYS_USB_CONNECTED)
+                {
+                    asher_wp_preview_close();
+                    aui_end();
+                    return 0;
+                }
+                redraw = true;
+                break;
+        }
+    }
+}
