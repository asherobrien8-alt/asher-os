diff --git a/apps/playlist.c b/apps/playlist.c
index 430a2ca117..8ffd8d63e5 100644
--- a/apps/playlist.c
+++ b/apps/playlist.c
@@ -4174,3 +4174,55 @@ error:
         audio_flush_and_reload_tracks();
     return rc;
 }
+
+/* ------------------------------------------------------------------ */
+/* Asher OS: the play queue                                            */
+/* ------------------------------------------------------------------ */
+int playlist_queued_ahead(void)
+{
+    struct playlist_info *pl = &current_playlist;
+    int n = 0;
+    if (!pl->started || pl->amount <= 0 || pl->index < 0)
+        return 0;
+    for (int i = pl->index + 1; i < pl->amount; i++)
+        if (pl->indices[i] & PLAYLIST_QUEUED)
+            n++;
+    return n;
+}
+
+bool playlist_is_queued_ahead(int ahead)
+{
+    struct playlist_info *pl = &current_playlist;
+    if (!pl->started || pl->amount <= 0 || pl->index < 0)
+        return false;
+    int i = (pl->index + ahead) % pl->amount;
+    return (pl->indices[i] & PLAYLIST_QUEUED) != 0;
+}
+
+int playlist_cancel_queue(void)
+{
+    struct playlist_info *pl = &current_playlist;
+    int removed = 0;
+    if (!pl->started || pl->amount <= 0 || pl->index < 0)
+        return 0;
+    dc_thread_stop(pl);
+    playlist_write_lock(pl);
+    if (check_control(pl) >= 0)
+    {
+        /* only the songs still to come; the one playing stays */
+        for (int i = pl->index + 1; i < pl->amount; )
+        {
+            if (!(pl->indices[i] & PLAYLIST_QUEUED))
+                i++;
+            else if (remove_track_unlocked(pl, i, true) >= 0)
+                removed++;           /* the next song moved into slot i */
+            else
+                break;
+        }
+    }
+    playlist_write_unlock(pl);
+    dc_thread_start(pl, false);
+    if (removed && (audio_status() & AUDIO_STATUS_PLAY))
+        audio_flush_and_reload_tracks();
+    return removed;
+}
