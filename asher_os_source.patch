diff --git a/apps/asher/asher_wallpaper.c b/apps/asher/asher_wallpaper.c
new file mode 100644
index 0000000000..e5e7c3a43f
--- /dev/null
+++ b/apps/asher/asher_wallpaper.c
@@ -0,0 +1,289 @@
+/* Asher OS live wallpapers. See asher_wallpaper.h. */
+#include <stdio.h>
+#include <string.h>
+#include <fcntl.h>
+#include "config.h"
+#include "system.h"
+#include "kernel.h"
+#include "file.h"
+#include "core_alloc.h"
+#include "asher_mem.h"
+#include "string-extra.h"
+#include "timefuncs.h"
+#include "lcd.h"
+#include "asher_wallpaper.h"
+
+#define AWP_DIR "/.rockbox/asher/wallpaper/"
+#define AWP_HDR 12
+
+struct awp {
+    int handle;
+    int w, h, n, ms;
+    size_t fsz;
+    char name[48];
+};
+static struct awp full = { -1 }, small = { -1 };
+
+static void (*load_cb)(int pct);
+static int load_base, load_span;
+
+void asher_wp_set_loading_cb(void (*cb)(int pct)) { load_cb = cb; }
+
+static char want[40];          /* chosen wallpaper (base name), "" = off */
+static char failed[48];        /* last pack that could not be loaded */
+static long failed_at;
+static bool want_auto;         /* follow the time of day */
+static long next_check;
+
+/* iPods with 32MB of memory (5th gen 30GB, nano 3rd gen) keep smaller
+ * wallpapers so there's room left for music, playlists and the library */
+static bool low_memory(void)
+{
+#if defined(IPOD_NANO3G)
+    return true;
+#elif defined(IPOD_VIDEO) && !defined(SIMULATOR)
+    extern unsigned char probed_ramsize;
+    return probed_ramsize <= 32;
+#else
+    return false;
+#endif
+}
+static size_t wp_budget(int w)
+{
+    if (!low_memory()) return (size_t)-1;
+    return w >= LCD_WIDTH ? 4500 * 1024 : (w >= 200 ? 1600 * 1024 : 1100 * 1024);
+}
+
+static void awp_free(struct awp *p)
+{
+    if (p->handle > 0) asher_free(p->handle);
+    p->handle = -1;
+    p->n = 0;
+    p->name[0] = '\0';
+}
+
+static bool awp_load(struct awp *p, const char *name, int w, int h)
+{
+    char path[MAX_PATH];
+    unsigned char hd[AWP_HDR];
+    int fd, n;
+    if (p->handle > 0 && !strcmp(p->name, name)) return true;
+    awp_free(p);
+    snprintf(path, sizeof(path), AWP_DIR "%s.awp", name);
+    fd = open(path, O_RDONLY);
+    if (fd < 0) return false;
+    if (read(fd, hd, AWP_HDR) != AWP_HDR || memcmp(hd, "AWP1", 4)
+        || (hd[4] | hd[5] << 8) != w || (hd[6] | hd[7] << 8) != h
+        || (n = (hd[8] | hd[9] << 8)) < 1)
+    { close(fd); return false; }
+    p->w = w; p->h = h;
+    p->ms = hd[10] | hd[11] << 8;
+    if (p->ms < 50) p->ms = 50;
+    p->fsz = (size_t)w * h * sizeof(fb_data);
+    /* iPods with less memory (5th gen 30GB): if it doesn't fit, keep every
+     * 2nd (3rd...) frame and play them a bit slower instead */
+    int step = 1;
+    while (n / step > 1 && ((size_t)(n / step) * p->fsz > wp_budget(w)
+                            || (size_t)(n / step) * p->fsz > asher_mem_avail()))
+        step++;     /* fewer frames rather than pausing the music for memory */
+    p->handle = -1;
+    while (n / step >= 1)
+    {
+        p->handle = asher_alloc((size_t)(n / step) * p->fsz);
+        if (p->handle > 0) break;
+        p->handle = -1;
+        if (n / step == 1) break;
+        step++;
+    }
+    if (p->handle <= 0) { close(fd); p->handle = -1; p->n = 0; return false; }
+    n = n / step;
+    p->n = n;
+    p->ms *= step;
+    bool ok = true;
+    if (load_cb) load_cb(load_base);
+    for (int i = 0; i < n && ok; i++)
+    {
+        char *dst = core_get_data_pinned(p->handle);
+        if (step > 1)
+            lseek(fd, AWP_HDR + (off_t)i * step * p->fsz, SEEK_SET);
+        ok = read(fd, dst + (size_t)i * p->fsz, p->fsz) == (ssize_t)p->fsz;
+        core_unpin(p->handle);
+        if (load_cb && (i & 1) == 0)
+            load_cb(load_base + (load_span * (i + 1)) / n);
+    }
+    close(fd);
+    if (!ok) { awp_free(p); return false; }
+    strmemccpy(p->name, name, sizeof(p->name));
+    return true;
+}
+
+const char *asher_scene_for_time(void)
+{
+    struct tm *t = get_time();
+    int h = t->tm_hour;
+    if (h >= 5 && h < 12)  return "street_morning";   /* 5 AM - 11:59 AM */
+    if (h >= 12 && h < 19) return "street_midday";    /* 12 PM - 6:59 PM */
+    return "street_night";                            /* 7 PM - 4:59 AM */
+}
+
+static void ensure_loaded(void)
+{
+    char sname[56];
+    const char *r;
+    if (!want[0]) return;
+    if (want_auto && TIME_BEFORE(current_tick, next_check) && full.handle > 0)
+        return;
+    next_check = current_tick + 30 * HZ;
+    r = want_auto ? asher_scene_for_time() : want;
+    snprintf(sname, sizeof(sname), "%s_s", r);
+    bool need_full = !(full.handle > 0 && !strcmp(full.name, r));
+    bool need_small = !(small.handle > 0 && !strcmp(small.name, sname));
+    load_base = 0; load_span = need_small ? 80 : 100;
+    /* a wallpaper that didn't load (drive busy at start-up, memory still
+     * being handed out...) is tried again every 10 seconds instead of
+     * leaving a black background until it's picked again */
+    if (!strcmp(failed, r) && TIME_BEFORE(current_tick, failed_at + 10 * HZ)) return;
+    if (need_full && !awp_load(&full, r, LCD_WIDTH, LCD_HEIGHT))
+        { strmemccpy(failed, r, sizeof(failed)); failed_at = current_tick; return; }
+    failed[0] = '\0';
+    load_base = need_full ? 80 : 0; load_span = need_full ? 20 : 100;
+    if (need_small) awp_load(&small, sname, ASHER_BOX_W, ASHER_BOX_H);
+}
+
+void asher_wallpaper_set(const char *scene, bool follow_time)
+{
+    want_auto = follow_time;
+    next_check = 0;
+    failed[0] = '\0';
+    if (scene) strmemccpy(want, scene, sizeof(want)); else want[0] = '\0';
+    if (!want[0]) { awp_free(&full); awp_free(&small); return; }
+    /* loaded on the next screen that shows it (with a loading screen) */
+}
+
+static int frame_index(const struct awp *p)
+{
+    if (p->n <= 1) return 0;
+    return (int)(((unsigned long)current_tick * (1000 / HZ) / p->ms) % p->n);
+}
+
+static const fb_data *frame(struct awp *p)
+{
+    ensure_loaded();
+    if (p->handle <= 0) return NULL;
+    return (const fb_data *)((char *)core_get_data(p->handle)
+                             + (size_t)frame_index(p) * p->fsz);
+}
+
+void asher_wp_prepare(void) { ensure_loaded(); }
+
+const fb_data *asher_wp_full(void)  { return want[0] ? frame(&full) : NULL; }
+const fb_data *asher_wp_small(void) { return want[0] ? frame(&small) : NULL; }
+
+/* first frame only (screens where the wallpaper shouldn't animate) */
+const fb_data *asher_wp_small_still(void)
+{
+    if (!want[0]) return NULL;
+    ensure_loaded();
+    return small.handle > 0 ? (const fb_data *)core_get_data(small.handle) : NULL;
+}
+
+bool asher_wp_animated(void)
+{
+    return want[0] && (full.n > 1 || small.n > 1);
+}
+
+int asher_wp_frame_ticks(void)
+{
+    int ms = full.n > 1 ? full.ms : small.ms;
+    int t = ms * HZ / 1000;
+    return t < 1 ? 1 : t;
+}
+
+int asher_wp_frame_no(void)
+{
+    struct awp *p = full.n > 1 ? &full : &small;
+    return asher_wp_animated() ? frame_index(p) : 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* Settings > Wallpaper preview (224x168 packs, read a few frames at a  */
+/* time so scrolling past one never waits for the hard drive)          */
+/* ------------------------------------------------------------------ */
+static struct { int fd, handle, w, h, n, ms, loaded, step; size_t fsz; } pv = { -1, -1, 0, 0, 0, 0, 0, 1, 0 };
+
+void asher_wp_preview_close(void)
+{
+    if (pv.fd >= 0) close(pv.fd);
+    if (pv.handle > 0) asher_free(pv.handle);
+    pv.fd = pv.handle = -1;
+    pv.n = pv.loaded = 0;
+}
+
+bool asher_wp_preview_open(const char *scene, bool timed)
+{
+    char path[MAX_PATH];
+    unsigned char hd[AWP_HDR];
+    asher_wp_preview_close();
+    if (!scene) return false;
+    snprintf(path, sizeof(path), AWP_DIR "%s_p.awp", timed ? asher_scene_for_time() : scene);
+    pv.fd = open(path, O_RDONLY);
+    if (pv.fd < 0) return false;
+    if (read(pv.fd, hd, AWP_HDR) != AWP_HDR || memcmp(hd, "AWP1", 4)
+        || (hd[4] | hd[5] << 8) != ASHER_PV_W || (hd[6] | hd[7] << 8) != ASHER_PV_H
+        || (pv.n = hd[8] | hd[9] << 8) < 1)
+        { asher_wp_preview_close(); return false; }
+    pv.w = ASHER_PV_W; pv.h = ASHER_PV_H;
+    pv.ms = hd[10] | hd[11] << 8;
+    if (pv.ms < 50) pv.ms = 50;
+    pv.fsz = (size_t)pv.w * pv.h * sizeof(fb_data);
+    pv.step = 1;
+    while (pv.n / pv.step > 1 && ((size_t)(pv.n / pv.step) * pv.fsz > wp_budget(pv.w)
+                                  || (size_t)(pv.n / pv.step) * pv.fsz > asher_mem_avail()))
+        pv.step++;
+    for (;;)
+    {
+        pv.handle = asher_alloc((size_t)(pv.n / pv.step) * pv.fsz);
+        if (pv.handle > 0 || pv.n / pv.step <= 1) break;
+        pv.step++;
+    }
+    if (pv.handle <= 0) { pv.handle = -1; asher_wp_preview_close(); return false; }
+    pv.n /= pv.step;
+    pv.ms *= pv.step;
+    return true;
+}
+
+/* read up to 'count' more frames; returns how much is loaded, 0..100 */
+int asher_wp_preview_load(int count)
+{
+    if (pv.handle <= 0) return 0;
+    while (count-- > 0 && pv.loaded < pv.n)
+    {
+        char *dst = core_get_data_pinned(pv.handle);
+        if (pv.step > 1)
+            lseek(pv.fd, AWP_HDR + (off_t)pv.loaded * pv.step * pv.fsz, SEEK_SET);
+        bool ok = read(pv.fd, dst + (size_t)pv.loaded * pv.fsz, pv.fsz) == (ssize_t)pv.fsz;
+        core_unpin(pv.handle);
+        if (!ok) { asher_wp_preview_close(); return 0; }
+        pv.loaded++;
+    }
+    if (pv.loaded == pv.n && pv.fd >= 0) { close(pv.fd); pv.fd = -1; }
+    return pv.loaded * 100 / pv.n;
+}
+
+bool asher_wp_preview_ready(void) { return pv.handle > 0 && pv.loaded == pv.n; }
+bool asher_wp_preview_loading(void) { return pv.handle > 0 && pv.loaded < pv.n; }
+int asher_wp_preview_ticks(void) { int t = pv.ms * HZ / 1000; return t < 1 ? 1 : t; }
+
+int asher_wp_preview_frame_no(void)
+{
+    if (!asher_wp_preview_ready() || pv.n <= 1) return 0;
+    return (int)(((unsigned long)current_tick * (1000 / HZ) / pv.ms) % pv.n);
+}
+
+/* the frame to show: the first one while the rest load, then it plays */
+const fb_data *asher_wp_preview_frame(void)
+{
+    if (pv.handle <= 0 || pv.loaded == 0) return NULL;
+    return (const fb_data *)((char *)core_get_data(pv.handle)
+                             + (size_t)asher_wp_preview_frame_no() * pv.fsz);
+}
