+#include "timefuncs.h"
+#include "audio.h"
+#include "playback.h"
+#include "buffering.h"
+#include "gui/viewport.h"
+#include "core_alloc.h"
+#include "action.h"
+#include "asher_ui.h"
+#include "asher_theme.h"
+#include "asher_wallpaper.h"
+
+#if LCD_PIXELFORMAT != RGB565
+#error "Asher OS UI expects an RGB565 screen"
+#endif
+
+#define UI_DIR "/.rockbox/asher/ui/"
+#define FONT_DIR "/.rockbox/fonts/"
+
+fb_data aui_fb[LCD_WIDTH * LCD_HEIGHT];
+
+/* ------------------------------------------------------------------ */
+/* themes                                                              */
+/* ------------------------------------------------------------------ */
+static const struct aui_theme themes[3] = {
+    /* Bubbles */
+    { false, true,  0x141633, 0x06070e, 0xffffff, 0xaab2d8, 0xb79cff,
+      0x7b5cff, 0x2f8cff, 0xffffff, 0x1b1e3a, 0x3a3f66 },
+    /* Classic */
+    { true,  false, 0xffffff, 0xffffff, 0x000000, 0x5d6372, 0x1a62c8,
+      0x5aa6f4, 0x1860c9, 0xffffff, 0xf2f3f6, 0xd4d7de },
+    /* Dark */
+    { false, true,  0x16171d, 0x0a0a0d, 0xf2f2f5, 0x9a9fb0, 0x6fb1ff,
+      0x4c9bf0, 0x1760c8, 0xffffff, 0x1c1d24, 0x3a3c46 },
+};
+
+const struct aui_theme *aui_theme(void)
+{
+    int i = asher_layout;
+    if (i < 0 || i > 2) i = 0;
+    return &themes[i];
+}
+
+/* ------------------------------------------------------------------ */
+/* colour helpers (RGB565)                                             */
+/* ------------------------------------------------------------------ */
+static inline fb_data px(unsigned rgb)
+{
+    return (fb_data)((((rgb >> 16) & 0xf8) << 8) | (((rgb >> 8) & 0xfc) << 3)
+                     | ((rgb & 0xff) >> 3));
+}
+static inline fb_data blend(fb_data d, fb_data s, unsigned a)   /* a 0..256 */
+{
+    unsigned dr = d >> 11, dg = (d >> 5) & 63, db = d & 31;
+    unsigned sr = s >> 11, sg = (s >> 5) & 63, sb = s & 31;
+    unsigned ia = 256 - a;
+    return (fb_data)((((sr * a + dr * ia) >> 8) << 11) |
+                     (((sg * a + dg * ia) >> 8) << 5) | ((sb * a + db * ia) >> 8));
+}
+static inline unsigned lerp_rgb(unsigned a, unsigned b, int t, int n)
+{
+    if (n <= 0) return a;
+    int r = ((a >> 16) & 255) + ((((int)((b >> 16) & 255) - (int)((a >> 16) & 255)) * t) / n);
+    int g = ((a >> 8) & 255) + ((((int)((b >> 8) & 255) - (int)((a >> 8) & 255)) * t) / n);
+    int bl = (a & 255) + ((((int)(b & 255) - (int)(a & 255)) * t) / n);
+    return (unsigned)((r << 16) | (g << 8) | bl);
+}
+static int isqrt_i(int v) { int r = 0; while ((r + 1) * (r + 1) <= v) r++; return r; }
+
+/* inset of a rounded corner on row dy (0 = top row) */
+static int corner_inset(int dy, int h, int r)
+{
+    int d = -1;
+    if (r <= 0) return 0;
+    if (dy < r) d = r - dy;
+    else if (dy >= h - r) d = dy - (h - r) + 1;
+    if (d < 0) return 0;
+    return r - isqrt_i(r * r - d * d);
+}
+
+/* ------------------------------------------------------------------ */
+/* compose                                                             */
+/* ------------------------------------------------------------------ */
+void aui_fill(int x, int y, int w, int h, unsigned rgb)
+{
+    aui_round(x, y, w, h, 0, rgb, rgb);
+}
+
+void aui_vgrad(int x, int y, int w, int h, unsigned top, unsigned bot)
+{
+    aui_round(x, y, w, h, 0, top, bot);
+}
+
+void aui_round(int x, int y, int w, int h, int r, unsigned top, unsigned bot)
+{
+    for (int dy = 0; dy < h; dy++)
+    {
+        int yy = y + dy, in = corner_inset(dy, h, r);
+        if (yy < 0 || yy >= AUI_H) continue;
+        fb_data c = px(lerp_rgb(top, bot, dy, h > 1 ? h - 1 : 1));
+        int x0 = x + in, x1 = x + w - in;
+        if (x0 < 0) x0 = 0;
+        if (x1 > AUI_W) x1 = AUI_W;
+        fb_data *p = &aui_fb[yy * AUI_W];
+        for (int xx = x0; xx < x1; xx++) p[xx] = c;
+    }
+}
+
+void aui_shade(int x, int y, int w, int h, int r, int keep, unsigned tint)
+{
+    fb_data t = px(tint);
+    for (int dy = 0; dy < h; dy++)
+    {
+        int yy = y + dy, in = corner_inset(dy, h, r);
+        if (yy < 0 || yy >= AUI_H) continue;
+        int x0 = x + in, x1 = x + w - in;
+        if (x0 < 0) x0 = 0;
+        if (x1 > AUI_W) x1 = AUI_W;
+        fb_data *p = &aui_fb[yy * AUI_W];
+        for (int xx = x0; xx < x1; xx++) p[xx] = blend(t, p[xx], keep);
+    }
+}
+
+void aui_blit(const fb_data *src, int sw, int sh, int x, int y)
+{
+    for (int j = 0; j < sh; j++)
+    {
+        int yy = y + j;
+        if (yy < 0 || yy >= AUI_H) continue;
+        int x0 = x < 0 ? -x : 0, x1 = (x + sw > AUI_W) ? AUI_W - x : sw;
+        if (x1 > x0)
+            memcpy(&aui_fb[yy * AUI_W + x + x0], &src[j * sw + x0],
+                   (x1 - x0) * sizeof(fb_data));
+    }
+}
+
+void aui_background(bool allow_wallpaper)
+{
+    const struct aui_theme *t = aui_theme();
+    const fb_data *f = (allow_wallpaper && t->wallpaper) ? asher_wp_full() : NULL;
+    if (f)
+        memcpy(aui_fb, f, sizeof(aui_fb));
+    else
+        aui_vgrad(0, 0, AUI_W, AUI_H, t->bg_top, t->bg_bot);
+}
+
+/* ------------------------------------------------------------------ */
+/* sprites                                                             */
+/* ------------------------------------------------------------------ */
+static const char *spr_file[SPR_COUNT] = {
+    "music", "settings", "stats", "play",
+    "music_s", "settings_s", "stats_s", "play_s",
+    "lbl_music", "lbl_settings", "lbl_stats", "lbl_play",
+    "bar_dark", "bar_light", "note", "stats_bg",
+    "moon0", "moon1", "moon2", "moon3", "moon4", "moon5", "moon6", "moon7",
+};
+struct spr { int w, h; unsigned char *rgb; unsigned char *a; };
+static struct spr sprs[SPR_COUNT];
+static unsigned char spool[700 * 1024];
+static size_t spool_used;
+
+static bool load_sprite(int id)
+{
+    char path[MAX_PATH];
+    unsigned char hd[8];
+    int fd;
+    snprintf(path, sizeof(path), UI_DIR "%s.asi", spr_file[id]);
+    fd = open(path, O_RDONLY);
+    if (fd < 0) return false;
+    if (read(fd, hd, 8) != 8 || memcmp(hd, "ASI1", 4)) { close(fd); return false; }
+    int w = hd[4] | hd[5] << 8, h = hd[6] | hd[7] << 8;
+    size_t need = (size_t)w * h * 3;
+    need = (need + 3) & ~3u;
+    if (w <= 0 || h <= 0 || spool_used + need > sizeof(spool)) { close(fd); return false; }
+    unsigned char *p = spool + spool_used;
+    if (read(fd, p, (size_t)w * h * 3) != (ssize_t)((size_t)w * h * 3)) { close(fd); return false; }
+    close(fd);
+    sprs[id].w = w; sprs[id].h = h;
+    sprs[id].rgb = p;
+    sprs[id].a = p + (size_t)w * h * 2;
+    spool_used += need;
+    return true;
+}
+
+int aui_sprite_w(int id) { return sprs[id].rgb ? sprs[id].w : 0; }
+int aui_sprite_h(int id) { return sprs[id].rgb ? sprs[id].h : 0; }
+
+static bool sprite_draw(int id, int x, int y, int op)
+{
+    const struct spr *s = &sprs[id];
+    if (!s->rgb) return false;
+    for (int j = 0; j < s->h; j++)
+    {
+        int yy = y + j;
+        if (yy < 0 || yy >= AUI_H) continue;
+        const unsigned char *c = s->rgb + (size_t)j * s->w * 2;
+        const unsigned char *a = s->a + (size_t)j * s->w;
+        fb_data *d = &aui_fb[yy * AUI_W];
+        for (int i = 0; i < s->w; i++)
+        {
+            int xx = x + i;
+            unsigned al = a[i];
+            if (!al || xx < 0 || xx >= AUI_W) continue;
+            fb_data sc = (fb_data)(c[2 * i] | (c[2 * i + 1] << 8));
+            unsigned w = al + (al >> 7);
+            if (op < 256) w = (w * op) >> 8;
+            d[xx] = (w >= 256) ? sc : blend(d[xx], sc, w);
+        }
+    }
+    return true;
+}
+
+bool aui_sprite(int id, int x, int y) { return sprite_draw(id, x, y, 256); }
+
+bool aui_sprite_c(int id, int cx, int cy)
+{
+    return sprite_draw(id, cx - sprs[id].w / 2, cy - sprs[id].h / 2, 256);
+}
+
+bool aui_sprite_ca(int id, int cx, int cy, int op)
+{
+    return sprite_draw(id, cx - sprs[id].w / 2, cy - sprs[id].h / 2, op);
+}
+
+/* ------------------------------------------------------------------ */
+/* fonts                                                               */
+/* ------------------------------------------------------------------ */
+static const char *font_file[AF_COUNT] = {
+    "18-Adobe-Helvetica-Bold", "14-Adobe-Helvetica-Bold",
+    "12-Adobe-Helvetica-Bold", "12-Adobe-Helvetica",
+    "20-Asher-Retro", "10-Asher-Retro",
+};
+static int fonts[AF_COUNT] = { -1, -1, -1, -1, -1, -1 };
+static bool inited;
+static bool load_anim(int i);
+
+/* album art slot shared by Stats and Now Playing (120x120) */
+static int aa_slot = -1;
+
+void aui_init(void)
+{
+    char path[MAX_PATH];
+    if (inited) return;
+    inited = true;
+    for (int i = 0; i < AF_COUNT; i++)
+    {
+        snprintf(path, sizeof(path), FONT_DIR "%s.fnt", font_file[i]);
+        fonts[i] = font_load(path);
+    }
+    for (int i = 0; i < SPR_COUNT; i++)
+        load_sprite(i);
+    for (int i = 0; i < LDR_COUNT; i++)
+        load_anim(i);
+#ifdef HAVE_ALBUMART
+    if (aa_slot < 0)
+    {
+        struct dim d = { 120, 120 };
+        aa_slot = playback_claim_aa_slot(&d);
+    }
+#endif
+}
+
+int aui_font(int which)
+{
+    if (which < 0 || which >= AF_COUNT || fonts[which] < 0) return FONT_UI;
+    return fonts[which];
+}
+int aui_font_h(int which) { return font_get(aui_font(which))->height; }
+int aui_text_w(int which, const char *s)
+{
+    int w = 0, h = 0;
+    font_getstringsize((const unsigned char *)s, &w, &h, aui_font(which));
+    return w;
+}
+
+
+/* ------------------------------------------------------------------ */
+/* loading animations                                                  */
+/* ------------------------------------------------------------------ */
+struct anim { int handle, w, h, n, ms; size_t fsz; };
+static struct anim anims[LDR_COUNT] = { { -1 }, { -1 }, { -1 } };
+static const char *anim_file[LDR_COUNT] = { "ldr_music", "ldr_stats", "ldr_np" };
+static const unsigned anim_bg[LDR_COUNT] = { 0x080a19, 0x000000, 0x1d384d };
+static const unsigned anim_fg[LDR_COUNT] = { 0xd9b8ff, 0xffa040, 0x13f08c };
+
+static bool load_anim(int i)
+{
+    char path[MAX_PATH];
+    unsigned char hd[12];
+    struct anim *a = &anims[i];
+    int fd;
+    snprintf(path, sizeof(path), UI_DIR "%s.awp", anim_file[i]);
+    fd = open(path, O_RDONLY);
+    if (fd < 0) return false;
+    if (read(fd, hd, 12) != 12 || memcmp(hd, "AWP1", 4)) { close(fd); return false; }
+    a->w = hd[4] | hd[5] << 8; a->h = hd[6] | hd[7] << 8;
+    a->n = hd[8] | hd[9] << 8; a->ms = hd[10] | hd[11] << 8;
+    if (a->w <= 0 || a->w > AUI_W || a->h <= 0 || a->h > AUI_H || a->n <= 0)
+        { close(fd); return false; }
+    if (a->ms < 20) a->ms = 20;
+    a->fsz = (size_t)a->w * a->h * sizeof(fb_data);
+    a->handle = core_alloc(a->fsz * a->n);
+    if (a->handle <= 0) { a->handle = -1; close(fd); return false; }
+    char *dst = core_get_data_pinned(a->handle);
+    bool ok = read(fd, dst, a->fsz * a->n) == (ssize_t)(a->fsz * a->n);
+    core_unpin(a->handle);
+    close(fd);
+    if (!ok) { core_free(a->handle); a->handle = -1; }
+    return ok;
+}
+
+int aui_loading_ticks(int which)
+{
+    int t = anims[which].handle > 0 ? anims[which].ms * HZ / 1000 : HZ / 5;
+    return t < 1 ? 1 : t;
+}
+
+void aui_loading(int which, const char *text, const char *sub, long start, bool once)
+{
+    struct anim *a = &anims[which];
+    int y = AUI_BAR + 10, h = a->handle > 0 ? a->h : 0;
+    int th = text ? aui_font_h(AF_RETRO) + 8 : 0, sh = sub ? aui_font_h(AF_RETRO_S) + 6 : 0;
+    aui_fill(0, 0, AUI_W, AUI_H, anim_bg[which]);
+    aui_topbar();
+    y = AUI_BAR + (AUI_H - AUI_BAR - h - th - sh) / 2;
+    if (a->handle > 0)
+    {
+        long ms = (long)(current_tick - start) * (1000 / HZ);
+        int f = (int)(ms / a->ms);
+        f = once ? MIN(f, a->n - 1) : f % a->n;
+        if (f < 0) f = 0;
+        aui_blit((const fb_data *)((char *)core_get_data(a->handle) + a->fsz * f),
+                 a->w, a->h, (AUI_W - a->w) / 2, y);
+    }
+    aui_present();
+    if (text) aui_text(AF_RETRO, AUI_W / 2, y + h + 8, anim_fg[which], text, AUI_W - 16, 1);
+    if (sub)  aui_text(AF_RETRO_S, AUI_W / 2, y + h + th + 4, 0xb8bcd6, sub, AUI_W - 16, 1);
+    aui_topbar_text("");
+    aui_update();
+}
+
+void aui_intro(int which)
+{
+    struct anim *a = &anims[which];
+    long start = current_tick;
+    long len = a->handle > 0 ? (long)a->n * a->ms * HZ / 1000 + HZ / 6 : 0;
+    if (len <= 0 || !aui_screen_on()) return;
+    while (TIME_BEFORE(current_tick, start + len))
+    {
+        aui_loading(which, NULL, NULL, start, true);
+        int act = get_action(CONTEXT_STD, aui_loading_ticks(which));
+        if (act != ACTION_NONE) break;          /* any button skips it */
+    }
+}
+
+int asher_splash_font(void)
+{
+    return inited ? fonts[AF_RETRO] : -1;
+}
+
+/* ------------------------------------------------------------------ */
+/* album art / progress                                                */
+/* ------------------------------------------------------------------ */
+bool aui_albumart(int x, int y, int box)
+{
+#ifdef HAVE_ALBUMART
+    struct bitmap *bmp = NULL;
+    int hid;
+    if (aa_slot < 0 || !(audio_status() & AUDIO_STATUS_PLAY)) return false;
+    hid = playback_current_aa_hid(aa_slot);
+    if (hid < 0 || bufgetdata(hid, 0, (void **)&bmp) <= 0 || !bmp || !bmp->data)
+        return false;
+    int w = MIN(bmp->width, box), h = MIN(bmp->height, box);
+    const fb_data *src = (const fb_data *)bmp->data;
+    int ox = x + (box - w) / 2, oy = y + (box - h) / 2;
+    for (int j = 0; j < h; j++)
+        if (oy + j >= 0 && oy + j < AUI_H)
+            memcpy(&aui_fb[(oy + j) * AUI_W + ox], &src[j * bmp->width],
+                   w * sizeof(fb_data));
+    return true;
+#else
+    (void)x; (void)y; (void)box;
+    return false;
+#endif
+}
+
+void aui_progress(int x, int y, int w, int h, long pos, long len)
+{
+    const struct aui_theme *t = aui_theme();
+    int r = h / 2, fill = 0;
+    aui_round(x, y, w, h, r, t->track, t->track);
+    if (len > 0)
+    {
+        if (pos < 0) pos = 0;
+        if (pos > len) pos = len;
+        fill = (int)((long long)w * pos / len);
+    }
+    if (fill > 0)
+        aui_round(x, y, MAX(fill, h), h, r, t->sel1, t->sel2);
+}
+
+/* ------------------------------------------------------------------ */
+/* top bar                                                             */
+/* ------------------------------------------------------------------ */
+void aui_topbar(void)
+{
+    const struct aui_theme *t = aui_theme();
+    int bat = battery_level();
+    int bx = AUI_W - 34, by = 9;
+    if (!aui_sprite(t->light ? SPR_BAR_LIGHT : SPR_BAR_DARK, 0, 0))
+        aui_vgrad(0, 0, AUI_W, AUI_BAR, t->light ? 0xf4f5f8 : 0x15173a,
+                  t->light ? 0xc9ced8 : 0x0a0b1c);
+    /* battery outline is part of the bar picture; draw the fill */
+    if (bat >= 0)
+    {
+        int f = (bat * 20 + 50) / 100;
+        unsigned c = bat <= 20 ? 0xe5463c : (charging_state() ? 0xffd34a : 0x4cd964);
+        if (f > 0) aui_round(bx + 2, by + 2, f, 8, 1, c, c);
+    }
+}
+
+void aui_topbar_text(const char *title)
+{
+    const struct aui_theme *t = aui_theme();
+    char buf[24];
+    unsigned c = t->light ? 0x161616 : 0xffffff;
+    int fh = aui_font_h(AF_MED), y = (AUI_BAR - fh) / 2;
+    aui_time_str(buf, sizeof(buf));
+    aui_text(AF_MED, 34, y, c, buf, 90, 0);
+    if (title && title[0])
+        aui_text(AF_MED, AUI_W / 2 + 8, y, c, title, 112, 1);
+    int bat = battery_level();
+    if (bat >= 0)
+    {
+        snprintf(buf, sizeof(buf), "%d%%", bat);
+        aui_text(AF_MED, AUI_W - 40, y, c, buf, 48, 2);
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* output                                                              */
+/* ------------------------------------------------------------------ */
+void aui_begin(void)
+{
+    aui_init();
+    viewportmanager_theme_enable(SCREEN_MAIN, false, NULL);
+    lcd_set_viewport(NULL);
+    lcd_set_drawmode(DRMODE_SOLID);
+}
+
+void aui_end(void)
+{
+    lcd_set_viewport(NULL);
+    lcd_set_drawmode(DRMODE_SOLID);
+    lcd_setfont(FONT_UI);
+    lcd_set_foreground(global_settings.fg_color);
+    lcd_set_background(global_settings.bg_color);
+    lcd_clear_display();
+    viewportmanager_theme_undo(SCREEN_MAIN, false);
+}
+
+void aui_present(void)
+{
+    lcd_set_viewport(NULL);
+    lcd_bitmap(aui_fb, 0, 0, AUI_W, AUI_H);
+}
+
+void aui_text(int font, int x, int y, unsigned rgb, const char *s, int maxw, int align)
+{
+    char buf[160];
+    int w = 0, h = 0, fid = aui_font(font);
+    if (!s || !s[0]) return;
+    strlcpy(buf, s, sizeof(buf));
+    font_getstringsize((unsigned char *)buf, &w, &h, fid);
+    if (maxw > 0 && w > maxw)
+    {
+        size_t len = strlen(buf);
+        while (len > 0)
+        {
+            do { len--; } while (len > 0 && (buf[len] & 0xc0) == 0x80);
+            buf[len] = '\0';
+            char tmp[164];
+            snprintf(tmp, sizeof(tmp), "%s...", buf);
+            font_getstringsize((unsigned char *)tmp, &w, &h, fid);
+            if (w <= maxw) { strlcpy(buf, tmp, sizeof(buf)); break; }
+        }
+    }
+    if (align == 1) x -= w / 2;
+    else if (align == 2) x -= w;
+    lcd_setfont(fid);
+    lcd_set_drawmode(DRMODE_FG);
+    lcd_set_foreground(LCD_RGBPACK((rgb >> 16) & 255, (rgb >> 8) & 255, rgb & 255));
+    lcd_putsxy(x, y, buf);
+    lcd_set_drawmode(DRMODE_SOLID);
+}
+
+void aui_update(void) { lcd_update(); }
+void aui_update_rect(int x, int y, int w, int h) { lcd_update_rect(x, y, w, h); }
+
+/* ------------------------------------------------------------------ */
+/* misc                                                                */
+/* ------------------------------------------------------------------ */
+void aui_time_str(char *buf, size_t n)
+{
+    struct tm *t = get_time();
+    snprintf(buf, n, "%d:%02d %s", t->tm_hour % 12 ? t->tm_hour % 12 : 12,
+             t->tm_min, t->tm_hour >= 12 ? "PM" : "AM");
+}
+
+void aui_fmt_time(char *buf, size_t n, long ms)
+{
+    long s = ms < 0 ? 0 : ms / 1000;
+    if (s >= 3600)
+        snprintf(buf, n, "%ld:%02ld:%02ld", s / 3600, (s / 60) % 60, s % 60);
+    else
+        snprintf(buf, n, "%ld:%02ld", s / 60, s % 60);
+}
+
+int aui_volume_pct(void)
+{
+    int mn = sound_min(SOUND_VOLUME), mx = sound_max(SOUND_VOLUME);
+    if (mx <= mn) return 0;
+    return (global_status.volume - mn) * 100 / (mx - mn);
+}
+
+bool aui_screen_on(void)
+{
+    return is_backlight_on(true);
+}
diff --git a/apps/asher/asher_ui.h b/apps/asher/asher_ui.h
new file mode 100644
index 0000000000..b874a90006
--- /dev/null
+++ b/apps/asher/asher_ui.h
@@ -0,0 +1,89 @@
+/* Asher OS shared drawing layer.
+ * Screens are composed into an off-screen buffer (aui_fb): wallpaper,
+ * glass panels and alpha-blended sprites. The buffer is then copied to the
+ * LCD and text is drawn on top with transparent background. */
+#ifndef ASHER_UI_H
+#define ASHER_UI_H
+#include <stdbool.h>
+#include <stddef.h>
+#include "config.h"
+#include "lcd.h"
+
+#define AUI_W   LCD_WIDTH
+#define AUI_H   LCD_HEIGHT
+#define AUI_BAR 30               /* height of the top bar on every screen */
+
+extern fb_data aui_fb[LCD_WIDTH * LCD_HEIGHT];
+
+struct aui_theme {
+    bool light;                  /* Classic (white) look */
+    bool wallpaper;              /* show the live wallpaper behind screens */
+    unsigned bg_top, bg_bot;     /* background gradient */
+    unsigned text, sub, accent;  /* text colours */
+    unsigned sel1, sel2;         /* selection bar gradient */
+    unsigned seltext;
+    unsigned panel;              /* solid panel colour (light theme) */
+    unsigned track;              /* progress bar track */
+};
+const struct aui_theme *aui_theme(void);
+
+/* sprites */
+enum {
+    SPR_MUSIC, SPR_SETTINGS, SPR_STATS, SPR_PLAY,           /* bubbles */
+    SPR_MUSIC_S, SPR_SETTINGS_S, SPR_STATS_S, SPR_PLAY_S,   /* selected */
+    SPR_LBL_MUSIC, SPR_LBL_SETTINGS, SPR_LBL_STATS, SPR_LBL_PLAY,
+    SPR_BAR_DARK, SPR_BAR_LIGHT, SPR_NOTE, SPR_STATS_BG,
+    SPR_MOON0, SPR_MOON1, SPR_MOON2, SPR_MOON3,
+    SPR_MOON4, SPR_MOON5, SPR_MOON6, SPR_MOON7,
+    SPR_COUNT
+};
+
+/* fonts */
+enum { AF_BIG, AF_MED, AF_SMALL, AF_SMALLR, AF_RETRO, AF_RETRO_S, AF_COUNT };
+
+/* loading animations */
+enum { LDR_MUSIC, LDR_STATS, LDR_NP, LDR_COUNT };
+
+void aui_init(void);                 /* load fonts + sprites (once) */
+void aui_begin(void);                /* take over the whole screen */
+void aui_end(void);                  /* hand the screen back */
+int  aui_font(int which);
+int  aui_font_h(int which);
+int  aui_text_w(int which, const char *s);
+
+/* ---- compose into aui_fb ---- */
+void aui_fill(int x, int y, int w, int h, unsigned rgb);
+void aui_vgrad(int x, int y, int w, int h, unsigned top, unsigned bot);
+void aui_round(int x, int y, int w, int h, int r, unsigned top, unsigned bot);
+void aui_shade(int x, int y, int w, int h, int r, int keep256, unsigned tint);
+void aui_blit(const fb_data *src, int sw, int sh, int x, int y);
+void aui_background(bool allow_wallpaper);
+bool aui_sprite(int id, int x, int y);          /* top-left placement */
+bool aui_sprite_c(int id, int cx, int cy);      /* centred placement */
+bool aui_sprite_ca(int id, int cx, int cy, int opacity); /* 0..256 */
+int  aui_sprite_w(int id);
+int  aui_sprite_h(int id);
+bool aui_albumart(int x, int y, int box);       /* false if no art */
+void aui_progress(int x, int y, int w, int h, long pos, long len);
+void aui_topbar(void);                          /* compose part of the bar */
+
+/* ---- output ---- */
+void aui_present(void);                         /* aui_fb -> LCD buffer */
+void aui_topbar_text(const char *title);        /* clock, title, battery */
+void aui_text(int font, int x, int y, unsigned rgb, const char *s,
+              int maxw, int align);             /* align 0=L 1=C 2=R */
+void aui_update(void);
+void aui_update_rect(int x, int y, int w, int h);
+
+/* loading screens: 'once' plays the animation from start_tick to the end */
+void aui_loading(int which, const char *text, const char *sub, long start_tick, bool once);
+void aui_intro(int which);              /* short skippable intro animation */
+int  aui_loading_ticks(int which);      /* ticks between frames */
+int  asher_splash_font(void);           /* retro pop-up font, or -1 */
+
+/* misc helpers */
+void aui_time_str(char *buf, size_t n);
+void aui_fmt_time(char *buf, size_t n, long ms);
+int  aui_volume_pct(void);
+bool aui_screen_on(void);
+#endif
diff --git a/apps/asher/asher_wallpaper.c b/apps/asher/asher_wallpaper.c
new file mode 100644
index 0000000000..f59abb38a8
--- /dev/null
+++ b/apps/asher/asher_wallpaper.c
@@ -0,0 +1,134 @@
+/* Asher OS live wallpapers. See asher_wallpaper.h. */
+#include <stdio.h>
+#include <string.h>
+#include <fcntl.h>
+#include "config.h"
+#include "system.h"
+#include "kernel.h"
+#include "file.h"
+#include "core_alloc.h"
+#include "string-extra.h"
+#include "timefuncs.h"
+#include "lcd.h"
+#include "asher_wallpaper.h"
+
+#define AWP_DIR "/.rockbox/asher/wallpaper/"
+#define AWP_HDR 12
+
+struct awp {
+    int handle;
+    int w, h, n, ms;
+    size_t fsz;
+    char name[48];
+};
+static struct awp full = { -1 }, small = { -1 };
+
+static char want[40];          /* chosen wallpaper (base name), "" = off */
+static bool want_auto;         /* follow the time of day */
+static long next_check;
+
+static void awp_free(struct awp *p)
+{
+    if (p->handle > 0) core_free(p->handle);
+    p->handle = -1;
+    p->n = 0;
+    p->name[0] = '\0';
+}
+
+static bool awp_load(struct awp *p, const char *name, int w, int h)
+{
+    char path[MAX_PATH];
+    unsigned char hd[AWP_HDR];
+    int fd, n;
+    if (p->handle > 0 && !strcmp(p->name, name)) return true;
+    awp_free(p);
+    snprintf(path, sizeof(path), AWP_DIR "%s.awp", name);
+    fd = open(path, O_RDONLY);
+    if (fd < 0) return false;
+    if (read(fd, hd, AWP_HDR) != AWP_HDR || memcmp(hd, "AWP1", 4)
+        || (hd[4] | hd[5] << 8) != w || (hd[6] | hd[7] << 8) != h
+        || (n = (hd[8] | hd[9] << 8)) < 1)
+    { close(fd); return false; }
+    p->w = w; p->h = h; p->n = n;
+    p->ms = hd[10] | hd[11] << 8;
+    if (p->ms < 50) p->ms = 50;
+    p->fsz = (size_t)w * h * sizeof(fb_data);
+    p->handle = core_alloc((size_t)n * p->fsz);
+    if (p->handle <= 0) { close(fd); p->handle = -1; p->n = 0; return false; }
+    char *dst = core_get_data_pinned(p->handle);
+    bool ok = true;
+    for (int i = 0; i < n && ok; i++)
+        ok = read(fd, dst + (size_t)i * p->fsz, p->fsz) == (ssize_t)p->fsz;
+    core_unpin(p->handle);
+    close(fd);
+    if (!ok) { awp_free(p); return false; }
+    strmemccpy(p->name, name, sizeof(p->name));
+    return true;
+}
+
+const char *asher_scene_for_time(void)
+{
+    struct tm *t = get_time();
+    int h = t->tm_hour;
+    if (h >= 5 && h < 12)  return "street_morning";   /* 5 AM - 11:59 AM */
+    if (h >= 12 && h < 19) return "street_midday";    /* 12 PM - 6:59 PM */
+    return "street_night";                            /* 7 PM - 4:59 AM */
+}
+
+static void ensure_loaded(void)
+{
+    char sname[56];
+    const char *r;
+    if (!want[0]) return;
+    if (want_auto && TIME_BEFORE(current_tick, next_check) && full.handle > 0)
+        return;
+    next_check = current_tick + 30 * HZ;
+    r = want_auto ? asher_scene_for_time() : want;
+    snprintf(sname, sizeof(sname), "%s_s", r);
+    awp_load(&full, r, LCD_WIDTH, LCD_HEIGHT);
+    awp_load(&small, sname, ASHER_BOX_W, ASHER_BOX_H);
+}
+
+void asher_wallpaper_set(const char *scene, bool follow_time)
+{
+    want_auto = follow_time;
+    next_check = 0;
+    if (scene) strmemccpy(want, scene, sizeof(want)); else want[0] = '\0';
+    if (!want[0]) { awp_free(&full); awp_free(&small); return; }
+    ensure_loaded();          /* load now (at boot, before music buffers) */
+}
+
+static int frame_index(const struct awp *p)
+{
+    if (p->n <= 1) return 0;
+    return (int)(((unsigned long)current_tick * (1000 / HZ) / p->ms) % p->n);
+}
+
+static const fb_data *frame(struct awp *p)
+{
+    ensure_loaded();
+    if (p->handle <= 0) return NULL;
+    return (const fb_data *)((char *)core_get_data(p->handle)
+                             + (size_t)frame_index(p) * p->fsz);
+}
+
+const fb_data *asher_wp_full(void)  { return want[0] ? frame(&full) : NULL; }
+const fb_data *asher_wp_small(void) { return want[0] ? frame(&small) : NULL; }
+
+bool asher_wp_animated(void)
+{
+    return want[0] && (full.n > 1 || small.n > 1);
+}
+
+int asher_wp_frame_ticks(void)
+{
+    int ms = full.n > 1 ? full.ms : small.ms;
+    int t = ms * HZ / 1000;
+    return t < 1 ? 1 : t;
+}
+
+int asher_wp_frame_no(void)
+{
+    struct awp *p = full.n > 1 ? &full : &small;
+    return asher_wp_animated() ? frame_index(p) : 0;
+}
diff --git a/apps/asher/asher_wallpaper.h b/apps/asher/asher_wallpaper.h
new file mode 100644
index 0000000000..b3b1dac0c1
--- /dev/null
+++ b/apps/asher/asher_wallpaper.h
@@ -0,0 +1,20 @@
+#ifndef ASHER_WALLPAPER_H
+#define ASHER_WALLPAPER_H
+#include <stdbool.h>
+#include "config.h"
+#include "lcd.h"
+/* Wallpaper pack (.awp): "AWP1", u16 width, u16 height, u16 frames,
+ * u16 frame_ms, then raw RGB565 frames. Packs are loaded into RAM once so
+ * the hard drive can sleep. Each wallpaper has a full-screen pack and a
+ * small 160x120 pack ("<name>_s") for the Stats screen box. */
+#define ASHER_BOX_W 160
+#define ASHER_BOX_H 120
+
+void asher_wallpaper_set(const char *scene, bool follow_time); /* NULL = off */
+const fb_data *asher_wp_full(void);   /* current 320x240 frame or NULL */
+const fb_data *asher_wp_small(void);  /* current 160x120 frame or NULL */
+bool asher_wp_animated(void);         /* more than one frame? */
+int  asher_wp_frame_ticks(void);      /* ticks between frames */
+int  asher_wp_frame_no(void);         /* changes whenever the frame changes */
+const char *asher_scene_for_time(void);
+#endif
diff --git a/apps/asher/moonphase.c b/apps/asher/moonphase.c
new file mode 100644
index 0000000000..bbe9d9ac69
--- /dev/null
+++ b/apps/asher/moonphase.c
@@ -0,0 +1,20 @@
+#include "moonphase.h"
+
+/* Days since a known new moon (2000-01-06 18:14 UTC), mod synodic month. */
+int asher_moon_phase(int year, int month, int day)
+{
+    /* Julian day number at noon for the given date */
+    int a = (14 - month) / 12;
+    int y = year + 4800 - a;
+    int m = month + 12 * a - 3;
+    long jdn = day + (153 * m + 2) / 5 + 365L * y + y / 4 - y / 100
+               + y / 400 - 32045;
+
+    /* Work in hundredths of a day to avoid floats on the iPod CPU.
+     * Reference new moon JD = 2451550.26, synodic month = 29.530589 d */
+    long since = (jdn - 2451550L) * 100 - 26;
+    long cycle = 2953;                       /* 29.53 days, x100 */
+    long pos = since % cycle;
+    if (pos < 0) pos += cycle;
+    return (int)((pos * 8 + cycle / 2) / cycle) & 7;
+}
