+/* add a song to the queue: it plays after the current song (and after
+ * anything queued before it), then the playlist carries on as before */
+static void queue_add(const char *path)
+{
+    struct playlist_info *pl = playlist_get_current();
+    loading_screen("LOADING", NULL);            /* the record player */
+    if (!(audio_status() & AUDIO_STATUS_PLAY) && (!pl->started || playlist_amount() <= 0
+                                                  || asher_queue_unstarted))
+    {
+        /* nothing loaded at all: start a list that waits for Play, so
+         * adding a song never starts it by itself */
+        if ((asher_queue_unstarted || playlist_create(NULL, NULL) >= 0)
+            && playlist_insert_track(NULL, path, PLAYLIST_INSERT_LAST, false, true) >= 0)
+        {
+            asher_queue_unstarted = true;
+            int n = playlist_amount();
+            if (n <= 1) splash(HZ * 3 / 2, "Queued - press Play");
+            else splashf(HZ * 3 / 2, "Queued (%d) - press Play", n);
+        }
+        else
+            splash(HZ * 3 / 2, "Couldn't add that song");
+        return;
+    }
+    /* something is playing (or paused): it plays after the current song,
+     * or right away if you skip */
+    if (playlist_insert_track(NULL, path, PLAYLIST_INSERT, true, true) < 0)
+    {
+        splash(HZ * 3 / 2, "Couldn't add that song");
+        return;
+    }
+    int n = playlist_queued_ahead();
+    if (n <= 1) splash(HZ, "Added to Queue");
+    else splashf(HZ, "Added to Queue (%d)", n);
+}
