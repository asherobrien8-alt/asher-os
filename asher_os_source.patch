diff --git a/apps/asher/asher_list.c b/apps/asher/asher_list.c
new file mode 100644
index 0000000000..4a4ae8bb6d
--- /dev/null
+++ b/apps/asher/asher_list.c
@@ -0,0 +1,190 @@
+/* Asher OS list screen: thick rounded selection bar, top bar with the
+ * clock, and accelerated scrolling with a first-letter bubble. */
+#include <stdio.h>
+#include <string.h>
+#include <ctype.h>
+#include "config.h"
+#include "system.h"
+#include "kernel.h"
+#include "action.h"
+#include "misc.h"
+#include "timefuncs.h"
+#include "lcd.h"
+#include "asher_ui.h"
+#include "asher_list.h"
+
+static int row_h(const struct aui_list *l) { return l->two_line ? 42 : 35; }
+static int visible(const struct aui_list *l) { return (AUI_H - AUI_BAR) / row_h(l); }
+
+static void clamp_top(struct aui_list *l)
+{
+    int vis = visible(l);
+    if (l->sel < l->top) l->top = l->sel;
+    if (l->sel >= l->top + vis) l->top = l->sel - vis + 1;
+    if (l->top > l->count - vis) l->top = l->count - vis;
+    if (l->top < 0) l->top = 0;
+}
+
+static void chevron(int x, int cy, unsigned c)
+{
+    for (int i = 0; i < 5; i++)
+    {
+        aui_fill(x + i, cy - 5 + i, 2, 1, c);
+        aui_fill(x + i, cy + 5 - i, 2, 1, c);
+    }
+}
+
+void aui_list_draw(struct aui_list *l, int letter)
+{
+    const struct aui_theme *t = aui_theme();
+    char buf[128], sub[128];
+    int rh = row_h(l), vis = visible(l), y0 = AUI_BAR + 2;
+    bool sb = l->count > vis;
+    int right = AUI_W - (sb ? 12 : 6);
+
+    clamp_top(l);
+    aui_vgrad(0, 0, AUI_W, AUI_H, t->bg_top, t->bg_bot);
+    aui_topbar();
+
+    /* rows: compose bars first */
+    for (int r = 0; r < vis; r++)
+    {
+        int i = l->top + r;
+        if (i >= l->count) break;
+        int y = y0 + r * rh;
+        if (i == l->sel)
+            aui_round(6, y + 2, right - 6, rh - 4, 9, t->sel1, t->sel2);
+        else if (t->light)
+            aui_fill(12, y + rh - 1, right - 18, 1, 0xe3e5ea);
+        if (l->chevrons)
+            chevron(right - 16, y + rh / 2,
+                    i == l->sel ? 0xffffff : (t->light ? 0x9aa0ab : 0x6c7290));
+    }
+    if (sb)
+    {
+        int th = AUI_H - AUI_BAR - 8, x = AUI_W - 7;
+        int kh = MAX(16, th * vis / l->count);
+        int ky = AUI_BAR + 4 + (th - kh) * l->top / MAX(1, l->count - vis);
+        aui_round(x, AUI_BAR + 4, 4, th, 2, t->track, t->track);
+        aui_round(x, ky, 4, kh, 2, t->sel1, t->sel2);
+    }
+    if (letter)
+    {
+        aui_shade(AUI_W / 2 - 34, 30 + (AUI_H - 30) / 2 - 34, 68, 68, 16, 70, 0x000000);
+    }
+    aui_present();
+
+    /* text */
+    for (int r = 0; r < vis; r++)
+    {
+        int i = l->top + r;
+        if (i >= l->count) break;
+        int y = y0 + r * rh;
+        bool s = (i == l->sel);
+        int maxw = right - 18 - (l->chevrons ? 22 : 4);
+        buf[0] = sub[0] = '\0';
+        l->get(l, i, buf, sizeof(buf), l->two_line ? sub : NULL, sizeof(sub));
+        if (l->two_line)
+        {
+            aui_text(AF_MED, 18, y + 5, s ? t->seltext : t->text, buf, maxw, 0);
+            aui_text(AF_SMALLR, 18, y + 23, s ? 0xe6ecff : t->sub, sub, maxw, 0);
+        }
+        else
+        {
+            int fh = aui_font_h(AF_BIG);
+            aui_text(AF_BIG, 18, y + (rh - fh) / 2, s ? t->seltext : t->text, buf, maxw, 0);
+        }
+    }
+    if (letter)
+    {
+        char lb[2] = { (char)letter, 0 };
+        int fh = aui_font_h(AF_BIG);
+        aui_text(AF_BIG, AUI_W / 2, 30 + (AUI_H - 30) / 2 - fh / 2, 0xffffff, lb, 0, 1);
+    }
+    aui_topbar_text(l->title);
+    aui_update();
+}
+
+static int first_letter(struct aui_list *l)
+{
+    char buf[128];
+    buf[0] = '\0';
+    l->get(l, l->sel, buf, sizeof(buf), NULL, 0);
+    const char *p = buf;
+    if (!strncasecmp(p, "the ", 4)) p += 4;
+    int c = toupper((unsigned char)*p);
+    if (c >= 'A' && c <= 'Z') return c;
+    if (c >= '0' && c <= '9') return '#';
+    return '#';
+}
+
+int aui_list_run(struct aui_list *l)
+{
+    long last_move = 0, letter_until = 0;
+    int streak = 0, minute = -1;
+    bool redraw = true;
+
+    if (l->count <= 0) return 0;
+    if (l->sel >= l->count) l->sel = 0;
+    aui_begin();
+    while (1)
+    {
+        bool show_letter = l->letter_jump && TIME_BEFORE(current_tick, letter_until);
+        if (redraw)
+        {
+            aui_list_draw(l, show_letter ? first_letter(l) : 0);
+            redraw = false;
+        }
+        int action = get_action(CONTEXT_STD, show_letter ? HZ / 5 : HZ);
+        switch (action)
+        {
+            case ACTION_STD_NEXT:
+            case ACTION_STD_NEXTREPEAT:
+            case ACTION_STD_PREV:
+            case ACTION_STD_PREVREPEAT:
+            {
+                int dir = (action == ACTION_STD_NEXT || action == ACTION_STD_NEXTREPEAT) ? 1 : -1;
+                if (TIME_BEFORE(current_tick, last_move + HZ / 8)) streak++;
+                else streak = 0;
+                last_move = current_tick;
+                int step = 1;
+                if (l->count > 40 && streak > 6)
+                    step = MIN(1 + (streak - 6) / 3, MAX(1, l->count / 40));
+                l->sel += dir * step;
+                if (step == 1 && l->sel < 0) l->sel = l->count - 1;
+                else if (step == 1 && l->sel >= l->count) l->sel = 0;
+                if (l->sel < 0) l->sel = 0;
+                if (l->sel >= l->count) l->sel = l->count - 1;
+                if (step > 1) letter_until = current_tick + HZ * 2 / 3;
+                redraw = true;
+                break;
+            }
+            case ACTION_STD_OK:
+            {
+                int r = l->select ? l->select(l, l->sel) : 0;
+                if (r == AUI_BACK) { aui_end(); return 0; }
+                if (r > 0) { aui_end(); return r; }
+                redraw = true;
+                break;
+            }
+            case ACTION_STD_CANCEL:
+            case ACTION_STD_MENU:
+                aui_end();
+                return 0;
+            case ACTION_NONE:
+            {
+                /* redraw for the clock, or to hide the letter bubble */
+                int m = get_time()->tm_min;
+                if (m != minute || (l->letter_jump && !show_letter && letter_until)) redraw = true;
+                if (!show_letter) letter_until = 0;
+                minute = m;
+                break;
+            }
+            default:
+                if (default_event_handler(action) == SYS_USB_CONNECTED)
+                    { aui_end(); return 0; }
+                redraw = true;
+                break;
+        }
+    }
+}
diff --git a/apps/asher/asher_list.h b/apps/asher/asher_list.h
new file mode 100644
index 0000000000..710e3d50ec
--- /dev/null
+++ b/apps/asher/asher_list.h
@@ -0,0 +1,29 @@
+#ifndef ASHER_LIST_H
+#define ASHER_LIST_H
+#include <stdbool.h>
+#include <stddef.h>
+
+#define AUI_BACK (-1)
+
+struct aui_list;
+/* fill buf with the item's main text, sub (may be NULL) with its second line */
+typedef void (*aui_list_get_fn)(struct aui_list *l, int i, char *buf, size_t n,
+                                char *sub, size_t subn);
+/* return 0 to stay, AUI_BACK to leave the list, or a GO_TO_* code (> 0) */
+typedef int (*aui_list_sel_fn)(struct aui_list *l, int i);
+
+struct aui_list {
+    const char *title;
+    int count;
+    int sel, top;
+    bool two_line;
+    bool chevrons;        /* show ">" on every row (submenus) */
+    bool letter_jump;     /* big first-letter bubble while fast scrolling */
+    aui_list_get_fn get;
+    aui_list_sel_fn select;
+    void *data;
+};
+
+int aui_list_run(struct aui_list *l);
+void aui_list_draw(struct aui_list *l, int letter);
+#endif
diff --git a/apps/asher/asher_music.c b/apps/asher/asher_music.c
new file mode 100644
index 0000000000..26ff132073
--- /dev/null
+++ b/apps/asher/asher_music.c
@@ -0,0 +1,568 @@
+/* Asher OS Music section: Search, Artists, Playlists, Shuffle, All Songs.
+ * A compact index of the music database (title, artist) is built once and
+ * kept in RAM, so browsing and searching are instant. */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <ctype.h>
+#include "config.h"
+#include "system.h"
+#include "kernel.h"
+#include "action.h"
+#include "button.h"
+#include "audio.h"
+#include "misc.h"
+#include "menu.h"
+#include "splash.h"
+#include "playlist.h"
+#include "tagcache.h"
+#include "core_alloc.h"
+#include "timefuncs.h"
+#include "root_menu.h"
+#include "asher_ui.h"
+#include "asher_list.h"
+#include "asher_music.h"
+
+/* ------------------------------------------------------------------ */
+/* library index                                                       */
+/* ------------------------------------------------------------------ */
+struct lent   { int32_t idx; uint32_t title, artist; };
+struct artist { uint32_t name; int start, count; };
+
+static int lib_handle = -1;
+static int lib_n, lib_cap, lib_nart, lib_res;
+static long lib_dbcount = -1;
+static struct lent *L;          /* entries */
+static int *by_title, *by_artist, *results;
+static struct artist *A;
+static char *pool;
+static size_t pool_used, pool_cap;
+static bool rebuild_requested;
+
+static void lib_free(void)
+{
+    if (lib_handle > 0) { core_unpin(lib_handle); core_free(lib_handle); }
+    lib_handle = -1;
+    lib_n = lib_nart = lib_res = 0;
+    lib_dbcount = -1;
+}
+
+static uint32_t pool_add(const char *s)
+{
+    size_t len = strlen(s) + 1;
+    if (pool_used + len > pool_cap) return 0;   /* offset 0 is "" */
+    uint32_t off = pool_used;
+    memcpy(pool + off, s, len);
+    pool_used += len;
+    return off;
+}
+
+static const char *T(int e) { return pool + L[e].title; }
+static const char *AR(int e) { return pool + L[e].artist; }
+
+static const char *skip_the(const char *s)
+{
+    return strncasecmp(s, "the ", 4) ? s : s + 4;
+}
+static int cmp_title(const void *a, const void *b)
+{
+    int r = strcasecmp(skip_the(T(*(const int *)a)), skip_the(T(*(const int *)b)));
+    return r ? r : strcasecmp(AR(*(const int *)a), AR(*(const int *)b));
+}
+static int cmp_artist(const void *a, const void *b)
+{
+    int r = strcasecmp(skip_the(AR(*(const int *)a)), skip_the(AR(*(const int *)b)));
+    return r ? r : strcasecmp(T(*(const int *)a), T(*(const int *)b));
+}
+
+static long load_start;
+static void loading_screen(const char *line1, const char *line2)
+{
+    if (!load_start || TIME_AFTER(current_tick, load_start + 60 * HZ))
+        load_start = current_tick;
+    aui_loading(LDR_MUSIC, line1, line2, load_start, false);
+}
+
+static bool lib_build(void)
+{
+    struct tagcache_search tcs;
+    static char fname[MAX_PATH];
+    char tb[128], ab[128], msg[48];
+    int n, i = 0;
+
+    if (!tagcache_search(&tcs, tag_filename)) return false;
+    n = tcs.entry_count;
+    if (n <= 0) { tagcache_search_finish(&tcs); return false; }
+
+    lib_free();
+    pool_cap = (size_t)n * 72 + 4096;
+    if (pool_cap > 3 * 1024 * 1024) pool_cap = 3 * 1024 * 1024;
+    size_t sz = (size_t)n * (sizeof(struct lent) + 3 * sizeof(int) + sizeof(struct artist))
+                + pool_cap + 64;
+    lib_handle = core_alloc(sz);
+    if (lib_handle <= 0) { tagcache_search_finish(&tcs); lib_handle = -1; return false; }
+    char *base = core_get_data_pinned(lib_handle);   /* stays pinned */
+    L = (struct lent *)base;
+    by_title = (int *)(L + n);
+    by_artist = by_title + n;
+    results = by_artist + n;
+    A = (struct artist *)(results + n);
+    pool = (char *)(A + n);
+    pool[0] = '\0';
+    pool_used = 1;
+    lib_cap = n;
+
+    while (i < n && tagcache_get_next(&tcs, fname, sizeof(fname)))
+    {
+        int32_t idx = tcs.idx_id;
+        if (!tagcache_retrieve(&tcs, idx, tag_title, tb, sizeof(tb)) || !tb[0]
+            || !strcmp(tb, UNTAGGED))
+        {
+            const char *b = strrchr(fname, '/');
+            strlcpy(tb, b ? b + 1 : fname, sizeof(tb));
+            char *dot = strrchr(tb, '.');
+            if (dot && dot != tb) *dot = '\0';
+        }
+        if (!tagcache_retrieve(&tcs, idx, tag_artist, ab, sizeof(ab)) || !ab[0]
+            || !strcmp(ab, UNTAGGED))
+            strlcpy(ab, "Unknown Artist", sizeof(ab));
+        L[i].idx = idx;
+        L[i].title = pool_add(tb);
+        L[i].artist = pool_add(ab);
+        by_title[i] = by_artist[i] = i;
+        i++;
+        if ((i & 63) == 0)
+        {
+            snprintf(msg, sizeof(msg), "%d of %d songs", i, n);
+            loading_screen("LOADING LIBRARY", msg);
+            yield();
+        }
+    }
+    tagcache_search_finish(&tcs);
+    lib_n = i;
+    lib_dbcount = n;
+
+    qsort(by_title, lib_n, sizeof(int), cmp_title);
+    qsort(by_artist, lib_n, sizeof(int), cmp_artist);
+    lib_nart = 0;
+    for (int k = 0; k < lib_n; k++)
+    {
+        int e = by_artist[k];
+        if (lib_nart && !strcasecmp(pool + A[lib_nart - 1].name, AR(e)))
+            A[lib_nart - 1].count++;
+        else
+        {
+            A[lib_nart].name = L[e].artist;
+            A[lib_nart].start = k;
+            A[lib_nart].count = 1;
+            lib_nart++;
+        }
+    }
+    return lib_n > 0;
+}
+
+/* make sure the database is ready and our index is current */
+static bool library_ready(void)
+{
+    struct tagcache_search tcs;
+    if (!tagcache_is_usable())
+    {
+        struct tagcache_stat *st = tagcache_get_stat();
+        if (!st->ready && st->commit_step == 0 && !rebuild_requested)
+        {
+            rebuild_requested = true;
+            tagcache_rebuild();
+        }
+        aui_begin();
+        while (!tagcache_is_usable())
+        {
+            char msg[64];
+            st = tagcache_get_stat();
+            if (st->commit_delayed)
+                snprintf(msg, sizeof(msg), "Restart your iPod to finish");
+            else if (st->commit_step > 0)
+                snprintf(msg, sizeof(msg), "Finishing up... step %d", st->commit_step);
+            else
+                snprintf(msg, sizeof(msg), "Found %d files so far", st->processed_entries);
+            loading_screen("BUILDING LIBRARY", msg);
+            int a = get_action(CONTEXT_STD, aui_loading_ticks(LDR_MUSIC));
+            if (a == ACTION_STD_CANCEL || a == ACTION_STD_MENU) { aui_end(); return false; }
+            if (a != ACTION_NONE) default_event_handler(a);
+        }
+        aui_end();
+    }
+    if (lib_handle > 0)
+    {
+        if (!tagcache_search(&tcs, tag_filename)) return lib_n > 0;
+        long cnt = tcs.entry_count;
+        tagcache_search_finish(&tcs);
+        if (cnt == lib_dbcount) return lib_n > 0;
+    }
+    aui_begin();
+    loading_screen("LOADING LIBRARY", NULL);
+    bool ok = lib_build();
+    aui_end();
+    if (!ok) splash(2 * HZ, "No songs found");
+    return ok;
+}
+
+/* ------------------------------------------------------------------ */
+/* playing                                                             */
+/* ------------------------------------------------------------------ */
+static int play_entries(const int *order, int count, int start, bool shuffle)
+{
+    struct tagcache_search tcs;
+    struct playlist_insert_context ctx;
+    static char path[MAX_PATH];
+    int added = 0, newstart = 0;
+
+    if (count <= 0) return 0;
+    const char *msg = shuffle ? "SHUFFLING" : "LOADING SONGS";
+    aui_begin();
+    loading_screen(msg, NULL);
+    if (playlist_create(NULL, NULL) < 0 || !tagcache_search(&tcs, tag_filename))
+        { aui_end(); return 0; }
+    if (playlist_insert_context_create(NULL, &ctx, PLAYLIST_INSERT_LAST, false, false) < 0)
+        { tagcache_search_finish(&tcs); aui_end(); return 0; }
+    for (int k = 0; k < count; k++)
+    {
+        if (tagcache_retrieve(&tcs, L[order[k]].idx, tag_filename, path, sizeof(path))
+            && path[0] && playlist_insert_context_add(&ctx, path) >= 0)
+        {
+            if (k == start) newstart = added;
+            added++;
+        }
+        if ((k & 127) == 0) loading_screen(msg, NULL);
+    }
+    playlist_insert_context_release(&ctx);
+    tagcache_search_finish(&tcs);
+    aui_end();
+    if (added == 0) { splash(2 * HZ, "Couldn't load those songs"); return 0; }
+    if (shuffle) { playlist_shuffle(current_tick, -1); newstart = 0; }
+    playlist_start(newstart, 0, 0);
+    return GO_TO_WPS;
+}
+
+static int shuffle_all(void)
+{
+    if (tagcache_is_usable() && library_ready())
+        return play_entries(by_title, lib_n, 0, true);
+    /* no database yet: shuffle every song on the disk */
+    aui_begin();
+    loading_screen("SHUFFLING", NULL);
+    aui_end();
+    playlist_create(NULL, NULL);
+    playlist_insert_directory(NULL, "/", PLAYLIST_INSERT_LAST, false, true, NULL);
+    if (playlist_amount() > 0)
+    {
+        playlist_shuffle(current_tick, -1);
+        playlist_start(0, 0, 0);
+        return GO_TO_WPS;
+    }
+    splash(2 * HZ, "No songs found");
+    return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* songs list (All Songs, an artist's songs)                           */
+/* ------------------------------------------------------------------ */
+struct songs { const int *order; int count; bool show_artist; };
+
+static void songs_get(struct aui_list *l, int i, char *buf, size_t n, char *sub, size_t subn)
+{
+    struct songs *s = l->data;
+    int e = s->order[i];
+    strlcpy(buf, T(e), n);
+    if (sub) strlcpy(sub, AR(e), subn);
+}
+static int songs_select(struct aui_list *l, int i)
+{
+    struct songs *s = l->data;
+    return play_entries(s->order, s->count, i, false);
+}
+static int songs_list(const char *title, const int *order, int count)
+{
+    struct songs s = { order, count, true };
+    struct aui_list l = { 0 };
+    l.title = title; l.count = count; l.two_line = true; l.letter_jump = true;
+    l.get = songs_get; l.select = songs_select; l.data = &s;
+    return aui_list_run(&l);
+}
+
+/* ------------------------------------------------------------------ */
+/* artists                                                             */
+/* ------------------------------------------------------------------ */
+static void artist_get(struct aui_list *l, int i, char *buf, size_t n, char *sub, size_t subn)
+{
+    (void)l;
+    strlcpy(buf, pool + A[i].name, n);
+    if (sub) snprintf(sub, subn, A[i].count == 1 ? "%d song" : "%d songs", A[i].count);
+}
+static int artist_select(struct aui_list *l, int i)
+{
+    (void)l;
+    int r = songs_list(pool + A[i].name, by_artist + A[i].start, A[i].count);
+    return r > 0 ? r : 0;
+}
+static int artists(void)
+{
+    struct aui_list l = { 0 };
+    l.title = "Artists"; l.count = lib_nart; l.two_line = true; l.chevrons = true;
+    l.letter_jump = true; l.get = artist_get; l.select = artist_select;
+    return aui_list_run(&l);
+}
+
+/* ------------------------------------------------------------------ */
+/* search                                                              */
+/* ------------------------------------------------------------------ */
+#define NCH 39
+static const char *strip_label(int i)
+{
+    static char one[2];
+    static const char *chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
+    if (i < 36) { one[0] = chars[i]; one[1] = 0; return one; }
+    return i == 36 ? "Space" : i == 37 ? "Delete" : "Results";
+}
+
+static bool contains_ci(const char *hay, const char *needle)
+{
+    size_t nl = strlen(needle);
+    if (!nl) return true;
+    for (; *hay; hay++)
+    {
+        size_t k = 0;
+        while (k < nl && hay[k] && tolower((unsigned char)hay[k]) == tolower((unsigned char)needle[k]))
+            k++;
+        if (k == nl) return true;
+    }
+    return false;
+}
+
+static void run_search(const char *q)
+{
+    lib_res = 0;
+    if (!q[0]) return;
+    for (int k = 0; k < lib_n; k++)
+    {
+        int e = by_title[k];
+        if (contains_ci(T(e), q) || contains_ci(AR(e), q))
+            results[lib_res++] = e;
+    }
+}
+
+#ifdef BUTTON_SCROLL_FWD
+#define ACT_RESULTS ACTION_STD_CONTEXT
+#define ACT_DELETE  ACTION_STD_QUICKSCREEN
+static const struct button_mapping search_map[] = {
+    { ACTION_STD_NEXT,       BUTTON_SCROLL_FWD,                BUTTON_NONE },
+    { ACTION_STD_NEXTREPEAT, BUTTON_SCROLL_FWD|BUTTON_REPEAT,  BUTTON_NONE },
+    { ACTION_STD_PREV,       BUTTON_SCROLL_BACK,               BUTTON_NONE },
+    { ACTION_STD_PREVREPEAT, BUTTON_SCROLL_BACK|BUTTON_REPEAT, BUTTON_NONE },
+    { ACTION_STD_OK,         BUTTON_SELECT|BUTTON_REL,         BUTTON_SELECT },
+    { ACT_RESULTS,           BUTTON_RIGHT|BUTTON_REL,          BUTTON_RIGHT },
+    { ACT_RESULTS,           BUTTON_PLAY|BUTTON_REL,           BUTTON_PLAY },
+    { ACT_DELETE,            BUTTON_LEFT|BUTTON_REL,           BUTTON_LEFT },
+    { ACTION_STD_MENU,       BUTTON_MENU|BUTTON_REL,           BUTTON_MENU },
+    LAST_ITEM_IN_LIST
+};
+static const struct button_mapping *search_ctx(int c) { (void)c; return search_map; }
+static int search_action(int timeout) { return get_custom_action(CONTEXT_PLUGIN | 1, timeout, search_ctx); }
+#else
+#define ACT_RESULTS ACTION_STD_CONTEXT
+#define ACT_DELETE  ACTION_STD_CANCEL
+static int search_action(int timeout) { return get_action(CONTEXT_STD, timeout); }
+#endif
+
+static void draw_search(const char *q, int letter, bool in_results, int rsel, int rtop)
+{
+    const struct aui_theme *t = aui_theme();
+    char buf[32];
+    int rh = 40, ry = 76, rvis = 3;
+
+    aui_vgrad(0, 0, AUI_W, AUI_H, t->bg_top, t->bg_bot);
+    aui_topbar();
+    /* query field */
+    aui_round(10, AUI_BAR + 6, AUI_W - 20, 34, 10, t->light ? 0xeef0f4 : 0x23264a,
+              t->light ? 0xe4e7ed : 0x1a1c38);
+    /* results */
+    for (int r = 0; r < rvis && rtop + r < lib_res; r++)
+        if (in_results && rtop + r == rsel)
+            aui_round(6, ry + r * rh + 1, AUI_W - 12, rh - 2, 9, t->sel1, t->sel2);
+    /* letter strip */
+    aui_shade(0, 198, AUI_W, AUI_H - 198, 0, t->light ? 230 : 140, t->light ? 0xc9ced8 : 0x000000);
+    int lw = aui_text_w(AF_BIG, strip_label(letter)) + 22;
+    if (lw < 34) lw = 34;
+    if (!in_results)
+        aui_round(AUI_W / 2 - lw / 2, 203, lw, 32, 12, t->sel1, t->sel2);
+    else
+        aui_round(AUI_W / 2 - lw / 2, 203, lw, 32, 12, t->track, t->track);
+    aui_present();
+
+    /* field text */
+    int fh = aui_font_h(AF_BIG);
+    if (q[0])
+    {
+        snprintf(buf, sizeof(buf), "%s_", q);
+        aui_text(AF_BIG, 20, AUI_BAR + 6 + (34 - fh) / 2, t->text, buf, AUI_W - 100, 0);
+        snprintf(buf, sizeof(buf), lib_res == 1 ? "%d song" : "%d songs", lib_res);
+        aui_text(AF_SMALLR, AUI_W - 20, AUI_BAR + 16, t->sub, buf, 80, 2);
+    }
+    else
+        aui_text(AF_BIG, 20, AUI_BAR + 6 + (34 - fh) / 2, t->sub, "Search songs & artists", AUI_W - 40, 0);
+
+    /* results or hints */
+    if (!q[0])
+    {
+        aui_text(AF_SMALLR, AUI_W / 2, ry + 12, t->sub, "Turn the wheel to pick a letter", AUI_W - 20, 1);
+        aui_text(AF_SMALLR, AUI_W / 2, ry + 32, t->sub, "Center adds it   |   << deletes", AUI_W - 20, 1);
+        aui_text(AF_SMALLR, AUI_W / 2, ry + 52, t->sub, ">> or Play jumps to the results", AUI_W - 20, 1);
+    }
+    else if (lib_res == 0)
+        aui_text(AF_MED, AUI_W / 2, ry + 40, t->sub, "No matches", AUI_W - 20, 1);
+    for (int r = 0; r < rvis && rtop + r < lib_res; r++)
+    {
+        int e = results[rtop + r], y = ry + r * rh;
+        bool s = in_results && rtop + r == rsel;
+        aui_text(AF_MED, 18, y + 4, s ? 0xffffff : t->text, T(e), AUI_W - 36, 0);
+        aui_text(AF_SMALLR, 18, y + 22, s ? 0xe6ecff : t->sub, AR(e), AUI_W - 36, 0);
+    }
+
+    /* strip labels: centre one big, neighbours fading outwards */
+    aui_text(AF_BIG, AUI_W / 2, 203 + (32 - fh) / 2, in_results ? t->sub : 0xffffff,
+             strip_label(letter), 0, 1);
+    for (int side = -1; side <= 1; side += 2)
+    {
+        int x = AUI_W / 2 + side * (lw / 2 + 8);
+        for (int k = 1; k <= 8; k++)
+        {
+            int i = (letter + side * k + NCH * 4) % NCH;
+            const char *s = strip_label(i);
+            int w = aui_text_w(AF_MED, s);
+            int cx = x + side * (w / 2);
+            if (cx < -20 || cx > AUI_W + 20) break;
+            unsigned c = k <= 2 ? t->text : t->sub;
+            aui_text(AF_MED, cx, 203 + (32 - aui_font_h(AF_MED)) / 2, c, s, 0, 1);
+            x += side * (w + 14);
+        }
+    }
+    aui_topbar_text("Search");
+    aui_update();
+}
+
+static int search(void)
+{
+    static char q[32];
+    static int letter = 0;
+    bool in_results = false;
+    int rsel = 0, rtop = 0, minute = -1;
+    bool redraw = true;
+
+    run_search(q);
+    aui_begin();
+    while (1)
+    {
+        if (redraw) { draw_search(q, letter, in_results, rsel, rtop); redraw = false; }
+        int a = search_action(HZ);
+        size_t len = strlen(q);
+        switch (a)
+        {
+            case ACTION_STD_NEXT: case ACTION_STD_NEXTREPEAT:
+                if (in_results) { if (rsel < lib_res - 1) rsel++; }
+                else letter = (letter + 1) % NCH;
+                redraw = true; break;
+            case ACTION_STD_PREV: case ACTION_STD_PREVREPEAT:
+                if (in_results) { if (rsel > 0) rsel--; }
+                else letter = (letter + NCH - 1) % NCH;
+                redraw = true; break;
+            case ACTION_STD_OK:
+                if (in_results)
+                {
+                    int r = play_entries(results, lib_res, rsel, false);
+                    if (r > 0) { aui_end(); return r; }
+                }
+                else if (letter < 36)
+                {
+                    if (len < sizeof(q) - 1) { q[len] = strip_label(letter)[0] + ('a' - 'A') * (letter < 26); q[len + 1] = 0; }
+                    run_search(q); rsel = rtop = 0;
+                }
+                else if (letter == 36)
+                {
+                    if (len && len < sizeof(q) - 1 && q[len - 1] != ' ') { q[len] = ' '; q[len + 1] = 0; }
+                }
+                else if (letter == 37)
+                {
+                    if (len) { q[len - 1] = 0; run_search(q); rsel = rtop = 0; }
+                }
+                else if (lib_res > 0) { in_results = true; rsel = rtop = 0; }
+                redraw = true; break;
+            case ACT_RESULTS:
+                if (!in_results && lib_res > 0) { in_results = true; rsel = rtop = 0; }
+                redraw = true; break;
+            case ACT_DELETE:
+                if (in_results) in_results = false;
+                else if (len) { q[len - 1] = 0; run_search(q); rsel = rtop = 0; }
+                redraw = true; break;
+            case ACTION_STD_MENU:
+            case ACTION_STD_CANCEL:
+                if (in_results) { in_results = false; redraw = true; break; }
+                aui_end();
+                return 0;
+            case ACTION_NONE:
+                if (get_time()->tm_min != minute) { minute = get_time()->tm_min; redraw = true; }
+                break;
+            default:
+                if (default_event_handler(a) == SYS_USB_CONNECTED) { aui_end(); return 0; }
+                redraw = true; break;
+        }
+        if (rsel < rtop) rtop = rsel;
+        if (rsel >= rtop + 3) rtop = rsel - 2;
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* Music menu                                                          */
+/* ------------------------------------------------------------------ */
+static const char *music_items[] = { "Search", "Artists", "Playlists", "Shuffle", "All Songs" };
+
+static void music_get(struct aui_list *l, int i, char *buf, size_t n, char *sub, size_t subn)
+{
+    (void)l; (void)sub; (void)subn;
+    strlcpy(buf, music_items[i], n);
+}
+
+static int music_select(struct aui_list *l, int i)
+{
+    (void)l;
+    switch (i)
+    {
+        case 0: return library_ready() ? search() : 0;
+        case 1: return library_ready() ? artists() : 0;
+        case 2: return GO_TO_PLAYLISTS_SCREEN;
+        case 3: return shuffle_all();
+        case 4: return library_ready() ? songs_list("All Songs", by_title, lib_n) : 0;
+    }
+    return 0;
+}
+
+int asher_music(void)
+{
+    static int sel = 0;
+    struct aui_list l = { 0 };
+    l.title = "Music"; l.count = 5; l.chevrons = true;
+    l.get = music_get; l.select = music_select; l.sel = sel;
+    int r = aui_list_run(&l);
+    sel = l.sel;
+    return r;
+}
+
+/* Settings > Music Library: rebuild the database from scratch */
+static int library_rebuild(void)
+{
+    lib_free();
+    rebuild_requested = true;
+    tagcache_rebuild();
+    splash(3 * HZ, "Rebuilding your music library in the background");
+    return 0;
+}
+MENUITEM_FUNCTION(asher_library_item, 0, "Rebuild Music Library",
+                  library_rebuild, NULL, Icon_NOICON);
