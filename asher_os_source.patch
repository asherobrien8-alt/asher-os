diff --git a/apps/asher/asher_stats.c b/apps/asher/asher_stats.c
new file mode 100644
index 0000000..5f0116e
--- /dev/null
+++ b/apps/asher/asher_stats.c
@@ -0,0 +1,100 @@
+#include <stdio.h>
+#include <string.h>
+#include "config.h"
+#include "system.h"
+#include "kernel.h"
+#include "lcd.h"
+#include "font.h"
+#include "action.h"
+#include "audio.h"
+#include "metadata.h"
+#include "playlist.h"
+#include "powermgmt.h"
+#include "power.h"
+#include "settings.h"
+#include "splash.h"
+#include "timefuncs.h"
+#include "menu.h"
+#include "lang.h"
+#include "root_menu.h"
+#include "asher_stats.h"
+#include "moonphase.h"
+
+static const char *moon_names[8] = {
+    "New Moon", "Waxing Crescent", "First Quarter", "Waxing Gibbous",
+    "Full Moon", "Waning Gibbous", "Last Quarter", "Waning Crescent"
+};
+
+static int shuffle_all(void)
+{
+    splash(0, ID2P(LANG_WAIT));
+    playlist_create(NULL, NULL);
+    playlist_insert_directory(NULL, "/", PLAYLIST_INSERT_LAST, false, true, NULL);
+    if (playlist_amount() > 0)
+    {
+        playlist_shuffle(current_tick, -1);
+        playlist_start(0, 0, 0);
+        return GO_TO_WPS;
+    }
+    splashf(2 * HZ, "No songs found");
+    return 0;
+}
+
+static void draw_stats(void)
+{
+    char buf[64];
+    struct tm *t = get_time();
+    struct mp3entry *id3 = audio_current_track();
+    int st = audio_status();
+    int bat = battery_level();
+    int y = 8, lh = 24;
+    int hour12 = t->tm_hour % 12 ? t->tm_hour % 12 : 12;
+
+    lcd_clear_display();
+    lcd_set_foreground(LCD_RGBPACK(150, 190, 255));
+    lcd_putsxy(8, y, "STATS"); y += lh + 4;
+    lcd_set_foreground(LCD_RGBPACK(255, 255, 255));
+
+    if (bat >= 0) snprintf(buf, sizeof(buf), "Battery: %d%%%s", bat,
+                           charger_inserted() ? " (charging)" : "");
+    else          snprintf(buf, sizeof(buf), "Battery: --");
+    lcd_putsxy(8, y, buf); y += lh;
+
+    snprintf(buf, sizeof(buf), "Time: %d:%02d %s", hour12, t->tm_min,
+             t->tm_hour >= 12 ? "PM" : "AM");
+    lcd_putsxy(8, y, buf); y += lh;
+
+    snprintf(buf, sizeof(buf), "Moon: %s", moon_names[
+        asher_moon_phase(t->tm_year + 1900, t->tm_mon + 1, t->tm_mday)]);
+    lcd_putsxy(8, y, buf); y += lh + 6;
+
+    lcd_set_foreground(LCD_RGBPACK(150, 190, 255));
+    lcd_putsxy(8, y, (st & AUDIO_STATUS_PLAY)
+               ? ((st & AUDIO_STATUS_PAUSE) ? "PAUSED" : "NOW PLAYING")
+               : "NOT PLAYING"); y += lh;
+    lcd_set_foreground(LCD_RGBPACK(255, 255, 255));
+    if (id3 && (st & AUDIO_STATUS_PLAY))
+    {
+        lcd_putsxy(8, y, id3->title ? id3->title : "Unknown"); y += lh;
+        lcd_putsxy(8, y, id3->artist ? id3->artist : "");      y += lh;
+    }
+    lcd_update();
+}
+
+static int stats_screen(void)
+{
+    int action;
+    lcd_setfont(FONT_UI);
+    do {
+        draw_stats();
+        action = get_action(CONTEXT_STD, HZ);
+    } while (action != ACTION_STD_CANCEL && action != ACTION_STD_MENU
+             && action != ACTION_STD_OK);
+    lcd_set_foreground(global_settings.fg_color);
+    lcd_clear_display();
+    return 0;
+}
+
+MENUITEM_FUNCTION(asher_shuffle_item, MENU_FUNC_CHECK_RETVAL, "Shuffle Songs",
+                  shuffle_all, NULL, Icon_Playlist);
+MENUITEM_FUNCTION(asher_stats_item, 0, "Stats", stats_screen, NULL, Icon_NOICON);
