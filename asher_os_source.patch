+static void gb_str(char *buf, size_t n, sector_t kib)
+{
+    /* GB the way Windows counts them (1 GB = 1024 x 1024 x 1024 bytes) */
+    unsigned long long h = ((unsigned long long)kib * 100 + 524288) / 1048576;
+    snprintf(buf, n, "%llu.%02llu GB", h / 100, h % 100);
+}
+
+static void version_draw(void)
+{
+    const struct aui_theme *t = aui_theme();
+    char buf[64], b1[24], b2[24];
+    sector_t size = 0, freek = 0;
+    int bat = battery_level();
+    int y = AUI_BAR + 8;
+
+    volume_size(IF_MV(0,) &size, &freek);
+    aui_vgrad(0, 0, AUI_W, AUI_H, t->bg_top, t->bg_bot);
+    aui_topbar();
+    /* storage card */
+    int cy = 134, ch = 94;
+    aui_round(10, cy, AUI_W - 20, ch, 12, t->light ? 0xffffff : 0x22253f,
+              t->light ? 0xf4f5f8 : 0x1a1c33);
+    if (size)
+        aui_progress(24, cy + 50, AUI_W - 48, 12, (long)((size - freek) / 1024),
+                     (long)(size / 1024));
+    aui_present();
+
+    aui_text(AF_RETRO, AUI_W / 2, y, t->accent, "ASHER OS", AUI_W - 20, 1);
+    y += 26;
+    aui_text(AF_BIG, AUI_W / 2, y, t->text, "Version " ASHER_OS_VERSION, AUI_W - 20, 1);
+    y += 22;
+    /* 2.5.2: exactly which iPod this is (read once, then kept) */
+    aui_text(AF_SMALL, AUI_W / 2, y, t->text, asher_model_name(), AUI_W - 20, 1);
+    y += 15;
+    aui_text(AF_SMALLR, AUI_W / 2, y, t->sub, asher_model_detail(), AUI_W - 20, 1);
+    y += 15;
+    {
+        const char *num = asher_model_number(), *ser = asher_model_serial();
+        char bb[16] = "";
+        if (bat >= 0) snprintf(bb, sizeof(bb), "Battery %d%%", bat);
+        if (num[0] && ser[0]) snprintf(buf, sizeof(buf), "Model %s   -   Serial %s", num, ser);
+        else if (num[0]) snprintf(buf, sizeof(buf), "Model %s   -   %s", num, bb);
+        else strlcpy(buf, bb, sizeof(buf));
+        aui_text(AF_SMALLR, AUI_W / 2, y, t->sub, buf, AUI_W - 20, 1);
+    }
+
+    aui_text(AF_SMALL, 24, cy + 8, t->sub, "STORAGE", 120, 0);
+    if (size)
+    {
+        gb_str(b1, sizeof(b1), freek);
+        snprintf(buf, sizeof(buf), "%s free", b1);
+        aui_text(AF_BIG, 24, cy + 24, t->text, buf, AUI_W - 48, 0);
+        gb_str(b1, sizeof(b1), size - freek);
+        gb_str(b2, sizeof(b2), size);
+        snprintf(buf, sizeof(buf), "%s used of %s", b1, b2);
+        aui_text(AF_MED, 24, cy + 70, t->text, buf, AUI_W - 48, 0);
+    }
+    else
+        aui_text(AF_MED, 24, cy + 30, t->sub, "Couldn't read the drive", AUI_W - 48, 0);
+    aui_topbar_text("About");
+    aui_update();
+}
+
+static int version_screen(void)
+{
+    static bool counted;
+    aui_begin();
+    if (!counted)
+    {
+        /* count the free space exactly once (reads the whole drive table) */
+        aui_loading(LDR_STATS, "CHECKING STORAGE", NULL, current_tick, false);
+#ifndef SIMULATOR
+        volume_recalc_free(IF_MV(0));
+#endif
+        counted = true;
+    }
+    while (1)
+    {
+        version_draw();
+        int a = get_action(CONTEXT_STD, HZ * 5);
+        if (a == ACTION_STD_QUICKSCREEN) { asher_music_mode(); continue; }
+        if (a == ACTION_STD_CANCEL || a == ACTION_STD_MENU || a == ACTION_STD_OK) break;
+        if (a != ACTION_NONE && default_event_handler(a) == SYS_USB_CONNECTED) break;
+    }
+    aui_end();
+    return 0;
+}
